  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-pill",
      "description": "药丸形主 CTA，白底 + indigo 文字 + indigo hairline 描边 + 淡阴影。",
      "html": "<button class=\"ds-btn ds-btn-primary\"><span>探索知识库</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"M13 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;font-family:\"Sora\",\"Noto Sans\",ui-sans-serif,system-ui,sans-serif;font-weight:700;font-size:14px;border:1px solid transparent;cursor:pointer;transition:background 160ms ease,color 160ms ease,border-color 160ms ease,transform 160ms ease}.ds-btn svg{width:16px;height:16px;flex-shrink:0}.ds-btn-primary{min-height:44px;padding:0 1rem;border-radius:9999px;background:var(--color-surface,#ffffff);color:var(--color-theme,#4f46e5);border-color:var(--color-border-strong,rgba(79,70,229,0.16));box-shadow:var(--shadow-sm,0 1px 2px rgba(15,23,42,0.06))}.ds-btn-primary:hover,.ds-btn-primary:focus-visible{background:var(--color-theme-soft-hover,#e3e1fb);border-color:var(--color-theme,#4f46e5)}.ds-btn-primary:active{transform:scale(0.95)}"
    },
    {
      "name": "Hero CTA",
      "kind": "button",
      "refersTo": "pill-cta--primary",
      "description": "首页 hero 主 CTA：indigo 渐变底 + 白字 + indigo 产品光晕，hover 上浮 2px。",
      "html": "<a class=\"ds-cta ds-cta-hero\" href=\"#\">从当前测试任务开始</a>",
      "css": ".ds-cta{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 22px;border-radius:9999px;font-family:\"Sora\",\"Noto Sans\",ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:800;text-decoration:none;box-shadow:var(--shadow-sm,0 1px 2px rgba(15,23,42,0.06));transition:transform 220ms ease,border-color 220ms ease}.ds-cta-hero{background:linear-gradient(135deg,var(--color-theme,#4f46e5),color-mix(in srgb,var(--color-theme,#4f46e5) 76%,var(--color-theme-light,#818cf8)));color:#fff;border:1px solid color-mix(in srgb,var(--color-theme,#4f46e5) 24%,transparent);box-shadow:0 18px 40px rgba(79,70,229,0.22)}.ds-cta-hero:hover,.ds-cta-hero:focus-visible{transform:translateY(-2px)}.ds-cta-hero:active{transform:scale(0.95)}"
    },
    {
      "name": "Ghost Pill",
      "kind": "button",
      "refersTo": "pill-cta--ghost",
      "description": "次级药丸 CTA：白玻璃底 + indigo 文字 + indigo hairline 描边 + 背景模糊。",
      "html": "<a class=\"ds-ghost\" href=\"#\">浏览 QA Skills</a>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 22px;border-radius:9999px;background:rgba(255,255,255,0.76);color:var(--color-theme,#4f46e5);border:1px solid color-mix(in srgb,var(--color-theme,#4f46e5) 22%,transparent);backdrop-filter:blur(16px);font-family:\"Sora\",\"Noto Sans\",ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:800;text-decoration:none;box-shadow:var(--shadow-sm,0 1px 2px rgba(15,23,42,0.06));transition:transform 220ms ease,border-color 220ms ease}.ds-ghost:hover,.ds-ghost:focus-visible{transform:translateY(-2px);border-color:var(--color-theme,#4f46e5)}.ds-ghost:active{transform:scale(0.95)}"
    },
    {
      "name": "Tag / Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "药丸标签，indigo-soft 底 + indigo 文字 + indigo hairline 描边，最小高 44px。",
      "html": "<a class=\"ds-chip\" href=\"#\">软件测试</a>",
      "css": ".ds-chip{display:inline-flex;align-items:center;min-height:44px;padding:0.35rem 0.75rem;border-radius:9999px;border:1px solid var(--color-border-strong,rgba(79,70,229,0.16));background:var(--color-theme-soft,#edecfc);color:var(--color-theme,#4f46e5);font-family:\"Sora\",\"Noto Sans\",ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:600;line-height:1.3;text-decoration:none;box-shadow:var(--shadow-sm,0 1px 2px rgba(15,23,42,0.06));transition:background 160ms ease,border-color 160ms ease}.ds-chip:hover,.ds-chip:focus-visible{background:var(--color-theme-soft-hover,#e3e1fb);border-color:var(--color-theme,#4f46e5)}"
