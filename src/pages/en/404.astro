---
import { LOCALES } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import HomeRedirectCountdown from "@/components/HomeRedirectCountdown.astro";
const title = "Page Not Found";
const homeUrl = "/en/";
---

<Layout {title} robots="noindex, nofollow, noarchive">
  <section class="container">
    <h1>
      <b>404</b>
      {title}
    </h1>

    <p>
      The page you are looking for could not be found. Please return to the top or try another language.
    </p>
    <HomeRedirectCountdown homeUrl={homeUrl} lang="en" />

    <a href={homeUrl} class="gotop">Top Page</a>

    <section class="langList">
      <h2>View in other languages</h2>
      <ul>
        {
          Object.entries(LOCALES).map(([lang, { label }]) => (
            <li>
              <a
                href={`/${lang}/`}
                data-lang-path={lang}
                onclick={`localStorage.selectedLang = "${lang}"`}
                dir={LOCALES[lang].dir || null}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </section>
</Layout>

<script is:inline>
  if (localStorage.userAccessPath) {
    history.replaceState("", "", localStorage.userAccessPath);
    document.querySelectorAll("a[data-lang-path]").forEach((a) => {
      const pathnames = localStorage.userAccessPath.split("/");
      const lang = a.getAttribute("data-lang-path");
      pathnames[1] = lang;
      a.href = pathnames.join("/");
    });
    localStorage.removeItem("userAccessPath");
  }
</script>
<style>
  .container {
    text-align: center;
    border: 1px solid color-mix(in srgb, var(--color-caution) 40%, var(--color-border));
    padding: var(--sp-l);
    border-radius: var(--radius-md);
  }
  .container > h1 {
    color: var(--color-main);
    font-size: 2rem;
    line-height: 1.08;
  }
  .container > h1 b {
    display: block;
    font-size: min(6rem, 28vw);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--color-caution);
    opacity: 1;
  }
  .container > p {
    margin-block-start: var(--sp-s);
  }
  .gotop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-inline: auto;
    margin-block-start: var(--sp-s);
    padding: 0.5em 1.5em;
    border-radius: var(--radius-sm);
    font-size: 1.05rem;
    font-weight: 700;
    background: var(--color-theme);
    color: var(--color-theme-on-dark);
    text-decoration: none;
  }
  .gotop:hover {
    background: var(--color-theme-focus);
  }
  .langList {
    margin-block-start: var(--sp-l);
  }
  .langList ul {
    margin-block-start: var(--sp-s);
    display: flex;
    gap: var(--sp-s);
    justify-content: center;
  }
  .langList a {
    color: var(--color-theme);
    text-decoration: underline;
  }
</style>
