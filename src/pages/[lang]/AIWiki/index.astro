---
import { getCollection } from "astro:content";
import DocsLayout from "@/layouts/Docs.astro";
import WikiIndex from "@/components/WikiIndex.astro";
import { LOCALES, type Lang } from "@/i18n";
import { NAV_HOME } from "@/consts";
import { aiwikiIdToLang, buildAiWikiSidebar } from "@/data/aiwiki";

export async function getStaticPaths() {
  return Object.keys(LOCALES).map((lang) => ({ params: { lang } }));
}

const locale = (Astro.params.lang ?? "en") as Lang;
const homeName = (typeof NAV_HOME === "string" ? NAV_HOME : NAV_HOME[locale]) ?? "Home";
const title = locale === "zh-cn" ? "AI 百科" : "AI Wiki";
const description =
  locale === "zh-cn"
    ? "面向 AI 与 Vibe Coding 的术语百科，提供中英文词条、定义、实践与参考链接。"
    : "A bilingual AI and vibe-coding glossary with practical definitions, guidance, and references.";
const keywords =
  locale === "zh-cn"
    ? "AI Wiki, AI 词条, Vibe Coding, LLM, Agent, MCP"
    : "AI Wiki, AI glossary, vibe coding, LLM, agent, MCP";

const breadcrumbs = [
  { name: homeName, url: `/${locale}/` },
  { name: title, url: `/${locale}/AIWiki/` },
];

const allEntries = await getCollection("aiwiki");
const entries = allEntries.filter((e) => (e.data.lang ? e.data.lang === locale : aiwikiIdToLang(e.id) === locale));
const fullSidebarSections = buildAiWikiSidebar(entries, locale);
const letterSections = fullSidebarSections.filter((s) => s.title);
const basePath = `/${locale}/AIWiki`;
const sidebarSections = [
  {
    items: [{ label: locale === "zh-cn" ? "概述" : "Overview", href: "" }],
  },
  {
    title: locale === "zh-cn" ? "词条" : "Entries",
    items: letterSections.flatMap((section) => section.items),
  },
];
const totalCount = entries.length;
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: `${siteOrigin}${basePath}/`,
  inLanguage: locale === "zh-cn" ? "zh-CN" : "en",
};
const itemListItems = letterSections.flatMap((section) =>
  section.items.map((item) => ({
    name: item.label,
    url: `${siteOrigin}${basePath}/${item.href}/`,
  })),
);
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: title,
  numberOfItems: totalCount,
  itemListElement: itemListItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      url: item.url,
  })),
};
---

<DocsLayout
  title={title}
  description={description}
  contentMode="index"
  keywords={keywords}
  structuredData={[collectionSchema, itemListSchema]}
  breadcrumbs={breadcrumbs}
  sidebarSections={sidebarSections}
  currentPath=""
  basePath={basePath}
  sidebarMenuLabel={locale === "zh-cn" ? "本页导航" : "On this page"}
  sidebarSearchPlaceholder={locale === "zh-cn" ? "检索词条…" : "Search terms…"}
  sidebarSearchTargetId="aiwiki-search"
>
  <WikiIndex
    title={title}
    description={description}
    totalCount={totalCount}
    letterSections={letterSections}
    basePath={basePath}
    searchId="aiwiki-search"
  />
</DocsLayout>
