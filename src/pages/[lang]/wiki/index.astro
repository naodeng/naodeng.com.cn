---
/** 本站双语测试百科首页：词条目录、搜索与字母导航。 */
import { getCollection } from "astro:content";
import { LOCALES } from "@/i18n";
import DocsLayout from "@/layouts/Docs.astro";
import WikiIndex from "@/components/WikiIndex.astro";
import { buildWikiSidebar } from "@/data/wiki";
import { NAV_HOME, WIKI_PAGE_DESCRIPTION, WIKI_PAGE_KEYWORDS } from "@/consts";
import type { Lang } from "@/i18n";

export async function getStaticPaths() {
  return Object.keys(LOCALES).map((lang) => ({ params: { lang } }));
}

const locale = (Astro.params.lang ?? "en") as Lang;
const isEn = locale === "en";
const homeName = (typeof NAV_HOME === "string" ? NAV_HOME : NAV_HOME[locale]) ?? (isEn ? "Home" : "首页");
const title = isEn ? "QA Wiki" : "测试百科";
const description = WIKI_PAGE_DESCRIPTION[locale];
const keywords = WIKI_PAGE_KEYWORDS[locale];
const breadcrumbs = [
  { name: homeName, url: `/${locale}/` },
  { name: title, url: `/${locale}/wiki/` },
];
const entries = isEn ? await getCollection("wikiEn") : await getCollection("wiki");
const fullSidebarSections = buildWikiSidebar(entries, locale);
const letterSections = fullSidebarSections.filter((section) => section.title);
const sidebarSections = [
  { items: [{ label: isEn ? "Overview" : "概述", href: "" }] },
  { title: isEn ? "Terms" : "词条", items: letterSections.flatMap((section) => section.items) },
];
const basePath = `/${locale}/wiki`;
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";
const definedTermSetSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: isEn ? "QA Wiki" : "软件测试百科",
  description,
  url: `${siteOrigin}/${locale}/wiki/`,
  inLanguage: LOCALES[locale].lang || locale,
  publisher: {
    "@type": "Organization",
    name: "Nao Deng",
    url: siteOrigin,
  },
};
---

<DocsLayout
  contentMode="index"
  title={title}
  description={description}
  keywords={keywords}
  breadcrumbs={breadcrumbs}
  sidebarSections={sidebarSections}
  currentPath=""
  basePath={basePath}
  sidebarMenuLabel={isEn ? "Wiki navigation" : "本页导航"}
  sidebarSearchPlaceholder={isEn ? "Search terms…" : "检索词条…"}
  sidebarSearchTargetId="wiki-search"
  structuredData={[definedTermSetSchema]}
>
  <WikiIndex
    title={title}
    description={description}
    totalCount={entries.length}
    letterSections={letterSections}
    basePath={basePath}
    searchId="wiki-search"
    groupLabel={isEn ? "letter groups" : "个字母组"}
  />
  {isEn && (
    <p class="wiki-license">
      This glossary is adapted from the
      <a href="https://github.com/naodeng/QA-Glossary-Wiki">QA Glossary Wiki source collection</a>.
      It is maintained by Nao Deng and licensed under
      <a href="https://polyformproject.org/licenses/noncommercial/1.0.0" rel="license">PolyForm Noncommercial 1.0.0</a>.
      See the <a href="/en/copyright/">copyright and licensing page</a> for details.
    </p>
  )}
</DocsLayout>

<style>
  .wiki-license { margin: 1.5rem 0 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.7; }
</style>
