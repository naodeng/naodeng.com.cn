---
/**
 * 测试百科首页（docs 布局：左侧导航 + 主内容）
 * - 中文：Docs 布局，侧栏为词条列表（中文名），主区为概述
 * - 英文：简单页 + 跳转 ray.run/wiki
 */
import { getCollection } from "astro:content";
import { LOCALES } from "@/i18n";
import Base from "@/layouts/Base.astro";
import DocsLayout from "@/layouts/Docs.astro";
import WikiIndex from "@/components/WikiIndex.astro";
import { buildWikiSidebar } from "@/data/wiki";
import { NAV_HOME, WIKI_PAGE_DESCRIPTION, WIKI_PAGE_KEYWORDS } from "@/consts";
import type { Lang } from "@/i18n";

export async function getStaticPaths() {
  return Object.keys(LOCALES).map((lang) => ({ params: { lang } }));
}

const locale = (Astro.params.lang ?? "en") as Lang;
const isEn = locale === "en";
const homeName = (typeof NAV_HOME === "string" ? NAV_HOME : NAV_HOME[locale]) ?? "首页";
const title = isEn ? "QA Wiki" : "测试百科";
const description = isEn
  ? WIKI_PAGE_DESCRIPTION["en"]
  : WIKI_PAGE_DESCRIPTION["zh-cn"];
const keywords = isEn ? WIKI_PAGE_KEYWORDS["en"] : WIKI_PAGE_KEYWORDS["zh-cn"];
const breadcrumbs = [
  { name: homeName, url: `/${locale}/` },
  { name: title, url: `/${locale}/wiki/` },
];

const entries = await getCollection("wiki");
const fullSidebarSections = isEn ? [] : buildWikiSidebar(entries);
const basePath = `/${locale}/wiki`;
/** 按字母分组的区块（不含「概述」），用于概述页按字母展示全部词条 */
const letterSections = fullSidebarSections.filter((s) => s.title);
const sidebarSections = [
  { items: [{ label: "概述", href: "" }] },
  {
    title: "词条",
    items: letterSections.flatMap((section) => section.items),
  },
];
const totalCount = entries.length;

const siteOrigin = "https://inaodeng.com";
// DefinedTermSet JSON-LD for zh-cn wiki (en redirects to ray.run)
const definedTermSetSchema = !isEn ? {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "软件测试百科",
  description: WIKI_PAGE_DESCRIPTION["zh-cn"],
  url: `${siteOrigin}/zh-cn/wiki/`,
  inLanguage: "zh-CN",
  publisher: {
    "@type": "Organization",
    name: "软件测试同学",
    url: siteOrigin,
  },
} : null;
---

{isEn ? (
  <Base title={title} description={description} keywords={keywords} breadcrumbs={breadcrumbs} robots="noindex, follow">
    <div class="l-content wiki-index">
      <h1>{title}</h1>
      <p class="wiki-intro">Software testing terms &amp; definitions. For the full QA Wiki, visit:</p>
      <p class="wiki-external">
        <a href="https://ray.run/wiki" target="_blank" rel="noopener noreferrer">ray.run/wiki</a>
      </p>
    </div>
  </Base>
) : (
  <DocsLayout
    contentMode="index"
    title={title}
    description={description}
    keywords={keywords}
    breadcrumbs={breadcrumbs}
    sidebarSections={sidebarSections}
    currentPath=""
    basePath={basePath}
    sidebarMenuLabel="本页导航"
    sidebarSearchPlaceholder="检索词条…"
    sidebarSearchTargetId="wiki-search"
    structuredData={definedTermSetSchema ? [definedTermSetSchema] : undefined}
  >
    <WikiIndex
      title={title}
      description={description}
      totalCount={totalCount}
      letterSections={letterSections}
      basePath={basePath}
      searchId="wiki-search"
      groupLabel="个字母组"
    />
  </DocsLayout>
)}

<style>
  .wiki-intro { margin: 0 0 var(--sp-s); font-size: 1.05rem; line-height: 1.65; color: var(--color-text-secondary); }
  .wiki-external { margin-block-start: var(--sp-m); }
  .wiki-external a { font-weight: 600; color: var(--color-theme); }
</style>
