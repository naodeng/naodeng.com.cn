---
/** 本站双语测试百科词条页。 */
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsLayout from "@/layouts/Docs.astro";
import Giscus from "@/components/Giscus.astro";
import TrackingEvents from "@/components/TrackingEvents.astro";
import { NAV_HOME } from "@/consts";
import { marked, type Tokens } from "marked";
import { slugToTitleEn, getTitleZhFromBody, getTitleZh, wikiIdToSlug } from "@/data/wiki";
import type { Lang } from "@/i18n";

export async function getStaticPaths() {
  const [zhEntries, enEntries] = await Promise.all([getCollection("wiki"), getCollection("wikiEn")]);
  const paths: { params: { lang: string; slug: string }; props: { entry: CollectionEntry<"wiki"> | CollectionEntry<"wikiEn"> } }[] = [];
  paths.push(...zhEntries.map((entry) => {
    const slug = wikiIdToSlug(entry.id);
    return { params: { lang: "zh-cn", slug }, props: { entry } };
  }));
  paths.push(...enEntries.map((entry) => {
    const slug = wikiIdToSlug(entry.id);
    return { params: { lang: "en", slug }, props: { entry } };
  }));

  return paths;
}

const locale = (Astro.params.lang ?? "zh-cn") as Lang;
const isEn = locale === "en";
const slugParam = (Astro.params.slug ?? "") as string;
const { entry } = Astro.props as { entry: CollectionEntry<"wiki"> | CollectionEntry<"wikiEn"> };

const homeName = (typeof NAV_HOME === "string" ? NAV_HOME : NAV_HOME[locale]) ?? (isEn ? "Home" : "首页");
const wikiTitle = isEn ? "QA Wiki" : "测试百科";
const bodyStr = typeof entry.body === "string" ? entry.body : "";
const pageTitle = isEn
  ? (entry.data?.title?.trim() || slugToTitleEn(slugParam))
  : (getTitleZhFromBody(bodyStr) || getTitleZh(entry.data?.title ?? "") || slugToTitleEn(slugParam));
const rawDescription =
  (entry.data?.description && String(entry.data.description).trim()) ||
  (bodyStr && bodyStr.replace(/^#.+/m, "").replace(/[#*_[\]()`]/g, "").trim().slice(0, 200)) ||
  pageTitle;
const metaDescription = rawDescription.length > 155 ? rawDescription.slice(0, 152).trimEnd() + "…" : rawDescription;
const breadcrumbs = [
  { name: homeName, url: `/${locale}/` },
  { name: wikiTitle, url: `/${locale}/wiki/` },
  { name: pageTitle, url: `/${locale}/wiki/${slugParam}/` },
];
const entries = isEn ? await getCollection("wikiEn") : await getCollection("wiki");
const slugCaseMap = new Map(entries.map((item) => {
  const slug = wikiIdToSlug(item.id);
  return [slug.toLowerCase(), slug];
}));
const labelMap = new Map(entries.map((item) => {
  const slug = wikiIdToSlug(item.id);
  const label = isEn
    ? (item.data?.title?.trim() || slugToTitleEn(slug))
    : (getTitleZhFromBody(item.body) || getTitleZh(item.data?.title ?? "") || slugToTitleEn(slug));
  return [slug, label];
}));
const explicitRelated = entry.data.related ?? [];
const relatedSlugs = [...new Set(explicitRelated as string[])]
  .map((slug) => slugCaseMap.get(slug.toLowerCase()))
  .filter((slug): slug is string => Boolean(slug) && slug!.toLowerCase() !== slugParam.toLowerCase())
  .slice(0, 5);
const relatedItems = relatedSlugs.map((slug) => ({ slug, label: labelMap.get(slug) ?? slug }));
const sidebarSections = [
  { items: [{ label: isEn ? "Overview" : "返回百科首页", href: "" }] },
  { title: isEn ? "Current term" : "当前词条", items: [{ label: pageTitle, href: slugParam }] },
  ...(relatedItems.length > 0
    ? [{ title: isEn ? "Related terms" : "相关词条", items: relatedItems.map((item) => ({ label: item.label, href: item.slug })) }]
    : []),
];
const { Content, headings: renderedHeadings = [] } = await render(entry);

function parseHeadings(body: string): { depth: number; slug: string; text: string }[] {
  const used = new Map<string, number>();
  return marked.lexer(body)
    .filter((token): token is Tokens.Heading => token.type === "heading" && token.depth >= 2 && token.depth <= 3)
    .map((token) => {
      const text = token.text.trim();
      const base = text.toLowerCase().replace(/[^\w\u4e00-\u9fff\s-]/g, "").replace(/\s+/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");
      const count = used.get(base) ?? 0;
      used.set(base, count + 1);
      return { depth: token.depth, slug: count ? `${base}-${count}` : base, text };
    });
}
const headings = renderedHeadings.length > 0 ? renderedHeadings : parseHeadings(bodyStr);
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";
const wikiPageUrl = `${siteOrigin}/${locale}/wiki/${slugParam}/`;
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: pageTitle,
  description: metaDescription,
  url: wikiPageUrl,
  inDefinedTermSet: {
    "@type": "DefinedTermSet",
    name: isEn ? "QA Wiki" : "软件测试百科",
    url: `${siteOrigin}/${locale}/wiki/`,
  },
};
const basePath = `/${locale}/wiki`;
---

<DocsLayout
  title={pageTitle}
  description={metaDescription}
  breadcrumbs={breadcrumbs}
  structuredData={[definedTermSchema]}
  sidebarSections={sidebarSections}
  currentPath={slugParam}
  basePath={basePath}
  sidebarMenuLabel={isEn ? "Wiki navigation" : "本页导航"}
  sidebarSearchPlaceholder={isEn ? "Search terms…" : "检索词条…"}
  sidebarSearchAction={`${basePath}/`}
  sidebarSearchLabel={isEn ? "Search terms" : "检索词条"}
  headings={headings}
  tocLabel={isEn ? "On this page" : "本页目录"}
>
  <article class="wiki-article">
    <Content />
    {relatedItems.length > 0 && (
      <section class="wiki-related" aria-labelledby="wiki-related-heading">
        <h2 id="wiki-related-heading" class="wiki-related-title">{isEn ? "Related terms" : "相关词条"}</h2>
        <div class="wiki-related-pills">
          {relatedItems.map((item) => (
            <a href={`${basePath}/${item.slug}/`} class="wiki-related-pill">{item.label}</a>
          ))}
        </div>
      </section>
    )}
  </article>
  <Giscus lang={isEn ? "en" : "zh-CN"} inputPosition="bottom" />
</DocsLayout>
<TrackingEvents mode="detail" locale={locale} channel="wiki" slug={slugParam} detailLinkSelector=".wiki-related-pill" />

<script>
  const activeLink = document.querySelector<HTMLAnchorElement>(".docs-sidebar-link--active");
  if (activeLink) activeLink.scrollIntoView({ block: "nearest", behavior: "instant" });
</script>

<style>
  :global(.docs-sidebar-wrap) {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  :global(.docs-sidebar) {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  :global(.docs-sidebar-inner) {
    border-inline-start: none !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius-md) !important;
    overflow: hidden;
    box-shadow: none;
  }

  .wiki-article {
    max-inline-size: 68ch;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  @media (width >= 1600px) {
    .wiki-article {
      max-inline-size: 100%;
      margin-inline: 0;
    }
  }

  .wiki-article :global(h1) {
    font-size: clamp(1.75rem, 3vw, 2rem);
    line-height: 1.3;
    padding-block-end: var(--sp-s);
    border-block-end: 1px solid var(--color-border);
    margin-block-end: var(--sp-m);
  }

  .wiki-article :global(h2) {
    font-size: clamp(1.45rem, 2.4vw, 1.75rem);
    font-weight: 700;
    border-inline-start: 1px solid var(--color-border-strong);
    background: transparent;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 0.25em 0.6em 0.25em var(--sp-s);
    margin-block: 2.2em 0.7em;
  }

  .wiki-article :global(h3) {
    font-size: clamp(1.2rem, 2vw, 1.35rem);
    font-weight: 650;
    border-inline-start: 1px solid var(--color-border);
    padding-inline-start: 0.6em;
    margin-block: 1.6em 0.5em;
  }

  .wiki-article :global(h4) {
    font-size: 1.05rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-main) 88%, transparent);
    margin-block: 1.2em 0.4em;
  }

  .wiki-article :global(h4::before) {
    content: "•";
    color: color-mix(in srgb, var(--color-theme) 72%, transparent);
    margin-inline-end: 0.45em;
  }

  .wiki-article :global(a) {
    color: var(--color-theme);
    text-decoration: underline;
  }

  .wiki-article :global(ul) {
    padding-inline-start: 1.5em;
  }

  .wiki-related {
    margin-block-start: calc(var(--sp-l) * 0.2);
    padding-block-start: calc(var(--sp-m) * 0.2);
    border-block-start: 1px solid var(--color-border);
  }

  .wiki-related-title {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-block-end: var(--sp-s);
    /* Keep the related-terms heading plain rather than inheriting article heading treatment. */
    background: none;
    border-radius: 0;
    border-inline-start: none;
    padding: 0;
    border-block-end: none;
  }

  .wiki-related-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .wiki-related-pill {
    display: inline-block;
    padding: 0.3em 0.75em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: background-color 0.2s, color 0.2s;
  }

  .wiki-related-pill:hover {
    background-color: var(--color-theme);
    color: var(--color-theme-on-dark);
  }
</style>
