---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import { marked } from "marked";
import {
  ABOUT_PAGE_TITLE,
  ABOUT_PAGE_DESCRIPTION,
  ABOUT_HERO_NAME,
  ABOUT_HERO_TAGLINE,
  ABOUT_STAT_ARTICLES,
  ABOUT_STAT_PROJECTS,
  ABOUT_STAT_TOPICS,
  ABOUT_ME_TITLE,
  ABOUT_ME_BODY,
  ABOUT_TECH_TITLE,
  ABOUT_TECH_TESTING,
  ABOUT_TECH_API_PERF,
  ABOUT_TECH_LANGUAGES,
  ABOUT_TECH_DEVOPS,
  ABOUT_PROJECTS_TITLE,
  ABOUT_SUPPORT_TITLE,
  ABOUT_SUPPORT_BODY,
  ABOUT_CONNECT_TITLE,
  ABOUT_CONNECT_BODY,
  FEATURED_PROJECTS,
  NAV_HOME,
} from "@/consts";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const title = t(ABOUT_PAGE_TITLE);
const description = t(ABOUT_PAGE_DESCRIPTION);
const homeName = (typeof NAV_HOME === "string" ? NAV_HOME : NAV_HOME[locale]) ?? (locale === "zh-cn" ? "首页" : "Home");
const breadcrumbs = [
  { name: homeName, url: `/${locale}/` },
  { name: title, url: `/${locale}/about/` },
];

// 真实数据：当前语言的文章数、精选项目数、内容栏目数
const allPosts = await getCollection("blog");
const articleCount = allPosts.filter((p) => p.id.split("/")[0] === locale).length;
const projectCount = FEATURED_PROJECTS.length;
const topicCount = 8; // Blog / Docs / Wiki / AI Wiki / Guild / Prompts / Workflows / QA Skills

// 技术栈（原生 chip，替代外链 shields 徽章）
const techGroups = [
  { icon: "devices", title: ABOUT_TECH_TESTING, items: ["Playwright", "Selenium", "Cypress", "Postman", "K6"] },
  { icon: "speed", title: ABOUT_TECH_API_PERF, items: ["RestAssured", "SuperTest", "Gatling", "Pytest"] },
  { icon: "code", title: ABOUT_TECH_LANGUAGES, items: ["Python", "JavaScript", "TypeScript", "Java", "Scala"] },
  { icon: "build", title: ABOUT_TECH_DEVOPS, items: ["GitHub Actions", "Docker"] },
];

const aboutMeHtml = marked(t(ABOUT_ME_BODY), { gfm: true }) as string;
// 赞助链接使用本站相对路径，保证指向当前语言的 /sponsor
const sponsorPath = getRelativeLocaleUrl(locale, "/sponsor");
const supportRaw = (t(ABOUT_SUPPORT_BODY) as string).replace(/\/sponsor/g, sponsorPath);
const supportHtml = marked(supportRaw, { gfm: true }) as string;
const connectHtml = marked(t(ABOUT_CONNECT_BODY), { gfm: true }) as string;

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));
---

<Layout {title} description={description} breadcrumbs={breadcrumbs}>
  <section class="about-hero">
    <div class="about-hero__mark" aria-hidden="true">N</div>
    <h1 class="about-hero__name">{t(ABOUT_HERO_NAME)}</h1>
    <p class="about-hero__tagline">{t(ABOUT_HERO_TAGLINE)}</p>
    <ul class="about-hero__stats" role="list">
      <li class="about-stat">
        <strong>{articleCount}</strong>
        <span>{t(ABOUT_STAT_ARTICLES)}</span>
      </li>
      <li class="about-stat">
        <strong>{projectCount}</strong>
        <span>{t(ABOUT_STAT_PROJECTS)}</span>
      </li>
      <li class="about-stat">
        <strong>{topicCount}</strong>
        <span>{t(ABOUT_STAT_TOPICS)}</span>
      </li>
    </ul>
  </section>

  <section class="about-section">
    <h2 class="section-title">{t(ABOUT_ME_TITLE)}</h2>
    <div class="prose" set:html={aboutMeHtml} />
  </section>

  <section class="about-section">
    <h2 class="section-title">{t(ABOUT_TECH_TITLE)}</h2>
    <p class="tech-intro">
      {locale === "zh-cn"
        ? "与 GitHub 主页及本站项目、博客内容保持一致，涵盖 UI/E2E、API、性能测试及常用语言与 DevOps 工具。"
        : "Aligned with GitHub profile and site projects & blog: UI/E2E, API, performance testing, languages, and DevOps."}
      <a href="https://github.com/naodeng" target="_blank" rel="noopener noreferrer" class="tech-github-link">GitHub @naodeng</a>
    </p>
    <div class="tech-grid">
      {techGroups.map((g) => (
        <article class="tech-card">
          <div class="tech-card__head">
            <span class="tech-card__icon material-icons-sharp" aria-hidden="true">{g.icon}</span>
            <h3 class="tech-card__title">{t(g.title)}</h3>
          </div>
          <ul class="tech-chips" role="list">
            {g.items.map((item) => (
              <li class="tech-chip">{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="about-section">
    <h2 class="section-title">{t(ABOUT_PROJECTS_TITLE)}</h2>
    <ul class="project-grid" role="list">
      {FEATURED_PROJECTS.map((proj) => (
        <li>
          <a href={proj.url} target="_blank" rel="noopener noreferrer" class="project-card">
            <span class="project-card__title-row">
              <strong class="project-card__title">{t(proj.title)}</strong>
              <span class="material-icons-sharp dir" aria-hidden="true">open_in_new</span>
            </span>
            <span class="project-desc">{t(proj.description)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="about-section">
    <div class="about-two-col">
      <div class="about-panel">
        <span class="about-panel__icon material-icons-sharp" aria-hidden="true">favorite</span>
        <h2 class="section-title">{t(ABOUT_SUPPORT_TITLE)}</h2>
        <div class="prose" set:html={supportHtml} />
      </div>
      <div class="about-panel">
        <span class="about-panel__icon material-icons-sharp" aria-hidden="true">alternate_email</span>
        <h2 class="section-title">{t(ABOUT_CONNECT_TITLE)}</h2>
        <div class="prose" set:html={connectHtml} />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ── */
  .about-hero {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--sp-s);
    padding-block: var(--sp-l) var(--sp-m);
  }
  .about-hero__mark {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--gradient-theme);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    box-shadow: var(--shadow-product);
  }
  .about-hero__name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.1;
    color: var(--color-main);
  }
  .about-hero__tagline {
    margin: 0;
    max-width: 36em;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .about-hero__stats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-s);
    margin: var(--sp-m) 0 0;
    padding: 0;
  }
  .about-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15em;
    min-width: 120px;
    padding: var(--sp-s) var(--sp-m);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: var(--shadow-sm);
  }
  .about-stat strong {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-theme);
  }
  .about-stat span {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
  }

  /* ── Sections ── */
  .about-section {
    margin-block-start: var(--sp-l);
    padding-block-start: var(--sp-m);
    border-block-start: 1px solid rgba(148, 163, 184, 0.22);
  }
  .section-title {
    margin: 0 0 var(--sp-m);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0;
    color: var(--color-main);
  }

  /* ── Prose ── */
  .prose :global(ul) {
    padding-inline-start: 1.2em;
  }
  .prose :global(li) {
    margin-block: 0.25em;
  }
  .prose :global(a) {
    color: var(--color-theme);
    text-decoration: underline;
  }
  .prose :global(strong) {
    font-weight: 800;
  }

  /* ── Tech stack ── */
  .tech-intro {
    margin: 0 0 var(--sp-m);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .tech-github-link {
    display: inline-block;
    margin-block-start: 0.35em;
    color: var(--color-theme);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px dashed var(--color-theme);
    transition: border-color 0.2s ease;
  }
  .tech-github-link:hover {
    border-bottom-style: solid;
  }
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-s);
  }
  .tech-card {
    padding: var(--sp-m);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: var(--shadow-sm);
  }
  .tech-card__head {
    display: flex;
    align-items: center;
    gap: var(--sp-s);
    margin-block-end: var(--sp-s);
  }
  .tech-card__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--color-theme-soft);
    color: var(--color-theme);
    font-size: 22px;
  }
  .tech-card__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-main);
  }
  .tech-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
  }
  .tech-chip {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--color-theme-soft);
    color: var(--color-theme);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  /* ── Projects ── */
  .project-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-s);
    margin: 0;
    padding: 0;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    height: 100%;
    padding: var(--sp-m);
    border-radius: var(--radius-md);
    background: var(--color-theme-soft);
    border: 1px solid transparent;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .project-card:hover,
  .project-card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-theme);
    box-shadow: var(--shadow-sm);
  }
  .project-card__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }
  .project-card__title {
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--color-main);
  }
  .project-card .material-icons-sharp {
    color: var(--color-theme);
    opacity: 0.7;
  }
  .project-desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* ── Support & Connect ── */
  .about-two-col {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-s);
  }
  .about-panel {
    padding: var(--sp-m);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: var(--shadow-sm);
  }
  .about-panel__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--color-theme-soft);
    color: var(--color-theme);
    font-size: 22px;
    margin-block-end: var(--sp-s);
  }

  @media (max-width: 700px) {
    .tech-grid,
    .project-grid,
    .about-two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
