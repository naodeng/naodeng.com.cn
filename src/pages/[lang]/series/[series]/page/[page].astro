---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CollectionPostGrid from "@/components/CollectionPostGrid.astro";
import PageHeadline from "@/components/PageHeadline.astro";
import PaginationNav from "@/components/PaginationNav.astro";
import { BLOG_POSTS_PER_PAGE, NAV_HOME, NAV_SERIES } from "@/consts";
import { getCollection, type CollectionEntry } from "astro:content";
import { filterPublishedBlogPosts } from "@/utils/blogPublication";
import { paginateItems } from "@/utils/blogPagination";

function slugToSeries(slug: string) {
  return decodeURIComponent(slug);
}

export async function getStaticPaths() {
  const allPosts = filterPublishedBlogPosts(await getCollection("blog"));
  const paths: {
    params: { lang: string; series: string; page: string };
    props: { posts: CollectionEntry<"blog">[] };
  }[] = [];

  for (const lang of Object.keys(LOCALES)) {
    const langPosts = allPosts.filter((post) => post.id.startsWith(`${lang}/`));
    const seriesSet = new Set(langPosts.flatMap((post) => post.data.series || []));

    for (const series of seriesSet) {
      const postsInSeries = langPosts.filter((post) => post.data.series?.includes(series));
      const totalPages = Math.max(1, Math.ceil(postsInSeries.length / BLOG_POSTS_PER_PAGE));

      for (let page = 2; page <= totalPages; page += 1) {
        paths.push({
          params: { lang, series, page: String(page) },
          props: { posts: postsInSeries },
        });
      }
    }
  }

  return paths;
}

const { lang, series: seriesSlug, page } = Astro.params;
const seriesName = seriesSlug ? slugToSeries(seriesSlug) : "";
const { posts } = Astro.props;
const locale = lang as Lang;
const t = useTranslations(locale);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const paginated = paginateItems(sortedPosts, Number(page) || 1, BLOG_POSTS_PER_PAGE);
const title = seriesName;
const seriesBasePath = `/series/${encodeURIComponent(seriesName)}/`;
const pageLabel = locale === "zh-cn" ? `第 ${paginated.currentPage} 页` : `Page ${paginated.currentPage}`;
const homeName = typeof NAV_HOME === "string" ? NAV_HOME : (NAV_HOME[locale] ?? (locale === "zh-cn" ? "首页" : "Home"));
const seriesLabel = typeof NAV_SERIES === "string" ? NAV_SERIES : (NAV_SERIES[locale] ?? (locale === "zh-cn" ? "系列" : "Series"));
const breadcrumbs = [
  { name: homeName, url: `/${lang}/` },
  { name: seriesLabel, url: `/${lang}/series/` },
  { name: seriesName, url: `/${lang}/series/${encodeURIComponent(seriesName)}/` },
  { name: pageLabel, url: `/${lang}${seriesBasePath}page/${paginated.currentPage}/` },
];
---

<Layout {title}>
  <Breadcrumb items={breadcrumbs} />
  <PageHeadline {title}>
    <p class="series-meta">{paginated.totalItems} {t({ en: "posts in this series", "zh-cn": "篇系列文章" })}</p>
  </PageHeadline>

  <div class="blog-container">
    <CollectionPostGrid posts={paginated.items} locale={locale} />
    {paginated.totalPages > 1 && (
      <PaginationNav currentPage={paginated.currentPage} totalPages={paginated.totalPages} locale={locale} basePath={seriesBasePath} />
    )}
  </div>
</Layout>

<style>
  .series-meta {
    font-size: 1rem;
    opacity: 0.8;
    margin-block-start: 0.5rem;
    font-weight: 600;
  }

  .blog-container {
    margin-block-start: var(--sp-l);
  }
</style>
