---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import PageHeadline from "@/components/PageHeadline.astro";
import { PROJECTS_LIST } from "@/data/projects";
import { getProjectHref, isExternalProject } from "@/utils/projectLinks";
import { NAV_HOME, PROJECTS_PAGE_DESCRIPTION, PROJECTS_PAGE_TITLE } from "@/consts";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const title = t(PROJECTS_PAGE_TITLE);
const description = t(PROJECTS_PAGE_DESCRIPTION);
const homeName = (typeof NAV_HOME === "string" ? NAV_HOME : NAV_HOME[locale]) ?? (locale === "zh-cn" ? "首页" : "Home");
const breadcrumbs = [
  { name: homeName, url: `/${locale}/` },
  { name: title, url: `/${locale}/projects/` },
];

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));
---

<Layout {title} description={description} breadcrumbs={breadcrumbs}>
  <PageHeadline {title} compact />

  <div class="project-container">
    <div class="project-grid">
      {PROJECTS_LIST.map((proj) => (
        <a href={getProjectHref(locale, proj)} target={isExternalProject(proj) ? "_blank" : undefined} rel={isExternalProject(proj) ? "noopener noreferrer" : undefined} class="project-card">
          <div class="project-header">
            <div class="project-title-row">
              <h2 class="project-name">{t(proj.name)}</h2>
              {proj.badge ? <span class="project-badge">{t(proj.badge)}</span> : null}
            </div>
            {isExternalProject(proj) && <span class="external-icon">
               <span class="material-icons-sharp">open_in_new</span>
            </span>}
          </div>
          
          <div class="project-tech-tags">
             {t(proj.techStack).split(/[、,，]/).map(tech => (
               <span class="mini-tag">{tech.trim()}</span>
             ))}
          </div>
          
          <p class="project-desc">{t(proj.description)}</p>
          
          <div class="project-footer">
            <span class="view-link">{isExternalProject(proj) ? (locale === "zh-cn" ? "查看源码" : "View Source") : (locale === "zh-cn" ? "查看项目" : "View project")}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .project-container {
    margin-block-start: var(--sp-l);
  }
  
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(14rem, 0.85fr) minmax(0, 2fr) auto;
    grid-template-rows: auto auto;
    grid-template-areas: "header desc footer" "tags desc footer";
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding: 1.1rem 1rem;
    border-block-start: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.2s ease;
    position: relative;
  }

  .project-card:hover {
    background: var(--color-surface-muted);
  }

  .project-card:last-child {
    border-block-end: 1px solid var(--color-border);
  }

  .project-header {
    grid-area: header;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    min-inline-size: 0;
  }

  .project-name {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-main);
    font-weight: 800;
    line-height: 1.2;
  }

  .project-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .project-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    padding: 0.16rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-theme) 28%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-theme) 12%, transparent);
    color: var(--color-theme);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .external-icon {
    color: var(--color-theme);
    opacity: 0.4;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .project-card:hover .external-icon {
    opacity: 1;
    transform: rotate(-10deg) scale(1.1);
  }

  .project-tech-tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-inline-size: 0;
  }

  .mini-tag {
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .project-desc {
    grid-area: desc;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .project-footer {
    grid-area: footer;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    white-space: nowrap;
  }

  .view-link {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-theme);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.4rem;
  }

  .view-link::after {
    content: "→";
    transition: transform 0.2s ease;
  }

  .project-card:hover .view-link::after {
    transform: translateX(4px);
  }

  @media (max-width: 960px) {
    .project-card {
      grid-template-columns: minmax(12rem, 0.9fr) minmax(0, 1.5fr);
      grid-template-rows: auto auto auto;
      grid-template-areas: "header desc" "tags desc" "footer footer";
      column-gap: 1rem;
    }
    .project-footer {
      justify-content: flex-start;
      padding-block-start: 0.65rem;
      border-block-start: 1px solid var(--color-border);
    }
  }

  @media (max-width: 640px) {
    .project-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas: "header" "desc" "tags" "footer";
      gap: 0.65rem;
      padding: 1rem 0.25rem;
    }
    .project-header {
      align-items: flex-start;
    }
    .project-name {
      font-size: var(--text-base);
    }
    .project-tech-tags {
      margin-block-start: 0.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card:hover .external-icon,
    .project-card:hover .view-link::after {
      transition: none;
      transform: none;
    }
  }
</style>
