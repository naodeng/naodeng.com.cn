---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import {
  SITE_TITLE,
  HOME_HERO_TITLE,
  HOME_HERO_SUBTITLE,
  HOME_CTA_START,
  HOME_CTA_WIKI,
  HOME_EXPLORE_TITLE,
  HOME_EXPLORE_SUBTITLE,
  HOME_LATEST_POSTS,
  HOME_VIEW_ALL,
  HOME_PAGE_DESCRIPTION,
  HOME_PAGE_KEYWORDS,
} from "@/consts";
import GoogleAd from "@/components/GoogleAd.astro";
import TrackingEvents from "@/components/TrackingEvents.astro";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const allPosts = (await getCollection("blog")).filter(
  (post) => post.id.split("/")[0] === locale,
);

const latestPosts = [...allPosts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const exploreCards =
  locale === "zh-cn"
    ? [
        {
          key: "wiki",
          href: getRelativeLocaleUrl(locale, "/wiki"),
          title: "测试百科",
          desc: "系统化测试百科",
        },
        {
          key: "aiwiki",
          href: getRelativeLocaleUrl(locale, "/AIWiki"),
          title: "AI Wiki",
          desc: "AI 测试与工程知识",
        },
        {
          key: "guild",
          href: getRelativeLocaleUrl(locale, "/guild/"),
          title: "Guild",
          desc: "框架与实践指南",
        },
        {
          key: "prompts",
          href: getRelativeLocaleUrl(locale, "/prompts/"),
          title: "Prompts",
          desc: "测试提示词合集",
        },
        {
          key: "qaskills",
          href: getRelativeLocaleUrl(locale, "/qaskills/"),
          title: "QA Skills",
          desc: "可复用技能卡片",
        },
        {
          key: "projects",
          href: getRelativeLocaleUrl(locale, "/projects/"),
          title: "Projects",
          desc: "开源与作品",
        },
      ]
    : [
        {
          key: "aiwiki",
          href: getRelativeLocaleUrl(locale, "/AIWiki"),
          title: "AI Wiki",
          desc: "AI testing & engineering",
        },
        {
          key: "guild",
          href: getRelativeLocaleUrl(locale, "/guild/"),
          title: "Guild",
          desc: "Guides and playbooks",
        },
        {
          key: "prompts",
          href: getRelativeLocaleUrl(locale, "/prompts/"),
          title: "Prompts",
          desc: "Testing prompts",
        },
        {
          key: "qaskills",
          href: getRelativeLocaleUrl(locale, "/qaskills/"),
          title: "QA Skills",
          desc: "Reusable QA skills",
        },
        {
          key: "projects",
          href: getRelativeLocaleUrl(locale, "/projects/"),
          title: "Projects",
          desc: "Open source & work",
        },
        {
          key: "blog",
          href: getRelativeLocaleUrl(locale, "/blog"),
          title: "Blog",
          desc: "Essays and practice notes",
        },
      ];

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));

const siteOrigin = "https://inaodeng.com";
const homeUrl = `${siteOrigin}/${locale}/`;

const homePageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(SITE_TITLE),
  description: t(HOME_PAGE_DESCRIPTION),
  url: homeUrl,
  inLanguage: locale === "zh-cn" ? "zh-CN" : "en",
  author: {
    "@type": "Person",
    name: "Nao Deng",
    url: siteOrigin,
  },
  publisher: {
    "@type": "Organization",
    name: t(SITE_TITLE),
    url: siteOrigin,
    logo: {
      "@type": "ImageObject",
      url: `${siteOrigin}/ogp.png`,
      width: 1200,
      height: 630,
    },
  },
};
---

<Layout
  title={t(SITE_TITLE)}
  description={t(HOME_PAGE_DESCRIPTION)}
  keywords={t(HOME_PAGE_KEYWORDS)}
  extraStructuredData={[homePageSchema]}
>
  <section class="home-apple-hero">
    <h1 class="home-apple-hero__title">{t(HOME_HERO_TITLE)}</h1>
    <p class="home-apple-hero__subtitle">{t(HOME_HERO_SUBTITLE)}</p>
    <div class="home-apple-hero__ctas">
      <a
        class="pill-cta pill-cta--primary"
        href={getRelativeLocaleUrl(locale, "/blog")}
      >
        {t(HOME_CTA_START)}
      </a>
      <a
        class="pill-cta pill-cta--ghost"
        href={locale === "zh-cn"
          ? getRelativeLocaleUrl(locale, "/wiki")
          : getRelativeLocaleUrl(locale, "/AIWiki")}
      >
        {t(HOME_CTA_WIKI)}
      </a>
    </div>
  </section>

  <section class="home-explore" aria-labelledby="home-explore-title">
    <h2 id="home-explore-title" class="home-explore__title">
      {t(HOME_EXPLORE_TITLE)}
    </h2>
    <p class="home-explore__subtitle">{t(HOME_EXPLORE_SUBTITLE)}</p>
    <ul class="home-explore-grid" role="list">
      {exploreCards.map((card) => (
        <li>
          <a class="home-explore-card" href={card.href}>
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
            <span class="home-explore-card__more">
              {locale === "zh-cn" ? "了解更多" : "Learn more"}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {!import.meta.env.DEV && (
    <div class="home-ad-wrap" aria-hidden="true">
      <ins
        class="adsbygoogle"
        style="display:block; text-align:center;"
        data-ad-layout="in-article"
        data-ad-format="fluid"
        data-ad-client="ca-pub-7249159446737834"
        data-ad-slot="5247439587"
      />
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  )}

  <GoogleAd />

  <section class="home-latest-posts" aria-labelledby="home-latest-title">
    <h2 id="home-latest-title">{t(HOME_LATEST_POSTS)}</h2>
    <ul class="home-latest-list" role="list">
      {latestPosts.map((post) => {
        const idParts = post.id.split("/").slice(1);
        const postUrl = `/${locale}/blog/${idParts.join("/").toLowerCase()}/`;
        return (
          <li>
            <a href={postUrl}>
              <span>{post.data.title}</span>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toISOString().slice(0, 10)}
              </time>
            </a>
          </li>
        );
      })}
    </ul>
    <p class="home-latest-more">
      <a
        class="pill-cta pill-cta--ghost"
        href={getRelativeLocaleUrl(locale, "/blog")}
      >
        {t(HOME_VIEW_ALL)}
      </a>
    </p>
  </section>
</Layout>

<TrackingEvents mode="home" locale={locale} />

<style>
  .home-apple-hero {
    background: #fff;
    text-align: center;
    padding: 80px 24px 56px;
  }

  .home-apple-hero__title {
    margin: 0;
    font-size: 48px;
    font-weight: 600;
    letter-spacing: -0.4px;
    line-height: 1.08;
    color: #1d1d1f;
  }

  .home-apple-hero__subtitle {
    margin: 14px auto 0;
    max-width: 28em;
    font-size: 21px;
    line-height: 1.3;
    color: #1d1d1f;
  }

  .home-apple-hero__ctas {
    margin-top: 22px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .pill-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    padding: 11px 22px;
    font-size: 17px;
    text-decoration: none;
    min-height: 44px;
  }

  .pill-cta--primary {
    background: var(--color-theme);
    color: #fff;
  }

  .pill-cta--ghost {
    color: var(--color-theme);
    border: 1px solid var(--color-theme);
    background: transparent;
  }

  .pill-cta:active {
    transform: scale(0.95);
  }

  .home-explore {
    background: #f5f5f7;
    padding: 48px 24px 56px;
    text-align: center;
  }

  .home-explore__title {
    margin: 0;
    font-size: 28px;
    font-weight: 600;
    color: #1d1d1f;
  }

  .home-explore__subtitle {
    margin: 8px auto 0;
    max-width: 32em;
    font-size: 17px;
    color: #7a7a7a;
  }

  .home-explore-grid {
    list-style: none;
    margin: 28px auto 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    max-width: 900px;
    text-align: start;
  }

  .home-explore-card {
    display: block;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 18px;
    padding: 24px;
    min-height: 140px;
    text-decoration: none;
    color: inherit;
    box-shadow: none;
  }

  .home-explore-card h3 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 600;
  }

  .home-explore-card p {
    margin: 0 0 14px;
    font-size: 14px;
    color: #7a7a7a;
  }

  .home-explore-card__more {
    color: var(--color-theme);
    font-size: 14px;
  }

  .home-ad-wrap {
    margin: 24px auto;
    max-width: 720px;
    min-height: 1px;
  }

  .home-latest-posts {
    background: #fff;
    padding: 48px 24px 56px;
    max-width: 720px;
    margin-inline: auto;
  }

  .home-latest-posts h2 {
    margin: 0 0 16px;
    font-size: 28px;
    font-weight: 600;
    color: #1d1d1f;
  }

  .home-latest-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-latest-list a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid #f0f0f0;
    text-decoration: none;
    color: #1d1d1f;
    font-size: 17px;
  }

  .home-latest-list time {
    color: #7a7a7a;
    font-size: 14px;
    white-space: nowrap;
  }

  .home-latest-more {
    margin: 28px 0 0;
    text-align: center;
  }

  @media (width < 720px) {
    .home-apple-hero__title {
      font-size: 34px;
    }

    .home-explore-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
