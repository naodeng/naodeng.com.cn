---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import { PROJECTS_LIST } from "@/data/projects";
import {
  SITE_TITLE,
  HOME_HERO_TITLE,
  HOME_HERO_SUBTITLE,
  HOME_CTA_START,
  HOME_CTA_WIKI,
  HOME_EXPLORE_TITLE,
  HOME_EXPLORE_SUBTITLE,
  HOME_EXPLORE_MORE,
  HOME_EXPLORE_CARDS,
  HOME_LATEST_POSTS,
  HOME_VIEW_ALL,
  HOME_PROJECTS_TITLE,
  HOME_TAGS_TITLE,
  HOME_VIEW_ALL_PROJECTS,
  HOME_WIKI_SECTION_TITLE,
  HOME_WIKI_INTRO,
  PROMPTS_PAGE_TITLE,
  PROMPTS_WORKFLOWS_SECTION_TITLE,
  HOME_PAGE_DESCRIPTION,
  HOME_PAGE_KEYWORDS,
} from "@/consts";
import { getTitleZhFromBody, getTitleZh, wikiIdToSlug } from "@/data/wiki";
import GuildShowcase from "@/components/guild/GuildShowcase.astro";
import GoogleAd from "@/components/GoogleAd.astro";
import TrackingEvents from "@/components/TrackingEvents.astro";
import HomeTaskNavigator from "@/components/home/HomeTaskNavigator.astro";
import CoreCapabilities from "@/components/home/CoreCapabilities.astro";
import HomeProofAndCases from "@/components/home/HomeProofAndCases.astro";
import { getQASkillsGrouped } from "@/utils/qaskills";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const allPosts = (await getCollection("blog")).filter(
  (post) => post.id.split("/")[0] === locale,
);

const latestPosts = [...allPosts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const tagCounts = allPosts
  .flatMap((post) => post.data.tags || [])
  .reduce(
    (acc, tag) => {
      acc[tag] = (acc[tag] || 0) + 1;
      return acc;
    },
    {} as Record<string, number>,
  );

const popularTags = Object.entries(tagCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 30)
  .map(([tag]) => tag);

const featuredProjects = PROJECTS_LIST.slice(0, 6);

const TESTING_TYPE_ORDER = [
  "requirements-analysis",
  "test-case-writing",
  "functional-testing",
  "performance-testing",
  "automation-testing",
  "mobile-testing",
  "bug-reporting",
  "test-reporting",
  "test-strategy",
  "ai-assisted-testing",
  "manual-testing",
  "security-testing",
  "api-testing",
  "accessibility-testing",
  "test-case-reviewer",
];

const allPrompts = await getCollection("prompts");
const localePrompts = allPrompts.filter((p) => p.data.lang === locale);
const promptTypeMap = new Map<string, (typeof localePrompts)[0]>();
for (const p of localePrompts.sort((a, b) => a.data.order - b.data.order)) {
  if (!promptTypeMap.has(p.data.testingType)) {
    promptTypeMap.set(p.data.testingType, p);
  }
}
const promptTypeCards = Array.from(promptTypeMap.values())
  .sort(
    (a, b) =>
      TESTING_TYPE_ORDER.indexOf(a.data.testingType) -
      TESTING_TYPE_ORDER.indexOf(b.data.testingType),
  )
  .slice(0, 6);

const localeWorkflows = (await getCollection("workflows"))
  .filter((w) => w.data.lang === locale)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const qaSkillsGrouped = await getQASkillsGrouped(locale);
const homeQASkills = [
  ...qaSkillsGrouped.testingTypes.slice(0, 3),
  ...qaSkillsGrouped.testingWorkflows.slice(0, 3),
];

function toHomeSkillSnippet(input: string, lang: Lang): string {
  const text = (input || "").replace(/\s+/g, " ").trim();
  if (!text) return "";
  const maxLen = lang === "zh-cn" ? 46 : 92;
  if (text.length <= maxLen) return text;
  return `${text.slice(0, maxLen).trimEnd()}…`;
}

function shuffle<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const wikiEntries =
  locale === "zh-cn"
    ? (await getCollection("wiki")).map((e) => {
        const slug = wikiIdToSlug(e.id);
        const labelZh =
          getTitleZhFromBody(e.body) || getTitleZh(e.data?.title ?? "") || slug;
        return { slug, labelZh };
      })
    : [];
const wikiShowcaseItems =
  wikiEntries.length > 0 ? shuffle(wikiEntries).slice(0, 24) : [];
const showWiki = locale === "zh-cn" && wikiShowcaseItems.length > 0;

const aiWikiShowcaseItems = shuffle(
  (await getCollection("aiwiki"))
    .filter((e) => (e.data.lang ?? "en") === locale)
    .map((e) => {
      const slug =
        e.data.slug ?? e.id.split("/").pop()?.replace(/\.md$/, "") ?? e.id;
      const label = e.data.title || e.data.titleZh || e.data.titleEn || slug;
      return { slug, label };
    }),
).slice(0, 18);

const exploreCards = HOME_EXPLORE_CARDS[locale].map((card) => ({
  ...card,
  href: getRelativeLocaleUrl(locale, card.path),
}));

const primaryEntries = [
  {
    key: "blog",
    href: getRelativeLocaleUrl(locale, "/blog"),
    eyebrow: locale === "zh-cn" ? "长期文章" : "Long-form writing",
    title: locale === "zh-cn" ? "博客" : "Blog",
    desc:
      locale === "zh-cn"
        ? "阅读软件测试、自动化、AI 工程和个人实践总结。"
        : "Read software testing, automation, AI engineering, and personal practice notes.",
  },
  {
    key: "wiki",
    href:
      locale === "zh-cn"
        ? getRelativeLocaleUrl(locale, "/wiki")
        : getRelativeLocaleUrl(locale, "/AIWiki"),
    eyebrow: locale === "zh-cn" ? "系统知识" : "Reference",
    title: locale === "zh-cn" ? "Wiki / AI 百科" : "Wiki / AI Wiki",
    desc:
      locale === "zh-cn"
        ? "查询测试概念、AI 术语和工程实践词条。"
        : "Look up testing concepts, AI terms, and engineering references.",
  },
  {
    key: "qa-tools",
    href: getRelativeLocaleUrl(locale, "/prompts"),
    eyebrow: locale === "zh-cn" ? "QA 工具内容" : "QA tools",
    title: locale === "zh-cn" ? "提示词、工作流与技能库" : "Prompts, workflows, and skills",
    desc:
      locale === "zh-cn"
        ? "进入可复用的测试提示词、流程和 QA Skills。"
        : "Use reusable testing prompts, workflows, and QA skills.",
  },
];

/* …projects 羊皮纸 → guild 白 → wiki 羊皮纸 → aiwiki 白 → tags 羊皮纸
   若无 wiki：guild 白 → aiwiki 羊皮纸 → tags 白 */
const bandWiki = "parchment" as const;
const bandAiWiki = showWiki ? ("white" as const) : ("parchment" as const);
const bandTags = showWiki ? ("parchment" as const) : ("white" as const);

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));

const siteOrigin = "https://inaodeng.com";
const homeUrl = `${siteOrigin}/${locale}/`;
const homeSeoTitle = locale === "zh-cn"
  ? "软件测试同学 X naodeng｜AI 测试知识、Skills 与 Prompts"
  : "Nao Deng | QA Skills, Prompts and AI Testing Knowledge";

const homePageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(SITE_TITLE),
  description: t(HOME_PAGE_DESCRIPTION),
  url: homeUrl,
  inLanguage: locale === "zh-cn" ? "zh-CN" : "en",
  author: {
    "@type": "Person",
    name: "Nao Deng",
    url: siteOrigin,
  },
  publisher: {
    "@type": "Organization",
    name: t(SITE_TITLE),
    url: siteOrigin,
    logo: {
      "@type": "ImageObject",
      url: `${siteOrigin}/ogp.png`,
      width: 1200,
      height: 630,
    },
  },
};
---

<Layout
  title={homeSeoTitle}
  titleMode="absolute"
  description={t(HOME_PAGE_DESCRIPTION)}
  keywords={t(HOME_PAGE_KEYWORDS)}
  extraStructuredData={[homePageSchema]}
>
  <div class="home-page">
    <section class="home-band home-band--white home-apple-hero">
      <div class="home-inner">
        <h1 class="home-hero__title">{t(HOME_HERO_TITLE)}</h1>
        <p class="home-hero__subtitle">{t(HOME_HERO_SUBTITLE)}</p>
        <div class="home-hero__ctas">
          <a
            class="pill-cta pill-cta--primary"
            href={getRelativeLocaleUrl(locale, "/blog")}
          >
            {t(HOME_CTA_START)}
          </a>
          <a
            class="pill-cta pill-cta--ghost"
            href={locale === "zh-cn"
              ? getRelativeLocaleUrl(locale, "/wiki")
              : getRelativeLocaleUrl(locale, "/AIWiki")}
          >
            {t(HOME_CTA_WIKI)}
          </a>
        </div>
        <ul
          class="home-primary-entries"
          role="list"
          aria-label={locale === "zh-cn" ? "主要内容入口" : "Primary content entries"}
        >
          {primaryEntries.map((entry) => (
            <li>
              {entry.key === "qa-tools" ? (
                <div class="home-primary-entry home-primary-entry--act">
                  <span class="home-primary-entry__eyebrow">{entry.eyebrow}</span>
                  <span class="home-primary-entry__title">{entry.title}</span>
                  <span class="home-primary-entry__desc">{entry.desc}</span>
                  <span class="home-primary-entry__actions">
                    <a href={getRelativeLocaleUrl(locale, "/qaskills/")}>Skills →</a>
                    <a href={getRelativeLocaleUrl(locale, "/prompts/")}>Prompts →</a>
                  </span>
                </div>
              ) : (
                <a class={`home-primary-entry home-primary-entry--${entry.key}`} href={entry.href}>
                  <span class="home-primary-entry__eyebrow">{entry.eyebrow}</span>
                  <span class="home-primary-entry__title">{entry.title}</span>
                  <span class="home-primary-entry__desc">{entry.desc}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
        <div class="home-hero-console" aria-hidden="true">
          <div class="console-topbar">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="console-grid">
            <div class="console-card console-card--primary">
              <span>{locale === "zh-cn" ? "知识库" : "Knowledge"}</span>
              <strong>{locale === "zh-cn" ? "测试百科" : "QA Wiki"}</strong>
            </div>
            <div class="console-card">
              <span>{locale === "zh-cn" ? "自动化" : "Automation"}</span>
              <strong>{locale === "zh-cn" ? "技能路径" : "Skill Paths"}</strong>
            </div>
            <div class="console-card">
              <span>{locale === "zh-cn" ? "AI 测试" : "AI Testing"}</span>
              <strong>{locale === "zh-cn" ? "提示词库" : "Prompt Library"}</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <HomeTaskNavigator locale={locale} />
    <CoreCapabilities locale={locale} />
    <HomeProofAndCases locale={locale} />

    <section class="home-band home-band--parchment" aria-labelledby="home-explore-title">
      <div class="home-inner">
        <h2 id="home-explore-title" class="home-band__title">{t(HOME_EXPLORE_TITLE)}</h2>
        <p class="home-band__subtitle">{t(HOME_EXPLORE_SUBTITLE)}</p>
        <ul class="home-grid home-explore-grid" role="list">
          {exploreCards.map((card) => (
            <li>
              <a class="home-card" href={card.href}>
                <h3 class="home-card__title">{card.title}</h3>
                <p class="home-card__desc">{card.desc}</p>
                <span class="home-card__more">{t(HOME_EXPLORE_MORE)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section
      class="home-band home-band--white home-latest-posts"
      aria-labelledby="home-latest-title"
    >
      <div class="home-inner">
        <h2 id="home-latest-title" class="home-band__title">{t(HOME_LATEST_POSTS)}</h2>
        <ul class="home-grid" role="list">
          {latestPosts.map((post) => {
            const idParts = post.id.split("/").slice(1);
            const postUrl = `/${locale}/blog/${idParts.join("/").toLowerCase()}/`;
            const dateStr = post.data.date.toLocaleDateString(
              locale === "zh-cn" ? "zh-CN" : "en-US",
              { year: "numeric", month: "short", day: "numeric" },
            );
            return (
              <li>
                <a class="home-card" href={postUrl}>
                  <time
                    class="home-card__meta"
                    datetime={post.data.date.toISOString()}
                  >
                    {dateStr}
                  </time>
                  <h3 class="home-card__title">{post.data.title}</h3>
                  {post.data.description && (
                    <p class="home-card__desc">{post.data.description}</p>
                  )}
                  <span class="home-card__more">{t(HOME_EXPLORE_MORE)}</span>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="home-band__footer">
          <a
            class="pill-cta pill-cta--ghost"
            href={getRelativeLocaleUrl(locale, "/blog")}
          >
            {t(HOME_VIEW_ALL)}
          </a>
        </p>
      </div>
    </section>

    <GoogleAd variant="band" />

    <section
      class="home-band home-band--parchment home-prompts"
      aria-labelledby="home-prompts-title"
    >
      <div class="home-inner">
        <h2 id="home-prompts-title" class="home-band__title">{t(PROMPTS_PAGE_TITLE)}</h2>
        <p class="home-band__subtitle">
          {locale === "zh-cn" ? "按测试类型精选提示词" : "Prompts by testing type"}
        </p>
        <ul class="home-grid" role="list">
          {promptTypeCards.map((entry) => (
            <li>
              <a
                class="home-card"
                href={getRelativeLocaleUrl(
                  locale,
                  `/prompts/${entry.data.testingType}/`,
                )}
              >
                <h3 class="home-card__title">
                  {entry.data.title.replace(/^[^-]+ - /, "")}
                </h3>
                <p class="home-card__desc">{entry.data.description}</p>
                <span class="home-card__more">{t(HOME_EXPLORE_MORE)}</span>
              </a>
            </li>
          ))}
        </ul>
        {localeWorkflows.length > 0 && (
          <>
            <p class="home-band__subtitle home-band__subtitle--spaced">
              {t(PROMPTS_WORKFLOWS_SECTION_TITLE)}
            </p>
            <ul class="home-grid" role="list">
              {localeWorkflows.map((wf) => (
                <li>
                  <a
                    class="home-card"
                    href={getRelativeLocaleUrl(
                      locale,
                      `/prompts/workflows/${wf.data.workflowType}/`,
                    )}
                  >
                    <h3 class="home-card__title">{wf.data.title}</h3>
                    <p class="home-card__desc">{wf.data.description}</p>
                    <span class="home-card__more">{t(HOME_EXPLORE_MORE)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        <p class="home-band__footer">
          <a
            class="pill-cta pill-cta--ghost"
            href={getRelativeLocaleUrl(locale, "/prompts/")}
          >
            {locale === "zh-cn" ? "查看全部提示词" : "View all prompts"}
          </a>
        </p>
      </div>
    </section>

    <section
      class="home-band home-band--white home-qaskills"
      aria-labelledby="home-qaskills-title"
    >
      <div class="home-inner">
        <h2 id="home-qaskills-title" class="home-band__title">
          {locale === "zh-cn"
            ? "专业质量保证技能库"
            : "Professional QA Skill Library"}
        </h2>
        <p class="home-band__subtitle">
          {locale === "zh-cn"
            ? "测试类型与工作流技能精选"
            : "Selected testing and workflow skills"}
        </p>
        <ul class="home-grid" role="list">
          {homeQASkills.map((skill) => (
            <li>
              <a
                class="home-card"
                href={getRelativeLocaleUrl(locale, `/qaskills/${skill.slug}/`)}
              >
                <h3 class="home-card__title">
                  {locale === "zh-cn"
                    ? skill.chineseName || skill.title
                    : skill.title}
                </h3>
                <p class="home-card__desc">
                  {toHomeSkillSnippet(skill.intro, locale)}
                </p>
                <span class="home-card__more">{t(HOME_EXPLORE_MORE)}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="home-band__footer">
          <a
            class="pill-cta pill-cta--ghost"
            href={getRelativeLocaleUrl(locale, "/qaskills/")}
          >
            {locale === "zh-cn" ? "查看全部技能库" : "View all skills"}
          </a>
        </p>
      </div>
    </section>

    <section
      class="home-band home-band--parchment home-projects"
      aria-labelledby="home-projects-title"
    >
      <div class="home-inner">
        <h2 id="home-projects-title" class="home-band__title">
          {t(HOME_PROJECTS_TITLE)}
        </h2>
        <ul class="home-grid" role="list">
          {featuredProjects.map((proj) => (
            <li>
              <a
                class="home-card"
                href={proj.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <h3 class="home-card__title">{t(proj.name)}</h3>
                <p class="home-card__desc">{t(proj.description)}</p>
                <span class="home-card__more">{t(HOME_EXPLORE_MORE)}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="home-band__footer">
          <a
            class="pill-cta pill-cta--ghost"
            href={getRelativeLocaleUrl(locale, "/projects")}
          >
            {t(HOME_VIEW_ALL_PROJECTS)}
          </a>
        </p>
      </div>
    </section>

    <section class="home-band home-band--white home-guild">
      <div class="home-inner">
        <GuildShowcase locale={locale} />
      </div>
    </section>

    {
      showWiki && (
        <section
          class={`home-band home-band--${bandWiki} home-wiki`}
          aria-labelledby="home-wiki-title"
        >
          <div class="home-inner">
            <h2 id="home-wiki-title" class="home-band__title">
              {HOME_WIKI_SECTION_TITLE}
            </h2>
            <p class="home-band__subtitle">{HOME_WIKI_INTRO}</p>
            <ul class="home-chip-cloud" role="list">
              {wikiShowcaseItems.map((item) => (
                <li>
                  <a
                    class="home-chip"
                    href={getRelativeLocaleUrl("zh-cn", `/wiki/${item.slug}`)}
                    title={item.labelZh}
                  >
                    {item.labelZh}
                  </a>
                </li>
              ))}
            </ul>
            <p class="home-band__footer">
              <a
                class="pill-cta pill-cta--ghost"
                href={getRelativeLocaleUrl(locale, "/wiki")}
              >
                进入百科
              </a>
            </p>
          </div>
        </section>
      )
    }

    <section
      class={`home-band home-band--${bandAiWiki} home-aiwiki`}
      aria-labelledby="home-aiwiki-title"
    >
      <div class="home-inner">
        <h2 id="home-aiwiki-title" class="home-band__title">
          {locale === "zh-cn" ? "AI 百科" : "AI Wiki"}
        </h2>
        <p class="home-band__subtitle">
          {locale === "zh-cn"
            ? "精选 AI 与工程实践词条"
            : "Selected AI and engineering terms"}
        </p>
        <ul class="home-chip-cloud" role="list">
          {aiWikiShowcaseItems.map((item) => (
            <li>
              <a
                class="home-chip"
                href={getRelativeLocaleUrl(locale, `/AIWiki/${item.slug}`)}
                title={item.label}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="home-band__footer">
          <a
            class="pill-cta pill-cta--ghost"
            href={getRelativeLocaleUrl(locale, "/AIWiki")}
          >
            {locale === "zh-cn" ? "进入 AI 百科" : "Browse AI Wiki"}
          </a>
        </p>
      </div>
    </section>

    <section
      class={`home-band home-band--${bandTags} home-tags`}
      aria-labelledby="home-tags-title"
    >
      <div class="home-inner">
        <h2 id="home-tags-title" class="home-band__title">{t(HOME_TAGS_TITLE)}</h2>
        <ul class="home-chip-cloud tags-container" role="list">
          {popularTags.map((tag) => (
            <li>
              <a
                class="home-chip"
                href={getRelativeLocaleUrl(
                  locale,
                  `/tags/${tag.includes("/") || tag.includes(" ") ? encodeURIComponent(tag) : tag}`,
                )}
              >
                #{tag}
                <span class="home-chip__count">{tagCounts[tag]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Layout>

<TrackingEvents mode="home" locale={locale} />

<style>
  /* 首页挣脱 .l-content 窄栏，色带全宽铺开 */
  :global(main.l-main:has(.home-page)) {
    max-inline-size: none;
    padding-inline: 0;
    margin-block-start: 0;
    padding-block-end: 0;
  }

  .home-page {
    background: #f5f5f7;
  }

  :global(.home-band) {
    width: 100%;
    padding-block: 72px;
  }

  :global(.home-band--white) {
    background: #ffffff;
  }

  :global(.home-band--parchment) {
    background: #f5f5f7;
  }

  :global(.home-inner) {
    width: min(980px, calc(100% - 48px));
    margin-inline: auto;
    text-align: center;
  }

  .home-hero__title {
    margin: 0;
    font-size: clamp(34px, 5vw, 48px);
    font-weight: 600;
    letter-spacing: -0.4px;
    line-height: 1.08;
    color: #1d1d1f;
  }

  .home-hero__subtitle {
    margin: 14px auto 0;
    max-width: 28em;
    font-size: 21px;
    line-height: 1.3;
    color: #1d1d1f;
  }

  .home-hero__ctas {
    margin-top: 22px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .home-primary-entries {
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    text-align: start;
  }

  .home-primary-entry {
    display: grid;
    gap: 8px;
    min-height: 156px;
