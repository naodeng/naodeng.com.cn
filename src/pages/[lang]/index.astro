---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import {
  SITE_TITLE,
  HOME_EXPLORE_TITLE,
  HOME_EXPLORE_SUBTITLE,
  HOME_EXPLORE_MORE,
  HOME_EXPLORE_CARDS,
  HOME_LATEST_POSTS,
  HOME_VIEW_ALL,
  HOME_PAGE_DESCRIPTION,
  HOME_PAGE_KEYWORDS,
  LEARNING_SITES,
} from "@/consts";
import TrackingEvents from "@/components/TrackingEvents.astro";
import HomeTaskNavigator from "@/components/home/HomeTaskNavigator.astro";
import HomeCapabilityGuide from "@/components/home/HomeCapabilityGuide.astro";
import HomeExploreHub from "@/components/home/HomeExploreHub.astro";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { PROJECTS_LIST } from "@/data/projects";
import HomeGlassHero from "@/components/home/HomeGlassHero.astro";
import { filterPublishedBlogPosts } from "@/utils/blogPublication";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const allPosts = filterPublishedBlogPosts(await getCollection("blog")).filter(
  (post) => post.id.split("/")[0] === locale,
);

const latestPosts = [...allPosts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

// 探索卡数量徽标：从内容集合动态统计，避免硬编码过时
const wikiCount = (await getCollection("wiki")).length;
const aiwikiEntries = await getCollection("aiwiki");
const aiwikiCount = aiwikiEntries.filter((e) =>
  e.data.lang ? e.data.lang === locale : e.id.startsWith(`${locale}/`),
).length;
const guildEntries = await getCollection("guild");
const guildCount = guildEntries.filter((e) => e.id.startsWith(`${locale}/`)).length;
const projectsCount = PROJECTS_LIST.length;

const exploreCards = HOME_EXPLORE_CARDS[locale].map((card) => ({
  ...card,
  href: getRelativeLocaleUrl(locale, card.path),
  meta:
    locale === "zh-cn"
      ? {
          wiki: `${wikiCount} 篇`,
          aiwiki: `${aiwikiCount} 篇`,
          guild: `${guildCount} 篇`,
          projects: `${projectsCount} 个项目`,
        }[card.key]
      : {
          wiki: `${wikiCount} entries`,
          aiwiki: `${aiwikiCount} entries`,
          guild: `${guildCount} guides`,
          projects: `${projectsCount} projects`,
        }[card.key] ?? "",
}));

const productLinks = [
  {
    href: getRelativeLocaleUrl(locale, "/dsh-qa"),
    title: "DSH-QA",
    desc: t(PROJECTS_LIST.find((project) => project.url === "/dsh-qa/")!.description),
    logo: "/images/product-logos/dsh-qa.svg",
  },
  {
    href: getRelativeLocaleUrl(locale, "/ai-test-auditor"),
    title: "AI test audit",
    desc: t(PROJECTS_LIST.find((project) => project.url === "/ai-test-auditor/")!.description),
    logo: "/images/product-logos/ai-test-auditor.svg",
  },
];

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));

const siteOrigin = "https://inaodeng.com";
const homeUrl = `${siteOrigin}/${locale}/`;
const homeSeoTitle = locale === "zh-cn"
  ? "软件测试同学 X naodeng｜AI 测试知识、Skills 与 Prompts"
  : "Nao Deng | QA Skills, Prompts and AI Testing Knowledge";

const homePageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(SITE_TITLE),
  description: t(HOME_PAGE_DESCRIPTION),
  url: homeUrl,
  inLanguage: locale === "zh-cn" ? "zh-CN" : "en",
  author: {
    "@type": "Person",
    name: "Nao Deng",
    url: siteOrigin,
  },
  publisher: {
    "@type": "Organization",
    name: t(SITE_TITLE),
    url: siteOrigin,
    logo: {
      "@type": "ImageObject",
      url: `${siteOrigin}/ogp.png`,
      width: 1200,
      height: 630,
    },
  },
};
---

<Layout
  title={homeSeoTitle}
  titleMode="absolute"
  description={t(HOME_PAGE_DESCRIPTION)}
  keywords={t(HOME_PAGE_KEYWORDS)}
  extraStructuredData={[homePageSchema]}
>
  <div class="home-page">
    <HomeGlassHero locale={locale} />

    <HomeTaskNavigator locale={locale} />
    <HomeCapabilityGuide locale={locale} />

    <section
      class="home-band home-band--muted home-latest-posts"
      aria-labelledby="home-latest-title"
    >
      <div class="home-inner">
        <HomeSectionHeading
          id="home-latest-title"
          title={t(HOME_LATEST_POSTS)}
        />
        <ul class="home-post-list" role="list">
          {latestPosts.map((post) => {
            const idParts = post.id.split("/").slice(1);
            const postUrl = `/${locale}/blog/${idParts.join("/").toLowerCase()}/`;
            const dateStr = post.data.date.toLocaleDateString(
              locale === "zh-cn" ? "zh-CN" : "en-US",
              { year: "numeric", month: "short", day: "numeric" },
            );
            return (
              <li>
                <a class="home-post-item" href={postUrl}>
                  <time
                    class="home-post-item__date"
                    datetime={post.data.date.toISOString()}
                  >
                    {dateStr}
                  </time>
                  <div class="home-post-item__body">
                    <h3 class="home-post-item__title">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="home-post-item__desc">{post.data.description}</p>
                    )}
                    {post.data.tags?.length ? (
                      <ul
                        class="home-post-item__tags"
                        aria-label={locale === "zh-cn" ? "文章标签" : "Article tags"}
                      >
                        {post.data.tags.map((tag) => <li>{tag}</li>)}
                      </ul>
                    ) : null}
                  </div>
                  <span class="home-post-item__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="home-band__footer">
          <a
            class="pill-cta pill-cta--ghost"
            href={getRelativeLocaleUrl(locale, "/blog")}
          >
            {t(HOME_VIEW_ALL)}
          </a>
        </p>
      </div>
    </section>


    <HomeExploreHub
      locale={locale}
      title={t(HOME_EXPLORE_TITLE)}
      subtitle={t(HOME_EXPLORE_SUBTITLE)}
      moreLabel={t(HOME_EXPLORE_MORE)}
      cards={exploreCards}
      productLinks={productLinks}
    />

    <section
      class="home-band home-band--muted home-learning-resources"
      aria-labelledby="home-learning-title"
    >
      <div class="home-inner">
        <HomeSectionHeading
          id="home-learning-title"
          title={locale === "zh-cn" ? "选择 30 天学习路径，持续进阶" : "Choose a 30-day learning path and keep growing"}
        />
        <ul class="home-learning-grid" role="list">
          {LEARNING_SITES.map((site) => (
            <li>
              <a class="home-learning-card" href={site.url} target="_blank" rel="noopener noreferrer">
                <span class="home-learning-card__plan">{locale === "zh-cn" ? "30 天计划" : "30-day plan"}</span>
                <h3>{t(site.homeTitle)}</h3>
                <p class="home-learning-card__description">{t(site.description)}</p>
                <span class="home-learning-card__link">
                  {locale === "zh-cn" ? "查看学习计划" : "View learning plan"}
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Layout>

<TrackingEvents mode="home" locale={locale} />

<style>
  /* 首页挣脱 .l-content 窄栏，色带全宽铺开 */
  :global(main.l-main:has(.home-page)) {
    inline-size: 100%;
    max-inline-size: none;
    padding-inline: 0;
    margin-block-start: 0;
    padding-block-end: 0;
  }

  :global(.home-band) {
    width: 100%;
    padding-block: 72px;
  }

  :global(.home-inner) {
    width: min(var(--layout-max), calc(100% - (2 * var(--layout-gutter))));
    margin-inline: auto;
    text-align: center;
  }

  .home-hero__title {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.4px;
    line-height: 1.08;
  }

  .home-hero__subtitle {
    margin: 14px auto 0;
    max-width: 28em;
    font-size: 21px;
    line-height: 1.3;
  }

  .home-hero__ctas {
    margin-top: 22px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  :global(.home-band__subtitle--spaced) {
    margin-top: 40px;
  }

  .home-band__footer {
    margin: 32px 0 0;
  }

  .pill-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 11px 22px;
    border-radius: var(--radius-sm);
    font-size: 17px;
    text-decoration: none;
  }

  .pill-cta--primary {
    background: var(--color-theme);
    color: var(--color-theme-on-dark);
  }

  .pill-cta--ghost {
    background: transparent;
    color: var(--color-theme);
    border: 1px solid var(--color-theme);
  }

  .pill-cta:active {
    transform: translateY(1px);
  }

  @media (width < 900px) {
    :global(.home-band) {
      padding-block: 42px;
    }

    :global(.home-inner) {
      width: min(var(--layout-max), calc(100% - (2 * var(--layout-gutter))));
    }
  }

  /* Proofline: restrained bands with a clear editorial rhythm. */
  .home-page { background: var(--color-base); }

  :global(.home-band) {
    position: relative;
    padding-block: clamp(3.25rem, 6vw, 5rem);
  }

  :global(.home-band--white),
  :global(.home-band--muted) {
    background: transparent;
  }

  :global(.home-band:nth-of-type(even))::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-surface-muted);
    pointer-events: none;
  }

  :global(.home-inner) {
    position: relative;
    z-index: 1;
    width: min(var(--layout-max), calc(100% - (2 * var(--layout-gutter))));
  }

  .home-hero {
    min-height: 380px;
    display: grid;
    align-items: center;
    padding-block: 80px 64px;
    background: transparent;
  }

  .home-hero__title {
    max-width: 920px;
    margin-inline: auto;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.04;
    color: var(--color-main);
  }

  .home-hero__title::after {
    content: "";
    display: block;
    width: 92px;
    height: 5px;
    margin: 22px auto 0;
    border-radius: var(--radius-sm);
    background: var(--color-theme);
  }

  .home-hero__subtitle {
    max-width: 720px;
    margin-top: 22px;
    font-size: 20px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .home-hero__ctas {
    margin-top: 30px;
  }

  .pill-cta {
    min-height: 48px;
    padding: 12px 22px;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 800;
    box-shadow: none;
  }

  .pill-cta--primary {
    background: var(--color-theme);
    color: var(--color-theme-on-dark);
    border: 0;
    box-shadow: none;
  }

  .pill-cta--ghost {
    background: var(--color-surface);
    color: var(--color-theme);
    border: 1px solid color-mix(in srgb, var(--color-theme) 22%, transparent);
    backdrop-filter: none;
  }

  .pill-cta:hover,
  .pill-cta:focus-visible {
    transform: translateY(-2px);
  }

  :global(.home-band__title) {
    font-family: var(--font-heading);
    font-size: clamp(1.55rem, 2.4vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -.015em;
    line-height: 1.25;
    color: var(--color-main);
  }

  :global(.home-band__subtitle) {
    color: var(--color-text-secondary);
  }

  /* 最新文章：日期、文章内容和入口统一排成可扫读的列表。 */
  .home-post-list {
    list-style: none;
    width: min(100%, 1160px);
    margin: 28px auto 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-block-start: 1px solid var(--color-border-strong);
    text-align: start;
  }

  .home-post-list > li { border-block-end: 1px solid var(--color-border); }

  .home-post-item {
    display: grid;
    grid-template-columns: 138px minmax(0, 1fr) 24px;
    align-items: center;
    gap: 1.25rem;
    min-height: 0;
    padding: 1.15rem .3rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .home-post-item__date {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .home-post-item__body {
    flex: 1;
    min-width: 0;
  }

  .home-post-item__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 750;
    line-height: 1.35;
    color: var(--color-main);
  }

  .home-post-item__desc {
    margin: 4px 0 0;
    font-size: .875rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-post-item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .home-post-item__tags li {
    max-width: 100%;
    padding: 3px 8px;
    border-radius: var(--radius-xl);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .home-post-item__arrow {
    align-self: center;
    color: var(--color-theme);
    font-weight: 800;
    transition: transform var(--transition-fast);
  }

  .home-post-item:hover .home-post-item__arrow,
  .home-post-item:focus-visible .home-post-item__arrow {
    transform: translateX(2px);
  }

  .home-post-item:hover .home-post-item__title,
  .home-post-item:focus-visible .home-post-item__title {
    color: var(--color-theme);
  }

  .home-learning-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    text-align: start;
  }

  .home-learning-card {
    box-sizing: border-box;
    display: flex;
    min-width: 0;
    min-height: 258px;
    height: 100%;
    flex-direction: column;
    align-items: flex-start;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }

  .home-learning-card:hover,
  .home-learning-card:focus-visible {
    border-color: var(--color-theme);
    background: var(--color-theme-soft);
    transform: translateY(-2px);
  }

  .home-learning-card:focus-visible {
    outline: 2px solid var(--color-theme);
    outline-offset: 3px;
  }

  .home-learning-card__plan {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .home-learning-card h3 {
    margin: 18px 0 0;
    color: var(--color-main);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 750;
    line-height: 1.3;
    text-wrap: balance;
  }

  .home-learning-card__description {
    flex: 1;
    margin: 12px 0 0;
    color: var(--color-text-secondary);
    font-size: 15px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .home-learning-card__link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-block-start: 18px;
    color: var(--color-theme);
    font-size: 15px;
    font-weight: 800;
  }

  .home-learning-card__link > span {
    transition: transform var(--transition-fast);
  }

  .home-learning-card:hover .home-learning-card__link > span,
  .home-learning-card:focus-visible .home-learning-card__link > span {
    transform: translateX(3px);
  }

  @media (width < 1040px) {
    .home-learning-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (width < 640px) {
    .home-learning-grid { grid-template-columns: 1fr; gap: 12px; }
    .home-learning-card { min-height: 210px; padding: 20px; }
  }

  @media (width < 640px) {
    .home-post-item {
      grid-template-columns: minmax(0, 1fr) 20px;
      gap: .45rem .8rem;
      padding-block: 1rem;
    }

    .home-post-item__date { grid-column: 1; grid-row: 1; }
    .home-post-item__body { grid-column: 1; grid-row: 2; }
    .home-post-item__arrow { grid-column: 2; grid-row: 1 / span 2; }
  }

  @media (width < 900px) {
    .home-band {
      padding-block: 42px;
    }

    .home-hero {
      min-height: 0;
      padding-block: 72px 52px;
    }

    .home-hero__title {
      font-size: clamp(1.75rem, 6.2vw, 2.5rem);
    }

    .home-hero__subtitle {
      font-size: 17px;
    }

    :global(.home-inner) {
      width: min(var(--layout-max), calc(100% - (2 * var(--layout-gutter))));
    }

    :global(.home-band__title) {
      font-size: clamp(1.45rem, 4vw, 1.85rem);
    }
  }

  :global(html[data-theme="dark"]) .home-page { background: transparent; }
  :global(html[data-theme="dark"]) .home-band:nth-of-type(even)::before { background: color-mix(in srgb, var(--color-surface) 72%, transparent); }
  :global(html[data-theme="dark"]) .home-post-item { background: transparent; border-color: var(--color-border); }
  :global(html[data-theme="dark"]) .home-post-list > li { border-color: var(--color-border); }

  /* Proofline home surfaces stay quiet and measurable. */
  :global(.home-band:nth-of-type(even))::before { background: var(--color-surface-muted); }
  :global(.home-band),
  :global(.home-band--white),
  :global(.home-band--muted) { background-color: transparent; }
  .home-post-item {
    transition: transform var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
  }
  .home-post-item:hover,
  .home-post-item:focus-visible {
    background: var(--color-theme-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .pill-cta:hover,
    .pill-cta:focus-visible,
    .home-post-item:hover,
    .home-post-item:focus-visible { transform: none; }
    .home-post-item:hover .home-post-item__arrow,
    .home-post-item:focus-visible .home-post-item__arrow { transform: none; }
    .home-learning-card,
    .home-learning-card__link > span { transition: none; }
    .home-learning-card:hover,
    .home-learning-card:focus-visible,
    .home-learning-card:hover .home-learning-card__link > span,
    .home-learning-card:focus-visible .home-learning-card__link > span { transform: none; }
  }
</style>
