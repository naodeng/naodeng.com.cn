---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import {
  SITE_TITLE,
  HOME_HERO_TITLE,
  HOME_HERO_SUBTITLE,
  HOME_CTA_TASK,
  HOME_CTA_SKILLS,
  HOME_EXPLORE_TITLE,
  HOME_EXPLORE_SUBTITLE,
  HOME_EXPLORE_MORE,
  HOME_EXPLORE_CARDS,
  HOME_LATEST_POSTS,
  HOME_VIEW_ALL,
  HOME_PAGE_DESCRIPTION,
  HOME_PAGE_KEYWORDS,
} from "@/consts";
import GoogleAdThin from "@/components/GoogleAdThin.astro";
import TrackingEvents from "@/components/TrackingEvents.astro";
import HomeTaskNavigator from "@/components/home/HomeTaskNavigator.astro";
import HomeCapabilityGuide from "@/components/home/HomeCapabilityGuide.astro";
import HomeExploreHub from "@/components/home/HomeExploreHub.astro";
import { PROJECTS_LIST } from "@/data/projects";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const allPosts = (await getCollection("blog")).filter(
  (post) => post.id.split("/")[0] === locale,
);

const latestPosts = [...allPosts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

// 探索卡数量徽标：从内容集合动态统计，避免硬编码过时
const wikiCount = (await getCollection("wiki")).length;
const aiwikiEntries = await getCollection("aiwiki");
const aiwikiCount = aiwikiEntries.filter((e) =>
  e.data.lang ? e.data.lang === locale : e.id.startsWith(`${locale}/`),
).length;
const guildEntries = await getCollection("guild");
const guildCount = guildEntries.filter((e) => e.id.startsWith(`${locale}/`)).length;
const projectsCount = PROJECTS_LIST.length;

const exploreCards = HOME_EXPLORE_CARDS[locale].map((card) => ({
  ...card,
  href: getRelativeLocaleUrl(locale, card.path),
  meta:
    locale === "zh-cn"
      ? {
          wiki: `${wikiCount} 篇`,
          aiwiki: `${aiwikiCount} 篇`,
          guild: `${guildCount} 篇`,
          projects: `${projectsCount} 个项目`,
        }[card.key]
      : {
          aiwiki: `${aiwikiCount} entries`,
          guild: `${guildCount} guides`,
          projects: `${projectsCount} projects`,
        }[card.key] ?? "",
}));

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));

const siteOrigin = "https://inaodeng.com";
const homeUrl = `${siteOrigin}/${locale}/`;
const homeSeoTitle = locale === "zh-cn"
  ? "软件测试同学 X naodeng｜AI 测试知识、Skills 与 Prompts"
  : "Nao Deng | QA Skills, Prompts and AI Testing Knowledge";

const homePageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(SITE_TITLE),
  description: t(HOME_PAGE_DESCRIPTION),
  url: homeUrl,
  inLanguage: locale === "zh-cn" ? "zh-CN" : "en",
  author: {
    "@type": "Person",
    name: "Nao Deng",
    url: siteOrigin,
  },
  publisher: {
    "@type": "Organization",
    name: t(SITE_TITLE),
    url: siteOrigin,
    logo: {
      "@type": "ImageObject",
      url: `${siteOrigin}/ogp.png`,
      width: 1200,
      height: 630,
    },
  },
};
---

<Layout
  title={homeSeoTitle}
  titleMode="absolute"
  description={t(HOME_PAGE_DESCRIPTION)}
  keywords={t(HOME_PAGE_KEYWORDS)}
  extraStructuredData={[homePageSchema]}
>
  <div class="home-page">
    <section class="home-band home-band--white home-hero">
      <div class="home-inner">
        <h1 class="home-hero__title">{t(HOME_HERO_TITLE)}</h1>
        <p class="home-hero__subtitle">{t(HOME_HERO_SUBTITLE)}</p>
        <div class="home-hero__ctas">
          <a
            class="pill-cta pill-cta--primary"
            href="#home-task-navigator"
          >
            {t(HOME_CTA_TASK)}
          </a>
          <a
            class="pill-cta pill-cta--ghost"
            href={getRelativeLocaleUrl(locale, "/qaskills")}
          >
            {t(HOME_CTA_SKILLS)}
          </a>
        </div>
      </div>
    </section>

    <HomeTaskNavigator locale={locale} />
    <HomeCapabilityGuide locale={locale} />

    <section
      class="home-band home-band--muted home-latest-posts"
      aria-labelledby="home-latest-title"
    >
      <div class="home-inner">
        <h2 id="home-latest-title" class="home-band__title">{t(HOME_LATEST_POSTS)}</h2>
        <ul class="home-post-list" role="list">
          {latestPosts.map((post) => {
            const idParts = post.id.split("/").slice(1);
            const postUrl = `/${locale}/blog/${idParts.join("/").toLowerCase()}/`;
            const dateStr = post.data.date.toLocaleDateString(
              locale === "zh-cn" ? "zh-CN" : "en-US",
              { year: "numeric", month: "short", day: "numeric" },
            );
            return (
              <li>
                <a class="home-post-item" href={postUrl}>
                  <time
                    class="home-post-item__date"
                    datetime={post.data.date.toISOString()}
                  >
                    {dateStr}
                  </time>
                  <div class="home-post-item__body">
                    <h3 class="home-post-item__title">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="home-post-item__desc">{post.data.description}</p>
                    )}
                  </div>
                  <span class="home-post-item__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="home-band__footer">
          <a
            class="pill-cta pill-cta--ghost"
            href={getRelativeLocaleUrl(locale, "/blog")}
          >
            {t(HOME_VIEW_ALL)}
          </a>
        </p>
      </div>
    </section>

    <GoogleAdThin />

    <HomeExploreHub
      locale={locale}
      title={t(HOME_EXPLORE_TITLE)}
      subtitle={t(HOME_EXPLORE_SUBTITLE)}
      moreLabel={t(HOME_EXPLORE_MORE)}
      cards={exploreCards}
    />
  </div>
</Layout>

<TrackingEvents mode="home" locale={locale} />

<style>
  /* 首页挣脱 .l-content 窄栏，色带全宽铺开 */
  :global(main.l-main:has(.home-page)) {
    max-inline-size: none;
    padding-inline: 0;
    margin-block-start: 0;
    padding-block-end: 0;
  }

  :global(.home-band) {
    width: 100%;
    padding-block: 72px;
  }

  :global(.home-inner) {
    width: min(980px, calc(100% - 48px));
    margin-inline: auto;
    text-align: center;
  }

  .home-hero__title {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.4px;
    line-height: 1.08;
  }

  .home-hero__subtitle {
    margin: 14px auto 0;
    max-width: 28em;
    font-size: 21px;
    line-height: 1.3;
  }

  .home-hero__ctas {
    margin-top: 22px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  :global(.home-band__title) {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.2px;
    line-height: 1.2;
  }

  :global(.home-band__subtitle) {
    margin: 10px auto 0;
    max-width: 36em;
    font-size: 17px;
    line-height: 1.45;
  }

  :global(.home-band__subtitle--spaced) {
    margin-top: 40px;
  }

  .home-band__footer {
    margin: 32px 0 0;
  }

  .pill-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 11px 22px;
    border-radius: 9999px;
    font-size: 17px;
    text-decoration: none;
  }

  .pill-cta--primary {
    background: var(--color-theme);
    color: #fff;
  }

  .pill-cta--ghost {
    background: transparent;
    color: var(--color-theme);
    border: 1px solid var(--color-theme);
  }

  .pill-cta:active {
    transform: scale(0.95);
  }

  @media (width < 900px) {
    :global(.home-band) {
      padding-block: 48px;
    }

    :global(.home-inner) {
      width: min(980px, calc(100% - 32px));
    }
  }

  /* Zenix-inspired product surface for the bilingual knowledge platform. */
  .home-page {
    background:
      linear-gradient(rgba(79, 70, 229, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(79, 70, 229, 0.035) 1px, transparent 1px),
      #f8fafc;
    background-size: 42px 42px, 42px 42px, auto;
  }

  :global(.home-band) {
    position: relative;
    padding-block: 88px;
    overflow: hidden;
  }

  :global(.home-band--white),
  :global(.home-band--muted) {
    background: transparent;
  }

  :global(.home-band:nth-of-type(even))::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.68), rgba(241, 245, 249, 0.64));
    pointer-events: none;
  }

  :global(.home-inner) {
    position: relative;
    z-index: 1;
    width: min(1120px, calc(100% - 48px));
  }

  .home-hero {
    min-height: 380px;
    display: grid;
    align-items: center;
    padding-block: 80px 64px;
    background: var(--gradient-hero);
  }

  .home-hero__title {
    max-width: 920px;
    margin-inline: auto;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.04;
    color: var(--color-main);
  }

  .home-hero__title::after {
    content: "";
    display: block;
    width: 92px;
    height: 5px;
    margin: 22px auto 0;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-theme), var(--color-theme-light));
  }

  .home-hero__subtitle {
    max-width: 720px;
    margin-top: 22px;
    font-size: 20px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .home-hero__ctas {
    margin-top: 30px;
  }

  .pill-cta {
    min-height: 48px;
    padding: 12px 22px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 800;
    box-shadow: var(--shadow-sm);
  }

  .pill-cta--primary {
    background: linear-gradient(135deg, var(--color-theme), color-mix(in srgb, var(--color-theme) 76%, var(--color-theme-light)));
    color: white;
    border: 1px solid color-mix(in srgb, var(--color-theme) 24%, transparent);
    box-shadow: 0 18px 40px rgba(79, 70, 229, 0.22);
  }

  .pill-cta--ghost {
    background: rgba(255, 255, 255, 0.76);
    color: var(--color-theme);
    border: 1px solid color-mix(in srgb, var(--color-theme) 22%, transparent);
    backdrop-filter: blur(16px);
  }

  .pill-cta:hover,
  .pill-cta:focus-visible {
    transform: translateY(-2px);
  }

  :global(.home-band__title) {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0;
    color: var(--color-main);
  }

  :global(.home-band__subtitle) {
    color: var(--color-text-secondary);
  }

  /* 最新文章：6 张卡片，每排 2 张 */
  .home-post-list {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    text-align: start;
  }

  .home-post-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    height: 100%;
    min-height: 170px;
    padding: 22px 24px;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .home-post-item:hover,
  .home-post-item:focus-visible {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-theme) 32%, transparent);
    box-shadow: var(--shadow-md);
  }

  .home-post-item__date {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .home-post-item__body {
    flex: 1;
    min-width: 0;
  }

  .home-post-item__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.35;
    color: var(--color-main);
  }

  .home-post-item__desc {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-post-item__arrow {
    margin-top: auto;
    align-self: flex-end;
    color: var(--color-theme);
    font-weight: 800;
  }

  @media (width < 800px) {
    .home-post-list {
      grid-template-columns: 1fr;
    }
  }

  @media (width < 900px) {
    .home-band {
      padding-block: 58px;
    }

    .home-hero {
      min-height: 0;
      padding-block: 72px 52px;
    }

    .home-hero__title {
      font-size: clamp(1.75rem, 6.2vw, 2.5rem);
    }

    .home-hero__subtitle {
      font-size: 17px;
    }

    :global(.home-inner) {
      width: min(980px, calc(100% - 32px));
    }

    :global(.home-band__title) {
      font-size: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pill-cta:hover,
    .pill-cta:focus-visible,
    .home-post-item:hover,
    .home-post-item:focus-visible {
      transform: none;
    }
  }
</style>
