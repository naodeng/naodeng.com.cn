---
import Base from "@/layouts/Base.astro";
import GoogleAd from "@/components/GoogleAd.astro";
import QASkillStarterPaths from "@/components/qaskills/QASkillStarterPaths.astro";
import RecommendedQASkills from "@/components/qaskills/RecommendedQASkills.astro";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getQASkillsGrouped, resolveLifecyclePath } from "@/utils/qaskills";
import { shouldShowEvalsFilter } from "@/utils/qaskillsFilter";
import { getQASkillCardSummary, QA_SKILL_TOOLS, RECOMMENDED_QA_SKILL_SLUGS } from "@/data/qaSkillLibrary";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "zh-cn" } },
  ];
}

const lang = Astro.params.lang as Lang;
const grouped = await getQASkillsGrouped(lang);
const allSkills = [...grouped.testingTypes, ...grouped.testingWorkflows, ...grouped.plus];
const lifecycleStages = resolveLifecyclePath(
  allSkills,
  lang === "zh-cn" ? "zh-cn" : "en"
);
const totalCount = allSkills.length;
const evalsCount = allSkills.filter((s) => s.hasEvals).length;
const latestSync = allSkills.map((s) => s.updatedAt).filter(Boolean).sort().at(-1) || "-";
const toolCount = QA_SKILL_TOOLS.length;
const recommendedSkills = RECOMMENDED_QA_SKILL_SLUGS
  .map((slug) => allSkills.find((skill) => skill.slug === slug))
  .filter((skill): skill is NonNullable<typeof skill> => Boolean(skill));

// 构建期判断：数据无区分度时不渲染 eval 筛选 chip（当前 38 个 skill 均含评测用例）
const showEvalsFilter = shouldShowEvalsFilter(allSkills);

const text = lang === "zh-cn" ? {
  title: "软件测试技能库",
  description: "覆盖测试类型、工作流与增强技能的 QA Skills Library",
  intro: "收录测试类型、测试工作流程和加强版技能，帮助你快速找到合适技能并直接上手。",
  quickStart: "快速开始",
  categories: "Skills 分类",
  startBtn: "快速开始",
  githubBtn: "查看 GitHub",
  skillCountLabel: "个 Skills",
  toolsLabel: "个 AI 工具",
  syncedLabel: "最近同步",
  evalsLabel: "提供自动化评测用例",
  resultsLabel: "个匹配结果",
  searchPlaceholder: "搜索 skill 名称 / 场景关键词…",
  filterAll: "全部",
  filterType: "测试类型",
  filterWorkflow: "工作流",
  filterPlus: "Plus",
  filterEvals: "有 Evals",
  typeTitle: "测试类型",
  workflowTitle: "测试工作流程",
  plusTitle: "加强版",
  typeDesc: "按测试能力方向查看技能。",
  workflowDesc: "按日常、迭代、发布流程查看技能。",
  plusDesc: "更深度、结构更完整的增强版本技能。",
  viewDetail: "查看详情",
  empty: "没有匹配的技能。试试 discover-testing，或清空筛选。",
  clearFilters: "清空筛选",
  hasEvals: "含评测用例",
  noEvals: "暂无评测用例",
  summaryWhen: "适用场景",
  summaryInput: "输入",
  summaryOutput: "输出",
  summaryReview: "人工复核",
  catType: "类型",
  catWorkflow: "工作流",
  catPlus: "Plus",
  lifecycleTitle: "软件测试生命周期路径",
  lifecycleIntro: "按生命周期阶段查看会用到的 Skills，点击进入详情。",
  lifecyclePlusLabel: "Plus",
  quickSteps: [
    { title: "选择技能", desc: "用搜索或分类找到当前任务最匹配的 Skill。" },
    { title: "准备输入", desc: "补齐范围、环境、时间与期望输出格式。" },
    { title: "安装调用", desc: "打开详情页，一键安装后按示例触发。" },
  ],
} : {
  title: "QA Skill Library",
  description: "Software testing skill library for testing types, workflows, and enhanced QA skills",
  intro: "Browse testing types, testing workflows, and plus skills to quickly find the right skill and start using it.",
  quickStart: "Quick Start",
  categories: "Skill Categories",
  startBtn: "Quick Start",
  githubBtn: "View GitHub",
  skillCountLabel: "skills",
  toolsLabel: "AI tools",
  syncedLabel: "Synced",
  evalsLabel: "with automated evaluation cases",
  resultsLabel: "matching results",
  searchPlaceholder: "Search by skill name or scenario…",
  filterAll: "All",
  filterType: "Types",
  filterWorkflow: "Workflows",
  filterPlus: "Plus",
  filterEvals: "Has Evals",
  typeTitle: "Testing Types",
  workflowTitle: "Testing Workflows",
  plusTitle: "Plus",
  typeDesc: "Browse by testing capability.",
  workflowDesc: "Browse by daily, sprint, and release workflows.",
  plusDesc: "Enhanced skills with deeper and more complete structure.",
  viewDetail: "View Details",
  empty: "No matching skills. Try discover-testing, or clear filters.",
  clearFilters: "Clear filters",
  hasEvals: "Evaluation cases included",
  noEvals: "No evaluation cases yet",
  summaryWhen: "Use case",
  summaryInput: "Input",
  summaryOutput: "Output",
  summaryReview: "Human review",
  catType: "Type",
  catWorkflow: "Workflow",
  catPlus: "Plus",
  lifecycleTitle: "Software Testing Lifecycle Path",
  lifecycleIntro: "Browse skills by lifecycle stage. Click any skill to open its detail page.",
  lifecyclePlusLabel: "Plus",
  quickSteps: [
    { title: "Pick a skill", desc: "Search or browse to match your QA task." },
    { title: "Prepare input", desc: "Provide scope, environment, timeline, and output format." },
    { title: "Install & run", desc: "Open the detail page, install, then trigger with the example." },
  ],
};

const categoryLabel = (category: string) => {
  if (category === "workflow") return text.catWorkflow;
  if (category === "plus") return text.catPlus;
  return text.catType;
};

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";
const pageUrl = `${siteOrigin}${getRelativeLocaleUrl(lang, "/qaskills/")}`;
const pageKeywords =
  lang === "zh-cn"
    ? "软件测试技能库,QA Skills,测试提示词,测试工作流,自动化测试,AI测试,质量保障"
    : "QA skill library,software testing skills,test workflows,testing prompts,automation testing,AI testing,quality assurance";
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: text.title,
  description: text.description,
  url: pageUrl,
  inLanguage: lang === "zh-cn" ? "zh-CN" : "en",
};
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: text.title,
  numberOfItems: totalCount,
  itemListElement: allSkills.slice(0, 20).map((skill, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: lang === "zh-cn" ? (skill.chineseName || skill.title) : skill.title,
    url: `${siteOrigin}${getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}`,
  })),
};

const breadcrumbs = [
  { name: lang === "zh-cn" ? "首页" : "Home", url: getRelativeLocaleUrl(lang, "/") },
  { name: text.title, url: getRelativeLocaleUrl(lang, "/qaskills") },
];

const displayNameOf = (skill: (typeof allSkills)[number]) =>
  lang === "zh-cn" ? (skill.chineseName || skill.title) : skill.title;

const summaryBySlug = new Map(
  allSkills.map((skill) => [skill.slug, getQASkillCardSummary(skill, lang)]),
);
const summaryOf = (skill: (typeof allSkills)[number]) => summaryBySlug.get(skill.slug)!;
---

<Base
  title={text.title}
  description={text.description}
  keywords={pageKeywords}
  breadcrumbs={breadcrumbs}
  extraStructuredData={[collectionSchema, itemListSchema]}
>
  <div class="qaskills-page">
    <header class="hero">
      <h1>{text.title}</h1>
      <p class="hero-sub">{text.description}</p>
      <p class="hero-intro">{text.intro}</p>
      <p class="hero-stats">
        <span>{totalCount} {text.skillCountLabel}</span>
        <span>{toolCount} {text.toolsLabel}</span>
        <span>{text.syncedLabel}: {latestSync}</span>
        <span>{evalsCount} {text.evalsLabel}</span>
      </p>
      <div class="hero-actions">
        <a href="#quickstart" class="btn btn-primary">{text.startBtn}</a>
        <a href="https://github.com/naodeng/awesome-qa-skills" target="_blank" rel="noopener noreferrer" class="btn btn-outline">{text.githubBtn}</a>
      </div>
    </header>

    <QASkillStarterPaths lang={lang} />

    <section class="section discovery" aria-label={lang === "zh-cn" ? "搜索与筛选" : "Search and filters"}>
      <input
        id="qaskills-search"
        class="search-input"
        type="search"
        placeholder={text.searchPlaceholder}
        autocomplete="off"
      />
      <div class="chips" role="group">
        <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">{text.filterAll}</button>
        <button type="button" class="chip" data-filter="type" aria-pressed="false">{text.filterType}</button>
        <button type="button" class="chip" data-filter="workflow" aria-pressed="false">{text.filterWorkflow}</button>
        <button type="button" class="chip" data-filter="plus" aria-pressed="false">{text.filterPlus}</button>
        {showEvalsFilter && (
          <button type="button" class="chip" data-evals-toggle="1" aria-pressed="false">{text.filterEvals}</button>
        )}
      </div>
      <p id="qaskills-results" class="results-count" aria-live="polite" data-label={text.resultsLabel}>{totalCount} {text.resultsLabel}</p>
    </section>

    <section class="section" id="categories">
      <h2>{text.categories}</h2>
      <p id="qaskills-empty" class="empty-state" hidden>
        {text.empty}
        <button type="button" id="qaskills-clear" class="btn btn-outline">{text.clearFilters}</button>
      </p>

      <div class="category-block" data-block="type">
        <h3>{text.typeTitle}</h3>
        <p>{text.typeDesc}</p>
        {grouped.testingTypeSubgroups.map((group) => (
          <div class="subgroup">
            <h4>{group.title[lang === "zh-cn" ? "zh-cn" : "en"]}</h4>
            <ul class="cards" role="list">
              {group.skills.map((skill) => (
                <li>
                  <a
                    class="card"
                    data-slug={skill.slug}
                    data-category={skill.category}
                    data-evals={skill.hasEvals ? "true" : "false"}
                    data-title={displayNameOf(skill)}
                    data-intro={skill.intro}
                    href={getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}
                  >
                    <h5>{displayNameOf(skill)}</h5>
                    <p class="card-meta">
                      <span class="tag">{categoryLabel(skill.category)}</span>
                      <span class="tag tag-evals">{skill.hasEvals ? text.hasEvals : text.noEvals}</span>
                      <span class="tag">{skill.updatedAt || "-"}</span>
                    </p>
                    <div class="card-summary">
                      <p data-summary-when><span class="summary-label">{text.summaryWhen}</span><span class="summary-text">{summaryOf(skill).whenToUse}</span></p>
                      <p data-summary-input><span class="summary-label">{text.summaryInput}</span><span class="summary-text">{summaryOf(skill).input}</span></p>
                      <p data-summary-output><span class="summary-label">{text.summaryOutput}</span><span class="summary-text">{summaryOf(skill).output}</span></p>
                      <p data-summary-review><span class="summary-label">{text.summaryReview}</span><span class="summary-text">{summaryOf(skill).humanReview}</span></p>
                    </div>
                    <span>{text.viewDetail} →</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="category-block" data-block="workflow">
        <h3>{text.workflowTitle}</h3>
        <p>{text.workflowDesc}</p>
        <ul class="cards" role="list">
          {grouped.testingWorkflows.map((skill) => (
            <li>
              <a
                class="card"
                data-slug={skill.slug}
                data-category={skill.category}
                data-evals={skill.hasEvals ? "true" : "false"}
                data-title={displayNameOf(skill)}
                data-intro={skill.intro}
                href={getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}
              >
                <h5>{displayNameOf(skill)}</h5>
                <p class="card-meta">
                  <span class="tag">{categoryLabel(skill.category)}</span>
                  <span class="tag tag-evals">{skill.hasEvals ? text.hasEvals : text.noEvals}</span>
                  <span class="tag">{skill.updatedAt || "-"}</span>
                </p>
                <p class="card-intro">{skill.intro}</p>
                <span>{text.viewDetail} →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="category-block" data-block="plus">
        <h3>{text.plusTitle}</h3>
        <p>{text.plusDesc}</p>
        <ul class="cards" role="list">
          {grouped.plus.map((skill) => (
            <li>
              <a
                class="card"
                data-slug={skill.slug}
                data-category={skill.category}
                data-evals={skill.hasEvals ? "true" : "false"}
                data-title={displayNameOf(skill)}
                data-intro={skill.intro}
                href={getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}
              >
                <h5>{displayNameOf(skill)}</h5>
                <p class="card-meta">
                  <span class="tag">{categoryLabel(skill.category)}</span>
                  <span class="tag tag-evals">{skill.hasEvals ? text.hasEvals : text.noEvals}</span>
                  <span class="tag">{skill.updatedAt || "-"}</span>
                </p>
                <p class="card-intro">{skill.intro}</p>
                <span>{text.viewDetail} →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="ad-slot-250">
        <GoogleAd />
      </div>
    </section>

    <RecommendedQASkills lang={lang} skills={recommendedSkills} />

    <section id="quickstart" class="section" data-qaskills-default-only>
      <h2>{text.quickStart}</h2>
      <ol class="quick-grid">
        {text.quickSteps.map((step, index) => (
          <li class="quick-card">
            <span class="num">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="lifecycle-path" class="section lifecycle-path" data-qaskills-default-only aria-labelledby="lifecycle-path-title">
      <h2 id="lifecycle-path-title">{text.lifecycleTitle}</h2>
      <p class="lifecycle-intro">{text.lifecycleIntro}</p>
      <div class="lifecycle-track">
        {lifecycleStages.map((stage, index) => (
          <div class="lifecycle-cell">
            <div class="lifecycle-stage" data-stage={stage.key}>
              <p class="lifecycle-stage-title">
                <span class="lifecycle-stage-num" aria-hidden="true">{index + 1}</span>
                {stage.title}
              </p>
              <ul class="lifecycle-skills" role="list">
                {stage.nodes.map((node) => (
                  <li>
                    <a
                      class:list={["lifecycle-skill", node.kind === "plus" && "lifecycle-skill--plus"]}
                      href={getRelativeLocaleUrl(lang, `/qaskills/${node.slug}/`)}
                      data-slug={node.slug}
                      data-kind={node.kind}
                    >
                      <span>{node.label}</span>
                      {node.kind === "plus" && <span class="lifecycle-plus-tag">{text.lifecyclePlusLabel}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            {index < lifecycleStages.length - 1 && <span class="lifecycle-arrow" aria-hidden="true">→</span>}
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<script is:inline>
  (() => {
    const search = document.getElementById("qaskills-search");
    const empty = document.getElementById("qaskills-empty");
    const results = document.getElementById("qaskills-results");
    const clearBtn = document.getElementById("qaskills-clear");
    const chips = Array.from(document.querySelectorAll(".chip[data-filter], .chip[data-evals-toggle]"));
    const cards = Array.from(document.querySelectorAll("a.card[data-slug]"));
    const blocks = Array.from(document.querySelectorAll(".category-block"));
    const defaultOnly = Array.from(document.querySelectorAll("[data-qaskills-default-only]"));
    if (!search || !empty || !cards.length) return;

    let category = "all";
    let evalsOnly = false;

    // 与 src/utils/qaskillsFilter.ts 的 isQASkillSearchActive 保持等价
    // （is:inline 脚本无法 import 模块，两处需同步维护）
    const searchActive = () =>
      (search.value || "").trim().length > 0 || category !== "all" || evalsOnly;

    const apply = () => {
      const q = (search.value || "").trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.getAttribute("data-category") || "type";
        const hasEvals = card.getAttribute("data-evals") === "true";
        const haystack = [
          card.getAttribute("data-slug") || "",
          card.getAttribute("data-title") || "",
          card.getAttribute("data-intro") || "",
        ]
          .join(" ")
          .toLowerCase();
        const okCat = category === "all" || cat === category;
        const okEvals = !evalsOnly || hasEvals;
        const okQuery = !q || haystack.includes(q);
        const show = okCat && okEvals && okQuery;
        card.closest("li")?.toggleAttribute("hidden", !show);
        if (show) visible += 1;
      });

      document.querySelectorAll(".subgroup").forEach((sub) => {
        const hasVisible = Array.from(sub.querySelectorAll("li")).some((li) => !li.hasAttribute("hidden"));
        sub.toggleAttribute("hidden", !hasVisible);
      });

      blocks.forEach((block) => {
        const blockCat = block.getAttribute("data-block");
        const relevant = category === "all" || category === blockCat;
        const hasVisible = Array.from(block.querySelectorAll("li")).some((li) => !li.hasAttribute("hidden"));
        block.toggleAttribute("hidden", !relevant || !hasVisible);
      });

      // 搜索态下隐藏默认辅助区，让目录结果紧邻筛选区
      defaultOnly.forEach((el) => el.toggleAttribute("hidden", searchActive()));

      empty.hidden = visible > 0;
      if (results) results.textContent = `${visible} ${results.dataset.label || ""}`.trim();
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        if (chip.hasAttribute("data-evals-toggle")) {
          evalsOnly = !evalsOnly;
          chip.classList.toggle("is-active", evalsOnly);
          chip.setAttribute("aria-pressed", String(evalsOnly));
        } else {
          category = chip.getAttribute("data-filter") || "all";
          document.querySelectorAll(".chip[data-filter]").forEach((c) => {
            c.classList.toggle("is-active", c === chip);
            c.setAttribute("aria-pressed", String(c === chip));
          });
        }
        apply();
      });
    });

    search.addEventListener("input", apply);
    clearBtn?.addEventListener("click", () => {
      search.value = "";
      category = "all";
      evalsOnly = false;
      document.querySelectorAll(".chip[data-filter]").forEach((c) => {
        c.classList.toggle("is-active", c.getAttribute("data-filter") === "all");
        c.setAttribute("aria-pressed", String(c.getAttribute("data-filter") === "all"));
      });
      const evalsChip = document.querySelector(".chip[data-evals-toggle]");
      evalsChip?.classList.remove("is-active");
      evalsChip?.setAttribute("aria-pressed", "false");
      apply();
      search?.focus();
    });

    apply();
  })();
</script>

<style>
  .qaskills-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--sp-l) var(--sp-m);
    display: grid;
    gap: 1.35rem;
  }
  .hero {
    padding: 2rem;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 18% 12%, rgba(79, 70, 229, 0.16), transparent 34%),
      radial-gradient(circle at 90% 18%, rgba(67, 56, 202, 0.16), transparent 30%),
      rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(148, 163, 184, 0.22);
    box-shadow: var(--shadow-md);
  }
  .hero h1 {
    margin: 0;
    font-size: 44px;
    line-height: 1.08;
  }
  .hero-sub {
    margin: 0.4rem 0 0;
    font-weight: 800;
    color: var(--color-theme);
  }
  .hero-intro {
    max-width: 72ch;
    margin-top: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }
  .hero-stats {
    margin-top: 0.7rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--color-text-primary);
  }
  .hero-actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.62rem 1.1rem;
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font: inherit;
  }
  .btn-primary {
    color: white;
    background: var(--gradient-theme);
    box-shadow: var(--shadow-product);
  }
  .btn-outline {
    color: var(--color-text-primary);
    border: 1px solid rgba(148, 163, 184, 0.28);
    background: rgba(255, 255, 255, 0.72);
  }
  .discovery {
    display: grid;
    gap: 0.75rem;
    padding: 0.85rem;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: var(--shadow-sm);
  }
  .search-input {
    width: 100%;
    min-height: 48px;
    border-radius: var(--radius-md);
    border: 1px solid rgba(148, 163, 184, 0.24);
    background: rgba(255, 255, 255, 0.88);
    padding: 0.65rem 0.95rem;
    font: inherit;
    color: inherit;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    appearance: none;
    border: 1px solid rgba(148, 163, 184, 0.24);
    background: rgba(255, 255, 255, 0.8);
    color: var(--color-text-primary);
    border-radius: 999px;
    padding: 0.42rem 0.82rem;
    font-weight: 800;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .chip.is-active {
    background: var(--gradient-theme);
    border-color: transparent;
    color: white;
  }
  .section h2 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.55rem;
    color: var(--color-text-primary);
  }
  .empty-state {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 0.9rem;
    border-radius: var(--radius-lg);
    border: 1px dashed rgba(148, 163, 184, 0.34);
    background: rgba(255, 255, 255, 0.72);
  }
  .empty-state[hidden] {
    display: none;
  }
  .quick-grid {
    list-style: none;
    padding: 0;
