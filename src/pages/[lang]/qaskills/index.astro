---
import Base from "@/layouts/Base.astro";
import GoogleAd from "@/components/GoogleAd.astro";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getQASkillsGrouped } from "@/utils/qaskills";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "zh-cn" } },
  ];
}

const lang = Astro.params.lang as Lang;
const grouped = await getQASkillsGrouped(lang);
const allSkills = [...grouped.testingTypes, ...grouped.testingWorkflows, ...grouped.plus];
const totalCount = allSkills.length;
const evalsCount = allSkills.filter((s) => s.hasEvals).length;
const latestSync = allSkills.map((s) => s.updatedAt).filter(Boolean).sort().at(-1) || "-";
const toolCount = 6;

const text = lang === "zh-cn" ? {
  title: "软件测试技能库",
  description: "覆盖测试类型、工作流与增强技能的 QA Skills Library",
  intro: "收录测试类型、测试工作流程和加强版技能，帮助你快速找到合适技能并直接上手。",
  quickStart: "快速开始",
  categories: "Skills 分类",
  startBtn: "快速开始",
  githubBtn: "查看 GitHub",
  skillCountLabel: "个 Skills",
  toolsLabel: "个 AI 工具",
  syncedLabel: "最近同步",
  evalsLabel: "含 Evals",
  searchPlaceholder: "搜索 skill 名称 / 场景关键词…",
  filterAll: "全部",
  filterType: "测试类型",
  filterWorkflow: "工作流",
  filterPlus: "Plus",
  filterEvals: "有 Evals",
  typeTitle: "测试类型",
  workflowTitle: "测试工作流程",
  plusTitle: "加强版",
  typeDesc: "按测试能力方向查看技能。",
  workflowDesc: "按日常、迭代、发布流程查看技能。",
  plusDesc: "更深度、结构更完整的增强版本技能。",
  viewDetail: "查看详情",
  empty: "没有匹配的技能。试试 discover-testing，或清空筛选。",
  clearFilters: "清空筛选",
  hasEvals: "Evals",
  noEvals: "No Evals",
  catType: "类型",
  catWorkflow: "工作流",
  catPlus: "Plus",
  quickSteps: [
    { title: "选择技能", desc: "用搜索或分类找到当前任务最匹配的 Skill。" },
    { title: "准备输入", desc: "补齐范围、环境、时间与期望输出格式。" },
    { title: "安装调用", desc: "打开详情页，一键安装后按示例触发。" },
  ],
} : {
  title: "QA Skill Library",
  description: "Software testing skill library for testing types, workflows, and enhanced QA skills",
  intro: "Browse testing types, testing workflows, and plus skills to quickly find the right skill and start using it.",
  quickStart: "Quick Start",
  categories: "Skill Categories",
  startBtn: "Quick Start",
  githubBtn: "View GitHub",
  skillCountLabel: "skills",
  toolsLabel: "AI tools",
  syncedLabel: "Synced",
  evalsLabel: "with Evals",
  searchPlaceholder: "Search by skill name or scenario…",
  filterAll: "All",
  filterType: "Types",
  filterWorkflow: "Workflows",
  filterPlus: "Plus",
  filterEvals: "Has Evals",
  typeTitle: "Testing Types",
  workflowTitle: "Testing Workflows",
  plusTitle: "Plus",
  typeDesc: "Browse by testing capability.",
  workflowDesc: "Browse by daily, sprint, and release workflows.",
  plusDesc: "Enhanced skills with deeper and more complete structure.",
  viewDetail: "View Details",
  empty: "No matching skills. Try discover-testing, or clear filters.",
  clearFilters: "Clear filters",
  hasEvals: "Evals",
  noEvals: "No Evals",
  catType: "Type",
  catWorkflow: "Workflow",
  catPlus: "Plus",
  quickSteps: [
    { title: "Pick a skill", desc: "Search or browse to match your QA task." },
    { title: "Prepare input", desc: "Provide scope, environment, timeline, and output format." },
    { title: "Install & run", desc: "Open the detail page, install, then trigger with the example." },
  ],
};

const categoryLabel = (category: string) => {
  if (category === "workflow") return text.catWorkflow;
  if (category === "plus") return text.catPlus;
  return text.catType;
};

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";
const pageUrl = `${siteOrigin}${getRelativeLocaleUrl(lang, "/qaskills/")}`;
const pageKeywords =
  lang === "zh-cn"
    ? "软件测试技能库,QA Skills,测试提示词,测试工作流,自动化测试,AI测试,质量保障"
    : "QA skill library,software testing skills,test workflows,testing prompts,automation testing,AI testing,quality assurance";
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: text.title,
  description: text.description,
  url: pageUrl,
  inLanguage: lang === "zh-cn" ? "zh-CN" : "en",
};
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: text.title,
  numberOfItems: totalCount,
  itemListElement: allSkills.slice(0, 20).map((skill, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: lang === "zh-cn" ? (skill.chineseName || skill.title) : skill.title,
    url: `${siteOrigin}${getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}`,
  })),
};

const breadcrumbs = [
  { name: lang === "zh-cn" ? "首页" : "Home", url: getRelativeLocaleUrl(lang, "/") },
  { name: text.title, url: getRelativeLocaleUrl(lang, "/qaskills") },
];

const displayNameOf = (skill: (typeof allSkills)[number]) =>
  lang === "zh-cn" ? (skill.chineseName || skill.title) : skill.title;
---

<Base
  title={text.title}
  description={text.description}
  keywords={pageKeywords}
  breadcrumbs={breadcrumbs}
  extraStructuredData={[collectionSchema, itemListSchema]}
>
  <div class="qaskills-page">
    <header class="hero">
      <h1>{text.title}</h1>
      <p class="hero-sub">{text.description}</p>
      <p class="hero-intro">{text.intro}</p>
      <p class="hero-stats">
        <span>{totalCount} {text.skillCountLabel}</span>
        <span>{toolCount} {text.toolsLabel}</span>
        <span>{text.syncedLabel}: {latestSync}</span>
        <span>{evalsCount} {text.evalsLabel}</span>
      </p>
      <div class="hero-actions">
        <a href="#quickstart" class="btn btn-primary">{text.startBtn}</a>
        <a href="https://github.com/naodeng/awesome-qa-skills" target="_blank" rel="noopener noreferrer" class="btn btn-outline">{text.githubBtn}</a>
      </div>
    </header>

    <section class="section discovery" aria-label={lang === "zh-cn" ? "搜索与筛选" : "Search and filters"}>
      <input
        id="qaskills-search"
        class="search-input"
        type="search"
        placeholder={text.searchPlaceholder}
        autocomplete="off"
      />
      <div class="chips" role="group">
        <button type="button" class="chip is-active" data-filter="all">{text.filterAll}</button>
        <button type="button" class="chip" data-filter="type">{text.filterType}</button>
        <button type="button" class="chip" data-filter="workflow">{text.filterWorkflow}</button>
        <button type="button" class="chip" data-filter="plus">{text.filterPlus}</button>
        <button type="button" class="chip" data-evals-toggle="1">{text.filterEvals}</button>
      </div>
    </section>

    <section id="quickstart" class="section">
      <h2>{text.quickStart}</h2>
      <ol class="quick-grid">
        {text.quickSteps.map((step, index) => (
          <li class="quick-card">
            <span class="num">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" id="categories">
      <h2>{text.categories}</h2>
      <p id="qaskills-empty" class="empty-state" hidden>
        {text.empty}
        <button type="button" id="qaskills-clear" class="btn btn-outline">{text.clearFilters}</button>
      </p>

      <div class="category-block" data-block="type">
        <h3>{text.typeTitle}</h3>
        <p>{text.typeDesc}</p>
        {grouped.testingTypeSubgroups.map((group) => (
          <div class="subgroup">
            <h4>{group.title[lang === "zh-cn" ? "zh-cn" : "en"]}</h4>
            <ul class="cards" role="list">
              {group.skills.map((skill) => (
                <li>
                  <a
                    class="card"
                    data-slug={skill.slug}
                    data-category={skill.category}
                    data-evals={skill.hasEvals ? "true" : "false"}
                    data-title={displayNameOf(skill)}
                    data-intro={skill.intro}
                    href={getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}
                  >
                    <h5>{displayNameOf(skill)}</h5>
                    <p class="card-meta">
                      <span class="tag">{categoryLabel(skill.category)}</span>
                      <span class="tag tag-evals">{skill.hasEvals ? text.hasEvals : text.noEvals}</span>
                      <span class="tag">{skill.updatedAt || "-"}</span>
                    </p>
                    <p class="card-intro">{skill.intro}</p>
                    <span>{text.viewDetail} →</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="ad-slot-250">
        <GoogleAd />
      </div>

      <div class="category-block" data-block="workflow">
        <h3>{text.workflowTitle}</h3>
        <p>{text.workflowDesc}</p>
        <ul class="cards" role="list">
          {grouped.testingWorkflows.map((skill) => (
            <li>
              <a
                class="card"
                data-slug={skill.slug}
                data-category={skill.category}
                data-evals={skill.hasEvals ? "true" : "false"}
                data-title={displayNameOf(skill)}
                data-intro={skill.intro}
                href={getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}
              >
                <h5>{displayNameOf(skill)}</h5>
                <p class="card-meta">
                  <span class="tag">{categoryLabel(skill.category)}</span>
                  <span class="tag tag-evals">{skill.hasEvals ? text.hasEvals : text.noEvals}</span>
                  <span class="tag">{skill.updatedAt || "-"}</span>
                </p>
                <p class="card-intro">{skill.intro}</p>
                <span>{text.viewDetail} →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="category-block" data-block="plus">
        <h3>{text.plusTitle}</h3>
        <p>{text.plusDesc}</p>
        <ul class="cards" role="list">
          {grouped.plus.map((skill) => (
            <li>
              <a
                class="card"
                data-slug={skill.slug}
                data-category={skill.category}
                data-evals={skill.hasEvals ? "true" : "false"}
                data-title={displayNameOf(skill)}
                data-intro={skill.intro}
                href={getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}
              >
                <h5>{displayNameOf(skill)}</h5>
                <p class="card-meta">
                  <span class="tag">{categoryLabel(skill.category)}</span>
                  <span class="tag tag-evals">{skill.hasEvals ? text.hasEvals : text.noEvals}</span>
                  <span class="tag">{skill.updatedAt || "-"}</span>
                </p>
                <p class="card-intro">{skill.intro}</p>
                <span>{text.viewDetail} →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="ad-slot-250">
        <GoogleAd />
      </div>
    </section>
  </div>
</Base>

<script is:inline>
  (() => {
    const search = document.getElementById("qaskills-search");
    const empty = document.getElementById("qaskills-empty");
    const clearBtn = document.getElementById("qaskills-clear");
    const chips = Array.from(document.querySelectorAll(".chip[data-filter], .chip[data-evals-toggle]"));
    const cards = Array.from(document.querySelectorAll("a.card[data-slug]"));
    const blocks = Array.from(document.querySelectorAll(".category-block"));
    if (!search || !empty || !cards.length) return;

    let category = "all";
    let evalsOnly = false;

    const apply = () => {
      const q = (search.value || "").trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.getAttribute("data-category") || "type";
        const hasEvals = card.getAttribute("data-evals") === "true";
        const haystack = [
          card.getAttribute("data-slug") || "",
          card.getAttribute("data-title") || "",
          card.getAttribute("data-intro") || "",
        ]
          .join(" ")
          .toLowerCase();
        const okCat = category === "all" || cat === category;
        const okEvals = !evalsOnly || hasEvals;
        const okQuery = !q || haystack.includes(q);
        const show = okCat && okEvals && okQuery;
        card.closest("li")?.toggleAttribute("hidden", !show);
        if (show) visible += 1;
      });

      document.querySelectorAll(".subgroup").forEach((sub) => {
        const hasVisible = Array.from(sub.querySelectorAll("li")).some((li) => !li.hasAttribute("hidden"));
        sub.toggleAttribute("hidden", !hasVisible);
      });

      blocks.forEach((block) => {
        const blockCat = block.getAttribute("data-block");
        const relevant = category === "all" || category === blockCat;
        const hasVisible = Array.from(block.querySelectorAll("li")).some((li) => !li.hasAttribute("hidden"));
        block.toggleAttribute("hidden", !relevant || !hasVisible);
      });

      empty.hidden = visible > 0;
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        if (chip.hasAttribute("data-evals-toggle")) {
          evalsOnly = !evalsOnly;
          chip.classList.toggle("is-active", evalsOnly);
        } else {
          category = chip.getAttribute("data-filter") || "all";
          document.querySelectorAll(".chip[data-filter]").forEach((c) => {
            c.classList.toggle("is-active", c === chip);
          });
        }
        apply();
      });
    });

    search.addEventListener("input", apply);
    clearBtn?.addEventListener("click", () => {
      search.value = "";
      category = "all";
      evalsOnly = false;
      document.querySelectorAll(".chip[data-filter]").forEach((c) => {
        c.classList.toggle("is-active", c.getAttribute("data-filter") === "all");
      });
      document.querySelector(".chip[data-evals-toggle]")?.classList.remove("is-active");
      apply();
    });

    apply();
  })();
</script>

<style>
  .qaskills-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--sp-l) var(--sp-m);
    display: grid;
    gap: 1.2rem;
  }
  .hero {
    padding: 1.25rem;
    border-radius: 14px;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--color-theme) 10%, var(--color-base)) 0%, color-mix(in srgb, var(--color-base) 92%, var(--color-main)) 100%);
    border: 1px solid color-mix(in srgb, var(--color-theme) 26%, transparent);
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.8rem);
  }
  .hero-sub {
    margin: 0.4rem 0 0;
    font-weight: 700;
    color: var(--color-theme);
  }
  .hero-intro { margin-top: 0.75rem; }
  .hero-stats {
    margin-top: 0.7rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .hero-actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn {
    display: inline-flex;
    padding: 0.55rem 0.95rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font: inherit;
  }
  .btn-primary { color: white; background: var(--color-theme); }
  .btn-outline {
    color: var(--color-main);
    border: 1px solid color-mix(in srgb, var(--color-main) 26%, transparent);
    background: transparent;
  }
  .discovery { display: grid; gap: 0.75rem; }
  .search-input {
    width: 100%;
    min-height: 44px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--color-main) 18%, transparent);
    background: color-mix(in srgb, var(--color-base) 98%, var(--color-main));
    padding: 0.55rem 0.85rem;
    font: inherit;
    color: inherit;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    appearance: none;
    border: 1px solid color-mix(in srgb, var(--color-main) 22%, transparent);
    background: color-mix(in srgb, var(--color-base) 97%, var(--color-main));
    color: inherit;
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .chip.is-active {
    background: var(--color-theme);
    border-color: var(--color-theme);
    color: white;
  }
  .section h2 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
  }
  .empty-state {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 0.9rem;
    border-radius: 12px;
    border: 1px dashed color-mix(in srgb, var(--color-main) 24%, transparent);
  }
  .empty-state[hidden] {
    display: none;
  }
  .quick-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .quick-card {
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--color-main) 14%, transparent);
    background: color-mix(in srgb, var(--color-base) 97%, var(--color-main));
    padding: 1rem;
  }
  .quick-card .num {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-theme) 20%, transparent);
    color: var(--color-theme);
    font-weight: 800;
  }
  .quick-card h3 { margin: 0.55rem 0 0.45rem; }
  .quick-card p { margin: 0; }
  .category-block {
    margin-top: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-main) 14%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-base) 97%, var(--color-main));
    padding: 0.95rem;
  }
  .category-block h3 { margin-bottom: 0.2rem; }
  .category-block > p { margin-top: 0; opacity: 0.85; }
  .subgroup {
    margin-top: 0.85rem;
    padding-top: 0.7rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-main) 14%, transparent);
  }
  .subgroup:first-of-type { border-top: 0; padding-top: 0; }
  .subgroup h4 {
    margin: 0 0 0.55rem;
    font-size: 1rem;
    color: var(--color-theme);
  }
  .ad-slot-250 { margin-top: 1rem; }
  .ad-slot-250 :global(.ad-collapse) {
    margin-block: 0;
    width: 100%;
    height: 250px;
    overflow: hidden;
  }
  .ad-slot-250 :global(.adsbygoogle) { height: 250px !important; }
  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .card {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border-radius: 11px;
    border: 1px solid color-mix(in srgb, var(--color-main) 15%, transparent);
    background: color-mix(in srgb, var(--color-base) 98%, var(--color-main));
    padding: 0.85rem;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-theme) 45%, transparent);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--color-main) 12%, transparent);
  }
  .card h5 { margin: 0 0 0.4rem; font-size: 1rem; }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 0.5rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-main) 18%, transparent);
    background: color-mix(in srgb, var(--color-theme) 8%, transparent);
    color: var(--color-theme);
  }
  .card-intro {
    margin: 0;
    font-size: 0.92rem;
    opacity: 0.88;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.55;
  }
  .card > span {
    display: inline-block;
    margin-top: 0.7rem;
    color: var(--color-theme);
    font-weight: 700;
    font-size: 0.9rem;
  }
  @media (max-width: 920px) {
    .quick-grid, .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .qaskills-page { padding: var(--sp-m); }
    .quick-grid, .cards { grid-template-columns: 1fr; }
    .chips { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 0.25rem; }
  }
</style>
