---
import Base from "@/layouts/Base.astro";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getQASkillsGrouped, resolveLifecyclePath } from "@/utils/qaskills";
import { shouldShowEvalsFilter } from "@/utils/qaskillsFilter";
import {
  getQASkillCardIntro,
  RECOMMENDED_QA_SKILL_SLUGS,
} from "@/data/qaSkillLibrary";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "zh-cn" } },
  ];
}

const lang = Astro.params.lang as Lang;
const grouped = await getQASkillsGrouped(lang);
const allSkills = [...grouped.testingTypes, ...grouped.testingWorkflows, ...grouped.plus];
const lifecycleStages = resolveLifecyclePath(
  allSkills,
  lang === "zh-cn" ? "zh-cn" : "en"
);
const lifecycleStagesBySlug = new Map<string, string[]>();
lifecycleStages.forEach((stage) => {
  stage.nodes.forEach((node) => {
    lifecycleStagesBySlug.set(node.slug, [...(lifecycleStagesBySlug.get(node.slug) || []), stage.key]);
  });
});
const totalCount = allSkills.length;
const evalsCount = allSkills.filter((s) => s.hasEvals).length;
const latestSync = allSkills.map((s) => s.updatedAt).filter(Boolean).sort().at(-1) || "-";
const recommendedSkills = RECOMMENDED_QA_SKILL_SLUGS
  .map((slug) => allSkills.find((skill) => skill.slug === slug))
  .filter((skill): skill is NonNullable<typeof skill> => Boolean(skill));

// 构建期判断：数据无区分度时不渲染 eval 筛选 chip。
const showEvalsFilter = shouldShowEvalsFilter(allSkills);

const text = lang === "zh-cn" ? {
  title: "软件测试技能库",
  description: "覆盖测试类型、工作流与增强技能的 QA Skills Library",
  intro: "收录测试类型、测试工作流程和加强版技能，帮助你快速找到合适技能并直接上手。",
  directoryLabel: "技能目录",
  searchLabel: "搜索 Skills",
  searchHint: "按名称、场景或关键词搜索…",
  filterTitle: "筛选目录",
  moreFilters: "更多筛选",
  featuredTitle: "常用入口",
  featuredIntro: "从高频任务开始，或直接搜索整个目录。",
  catalogTitle: "全部 Skills",
  catalogIntro: "按分类浏览，点击卡片直接打开使用指南。",
  quickStart: "如何使用",
  categories: "Skills 分类",
  githubBtn: "查看 GitHub",
  skillCountLabel: "个 Skills",
  syncedLabel: "最近同步",
  resultsLabel: "个匹配结果",
  searchPlaceholder: "搜索 skill 名称 / 场景关键词…",
  filterAll: "全部",
  filterType: "测试类型",
  filterWorkflow: "工作流",
  filterPlus: "Plus",
  filterEvals: "有 Evals",
  lifecycleFilters: "按测试阶段筛选",
  subcategoryFilters: "按目录分组筛选",
  activeFilters: "已选条件",
  removeFilter: "移除",
  viewDetail: "查看详情",
  empty: "没有匹配的技能。试试 discover-testing，或清空筛选。",
  clearFilters: "清空筛选",
  hasEvals: "含评测用例",
  noEvals: "暂无评测用例",
  resultPrefix: "显示",
  catType: "类型",
  catWorkflow: "工作流",
  catPlus: "Plus",
  lifecycleTitle: "软件测试生命周期路径",
  lifecycleIntro: "按生命周期阶段查看会用到的 Skills，点击进入详情。",
  lifecyclePlusLabel: "Plus",
  quickSteps: [
    { title: "选择技能", desc: "用搜索或分类找到当前任务最匹配的 Skill。" },
    { title: "准备输入", desc: "补齐范围、环境、时间与期望输出格式。" },
    { title: "安装调用", desc: "打开详情页，一键安装后按示例触发。" },
  ],
} : {
  title: "QA Skill Library",
  description: "Software testing skill library for testing types, workflows, and enhanced QA skills",
  intro: "Browse testing types, testing workflows, and plus skills to quickly find the right skill and start using it.",
  directoryLabel: "Skill directory",
  searchLabel: "Search Skills",
  searchHint: "Search by name, scenario, or keyword…",
  filterTitle: "Filter directory",
  moreFilters: "More filters",
  featuredTitle: "Popular entry points",
  featuredIntro: "Start with a common QA task, or search the full directory.",
  catalogTitle: "All Skills",
  catalogIntro: "Browse by category and open any card to read its usage guide.",
  quickStart: "How to use",
  categories: "Skill Categories",
  githubBtn: "View GitHub",
  skillCountLabel: "skills",
  syncedLabel: "Synced",
  resultsLabel: "matching results",
  searchPlaceholder: "Search by skill name or scenario…",
  filterAll: "All",
  filterType: "Types",
  filterWorkflow: "Workflows",
  filterPlus: "Plus",
  filterEvals: "Has Evals",
  lifecycleFilters: "Filter by testing stage",
  subcategoryFilters: "Filter by catalog group",
  activeFilters: "Active filters",
  removeFilter: "Remove",
  viewDetail: "View Details",
  empty: "No matching skills. Try discover-testing, or clear filters.",
  clearFilters: "Clear filters",
  hasEvals: "Evaluation cases included",
  noEvals: "No evaluation cases yet",
  resultPrefix: "Showing",
  catType: "Type",
  catWorkflow: "Workflow",
  catPlus: "Plus",
  lifecycleTitle: "Software Testing Lifecycle Path",
  lifecycleIntro: "Browse skills by lifecycle stage. Click any skill to open its detail page.",
  lifecyclePlusLabel: "Plus",
  quickSteps: [
    { title: "Pick a skill", desc: "Search or browse to match your QA task." },
    { title: "Prepare input", desc: "Provide scope, environment, timeline, and output format." },
    { title: "Install & run", desc: "Open the detail page, install, then trigger with the example." },
  ],
};

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";
const pageUrl = `${siteOrigin}${getRelativeLocaleUrl(lang, "/qaskills/")}`;
const pageKeywords =
  lang === "zh-cn"
    ? "软件测试技能库,QA Skills,测试提示词,测试工作流,自动化测试,AI测试,质量保障"
    : "QA skill library,software testing skills,test workflows,testing prompts,automation testing,AI testing,quality assurance";
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: text.title,
  description: text.description,
  url: pageUrl,
  inLanguage: lang === "zh-cn" ? "zh-CN" : "en",
};
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: text.title,
  numberOfItems: totalCount,
  itemListElement: allSkills.slice(0, 20).map((skill, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: lang === "zh-cn" ? (skill.chineseName || skill.title) : skill.title,
    url: `${siteOrigin}${getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}`,
  })),
};

const breadcrumbs = [
  { name: lang === "zh-cn" ? "首页" : "Home", url: getRelativeLocaleUrl(lang, "/") },
  { name: text.title, url: getRelativeLocaleUrl(lang, "/qaskills") },
];

const displayNameOf = (skill: (typeof allSkills)[number]) =>
  lang === "zh-cn" ? (skill.chineseName || skill.title) : skill.title;

const displayCatalogTitle = (title: string) => title.replace(/\s+—\s+/g, " / ");

const catalogCategoryOf = (skill: (typeof allSkills)[number]) =>
  skill.category === "plus" || skill.slug.endsWith("-plus") ? "plus" : skill.category;

const catalogCategoriesOf = (skills: (typeof allSkills)[number][]) =>
  Array.from(new Set(skills.map(catalogCategoryOf))).join(" ");

const categoryOptions = [
  { key: "all", label: text.filterAll, count: totalCount },
  { key: "type", label: text.filterType, count: allSkills.filter((skill) => catalogCategoryOf(skill) === "type").length },
  { key: "workflow", label: text.filterWorkflow, count: allSkills.filter((skill) => catalogCategoryOf(skill) === "workflow").length },
  { key: "plus", label: text.filterPlus, count: allSkills.filter((skill) => catalogCategoryOf(skill) === "plus").length },
];

const secondaryFilterGroups = grouped.catalogGroups.map((catalogGroup) => ({
  key: catalogGroup.key,
  title: displayCatalogTitle(catalogGroup.title[lang === "zh-cn" ? "zh-cn" : "en"]),
  filters: [
    ...(catalogGroup.skills.length > 0
      ? [{
          key: `${catalogGroup.key}--root`,
          label: displayCatalogTitle(catalogGroup.title[lang === "zh-cn" ? "zh-cn" : "en"]),
          parentCategory: catalogCategoriesOf(catalogGroup.skills),
          count: catalogGroup.skills.length,
        }]
      : []),
    ...catalogGroup.groups.map((subgroup) => ({
      key: `${catalogGroup.key}--${subgroup.key}`,
      label: subgroup.title[lang === "zh-cn" ? "zh-cn" : "en"],
      parentCategory: catalogCategoriesOf(subgroup.skills),
      count: subgroup.skills.length,
    })),
  ],
})).filter((group) => group.filters.length > 0);

---

<Base
  title={text.title}
  description={text.description}
  keywords={pageKeywords}
  breadcrumbs={breadcrumbs}
  extraStructuredData={[collectionSchema, itemListSchema]}
>
  <div class="qaskills-page" data-qaskills-directory>
    <header class="directory-hero">
      <div class="directory-hero-topline">
        <span class="eyebrow">{text.directoryLabel}</span>
        <span class="hero-sync">{totalCount} {text.skillCountLabel} · {text.syncedLabel} {latestSync}</span>
      </div>
      <div class="directory-hero-main">
        <div>
          <h1>{text.title}</h1>
          <p class="hero-intro">{text.intro}</p>
        </div>
        <a href="https://github.com/naodeng/awesome-qa-skills" target="_blank" rel="noopener noreferrer" class="source-link">
          <span>{text.githubBtn}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="hero-metrics" aria-label={lang === "zh-cn" ? "目录信息" : "Directory information"}>
        <span><strong>{totalCount}</strong> {text.skillCountLabel}</span>
        {categoryOptions.slice(1).map((option) => (
          <span><strong>{option.count}</strong> {option.label}</span>
        ))}
      </div>
    </header>

    <section class="section discovery directory-toolbar" aria-label={lang === "zh-cn" ? "搜索 Skills" : "Search Skills"}>
      <div class="toolbar-main">
        <div class="search-control">
          <span class="material-icons-sharp search-control-icon" aria-hidden="true">search</span>
          <label class="sr-only" for="qaskills-search">{text.searchLabel}</label>
          <input
            id="qaskills-search"
            class="search-input"
            type="search"
            placeholder={text.searchHint}
            autocomplete="off"
          />
          <button type="button" id="qaskills-clear" class="toolbar-clear" hidden>{text.clearFilters}</button>
        </div>
        <p id="qaskills-results" class="results-count" aria-live="polite" data-label={text.resultsLabel} data-prefix={text.resultPrefix}>{totalCount} {text.resultsLabel}</p>
      </div>

      <section id="recommended-skills" class="featured-strip" data-qaskills-default-only aria-labelledby="featured-title">
        <div class="featured-copy">
          <h2 id="featured-title">{text.featuredTitle}</h2>
          <p>{text.featuredIntro}</p>
        </div>
        <div class="featured-list">
          {recommendedSkills.map((skill, index) => (
            <a class:list={["featured-link", index === 0 && "featured-link-primary"]} data-recommended-skill={skill.slug} href={getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}>
              <span class="featured-number">0{index + 1}</span>
              <span class="featured-link-copy">
                <strong>{displayNameOf(skill)}</strong>
                <small>{getQASkillCardIntro(skill, lang)}</small>
              </span>
              <span class="featured-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    </section>

    <section class="section directory-section" id="categories">
      <div class="directory-layout">
        <aside class="filter-sidebar" aria-label={lang === "zh-cn" ? "目录筛选" : "Directory filters"}>
          <div class="filter-sidebar-heading">
            <div>
              <h2>{text.filterTitle}</h2>
            </div>
            <span class="filter-sidebar-count">{totalCount}</span>
          </div>

          <div class="filter-group">
            <p class="filter-group-label">{text.categories}</p>
            <div class="filter-options" role="group" aria-label={text.categories}>
              {categoryOptions.map((option) => (
                <button type="button" class:list={["filter-option", option.key === "all" && "is-active"]} data-filter={option.key} aria-pressed={option.key === "all" ? "true" : "false"}>
                  <span>{option.label}</span><span>{option.count}</span>
                </button>
              ))}
              {showEvalsFilter && (
                <button type="button" class="filter-option" data-evals-toggle="1" aria-pressed="false">
                  <span>{text.filterEvals}</span><span>{evalsCount}</span>
                </button>
              )}
            </div>
          </div>

          <details class="more-filter-details">
            <summary>{text.moreFilters}<span class="material-icons-sharp" aria-hidden="true">expand_more</span></summary>
            <div class="more-filter-content">
              <div class="filter-group">
                <p class="filter-group-label">{text.lifecycleFilters}</p>
                <div class="chips chips-lifecycle" role="group" aria-label={text.lifecycleFilters}>
                  {lifecycleStages.map((stage) => (
                    <button type="button" class="chip chip-secondary" data-lifecycle-filter={stage.key} aria-pressed="false">
                      <span data-filter-label>{stage.title}</span><span data-filter-count aria-hidden="true">{stage.nodes.length}</span>
                    </button>
                  ))}
                </div>
              </div>
              <p class="filter-group-label secondary-filter-label" data-secondary-filter-label hidden>{text.subcategoryFilters}</p>
              <div id="qaskills-secondary-filters" class="chips-secondary" role="group" aria-label={lang === "zh-cn" ? "二级分类" : "Subcategories"} hidden>
                {secondaryFilterGroups.map((group) => (
                  <details class="secondary-filter-group" data-secondary-group>
                    <summary>
                      <span>{group.title}</span>
                      <span class="material-icons-sharp" aria-hidden="true">expand_more</span>
                    </summary>
                    <div class="secondary-filter-group-content">
                      {group.filters.map((filter) => (
                        <button type="button" class="chip chip-secondary" data-secondary-filter={filter.key} data-parent-category={filter.parentCategory} aria-pressed="false" hidden>
                          <span data-filter-label>{filter.label}</span>
                          <span class="filter-chip-count" data-filter-count aria-hidden="true">{filter.count}</span>
                        </button>
                      ))}
                    </div>
                  </details>
                ))}
              </div>
            </div>
          </details>
          <div id="qaskills-active-filters" class="active-filters" aria-label={text.activeFilters} data-remove-label={text.removeFilter} hidden></div>
        </aside>

        <div class="results-column">
          <div class="results-heading">
            <div>
              <h2>{text.catalogTitle}</h2>
            </div>
            <p>{text.catalogIntro}</p>
          </div>
          <p id="qaskills-empty" class="empty-state" hidden>{text.empty}</p>

          <div class="category-list">
            {grouped.catalogGroups.map((catalogGroup) => {
              const groupCount = catalogGroup.skills.length + catalogGroup.groups.reduce((count, group) => count + group.skills.length, 0);
              const rootSecondaryKey = `${catalogGroup.key}--root`;
              return (
                <section class="category-block" data-block={catalogGroup.key}>
                  <h3>
                    <button type="button" class="category-toggle" aria-expanded="true" aria-controls={`category-content-${catalogGroup.key}`}>
                      <span>{displayCatalogTitle(catalogGroup.title[lang === "zh-cn" ? "zh-cn" : "en"])}</span>
                      <span class="category-toggle-count">{groupCount}</span>
                      <span class="material-icons-sharp" aria-hidden="true">expand_more</span>
                    </button>
                  </h3>
                  <div id={`category-content-${catalogGroup.key}`} class="category-content">
                    {catalogGroup.skills.length > 0 && (
                      <ul class="cards" role="list">
                        {catalogGroup.skills.map((skill) => {
                          const cardCategory = catalogCategoryOf(skill);
                          const showCardType = cardCategory === "workflow" || cardCategory === "plus";
                          const cardIntro = getQASkillCardIntro(skill, lang);
                          return (
                            <li data-skill-item={skill.slug}>
                              <a class="card skill-card" data-slug={skill.slug} data-category={cardCategory} data-secondary-category={rootSecondaryKey} data-evals={skill.hasEvals ? "true" : "false"} data-lifecycle-stages={(lifecycleStagesBySlug.get(skill.slug) || []).join(" ")} data-title={displayNameOf(skill)} data-intro={cardIntro} href={getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}>
                                <div class="skill-card-title-row">
                                  <h5>{displayNameOf(skill)}</h5>
                                  {showCardType && <span class="skill-card-type">{cardCategory === "plus" ? text.catPlus : text.catWorkflow}</span>}
                                </div>
                                <p class="card-intro">{cardIntro}</p>
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    )}
                    {catalogGroup.groups.map((subgroup) => (
                      <div class="subgroup">
                        <h4>{subgroup.title[lang === "zh-cn" ? "zh-cn" : "en"]}</h4>
                        <ul class="cards" role="list">
                          {subgroup.skills.map((skill) => {
                            const cardCategory = catalogCategoryOf(skill);
                            const showCardType = cardCategory === "workflow" || cardCategory === "plus";
                            const cardIntro = getQASkillCardIntro(skill, lang);
                            return (
                              <li data-skill-item={skill.slug}>
                                <a class="card skill-card" data-slug={skill.slug} data-category={cardCategory} data-secondary-category={`${catalogGroup.key}--${subgroup.key}`} data-evals={skill.hasEvals ? "true" : "false"} data-lifecycle-stages={(lifecycleStagesBySlug.get(skill.slug) || []).join(" ")} data-title={displayNameOf(skill)} data-intro={cardIntro} href={getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}>
                                  <div class="skill-card-title-row">
                                    <h5>{displayNameOf(skill)}</h5>
                                    {showCardType && <span class="skill-card-type">{cardCategory === "plus" ? text.catPlus : text.catWorkflow}</span>}
                                  </div>
                                  <p class="card-intro">{cardIntro}</p>
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    ))}
                  </div>
                </section>
              );
            })}
          </div>

        </div>
      </div>
    </section>

    <section id="quickstart" class="section usage-note" data-qaskills-default-only>
      <div>
        <h2>{text.quickStart}</h2>
      </div>
      <ol>
        {text.quickSteps.map((step, index) => (
          <li><span>{index + 1}</span><div><strong>{step.title}</strong><p>{step.desc}</p></div></li>
        ))}
      </ol>
    </section>

    <section id="lifecycle-path" class="section lifecycle-path" data-qaskills-default-only aria-labelledby="lifecycle-path-title">
      <div class="lifecycle-heading">
        <div>
          <h2 id="lifecycle-path-title">{text.lifecycleTitle}</h2>
        </div>
        <p>{text.lifecycleIntro}</p>
      </div>
      <div class="lifecycle-track">
        {lifecycleStages.map((stage, index) => (
          <div class="lifecycle-cell">
            <div class="lifecycle-stage" data-stage={stage.key}>
              <p class="lifecycle-stage-title"><span class="lifecycle-stage-num" aria-hidden="true">{index + 1}</span>{stage.title}</p>
              <ul class="lifecycle-skills" role="list">
                {stage.nodes.map((node) => (
                  <li>
                    <a class:list={["lifecycle-skill", node.kind === "plus" && "lifecycle-skill--plus"]} href={getRelativeLocaleUrl(lang, `/qaskills/${node.slug}/`)} data-slug={node.slug} data-kind={node.kind}>
                      <span>{node.label}</span>
                      {node.kind === "plus" && <span class="lifecycle-plus-tag">{text.lifecyclePlusLabel}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            {index < lifecycleStages.length - 1 && <span class="lifecycle-arrow" aria-hidden="true">→</span>}
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<script is:inline>
  (() => {
    const search = document.getElementById("qaskills-search");
    const empty = document.getElementById("qaskills-empty");
    const results = document.getElementById("qaskills-results");
    const clearBtn = document.getElementById("qaskills-clear");
    const activeFilters = document.getElementById("qaskills-active-filters");
    const chips = Array.from(document.querySelectorAll("[data-filter], [data-evals-toggle]"));
    const categoryFilters = Array.from(document.querySelectorAll(".filter-option[data-filter]"));
    const secondaryFilters = document.getElementById("qaskills-secondary-filters");
    const secondaryFilterLabel = document.querySelector("[data-secondary-filter-label]");
    const secondaryFilterGroups = Array.from(document.querySelectorAll("[data-secondary-group]"));
    const secondaryChips = Array.from(document.querySelectorAll(".chip[data-secondary-filter]"));
    const lifecycleChips = Array.from(document.querySelectorAll(".chip[data-lifecycle-filter]"));
    const cards = Array.from(document.querySelectorAll("a.card[data-slug]"));
    const blocks = Array.from(document.querySelectorAll(".category-block"));
    const categoryToggles = Array.from(document.querySelectorAll(".category-toggle"));
    const defaultOnly = Array.from(document.querySelectorAll("[data-qaskills-default-only]"));
    if (!search || !empty || !cards.length) return;

    let category = "all";
    let secondaryCategory = "";
    let lifecycleStage = "";
    let evalsOnly = false;

    const queryValue = () => (search.value || "").trim().toLowerCase();

    const cardMatches = (card, overrides = {}) => {
      const selectedCategory = overrides.category ?? category;
      const selectedSecondary = overrides.secondaryCategory ?? secondaryCategory;
      const selectedLifecycle = overrides.lifecycleStage ?? lifecycleStage;
      const selectedEvals = overrides.evalsOnly ?? evalsOnly;
      const query = overrides.query ?? queryValue();
      const cardCategory = card.getAttribute("data-category") || "type";
      const subcategory = card.getAttribute("data-secondary-category") || "";
      const stages = (card.getAttribute("data-lifecycle-stages") || "").split(" ");
      const hasEvals = card.getAttribute("data-evals") === "true";
      const haystack = [
        card.getAttribute("data-slug") || "",
        card.getAttribute("data-title") || "",
        card.getAttribute("data-intro") || "",
      ]
        .join(" ")
        .toLowerCase();

      return (
        (selectedCategory === "all" || cardCategory === selectedCategory) &&
        (!selectedSecondary || subcategory === selectedSecondary) &&
        (!selectedLifecycle || stages.includes(selectedLifecycle)) &&
        (!selectedEvals || hasEvals) &&
        (!query || haystack.includes(query))
      );
    };

    const countMatchingCards = (overrides = {}) => cards.filter((card) => cardMatches(card, overrides)).length;

    const belongsToCategory = (chip, selectedCategory) =>
      selectedCategory === "all" || (chip.getAttribute("data-parent-category") || "").split(/\s+/).includes(selectedCategory);

    // 与 src/utils/qaskillsFilter.ts 的 isQASkillSearchActive 保持等价
    // （is:inline 脚本无法 import 模块，两处需同步维护）
    const searchActive = () =>
      (search.value || "").trim().length > 0 || category !== "all" || secondaryCategory !== "" || lifecycleStage !== "" || evalsOnly;

    const updateSecondaryFilters = () => {
      const visible = secondaryChips.filter((chip) => belongsToCategory(chip, category));
      const hasVisible = visible.length > 0;
      secondaryFilters?.toggleAttribute("hidden", !hasVisible);
      secondaryFilterLabel?.toggleAttribute("hidden", !hasVisible);
      secondaryChips.forEach((chip) => chip.toggleAttribute("hidden", !visible.includes(chip)));
      secondaryFilterGroups.forEach((group) => {
        const hasVisibleChip = Array.from(group.querySelectorAll("[data-secondary-filter]")).some((chip) => !chip.hasAttribute("hidden"));
        group.toggleAttribute("hidden", !hasVisibleChip);
      });
      if (!visible.some((chip) => chip.getAttribute("data-secondary-filter") === secondaryCategory)) {
        secondaryCategory = "";
      }
      secondaryChips.forEach((chip) => {
        const key = chip.getAttribute("data-secondary-filter") || "";
        const count = cards.filter((card) =>
          card.getAttribute("data-secondary-category") === key && cardMatches(card, { secondaryCategory: "" })
        ).length;
        const countLabel = chip.querySelector("[data-filter-count]");
        if (countLabel) countLabel.textContent = String(count);
        const selected = chip.getAttribute("data-secondary-filter") === secondaryCategory;
        chip.disabled = count === 0 && !selected;
        chip.classList.toggle("is-unavailable", count === 0 && !selected);
        chip.classList.toggle("is-active", selected);
        chip.setAttribute("aria-pressed", String(selected));
      });
    };

    const updateLifecycleFilters = () => {
      lifecycleChips.forEach((chip) => {
        const stage = chip.getAttribute("data-lifecycle-filter") || "";
        const count = cards.filter((card) =>
          (card.getAttribute("data-lifecycle-stages") || "").split(" ").includes(stage) &&
          cardMatches(card, { lifecycleStage: "" })
        ).length;
        chip.disabled = count === 0;
        chip.classList.toggle("is-unavailable", count === 0);
        const countLabel = chip.querySelector("[data-filter-count]");
        if (countLabel) countLabel.textContent = String(count);
        if (count === 0 && lifecycleStage === stage) lifecycleStage = "";
      });
      lifecycleChips.forEach((chip) => {
        const selected = chip.getAttribute("data-lifecycle-filter") === lifecycleStage;
        chip.classList.toggle("is-active", selected);
        chip.setAttribute("aria-pressed", String(selected));
      });
    };

    const updateCategoryFilters = () => {
      categoryFilters.forEach((chip) => {
        const selectedCategory = chip.getAttribute("data-filter") || "all";
        const count = countMatchingCards({ category: selectedCategory });
        const countLabel = chip.querySelector("span:last-child");
        if (countLabel) countLabel.textContent = String(count);
      });
    };

    const updateCategoryGroupCounts = () => {
      blocks.forEach((block) => {
        const count = Array.from(block.querySelectorAll("li")).filter((item) => !item.hasAttribute("hidden")).length;
        const countLabel = block.querySelector(".category-toggle-count");
        if (countLabel) countLabel.textContent = String(count);
      });
    };

    const updateEvalsFilter = () => {
      const evalsFilter = document.querySelector("[data-evals-toggle]");
      if (!evalsFilter) return;
      const count = cards.filter((card) => card.getAttribute("data-evals") === "true" && cardMatches(card, { evalsOnly: false })).length;
      const countLabel = evalsFilter.querySelector("span:last-child");
      if (countLabel) countLabel.textContent = String(count);
    };

    const updateActiveFilters = () => {
      if (!activeFilters) return;
      const active = [
        ...Array.from(document.querySelectorAll(".is-active[data-filter], .is-active[data-evals-toggle], .is-active[data-secondary-filter], .is-active[data-lifecycle-filter]")),
      ].filter((chip) => chip.getAttribute("data-filter") !== "all");
      activeFilters.replaceChildren(
        ...active.map((chip) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "active-filter";
          const label = chip.querySelector("[data-filter-label]")?.textContent?.trim() || (chip.textContent || "").trim();
          button.textContent = `${label} ×`;
          button.setAttribute("aria-label", `${activeFilters.dataset.removeLabel || "Remove"} ${label} filter`);
          button.addEventListener("click", () => chip.click());
          return button;
        })
      );
      activeFilters.toggleAttribute("hidden", active.length === 0);
    };

    const apply = () => {
      let visible = 0;
      cards.forEach((card) => {
        const show = cardMatches(card);
        card.closest("li")?.toggleAttribute("hidden", !show);
        if (show) visible += 1;
      });

      document.querySelectorAll(".subgroup").forEach((sub) => {
        const hasVisible = Array.from(sub.querySelectorAll("li")).some((li) => !li.hasAttribute("hidden"));
        sub.toggleAttribute("hidden", !hasVisible);
      });

      blocks.forEach((block) => {
        const hasVisible = Array.from(block.querySelectorAll("li")).some((li) => !li.hasAttribute("hidden"));
        block.toggleAttribute("hidden", !hasVisible);
        if (searchActive() && hasVisible) {
          const toggle = block.querySelector(".category-toggle");
          const content = document.getElementById(toggle?.getAttribute("aria-controls") || "");
          toggle?.setAttribute("aria-expanded", "true");
          content?.removeAttribute("hidden");
        }
      });

      // 搜索态下隐藏默认辅助区，让目录结果紧邻筛选区。
      defaultOnly.forEach((el) => {
        const hidden = searchActive();
        el.toggleAttribute("hidden", hidden);
        if (hidden) {
          el.style.setProperty("display", "none", "important");
        } else {
          el.style.removeProperty("display");
        }
      });

      empty.hidden = visible > 0;
      clearBtn?.toggleAttribute("hidden", !searchActive());
      updateCategoryFilters();
      updateCategoryGroupCounts();
      updateEvalsFilter();
      updateActiveFilters();
      if (results) results.textContent = `${visible} ${results.dataset.label || ""}`.trim();
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        if (chip.hasAttribute("data-evals-toggle")) {
          evalsOnly = !evalsOnly;
          chip.classList.toggle("is-active", evalsOnly);
          chip.setAttribute("aria-pressed", String(evalsOnly));
          updateSecondaryFilters();
          updateLifecycleFilters();
        } else {
          category = chip.getAttribute("data-filter") || "all";
          categoryFilters.forEach((c) => {
            c.classList.toggle("is-active", c === chip);
            c.setAttribute("aria-pressed", String(c === chip));
          });
          updateSecondaryFilters();
          updateLifecycleFilters();
        }
        apply();
      });
    });

    secondaryChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const selected = chip.getAttribute("data-secondary-filter") || "";
        secondaryCategory = secondaryCategory === selected ? "" : selected;
        secondaryChips.forEach((item) => {
          item.classList.toggle("is-active", item.getAttribute("data-secondary-filter") === secondaryCategory);
          item.setAttribute("aria-pressed", String(item.getAttribute("data-secondary-filter") === secondaryCategory));
        });
        updateLifecycleFilters();
        apply();
      });
    });

    lifecycleChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const selected = chip.getAttribute("data-lifecycle-filter") || "";
        lifecycleStage = lifecycleStage === selected ? "" : selected;
        lifecycleChips.forEach((item) => {
          item.classList.toggle("is-active", item.getAttribute("data-lifecycle-filter") === lifecycleStage);
          item.setAttribute("aria-pressed", String(item.getAttribute("data-lifecycle-filter") === lifecycleStage));
        });
        updateSecondaryFilters();
        apply();
      });
    });

    search.addEventListener("input", () => {
      updateSecondaryFilters();
      updateLifecycleFilters();
      apply();
    });
    categoryToggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const content = document.getElementById(toggle.getAttribute("aria-controls") || "");
        if (!content) return;
        const expanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!expanded));
        content.toggleAttribute("hidden", expanded);
      });
    });
    clearBtn?.addEventListener("click", () => {
      search.value = "";
      category = "all";
      secondaryCategory = "";
      lifecycleStage = "";
      evalsOnly = false;
      document.querySelectorAll("[data-filter]").forEach((c) => {
        c.classList.toggle("is-active", c.getAttribute("data-filter") === "all");
        c.setAttribute("aria-pressed", String(c.getAttribute("data-filter") === "all"));
      });
      const evalsChip = document.querySelector("[data-evals-toggle]");
      evalsChip?.classList.remove("is-active");
      evalsChip?.setAttribute("aria-pressed", "false");
      lifecycleChips.forEach((chip) => {
        chip.classList.remove("is-active");
        chip.setAttribute("aria-pressed", "false");
      });
      categoryToggles.forEach((toggle) => {
        toggle.setAttribute("aria-expanded", "true");
        document.getElementById(toggle.getAttribute("aria-controls") || "")?.removeAttribute("hidden");
      });
      updateSecondaryFilters();
      updateLifecycleFilters();
      apply();
      search?.focus();
    });

    updateSecondaryFilters();
    updateLifecycleFilters();
    apply();
  })();
</script>

