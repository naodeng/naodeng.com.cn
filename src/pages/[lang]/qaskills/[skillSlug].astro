---
import Base from "@/layouts/Base.astro";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  getQASkills,
  getQASkillBySlug,
  getRelatedForSkill,
  SECTION_KEYS,
  SECTION_LABELS,
} from "@/utils/qaskills";
import GoogleAd from "@/components/GoogleAd.astro";
import ArticleShare from "@/components/ArticleShare.astro";
import Giscus from "@/components/Giscus.astro";

export async function getStaticPaths() {
  const langs: Lang[] = ["en", "zh-cn"];
  const routes: Array<{ params: { lang: string; skillSlug: string } }> = [];

  for (const lang of langs) {
    const skills = await getQASkills(lang);
    for (const skill of skills) {
      routes.push({
        params: {
          lang,
          skillSlug: skill.slug,
        },
      });
    }
  }

  return routes;
}

const lang = Astro.params.lang as Lang;
const skillSlug = Astro.params.skillSlug as string;
const skill = await getQASkillBySlug(lang, skillSlug);

if (!skill) {
  throw new Error(`QASkill not found: ${lang}/${skillSlug}`);
}

const related = await getRelatedForSkill(lang, skill.slug, 5);
const localeKey = lang === "zh-cn" ? "zh-cn" : "en";
const displayName = lang === "zh-cn" ? (skill.chineseName || skill.title) : skill.title;

const text = lang === "zh-cn" ? {
  home: "首页",
  list: "QA Skills",
  installNow: "立即安装",
  sourceSkill: "源 SKILL.md",
  guideTab: "Guide",
  rawTab: "SKILL.md",
  copyRaw: "复制全文",
  copied: "已复制",
  platform: "平台",
  aiTool: "AI 工具",
  quickInstall: "快速安装（一行命令）",
  fullScript: "完整脚本",
  callExample: "调用示例",
  related: "相关技能",
  category: "分类",
  evals: "Evals",
  noEvals: "No Evals",
  updated: "同步日期",
  author: "作者",
  rawMissing: "暂无源文件预览，请打开 GitHub 查看。",
  catType: "类型",
  catWorkflow: "工作流",
  catPlus: "Plus",
  installPanel: "安装与调用",
  onThisPage: "本页导航",
} : {
  home: "Home",
  list: "QA Skills",
  installNow: "Install Now",
  sourceSkill: "Source SKILL.md",
  guideTab: "Guide",
  rawTab: "SKILL.md",
  copyRaw: "Copy all",
  copied: "Copied",
  platform: "Platform",
  aiTool: "AI Tool",
  quickInstall: "Quick install (one line)",
  fullScript: "Full script",
  callExample: "Call example",
  related: "Related skills",
  category: "Category",
  evals: "Evals",
  noEvals: "No Evals",
  updated: "Synced",
  author: "Author",
  rawMissing: "Raw preview unavailable. Open GitHub instead.",
  catType: "Type",
  catWorkflow: "Workflow",
  catPlus: "Plus",
  installPanel: "Install & call",
  onThisPage: "On this page",
};

const categoryLabel =
  skill.category === "workflow"
    ? text.catWorkflow
    : skill.category === "plus"
      ? text.catPlus
      : text.catType;

const breadcrumbs = [
  { name: text.home, url: getRelativeLocaleUrl(lang, "/") },
  { name: text.list, url: getRelativeLocaleUrl(lang, "/qaskills/") },
  { name: displayName, url: getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`) },
];

const installerLang = lang === "zh-cn" ? "zh" : "en";
const aiTools = ["codex", "cursor", "claudecode", "kiro", "opencode", "trae"] as const;
const toolMeta = {
  codex: { icon: "code", label: "codex" },
  cursor: { icon: "ads_click", label: "cursor" },
  claudecode: { icon: "auto_awesome", label: "claudecode" },
  kiro: { icon: "psychology_alt", label: "kiro" },
  opencode: { icon: "integration_instructions", label: "opencode" },
  trae: { icon: "bolt", label: "trae" },
} as const;

const skillKindMatch = skill.sourceSkillUrl.match(/\/skills\/(?:zh|en)\/(testing-types|testing-workflows)\//);
const skillKind = skillKindMatch?.[1] || (skill.category === "workflow" ? "testing-workflows" : "testing-types");
const installContext = {
  slug: skill.slug,
  lang: installerLang,
  kind: skillKind,
};

const callExample =
  lang === "zh-cn"
    ? `@skill ${skill.slug}\n结合当前项目上下文，按该技能的要求给出可执行结果。`
    : `@skill ${skill.slug}\nUsing the current project context, produce an actionable result following this skill.`;

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";
const canonicalUrl = `${siteOrigin}${getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}`;
const pageLocale = (lang === "zh-cn" ? "zh-cn" : "en") as "en" | "zh-cn";
const pageTitle = lang === "zh-cn"
  ? `${displayName} - 软件测试技能库`
  : `${displayName} - QA Skill Library`;
const rawPageDescription = (skill.intro || skill.description || skill.title || "").trim();
const pageDescription = rawPageDescription.length < 80
  ? lang === "zh-cn"
    ? `${rawPageDescription} 提供可直接使用的安装、调用、输入输出与人工复核说明。`
    : `${rawPageDescription} Includes practical installation, calling, input/output, and human-review guidance.`
  : rawPageDescription;
const pageKeywords = [
  skill.title,
  skill.chineseName,
  lang === "zh-cn" ? "软件测试技能库" : "QA skill library",
  lang === "zh-cn" ? "测试技能" : "testing skills",
].filter(Boolean).join(", ");
const skillSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: displayName,
  description: pageDescription,
  url: canonicalUrl,
  inLanguage: lang === "zh-cn" ? "zh-CN" : "en",
  dateModified: skill.updatedAt || undefined,
  author: { "@type": "Person", name: skill.author || "naodeng" },
  publisher: { "@type": "Organization", name: "naodeng", url: siteOrigin },
  mainEntityOfPage: canonicalUrl,
};
const showRawTab = Boolean(skill.rawSkillMarkdown || skill.sourceSkillUrl);
const visibleSections = SECTION_KEYS.filter((key) => Boolean(skill.sections[key]));
const tocHeadings = [
  ...visibleSections.map((key) => ({
    depth: 2 as const,
    slug: `section-${key}`,
    text: SECTION_LABELS[key][localeKey],
  })),
  { depth: 2 as const, slug: "install-section", text: text.installPanel },
];
---

<Base
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  breadcrumbs={breadcrumbs}
  extraStructuredData={[skillSchema]}
>
  <article class="qaskill-detail">
    <header class="detail-header">
      <div class="detail-header-main">
        <p class="meta-row">
          <span class="tag">{categoryLabel}</span>
          <span class="tag tag-evals">{skill.hasEvals ? text.evals : text.noEvals}</span>
          <span class="tag">{text.updated}: {skill.updatedAt || "-"}</span>
        </p>
        <h1>{displayName}</h1>
        <p class="sub-meta">{text.author}: {skill.author || "-"}</p>
      </div>
      <div class="actions header-actions">
        <a href="#install-section" class="btn btn-primary">{text.installNow}</a>
        {skill.sourceSkillUrl && (
          <a href={skill.sourceSkillUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">{text.sourceSkill}</a>
        )}
      </div>
    </header>

    <div class="detail-layout">
      <div class="detail-main">
        <div class="detail-tabs" role="tablist" aria-label="Skill content">
          <button type="button" class="detail-tab is-active" role="tab" aria-selected="true" data-tab="guide">{text.guideTab}</button>
          {showRawTab && (
            <button type="button" class="detail-tab" role="tab" aria-selected="false" data-tab="raw">{text.rawTab}</button>
          )}
        </div>

        <div id="panel-guide" class="tab-panel" role="tabpanel">
          {visibleSections.map((key) => (
            <section class="detail-section" id={`section-${key}`}>
              <h2>{SECTION_LABELS[key][localeKey]}</h2>
              <div class="prose" set:html={skill.sectionHtml[key]} />
            </section>
          ))}
        </div>

        {showRawTab && (
          <div id="panel-raw" class="tab-panel" role="tabpanel" hidden>
            {skill.rawSkillMarkdown ? (
              <div class="raw-wrap">
                <div class="raw-toolbar">
                  <span class="raw-toolbar-label">SKILL.md</span>
                  <button type="button" id="copy-raw-skill-btn" class="copy-raw-btn">{text.copyRaw}</button>
                </div>
                <pre class="skill-raw"><code id="raw-skill-code">{skill.rawSkillMarkdown}</code></pre>
              </div>
            ) : (
              <p>
                {text.rawMissing}{" "}
                {skill.sourceSkillUrl && (
                  <a href={skill.sourceSkillUrl} target="_blank" rel="noopener noreferrer">{text.sourceSkill}</a>
                )}
              </p>
            )}
          </div>
        )}

        <section class="install-block" id="install-section">
          <h2>{text.installPanel}</h2>
          <div class="installer-panel" id="installer-panel" data-default-lang={installerLang}>
            <div class="installer-row">
              <p class="installer-label">{text.platform}</p>
              <div class="tab-group platform-tabs" role="tablist">
                <button type="button" class="tab-btn is-active" data-os="mac">
                  <span class="material-icons-sharp tab-icon" aria-hidden="true">terminal</span>
                  <span>macOS / Linux</span>
                </button>
                <button type="button" class="tab-btn" data-os="windows">
                  <span class="material-icons-sharp tab-icon" aria-hidden="true">desktop_windows</span>
                  <span>Windows</span>
                </button>
              </div>
            </div>

            <div class="installer-row">
              <p class="installer-label">{text.aiTool}</p>
              <div class="tab-group tools-tabs" role="tablist">
                {aiTools.map((tool, i) => (
                  <button type="button" class:list={["tab-btn", i === 0 && "is-active"]} data-tool={tool}>
                    <span class="material-icons-sharp tab-icon" aria-hidden="true">{toolMeta[tool].icon}</span>
                    <span>{toolMeta[tool].label}</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="installer-snippet">
              <p class="installer-label">{text.quickInstall}</p>
              <div class="code-card">
                <pre data-lang="shell"><code id="quick-install-code" class="language-bash">…</code></pre>
                <button type="button" id="copy-quick-btn" class="copy-mini">{lang === "zh-cn" ? "复制" : "Copy"}</button>
              </div>
            </div>

            <div class="installer-snippet">
              <p class="installer-label">{text.fullScript}</p>
              <div class="code-card">
                <pre data-lang="shell"><code id="full-install-code" class="language-bash">…</code></pre>
                <button type="button" id="copy-full-btn" class="copy-mini">{lang === "zh-cn" ? "复制" : "Copy"}</button>
              </div>
            </div>

            <div class="installer-snippet">
              <p class="installer-label">{text.callExample}</p>
              <div class="code-card">
                <pre data-lang="text"><code id="call-example-code">{callExample}</code></pre>
                <button type="button" id="copy-call-btn" class="copy-mini">{lang === "zh-cn" ? "复制" : "Copy"}</button>
              </div>
            </div>
          </div>
        </section>

        {related.length > 0 && (
          <section class="related-block related-block--main">
            <h2>{text.related}</h2>
            <ul>
              {related.map((item) => (
                <li>
                  <a href={getRelativeLocaleUrl(lang, `/qaskills/${item.slug}/`)}>
                    {lang === "zh-cn" ? (item.chineseName || item.title) : item.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

      </div>

      <aside class="detail-aside" aria-label={text.onThisPage}>
        <nav class="elevator" id="skill-elevator">
          <p class="elevator-title">{text.onThisPage}</p>
          <ul class="elevator-list">
            {tocHeadings.map((item) => (
              <li>
                <a class="elevator-link" href={`#${item.slug}`} data-elevator-target={item.slug}>{item.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    </div>

    <ArticleShare title={displayName} url={canonicalUrl} locale={pageLocale} />
    <div class="ad-slot-250">
      <GoogleAd />
    </div>
    <Giscus
      lang={lang === "zh-cn" ? "zh-CN" : "en"}
      theme="preferred_color_scheme"
      inputPosition="bottom"
      reactionsEnabled={true}
      loading="lazy"
    />
  </article>
</Base>

<script is:inline define:vars={{ installContext, lang, copiedLabel: text.copied, copyLabel: lang === "zh-cn" ? "复制" : "Copy", copyRawLabel: text.copyRaw }}>
  (() => {
    const tabButtons = Array.from(document.querySelectorAll(".detail-tab[data-tab]"));
    const panelGuide = document.getElementById("panel-guide");
    const panelRaw = document.getElementById("panel-raw");
    const activateTab = (tab) => {
      tabButtons.forEach((b) => {
        const active = b.getAttribute("data-tab") === tab;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-selected", active ? "true" : "false");
      });
      if (panelGuide) panelGuide.hidden = tab !== "guide";
      if (panelRaw) panelRaw.hidden = tab !== "raw";
    };
    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => activateTab(btn.getAttribute("data-tab") || "guide"));
    });

    const elevatorLinks = Array.from(document.querySelectorAll("[data-elevator-target]"));
    const setActiveElevator = (slug) => {
      elevatorLinks.forEach((a) => {
        a.classList.toggle("is-active", a.getAttribute("data-elevator-target") === slug);
      });
    };
    elevatorLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const target = link.getAttribute("data-elevator-target") || "";
        if (target.startsWith("section-")) activateTab("guide");
        setActiveElevator(target);
      });
    });
    const observed = elevatorLinks
      .map((link) => document.getElementById(link.getAttribute("data-elevator-target") || ""))
      .filter(Boolean);
    if (observed.length && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible?.target?.id) setActiveElevator(visible.target.id);
        },
        { rootMargin: "-20% 0px -55% 0px", threshold: [0.1, 0.35, 0.6] }
      );
      observed.forEach((el) => io.observe(el));
    }

    const copyRawBtn = document.getElementById("copy-raw-skill-btn");
    const rawCode = document.getElementById("raw-skill-code");
    copyRawBtn?.addEventListener("click", async () => {
      const content = rawCode?.textContent || "";
      if (!content) return;
      try {
        await navigator.clipboard.writeText(content);
        copyRawBtn.textContent = copiedLabel;
        setTimeout(() => { copyRawBtn.textContent = copyRawLabel; }, 1200);
      } catch {}
    });

    const panel = document.getElementById("installer-panel");
    if (!panel) return;
    const osButtons = Array.from(panel.querySelectorAll("[data-os]"));
    const toolButtons = Array.from(panel.querySelectorAll("[data-tool]"));
    const quickCodeEl = document.getElementById("quick-install-code");
    const fullCodeEl = document.getElementById("full-install-code");
    const copyQuickBtn = document.getElementById("copy-quick-btn");
    const copyFullBtn = document.getElementById("copy-full-btn");
    const copyCallBtn = document.getElementById("copy-call-btn");
    const callCodeEl = document.getElementById("call-example-code");
    if (!quickCodeEl || !fullCodeEl || !copyQuickBtn || !copyFullBtn) return;

    let currentOS = /windows/i.test(navigator.userAgent) ? "windows" : "mac";
    let currentTool = "codex";

    const escapeHTML = (value) =>
      value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    const highlightCode = (source, langKey) => {
      if (!source) return "";
      let html = escapeHTML(source);
      const slots = [];
      const stash = (pattern, cls) => {
        html = html.replace(pattern, (m) => {
          const id = slots.push(`<span class="${cls}">${m}</span>`) - 1;
          return `@@CODE_SLOT_${id}@@`;
        });
      };
      stash(/"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/g, "tok-string");
      stash(/\$\{[^}]+\}|\$[A-Za-z_][A-Za-z0-9_:]*/g, "tok-var");
      stash(/(^|\n)\s*#.*$/gm, "tok-comment");
      stash(/\b(?:if|then|fi|for|do|done|while|case|esac)\b/g, "tok-keyword");
      stash(/\b(?:curl|irm|iex|exec|set|mkdir|cd|git|cp|echo|bash|trap|Join-Path|Set-Location|Copy-Item|Write-Host|New-Item|Remove-Item)\b/g, "tok-fn");
      stash(/\|\||&&|\||=>|->/g, "tok-op");
      if (langKey === "powershell") {
        stash(/\b(?:param|function|foreach|switch|where|select)\b/g, "tok-keyword");
      }
      return html.replace(/@@CODE_SLOT_(\d+)@@/g, (_, i) => slots[Number(i)] || "");
    };

    const renderCode = (el, source, langKey) => {
      el.innerHTML = highlightCode(source, langKey);
    };

    const renderActive = () => {
      osButtons.forEach((btn) => btn.classList.toggle("is-active", btn.dataset.os === currentOS));
      toolButtons.forEach((btn) => btn.classList.toggle("is-active", btn.dataset.tool === currentTool));
    };

    // Per-skill shortcut installers under installers/ are not portable for website visitors.
    // Use the official scripts/install-skills-* after a shallow clone instead.
    const getQuickCommand = () => {
      if (currentOS === "windows") {
        return [
          `$repo = Join-Path $env:TEMP ("aqs-" + [guid]::NewGuid().ToString("N"));`,
          `git clone --depth 1 https://github.com/naodeng/awesome-qa-skills.git $repo;`,
          `& (Join-Path $repo "scripts\\install-skills-windows.ps1") -Tool ${currentTool} -Lang ${installContext.lang} -Skill ${installContext.slug};`,
          `Remove-Item -Recurse -Force $repo`,
        ].join(" ");
      }
      return [
        `REPO="$(mktemp -d)"`,
        `git clone --depth 1 https://github.com/naodeng/awesome-qa-skills.git "$REPO"`,
        `bash "$REPO/scripts/install-skills-mac.sh" --tool ${currentTool} --lang ${installContext.lang} --skill ${installContext.slug}`,
        `rm -rf "$REPO"`,
      ].join(" && ");
    };

    const getFullScript = () => {
      if (currentOS === "windows") {
        return [
          `# Install ${installContext.slug} for ${currentTool}`,
          `$ErrorActionPreference = "Stop"`,
          `$repo = Join-Path $env:TEMP ("aqs-" + [guid]::NewGuid().ToString("N"))`,
          `try {`,
          `  git clone --depth 1 https://github.com/naodeng/awesome-qa-skills.git $repo`,
          `  & (Join-Path $repo "scripts\\install-skills-windows.ps1") -Tool ${currentTool} -Lang ${installContext.lang} -Skill ${installContext.slug}`,
          `}`,
          `finally {`,
          `  if (Test-Path $repo) { Remove-Item -Recurse -Force $repo }`,
          `}`,
        ].join("\n");
      }
      return [
        `#!/usr/bin/env bash`,
        `set -euo pipefail`,
        `# Install ${installContext.slug} for ${currentTool}`,
        `REPO="$(mktemp -d)"`,
        `trap 'rm -rf "$REPO"' EXIT`,
        `git clone --depth 1 https://github.com/naodeng/awesome-qa-skills.git "$REPO"`,
        `bash "$REPO/scripts/install-skills-mac.sh" --tool ${currentTool} --lang ${installContext.lang} --skill ${installContext.slug}`,
      ].join("\n");
    };

    const refreshCommands = () => {
      const langKey = currentOS === "windows" ? "powershell" : "shell";
      const codeClass = currentOS === "windows" ? "language-powershell" : "language-bash";
      [quickCodeEl, fullCodeEl].forEach((el) => {
        el.className = codeClass;
        el.closest("pre")?.setAttribute("data-lang", langKey);
      });
      renderCode(quickCodeEl, getQuickCommand(), langKey);
      renderCode(fullCodeEl, getFullScript(), langKey);
    };

    const bindCopy = (btn, el) => {
      btn.addEventListener("click", async () => {
        const content = el.textContent || "";
        if (!content) return;
        try {
          await navigator.clipboard.writeText(content);
          btn.textContent = copiedLabel;
          setTimeout(() => { btn.textContent = copyLabel; }, 1200);
        } catch {}
      });
    };

    osButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        currentOS = btn.dataset.os || "mac";
        renderActive();
        refreshCommands();
      });
    });
    toolButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        currentTool = btn.dataset.tool || "codex";
        renderActive();
        refreshCommands();
      });
    });

    bindCopy(copyQuickBtn, quickCodeEl);
    bindCopy(copyFullBtn, fullCodeEl);
    if (copyCallBtn && callCodeEl) bindCopy(copyCallBtn, callCodeEl);

    renderActive();
    refreshCommands();
  })();
</script>

<style>
  .qaskill-detail {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }
  .detail-header {
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--color-theme) 22%, transparent);
    background: color-mix(in srgb, var(--color-theme) 6%, var(--color-base));
    padding: 0.95rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
  }
  .detail-header-main {
    min-width: 0;
    flex: 1 1 auto;
  }
  .detail-header h1 {
    margin: 0.35rem 0 0;
    line-height: 1.25;
    font-size: clamp(1.6rem, 2.5vw, 1.95rem);
  }
  .meta-row, .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
  }
  .sub-meta { margin: 0.4rem 0 0; opacity: 0.85; }
  .tag {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-main) 18%, transparent);
    background: color-mix(in srgb, var(--color-theme) 8%, transparent);
    color: var(--color-theme);
  }
  .detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(160px, 200px);
    gap: 0.85rem;
    align-items: start;
    min-width: 0;
  }
  .detail-main {
    min-width: 0;
  }
  .detail-aside {
    position: sticky;
    top: 0.75rem;
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }
  .elevator {
    border: 1px solid color-mix(in srgb, var(--color-main) 12%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-base) 97%, var(--color-main));
    padding: 0.7rem 0.75rem;
  }
  .elevator-title {
    margin: 0 0 0.45rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
