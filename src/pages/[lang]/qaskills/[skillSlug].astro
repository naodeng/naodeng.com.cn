---
import Base from "@/layouts/Base.astro";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getQASkills } from "@/utils/qaskills";
import { getRelatedQASkills } from "@/utils/qaskillsRelated";
import { getQASkillCardIntro, getQASkillCardSummary } from "@/data/qaSkillLibrary";
import { buildGenericQASkillDetailData, getQASkillDetailData } from "@/data/qaSkillDetail";
import ArticleShare from "@/components/ArticleShare.astro";
import Giscus from "@/components/Giscus.astro";

export async function getStaticPaths() {
  const langs: Lang[] = ["en", "zh-cn"];
  const routes: Array<{ params: { lang: string; skillSlug: string } }> = [];
  for (const lang of langs) {
    const skills = await getQASkills(lang);
    for (const skill of skills) routes.push({ params: { lang, skillSlug: skill.slug } });
  }
  return routes;
}

const lang = Astro.params.lang as Lang;
const skillSlug = Astro.params.skillSlug as string;
const allSkills = await getQASkills(lang);
const skill = allSkills.find((item) => item.slug === skillSlug) ?? null;
if (!skill) throw new Error(`QASkill not found: ${lang}/${skillSlug}`);

const related = getRelatedQASkills(allSkills, skill.slug, 5);
const displayName = lang === "zh-cn" ? (skill.chineseName || skill.title) : skill.title;
const heroTitleLines = (() => {
  const match = displayName.match(/^(.*?)(\s*[（(][^）)]*[）)])$/);
  return match ? [match[1].trim(), match[2].trim()] : [displayName];
})();
const secondaryName = skill.slug === "requirements-analysis"
  ? lang === "zh-cn" ? "" : "需求分析"
  : "";
const localizedIntro = getQASkillCardIntro(skill, lang);

const text = lang === "zh-cn" ? {
  home: "首页", list: "QA 技能库", consoleName: "Skill 详情", skillDetail: "技能详情",
  source: "GitHub 源码", sourceSkill: "源 SKILL.md", useNow: "立即使用", copyPrompt: "复制调用示例",
  copy: "复制", copied: "已复制", copyFailed: "复制失败，请手动复制", synced: "同步日期", noSyncDate: "暂无同步日期",
  status: "状态", stable: "稳定", type: "类型", domain: "领域", sdlc: "生命周期", roles: "适合角色",
  language: "语言", languageValue: "中文 / 英文", evals: "评测", evalsAvailable: "有评测 ✓", noEvals: "暂无评测",
  install: "安装命令", shell: "SHELL", problem: "解决什么问题", recommended: "适用场景", recommendedLabel: "推荐使用",
  notRecommended: "不建议直接使用", input: "输入", minimum: "最低输入",
  recommendedInput: "推荐输入", optional: "可选上下文", output: "输出",
  outputHint: "不安装也能判断输出价值", preview: "输出预览", priority: "优先级",
  finding: "发现", evidence: "证据", impact: "影响", action: "行动", example: "真实示例", before: "输入",
  runSkill: "调用", after: "结果", fullExample: "查看完整示例", howItWorks: "工作原理",
  workflow: "Skill 工作流", workflowHint: "当前 Skill 在质量工作流中的位置",
  info: "Skill 信息", examples: "示例", related: "相关 Skill", beforeSkill: "前置 Skill",
  noPrerequisite: "无需前置 Skill", deepen: "深入分析", continueTo: "下一步", similar: "相似 Skill",
  purpose: "主要解决的问题", timing: "推荐时机", quickStart: "安装与快速开始",
  promptTab: "Prompt", skillMdTab: "SKILL.md", moreDetails: "更多详情", outputFull: "查看完整输出结构", advanced: "高级用法",
  deepDive: "深入阅读", resources: "资源", sourceFiles: "源文件", references: "参考资料", agentConfig: "Agent 配置",
  noContent: "当前 Skill 暂无可展示内容。", notProvided: "未单独定义", relatedHint: "继续探索相邻的质量能力。", nextSkill: "下一步 Skill",
  nextHint: "完成需求分析后，继续进入下一步质量活动。", noMatch: "暂无可用 Skill",
  rawMissing: "暂无源文件预览，请打开 GitHub 查看。", onThisPage: "本页导航", categoryType: "测试类型",
  categoryWorkflow: "工作流", categoryPlus: "增强 Skill", skillAttributes: "技能属性", heroCommand: "调用入口", heroCommandKind: "调用命令", heroCommandHint: "在 Codex 中输入以下命令即可开始使用。",
  prompt: `@skill ${skill.slug}\n\n${skill.slug === "requirements-analysis" ? "分析这个需求，识别业务规则、边界、依赖、信息缺口和质量风险。\n\n需求：\n[粘贴需求内容]" : "结合当前项目上下文，按该 Skill 的要求给出可执行结果。\n\n补充上下文：\n[粘贴项目背景或需求]"}`,
} : {
  home: "Home", list: "QA Skills", consoleName: "Skill Detail", skillDetail: "SKILL DETAIL", source: "GitHub source",
  sourceSkill: "Source SKILL.md", useNow: "Use now", copyPrompt: "Copy call example", copy: "Copy", copied: "Copied",
  copyFailed: "Copy failed. Please copy manually.", synced: "Synced", noSyncDate: "No sync date", status: "Status",
  stable: "Stable", type: "Type", domain: "Domain", sdlc: "SDLC", roles: "Good for", language: "Language",
  languageValue: "Chinese / English", evals: "Evals", evalsAvailable: "Evals ✓", noEvals: "No evals yet",
  install: "Install command", shell: "SHELL", problem: "Why this Skill", recommended: "When to use", recommendedLabel: "Use this Skill",
  notRecommended: "When not to use", input: "Input", minimum: "Minimum Input",
  recommendedInput: "Recommended Input", optional: "Optional Context", output: "Output",
  outputHint: "Judge the output value before installing", preview: "Output preview",
  priority: "Priority", finding: "Finding", evidence: "Evidence", impact: "Impact", action: "Action", example: "Real example",
  before: "Before", runSkill: "Run Skill", after: "After", fullExample: "View full example", howItWorks: "How It Works",
  workflow: "Skill Workflow", workflowHint: "Where this Skill sits in the quality workflow",
  info: "Skill information", examples: "Examples", related: "Related Skills", beforeSkill: "Before This Skill",
  noPrerequisite: "No prerequisite Skill required", deepen: "Deepen the Analysis", continueTo: "Continue To", similar: "Similar Skills",
  purpose: "Main problem solved", timing: "Recommended timing", quickStart: "Install & Quick Start",
  promptTab: "Prompt", skillMdTab: "SKILL.md", moreDetails: "More details", outputFull: "View full output structure", advanced: "Advanced",
  deepDive: "Deep dive", resources: "Resources", sourceFiles: "Source files", references: "References", agentConfig: "Agent config",
  noContent: "No content is available for this Skill yet.", notProvided: "Not specified", relatedHint: "Continue exploring adjacent quality capabilities.", nextSkill: "Next Skill",
  nextHint: "After requirements analysis, continue to the next quality activity.", noMatch: "No matching Skill available",
  rawMissing: "Raw preview unavailable. Open GitHub instead.", onThisPage: "On this page", categoryType: "Testing type",
  categoryWorkflow: "Workflow", categoryPlus: "Enhanced Skill", skillAttributes: "Skill attributes", heroCommand: "Call this Skill", heroCommandKind: "Command", heroCommandHint: "Enter this command in Codex to start.",
  prompt: `@skill ${skill.slug}\n\n${skill.slug === "requirements-analysis" ? "Analyze this requirement. Identify business rules, boundaries, dependencies, information gaps, and quality risks.\n\nRequirement:\n[Paste requirement here]" : "Using the current project context, produce an actionable result following this Skill.\n\nAdditional context:\n[Paste project context or requirement]"}`,
};

const summary = getQASkillCardSummary(skill, lang);
const localizedDescription = (lang === "zh-cn" ? localizedIntro || skill.description || skill.title : skill.description || localizedIntro || skill.title).trim();
const heroIntro = /当前质量任务|current quality task/i.test(localizedDescription) && summary.whenToUse
  ? summary.whenToUse
  : localizedDescription;
const configuredDetail = getQASkillDetailData(skill.slug);
  const genericDetail = buildGenericQASkillDetailData({
    skill,
  lang,
  summary,
  relatedSlugs: related.map((item) => item.slug),
});
const local = <T,>(value: Record<Lang, T>): T => value[lang];
const detailSource = configuredDetail ?? genericDetail;
const detail = {
  domain: local(detailSource.domain), sdlc: local(detailSource.sdlc), type: local(detailSource.type),
  status: local(detailSource.status), problemValue: local(detailSource.problemValue), outputSummary: local(detailSource.outputSummary),
  notRecommendedLabel: local(detailSource.notRecommendedLabel), roles: local(detailSource.roles), problem: local(detailSource.problem),
  whenToUse: local(detailSource.whenToUse), whenNotToUse: local(detailSource.whenNotToUse),
  input: { minimum: local(detailSource.input.minimum), recommended: local(detailSource.input.recommended), optional: local(detailSource.input.optional) },
  outputSections: local(detailSource.outputSections),
  outputPreview: detailSource.outputPreview.map((row) => ({ priority: row.priority, finding: local(row.finding), evidence: local(row.evidence), impact: local(row.impact), action: local(row.action) })),
  example: detailSource.example ? { before: local(detailSource.example.before), run: local(detailSource.example.run), after: local(detailSource.example.after), full: local(detailSource.example.full) } : null,
  howItWorks: local(detailSource.howItWorks), workflow: detailSource.workflow, relations: detailSource.relations, similarNotes: detailSource.similarNotes,
};
const problemItems = configuredDetail
  ? detail.problem
  : detail.problem.filter((item) => item.trim() !== heroIntro.trim());

const skillMap = new Map(allSkills.map((item) => [item.slug, item]));
const relationCards = (slugs: string[]) => slugs.map((slug) => skillMap.get(slug)).filter(Boolean).map((item) => ({ slug: item!.slug, name: lang === "zh-cn" ? (item!.chineseName || item!.title) : item!.title, intro: getQASkillCardIntro(item!, lang) }));
const beforeCards = relationCards(detail.relations.before);
const deepenCards = relationCards(detail.relations.deepen);
const continueCards = relationCards(detail.relations.continueTo);
const similarCards = relationCards(detail.relations.similar);
const outputHighlights = detail.outputSections.slice(0, 4);
const outputMore = detail.outputSections.slice(4);
const relatedPreviewCards = [
  ...beforeCards.slice(0, 1).map((item) => ({ item, kind: text.beforeSkill })),
  ...deepenCards.slice(0, 1).map((item) => ({ item, kind: text.deepen })),
  ...continueCards.slice(0, 1).map((item) => ({ item, kind: text.continueTo })),
  ...similarCards.map((item) => ({ item, kind: text.similar })),
].filter((entry, index, entries) => entries.findIndex((candidate) => candidate.item.slug === entry.item.slug) === index).slice(0, 6);
const relationDescription = (item: { slug: string; intro: string }, kind: string) => {
  const notes = kind === text.similar ? configuredDetail?.similarNotes[item.slug] : undefined;
  return notes ? `${local(notes.problem)} · ${local(notes.timing)}` : item.intro;
};

const installerLang = lang === "zh-cn" ? "zh" : "en";
const skillKindMatch = (skill.sourceSkillUrl || "").match(/\/skills\/(?:zh|en)\/(testing-types|testing-workflows|skill-engineering)\//);
const skillKind = skillKindMatch?.[1] || (skill.category === "workflow" ? "testing-workflows" : "testing-types");
const installTarget = `https://github.com/naodeng/awesome-qa-skills/tree/main/skills/${installerLang}/${skillKind}/${skill.slug}`;
const npxInstallCommand = `npx skills add https://github.com/naodeng/awesome-qa-skills/tree/main/skills/${installerLang}/${skillKind}/${skill.slug} -g`;
const npxInstallCommandDisplay = ["npx skills add \\", `  ${installTarget}`, "  -g"].join("\n");
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";
const canonicalUrl = `${siteOrigin}${getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`)}`;
const pageLocale = (lang === "zh-cn" ? "zh-cn" : "en") as "en" | "zh-cn";
const pageTitle = lang === "zh-cn" ? `${displayName} - 软件测试技能库` : `${displayName} - QA Skill Library`;
const pageDescription = localizedDescription.length < 80
  ? lang === "zh-cn" ? `${localizedDescription} 提供可直接使用的安装、调用、输入输出与人工复核说明。` : `${localizedDescription} Includes practical installation, input, output, and human-review guidance.`
  : localizedDescription;
const pageKeywords = [skill.title, skill.chineseName, detail.domain, lang === "zh-cn" ? "软件测试技能库" : "QA skill library"].filter(Boolean).join(", ");
const skillSchema = { "@context": "https://schema.org", "@type": "TechArticle", headline: displayName, description: pageDescription, url: canonicalUrl, inLanguage: lang === "zh-cn" ? "zh-CN" : "en", dateModified: skill.updatedAt || undefined, author: { "@type": "Person", name: skill.author || "naodeng" }, publisher: { "@type": "Organization", name: "naodeng", url: siteOrigin }, mainEntityOfPage: canonicalUrl };
const tocHeadings = [
  { slug: "section-problem", text: text.problem }, { slug: "section-when", text: text.recommended }, { slug: "section-input", text: text.input }, { slug: "section-output", text: text.output },
  ...(detail.outputPreview.length ? [{ slug: "section-output-preview", text: text.preview }] : []), ...(detail.example ? [{ slug: "section-real-example", text: text.example }] : []),
  ...(detail.howItWorks.length ? [{ slug: "section-how-it-works", text: text.howItWorks }] : []),
  { slug: "quick-start", text: text.quickStart }, { slug: "section-related-skills", text: text.related },
];
---

<Base
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  breadcrumbs={[
    { name: text.home, url: getRelativeLocaleUrl(lang, "/") },
    { name: text.list, url: getRelativeLocaleUrl(lang, "/qaskills/") },
    { name: displayName, url: getRelativeLocaleUrl(lang, `/qaskills/${skill.slug}/`) },
  ]}
  extraStructuredData={[skillSchema]}
>
  <article class="qaskill-detail skill-console">
    <header class="console-hero">
      <div class="console-hero-main">
        <div class="console-hero-copy">
          <p class="console-kicker">{text.skillDetail}</p>
          <h1 aria-label={displayName}>{heroTitleLines.map((line) => <span class="console-hero-title-line">{line}</span>)}</h1>
          {secondaryName && <p class="console-hero-alias">{secondaryName}</p>}
          <p class="console-hero-intro">{heroIntro}</p>
          <div class="console-actions">
            <a href="#quick-start" class="console-button console-button--primary" data-use-now>{text.useNow} <span aria-hidden="true">→</span></a>
            {skill.sourceSkillUrl && <a class="console-source-link" href={skill.sourceSkillUrl} target="_blank" rel="noopener noreferrer">{text.source} ↗</a>}
          </div>
        </div>
        <div class="console-hero-side">
          <aside class="console-hero-command" aria-label={text.heroCommand}>
            <div class="console-hero-command-meta">
              <span class="console-hero-command-meta-label">{text.skillAttributes}</span>
              <div class="console-tag-row" aria-label={text.skillAttributes}><span class="tag">{detail.domain}</span><span class="tag">{detail.sdlc}</span><span class="tag">{detail.type}</span></div>
            </div>
            <div class="console-hero-command-head"><span>{text.heroCommand}</span><span class="console-hero-command-kind">{text.heroCommandKind}</span></div>
            <pre><code>@skill {skill.slug}</code></pre>
            <p>{text.heroCommandHint}</p>
          </aside>
        </div>
      </div>
    </header>

    <section class="console-info-strip" id="skill-info-strip" aria-label={text.info}>
      <div><span>{text.status}</span><strong>{detail.status}</strong></div><div><span>{text.type}</span><strong>{detail.type}</strong></div><div><span>{text.domain}</span><strong>{detail.domain}</strong></div><div><span>{text.sdlc}</span><strong>{detail.sdlc}</strong></div><div><span>{text.roles}</span><strong>{detail.roles.length ? detail.roles.join(" / ") : text.notProvided}</strong></div><div><span>{text.language}</span><strong>{text.languageValue}</strong></div><div><span>{text.evals}</span><strong>{skill.hasEvals ? text.evalsAvailable : text.noEvals}</strong></div><div><span>{text.synced}</span><strong>{skill.updatedAt || text.noSyncDate}</strong></div>
    </section>

    <nav class="detail-nav" id="skill-elevator" aria-label={text.onThisPage}><p class="elevator-title">{text.onThisPage}</p><ul class="elevator-list">{tocHeadings.map((item) => <li><a class="elevator-link" href={`#${item.slug}`} data-elevator-target={item.slug}>{item.text}</a></li>)}</ul></nav>

    <div class="detail-layout">
      <main class="detail-main">
        <div class="console-grid">
          <section class="console-panel console-panel--wide" id="section-problem">
            <div class="console-panel-head"><h2>{text.problem}</h2></div>
            <div class="problem-layout"><div class="problem-lead">{configuredDetail && <p>{localizedDescription}</p>}<p class="problem-value">{detail.problemValue}</p></div><ul class="problem-list">{problemItems.map((item) => <li>{item}</li>)}</ul></div>
          </section>

          <section class="console-panel console-panel--wide" id="section-when">
            <div class="console-panel-head"><h2>{text.recommended}</h2></div>
            <div class="decision-grid"><div class="decision-card decision-card--yes"><span>{text.recommendedLabel}</span><ul>{detail.whenToUse.map((item) => <li>{item}</li>)}</ul></div><div class="decision-card decision-card--no"><span>{detail.notRecommendedLabel}</span><ul>{detail.whenNotToUse.length ? detail.whenNotToUse.map((item) => <li>{item}</li>) : <li>{text.noContent}</li>}</ul></div></div>
          </section>

          <section class="console-panel console-panel--wide" id="section-input">
            <div class="console-panel-head"><h2>{text.input}</h2></div>
            <div class="contract-grid"><div class="contract-card contract-card--required"><span>{text.minimum}</span><ul>{detail.input.minimum.map((item) => <li>{item}</li>)}</ul></div><div class="contract-card"><span>{text.recommendedInput}</span><ul>{detail.input.recommended.length ? detail.input.recommended.map((item) => <li>{item}</li>) : <li>{text.noContent}</li>}</ul></div><div class="contract-card"><span>{text.optional}</span><ul>{detail.input.optional.length ? detail.input.optional.map((item) => <li>{item}</li>) : <li>{text.noContent}</li>}</ul></div></div>
          </section>

          <section class="console-panel console-panel--wide" id="section-output">
            <div class="console-panel-head"><h2>{text.output}</h2></div>
            <div class="output-layout"><div class="output-summary"><p>{detail.outputSummary}</p><p class="output-hint">{text.outputHint}</p></div><div><ol class="output-sections">{outputHighlights.map((item, index) => <li><b>{String(index + 1).padStart(2, "0")}</b><span>{item}</span></li>)}</ol>{outputMore.length > 0 && <details class="output-more"><summary>{text.outputFull}<span aria-hidden="true">↗</span></summary><ol class="output-sections output-sections--more">{outputMore.map((item, index) => <li><b>{String(index + outputHighlights.length + 1).padStart(2, "0")}</b><span>{item}</span></li>)}</ol></details>}</div></div>
          </section>

          {detail.outputPreview.length > 0 && <section class="console-panel console-panel--wide" id="section-output-preview"><div class="console-panel-head"><h2>{text.preview}</h2></div><div class="preview-table" role="table" aria-label={text.preview}><div class="preview-row preview-row--head" role="row"><span role="columnheader">{text.priority}</span><span role="columnheader">{text.finding}</span><span role="columnheader">{text.evidence}</span><span role="columnheader">{text.impact}</span><span role="columnheader">{text.action}</span></div>{detail.outputPreview.map((row) => <div class="preview-row" role="row"><strong role="cell" class:list={["priority", `priority--${row.priority.toLowerCase()}`]} data-label={text.priority}>{row.priority}</strong><span role="cell" data-label={text.finding}>{row.finding}</span><span role="cell" data-label={text.evidence}>{row.evidence}</span><span role="cell" data-label={text.impact}>{row.impact}</span><span role="cell" data-label={text.action}>{row.action}</span></div>)}</div></section>}

          {detail.example && <section class="console-panel console-panel--wide" id="section-real-example"><div class="console-panel-head"><h2>{text.example}</h2></div><div class="example-flow"><div class="example-step"><span>{text.before}</span><p>{detail.example.before}</p></div><div class="example-step"><span>{text.runSkill}</span><pre><code>{detail.example.run}</code></pre></div><div class="example-step example-step--after"><span>{text.after}</span><ul>{detail.example.after.map((item) => <li><b>{item.label}</b><span>{item.value}</span></li>)}</ul></div></div></section>}

          {detail.howItWorks.length > 0 && <section class="console-panel console-panel--wide" id="section-how-it-works"><div class="console-panel-head"><h2>{text.howItWorks}</h2></div><ol class="how-it-works">{detail.howItWorks.map((step, index) => <li><b>{String(index + 1).padStart(2, "0")}</b><span>{step}</span></li>)}</ol></section>}

        </div>

        <section class="console-panel console-panel--wide console-panel--quick" id="quick-start" tabindex="-1"><div class="console-panel-head"><h2>{text.quickStart}</h2></div><div class="quick-install-block" id="install-section"><div class="quick-install-top"><span>{text.install} / {text.shell}</span><button type="button" data-copy={npxInstallCommand}>{text.copy}</button></div><pre><code id="npx-install-code">{npxInstallCommandDisplay}</code></pre></div><div class="quick-start-tabs" role="tablist" aria-label={text.quickStart}><button type="button" id="quick-tab-prompt" role="tab" aria-selected="true" aria-controls="quick-prompt" data-doc-tab="prompt">{text.promptTab}</button><button type="button" id="quick-tab-skill" role="tab" aria-selected="false" aria-controls="quick-skill-md" data-doc-tab="skill">{text.skillMdTab}</button></div><div class="quick-doc-card"><div class="quick-doc-top"><span data-doc-title>{skill.slug}.prompt</span><button type="button" data-doc-copy>{text.copy}</button></div><div id="quick-prompt" class="quick-doc-panel" data-doc-panel="prompt" role="tabpanel" aria-labelledby="quick-tab-prompt" tabindex="0"><pre><code>{text.prompt}</code></pre></div><div id="quick-skill-md" class="quick-doc-panel" data-doc-panel="skill" role="tabpanel" aria-labelledby="quick-tab-skill" tabindex="0" hidden><div class="raw-wrap">{skill.rawSkillMarkdown ? <pre class="skill-raw"><code id="raw-skill-code">{skill.rawSkillMarkdown}</code></pre> : <p class="console-empty">{text.rawMissing}</p>}</div></div></div></section>

        <section class="console-panel console-panel--wide" id="section-related-skills"><div class="console-panel-head"><h2>{text.related}</h2></div>{detail.workflow.length > 1 && <div class="related-workflow" id="section-workflow"><div class="related-subhead"><span>{text.workflow}</span><small>{text.workflowHint}</small></div><ol class="workflow-track">{detail.workflow.map((slug, index) => { const item = skillMap.get(slug); const label = item ? (lang === "zh-cn" ? (item.chineseName || item.title) : item.title) : slug; return <li class:list={[slug === skill.slug && "is-current"]}>{item ? <a href={getRelativeLocaleUrl(lang, `/qaskills/${slug}/`)}>{label}</a> : <span>{label}</span>}{index < detail.workflow.length - 1 && <b aria-hidden="true">→</b>}</li>; })}</ol></div>}{relatedPreviewCards.length ? <div class="related-preview-grid">{relatedPreviewCards.map(({ item, kind }) => <a class="relation-card" href={getRelativeLocaleUrl(lang, `/qaskills/${item.slug}/`)}><span class="relation-card-kind">{kind}</span><b>{item.name}</b><small>{relationDescription(item, kind)}</small></a>)}</div> : <p class="relation-empty">{text.noMatch}</p>}</section>
      </main>

    </div>

    <ArticleShare title={displayName} url={canonicalUrl} locale={pageLocale} showLabel={false} />
    <Giscus lang={lang === "zh-cn" ? "zh-CN" : "en"} theme="preferred_color_scheme" inputPosition="bottom" reactionsEnabled={true} loading="eager" />
  </article>
</Base>

<script is:inline define:vars={{ copiedLabel: text.copied, copyLabel: text.copy, copyFailedLabel: text.copyFailed }}>
  (() => {
    const root = document.querySelector(".skill-console");
    if (!root) return;
    const docTabs = Array.from(root.querySelectorAll("[data-doc-tab]"));
    const docPanels = Array.from(root.querySelectorAll("[data-doc-panel]"));
    const docTitle = root.querySelector("[data-doc-title]");
    const docCopyButton = root.querySelector("[data-doc-copy]");
    const promptTitle = docTitle?.textContent || "prompt";
    const quickStart = root.querySelector("#quick-start");
    const applyDoc = (doc) => {
      const selected = doc === "skill" ? "skill" : "prompt";
      docTabs.forEach((tab) => { const isSelected = tab.getAttribute("data-doc-tab") === selected; tab.setAttribute("aria-selected", String(isSelected)); tab.setAttribute("tabindex", isSelected ? "0" : "-1"); });
      docPanels.forEach((panel) => { panel.hidden = panel.getAttribute("data-doc-panel") !== selected; });
      if (docTitle) docTitle.textContent = selected === "skill" ? "SKILL.md" : promptTitle;
      if (docCopyButton) { const content = selected === "skill" ? root.querySelector("#raw-skill-code")?.textContent || "" : root.querySelector("#quick-prompt code")?.textContent || ""; docCopyButton.setAttribute("data-copy", content); docCopyButton.textContent = copyLabel; }
    };
    docTabs.forEach((tab) => {
      tab.addEventListener("click", () => applyDoc(tab.getAttribute("data-doc-tab") || "prompt"));
      tab.addEventListener("keydown", (event) => { const currentIndex = docTabs.indexOf(tab); if (currentIndex < 0) return; let nextIndex = currentIndex; if (event.key === "ArrowRight" || event.key === "ArrowDown") nextIndex = (currentIndex + 1) % docTabs.length; if (event.key === "ArrowLeft" || event.key === "ArrowUp") nextIndex = (currentIndex - 1 + docTabs.length) % docTabs.length; if (event.key === "Home") nextIndex = 0; if (event.key === "End") nextIndex = docTabs.length - 1; if (nextIndex === currentIndex) return; event.preventDefault(); const nextTab = docTabs[nextIndex]; nextTab.focus(); applyDoc(nextTab.getAttribute("data-doc-tab") || "prompt"); });
    });
    applyDoc("prompt");
    const focusQuickStart = () => {
      if (!quickStart) return;
      const url = new URL(window.location.href);
      url.hash = "quick-start";
      window.history.replaceState({}, "", url);
      window.setTimeout(() => {
        const headerHeight = document.querySelector(".l-header")?.getBoundingClientRect().height || 0;
        const targetTop = quickStart.getBoundingClientRect().top + window.scrollY - headerHeight - 16;
        window.scrollTo({ top: Math.max(0, targetTop), behavior: "smooth" });
      }, 0);
      quickStart.classList.remove("is-highlighted");
      window.requestAnimationFrame(() => { quickStart.classList.add("is-highlighted"); quickStart.focus({ preventScroll: true }); });
      window.setTimeout(() => quickStart.classList.remove("is-highlighted"), 1800);
    };
    root.querySelector("[data-use-now]")?.addEventListener("click", (event) => { event.preventDefault(); applyDoc("prompt"); focusQuickStart(); });
    if (window.location.hash === "#quick-start") window.setTimeout(focusQuickStart, 0);
    const bindCopy = (button) => { button.addEventListener("click", async () => { const content = button.getAttribute("data-copy") || ""; if (!content) return; const defaultLabel = button.dataset.defaultLabel || button.textContent || copyLabel; button.dataset.defaultLabel = defaultLabel; try { await navigator.clipboard.writeText(content); button.textContent = copiedLabel; window.setTimeout(() => { button.textContent = defaultLabel; }, 1200); } catch { button.textContent = copyFailedLabel; window.setTimeout(() => { button.textContent = defaultLabel; }, 1200); } }); };
    root.querySelectorAll("[data-copy]").forEach(bindCopy);
    const elevatorLinks = Array.from(root.querySelectorAll("[data-elevator-target]"));
    const setActiveElevator = (slug) => { elevatorLinks.forEach((link) => { const active = link.getAttribute("data-elevator-target") === slug; link.classList.toggle("is-active", active); if (active) link.setAttribute("aria-current", "location"); else link.removeAttribute("aria-current"); }); };
    elevatorLinks.forEach((link) => link.addEventListener("click", () => setActiveElevator(link.getAttribute("data-elevator-target") || "")));
    const observed = elevatorLinks.map((link) => document.getElementById(link.getAttribute("data-elevator-target") || "")).filter(Boolean);
