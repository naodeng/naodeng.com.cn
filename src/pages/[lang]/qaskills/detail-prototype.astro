---
// PROTOTYPE — three throwaway UI directions for the Skill detail redesign.
// Switch with ?variant=a|b|c. This route is intentionally separate from the
// production detail page and should be removed after the winning direction is
// folded into [skillSlug].astro.
import Base from "@/layouts/Base.astro";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getQASkills } from "@/utils/qaskills";

export async function getStaticPaths() {
  return (["en", "zh-cn"] as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const isZh = lang === "zh-cn";
const skills = await getQASkills(lang);
const skillBySlug = new Map(skills.map((skill) => [skill.slug, skill]));
const mainSkill = skillBySlug.get("requirements-analysis");

if (!mainSkill) {
  throw new Error(`QASkill not found: ${lang}/requirements-analysis`);
}

const labelOf = (slug: string) => {
  const skill = skillBySlug.get(slug);
  return skill ? (isZh ? skill.chineseName || skill.title : skill.title) : slug;
};
const hrefOf = (slug: string) => getRelativeLocaleUrl(lang, `/qaskills/${slug}/`);
const sourceHref = mainSkill.sourceSkillUrl || mainSkill.sourceRepoUrl;
const displayName = isZh ? mainSkill.chineseName || mainSkill.title : mainSkill.title;
const installerLang = lang === "zh-cn" ? "zh" : "en";
const skillKind = mainSkill.sourceSkillUrl.match(/\/skills\/(?:zh|en)\/(testing-types|testing-workflows|skill-engineering)\//)?.[1]
  || (mainSkill.category === "workflow" ? "testing-workflows" : "testing-types");
const installCommand = `npx skills add https://github.com/naodeng/awesome-qa-skills/tree/main/skills/${installerLang}/${skillKind}/${mainSkill.slug} -g`;

const copy = isZh
  ? {
      prototype: "UI 原型 / 详情页基准",
      prototypeNote: "这是视觉确认用原型，不代表最终实现。使用底部切换器比较三种信息架构。",
      backToSkills: "返回 Skills",
      source: "GitHub 源码",
      install: "立即安装",
      useNow: "立即使用",
      copyPrompt: "复制调用示例",
      copied: "已复制",
      documented: "已文档化",
      statusLabel: "状态",
      readyState: "可使用",
      statusDetail: "安装命令已准备",
      evals: "Evals ✓",
      synced: "同步",
      consoleName: "Skill 控制台",
      prototypeVersion: "v0 / 原型",
      runbook: "运行手册",
      language: "语言",
      languageValue: "中文 · 英文",
      passReady: "通过 / 就绪",
      beforeTestDesign: "测试设计前",
      signal: "信号",
      routing: "路由",
      useLabel: "适用",
      avoidLabel: "不适用",
      inputRequired: "输入 / 必需",
      inputContext: "输入 / 上下文",
      outputReport: "输出 / 报告",
      contract: "契约",
      priority: "优先级",
      finding: "发现",
      action: "行动",
      report: "报告",
      preview: "预览",
      processLabel: "过程",
      replay: "复盘",
      graph: "流程",
      compare: "对比",
      execute: "执行",
      variantLabel: "原型方案",
      prototypeVariants: "原型方案切换",
      type: "类型",
      testingType: "测试类型",
      requirementQuality: "需求质量",
      what: "是什么",
      why: "为什么",
      when: "使用时机",
      whenNot: "不适用场景",
      input: "输入",
      output: "输出",
      example: "真实示例",
      how: "工作方式",
      workflow: "Skill 工作流",
      related: "相关 Skill",
      similar: "相似 Skill",
      quickStart: "快速开始",
      advanced: "高级用法",
      required: "最低输入",
      recommended: "推荐上下文",
      optional: "可选证据",
      confirmed: "已确认事实",
      assumption: "当前假设",
      missing: "信息缺口",
      before: "开始前",
      run: "运行 Skill",
      after: "运行后",
      use: "适合使用",
      avoid: "不建议直接使用",
      deepens: "深入分析",
      continueTo: "继续下一步",
      noPrerequisite: "不需要前置 Skill",
      copy: "复制",
      installTab: "安装命令",
      promptTab: "Prompt",
      skillMdTab: "SKILL.md",
      openSource: "打开源文件",
      sourceLabel: "来源",
      previous: "上一个方案",
      next: "下一个方案",
      variantA: "A · 实战指南",
      variantB: "B · 编辑分栏",
      variantC: "C · 操作控制台",
      prompt: `@skill requirements-analysis\n\n分析下面的需求。\n\n重点关注：\n- 业务规则\n- 边界条件\n- 状态变化\n- 外部依赖\n- 信息缺口\n- 潜在质量风险\n\n需求：\n[粘贴需求内容]`,
    }
  : {
      prototype: "UI Prototype / Golden Detail Page",
      prototypeNote: "Visual review prototype only. Use the switcher below to compare three information architectures.",
      backToSkills: "Back to Skills",
      source: "GitHub source",
      install: "Install now",
      useNow: "Use now",
      copyPrompt: "Copy call example",
      copied: "Copied",
      documented: "Documented",
      statusLabel: "Status",
      readyState: "READY",
      statusDetail: "Install command ready",
      evals: "Evals ✓",
      synced: "Synced",
      consoleName: "SKILL CONSOLE",
      prototypeVersion: "v0 / PROTOTYPE",
      runbook: "RUNBOOK",
      language: "LANG",
      languageValue: "ZH · EN",
      passReady: "PASS / READY",
      beforeTestDesign: "BEFORE TEST DESIGN",
      signal: "signal",
      routing: "routing",
      useLabel: "USE",
      avoidLabel: "AVOID",
      inputRequired: "IN / REQUIRED",
      inputContext: "IN / CONTEXT",
      outputReport: "OUT / REPORT",
      contract: "contract",
      priority: "PRI",
      finding: "FINDING",
      action: "ACTION",
      report: "report",
      preview: "Preview",
      processLabel: "PROCESS",
      replay: "replay",
      graph: "graph",
      compare: "compare",
      execute: "execute",
      variantLabel: "Prototype variant",
      prototypeVariants: "Prototype variants",
      type: "Type",
      testingType: "Testing type",
      requirementQuality: "Requirement quality",
      what: "What",
      why: "Why",
      when: "When",
      whenNot: "When not",
      input: "Input",
      output: "Output",
      example: "Real Example",
      how: "How it works",
      workflow: "Skill workflow",
      related: "Related skills",
      similar: "Similar skills",
      quickStart: "Quick start",
      advanced: "Advanced",
      required: "Minimum input",
      recommended: "Recommended context",
      optional: "Optional evidence",
      confirmed: "Confirmed",
      assumption: "Assumption",
      missing: "Missing",
      before: "Before",
      run: "Run Skill",
      after: "After",
      use: "Use it when",
      avoid: "Do not use it directly for",
      deepens: "Deepen the analysis",
      continueTo: "Continue to",
      noPrerequisite: "No prerequisite Skill required",
      copy: "Copy",
      installTab: "Install command",
      promptTab: "Prompt",
      skillMdTab: "SKILL.md",
      openSource: "Open source file",
      sourceLabel: "Source",
      previous: "Previous variant",
      next: "Next variant",
      variantA: "A · Field Guide",
      variantB: "B · Editorial Split",
      variantC: "C · Operator Console",
      prompt: `@skill requirements-analysis\n\nAnalyze the requirement below.\n\nFocus on:\n- business rules\n- boundary conditions\n- state changes\n- external dependencies\n- information gaps\n- quality risks\n\nRequirement:\n[Paste requirement here]`,
    };

const content = isZh
  ? {
      intro: "在测试设计之前，把需求拆成范围、规则、边界、依赖、信息缺口和质量风险。",
      problemLead: "很多测试问题并不是用例写得不够多，而是需求从未被整理成可验证的结构。",
      problem: [
        "正常流程明确，异常流程却没有定义。",
        "状态变化、边界条件和外部依赖散落在不同文档里。",
        "Acceptance Criteria 无法直接转成验证动作。",
      ],
      use: ["新需求进入 Refinement", "PRD / User Story 初步完成", "开始测试分析之前", "需求发生重大变化"],
      avoid: ["只需要生成 Test Case", "单纯分析 PR Diff", "单纯排查生产事故", "单纯执行 Regression"],
      input: {
        required: ["Requirement / User Story", "当前变更目标"],
        recommended: ["PRD", "Acceptance Criteria", "Business Rules", "API Specification"],
        optional: ["UI / Prototype", "Architecture", "Existing Test Cases", "Historical Defects"],
      },
      output: ["Scope Summary", "Business Rules", "Main / Exception Flow", "State Changes", "Boundaries", "Dependencies", "Missing Information", "Quality Risks"],
      preview: [
        ["P0", "升级失败后的会员状态未定义", "AC-03", "状态可能不一致", "PM 明确失败规则"],
        ["P1", "外部权益接口超时行为未知", "API Spec", "无法设计恢复场景", "Dev 补充 Timeout 策略"],
        ["P1", "10,000 元边界未明确", "PRD", "边界测试无法确定", "明确 >= / >"],
      ],
      example: {
        before: "新增会员等级自动升级功能。Gold 用户累计消费达到 10,000 元后，自动升级为 Platinum，并立即获得 Platinum 权益。",
        run: "提取业务规则、状态变化、边界、依赖和信息缺口，并按风险排序。",
        after: "识别出 Gold → Platinum、9,999.99 / 10,000.00 / 10,000.01 三个边界，以及“等级已升级但权益发放失败”的 P0 风险。",
      },
      how: ["理解上下文", "提取业务规则", "识别流程 / 状态", "识别边界条件", "发现信息缺口", "按优先级梳理质量风险"],
      workflow: ["requirements-analysis", "requirement-gap-analysis", "testability-analysis", "quality-risk-analysis", "test-strategy", "test-case-writing"],
      deepens: ["requirement-gap-analysis", "testability-analysis", "quality-risk-analysis"],
      continueTo: ["test-strategy", "test-case-writing"],
      similar: [
        ["requirement-gap-analysis", "找遗漏、冲突", "深入 Review"],
        ["testability-analysis", "判断是否容易验证", "开始测试设计前"],
        ["acceptance-criteria-review", "检查 AC 是否可验收", "Story Refinement"],
      ],
    }
  : {
      intro: "Turn requirements into scope, rules, boundaries, dependencies, gaps, and quality risks before test design.",
      problemLead: "Many test problems are not caused by too few cases. The requirement was never shaped into something verifiable.",
      problem: [
        "The happy path is clear while exception behavior is undefined.",
        "State changes, boundaries, and dependencies are scattered across documents.",
        "Acceptance Criteria cannot be translated directly into verification actions.",
      ],
      use: ["A new requirement enters refinement", "A PRD / user story is taking shape", "Before test analysis begins", "A requirement changes materially"],
      avoid: ["You only need test cases", "You are reviewing a PR diff", "You are investigating a production incident", "You only need regression execution"],
      input: {
        required: ["Requirement / User Story", "Current change goal"],
        recommended: ["PRD", "Acceptance Criteria", "Business Rules", "API Specification"],
        optional: ["UI / Prototype", "Architecture", "Existing Test Cases", "Historical Defects"],
      },
      output: ["Scope Summary", "Business Rules", "Main / Exception Flow", "State Changes", "Boundaries", "Dependencies", "Missing Information", "Quality Risks"],
      preview: [
        ["P0", "Membership state after upgrade failure is undefined", "AC-03", "State may diverge", "PM defines failure rule"],
        ["P1", "Timeout behavior for benefits API is unknown", "API Spec", "Recovery cases cannot be designed", "Dev defines timeout policy"],
        ["P1", "10,000 boundary is ambiguous", "PRD", "Boundary test is undecidable", "Clarify >= / >"],
      ],
      example: {
        before: "Add automatic membership upgrades. When a Gold user reaches 10,000 in cumulative spend, upgrade them to Platinum and grant Platinum benefits immediately.",
        run: "Extract rules, state changes, boundaries, dependencies, and missing information, then prioritize by risk.",
        after: "The analysis surfaces Gold → Platinum, 9,999.99 / 10,000.00 / 10,000.01 boundaries, and the P0 risk of an upgraded member without benefits.",
      },
      how: ["Understand context", "Extract business rules", "Identify flow / state", "Identify boundaries", "Discover missing information", "Prioritize quality risk"],
      workflow: ["requirements-analysis", "requirement-gap-analysis", "testability-analysis", "quality-risk-analysis", "test-strategy", "test-case-writing"],
      deepens: ["requirement-gap-analysis", "testability-analysis", "quality-risk-analysis"],
      continueTo: ["test-strategy", "test-case-writing"],
      similar: [
        ["requirement-gap-analysis", "Find omissions and conflicts", "Deep review"],
        ["testability-analysis", "Judge whether behavior is verifiable", "Before test design"],
        ["acceptance-criteria-review", "Check whether AC is testable", "Story refinement"],
      ],
    };

const breadcrumbs = [
  { name: isZh ? "首页" : "Home", url: getRelativeLocaleUrl(lang, "/") },
  { name: "QA Skills", url: getRelativeLocaleUrl(lang, "/qaskills/") },
  { name: `${displayName} · Prototype`, url: getRelativeLocaleUrl(lang, "/qaskills/detail-prototype/") },
];

const pageTitle = `${displayName} · UI Prototype`;
---

<Base
  title={pageTitle}
  description={copy.prototypeNote}
  breadcrumbs={breadcrumbs}
  robots="noindex, nofollow"
>
  <div class="skill-prototype" data-prototype-root data-lang={lang}>
    <aside class="prototype-banner" aria-label={copy.prototype}>
      <span class="prototype-kicker">Prototype</span>
      <p>{copy.prototypeNote}</p>
      <a href={getRelativeLocaleUrl(lang, "/qaskills/")}>{copy.backToSkills} ↗</a>
    </aside>

    <section class="variant variant-a is-active" data-variant-view="a" aria-label={copy.variantA}>
      <div class="a-page-grid">
        <aside class="a-rail">
          <p class="rail-mark">QA<br />FIELD<br />GUIDE</p>
          <div class="rail-rule"></div>
          <p class="rail-caption">01 / {copy.requirementQuality}</p>
          <div class="rail-stamp">{copy.documented}</div>
        </aside>

        <div class="a-content">
          <header class="a-hero">
            <div class="a-hero-topline">
              <span>SKILL / {mainSkill.slug}</span>
              <span>{copy.synced} {mainSkill.updatedAt || "—"}</span>
            </div>
            <div class="a-hero-body">
              <div>
                <p class="a-eyebrow">{copy.testingType} · {copy.requirementQuality}</p>
                <h1>{displayName}</h1>
                <p class="a-intro">{content.intro}</p>
              </div>
              <div class="a-hero-side">
                <p class="side-label">{copy.what}</p>
                <p>{content.problemLead}</p>
                <div class="a-hero-actions">
                  <a class="button button-primary" href="#a-quick-start">{copy.install} <span>↓</span></a>
                  <button class="button button-quiet" type="button" data-copy={copy.prompt}>{copy.copyPrompt}</button>
                </div>
              </div>
            </div>
            <div class="a-hero-meta">
              <span class="meta-token meta-token--solid">{copy.documented}</span>
              <span class="meta-token">{copy.evals}</span>
              <span class="meta-token">ZH · EN</span>
              <span class="meta-token">{copy.type} / {copy.testingType}</span>
              <a href={sourceHref} target="_blank" rel="noopener noreferrer">{copy.source} ↗</a>
            </div>
          </header>

          <div class="a-section-label"><span>01</span><span>{copy.why}</span></div>
          <section class="a-problem-block" id="a-problem">
            <div>
              <h2>{copy.why}</h2>
              <p>{content.problemLead}</p>
            </div>
            <ul class="signal-list">
              {content.problem.map((item) => <li><span class="signal-dot"></span>{item}</li>)}
            </ul>
          </section>

          <div class="a-section-label"><span>02</span><span>{copy.when}</span></div>
          <section class="a-decision-grid">
            <div class="decision-card decision-card--use">
              <div class="decision-card-head"><span>✓</span><h2>{copy.use}</h2></div>
              <ul>{content.use.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div class="decision-card decision-card--avoid">
              <div class="decision-card-head"><span>×</span><h2>{copy.avoid}</h2></div>
              <ul>{content.avoid.map((item) => <li>{item}</li>)}</ul>
            </div>
          </section>

          <div class="a-section-label"><span>03</span><span>{copy.input} → {copy.output}</span></div>
          <section class="a-contract-grid">
            <div class="contract-panel">
              <div class="contract-heading"><span class="contract-index">IN</span><h2>{copy.input}</h2></div>
              <div class="contract-group"><span class="contract-label contract-label--required">{copy.required}</span>{content.input.required.map((item) => <span class="contract-chip">{item}</span>)}</div>
              <div class="contract-group"><span class="contract-label">{copy.recommended}</span>{content.input.recommended.map((item) => <span class="contract-chip">{item}</span>)}</div>
              <div class="contract-group"><span class="contract-label contract-label--optional">{copy.optional}</span>{content.input.optional.map((item) => <span class="contract-chip">{item}</span>)}</div>
            </div>
            <div class="contract-panel contract-panel--output">
              <div class="contract-heading"><span class="contract-index">OUT</span><h2>{copy.output}</h2></div>
              <ol class="output-list">{content.output.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{item}</li>)}</ol>
            </div>
          </section>

          <section class="a-preview-block">
            <div class="preview-heading"><div><p class="a-eyebrow">{copy.output} / PREVIEW</p><h2>{copy.output} Preview</h2></div><span class="preview-note">{copy.confirmed} · {copy.assumption} · {copy.missing}</span></div>
            <div class="preview-table" role="table">
              <div class="preview-row preview-row--head" role="row"><span>PRIORITY</span><span>FINDING</span><span>EVIDENCE</span><span>IMPACT</span><span>ACTION</span></div>
              {content.preview.map((row) => <div class="preview-row" role="row">{row.map((cell, index) => <span class:list={[index === 0 && "priority-cell"]}>{cell}</span>)}</div>)}
            </div>
          </section>

          <section class="a-example-block" id="a-example">
            <div class="example-head"><p class="a-eyebrow">04 / {copy.example}</p><h2>{copy.example}</h2><span>Before → Run Skill → After</span></div>
            <div class="example-flow">
              <div class="example-step"><span class="step-number">01</span><p class="step-label">{copy.before}</p><p>{content.example.before}</p></div>
              <div class="example-arrow">→</div>
              <div class="example-step example-step--active"><span class="step-number">02</span><p class="step-label">{copy.run}</p><p>{content.example.run}</p></div>
              <div class="example-arrow">→</div>
              <div class="example-step"><span class="step-number">03</span><p class="step-label">{copy.after}</p><p>{content.example.after}</p></div>
            </div>
          </section>

          <section class="a-process-block" id="a-how">
            <div class="process-title"><p class="a-eyebrow">05 / {copy.how}</p><h2>{copy.how}</h2></div>
            <div class="process-track">{content.how.map((item, index) => <div class="process-node"><span>{String(index + 1).padStart(2, "0")}</span><strong>{item}</strong>{index < content.how.length - 1 && <i aria-hidden="true">↓</i>}</div>)}</div>
          </section>

          <section class="a-workflow-block" id="a-workflow">
            <div class="workflow-head"><div><p class="a-eyebrow">06 / {copy.workflow}</p><h2>{copy.workflow}</h2></div><span>Current Skill highlighted</span></div>
            <div class="workflow-line">{content.workflow.map((slug, index) => <a class:list={["workflow-node", slug === "requirements-analysis" && "workflow-node--current"]} href={hrefOf(slug)}><span>{String(index + 1).padStart(2, "0")}</span>{labelOf(slug)}</a>)}</div>
          </section>

          <section class="a-navigation-grid" id="a-related">
            <div class="navigation-column"><p class="a-eyebrow">07 / {copy.related}</p><h2>{copy.related}</h2><p class="muted-note">{copy.noPrerequisite}</p><div class="skill-link-list">{content.deepens.map((slug) => <a href={hrefOf(slug)}><span>→</span>{labelOf(slug)}<small>{copy.deepens}</small></a>)}</div></div>
            <div class="navigation-column"><p class="a-eyebrow">08 / {copy.continueTo}</p><h2>{copy.continueTo}</h2><div class="skill-link-list">{content.continueTo.map((slug) => <a href={hrefOf(slug)}><span>↳</span>{labelOf(slug)}<small>{copy.continueTo}</small></a>)}</div></div>
          </section>

          <section class="a-quick-start" id="a-quick-start">
            <div><p class="a-eyebrow">09 / {copy.quickStart}</p><h2>{copy.quickStart}</h2><p>{isZh ? "复制这段 Skill-specific Prompt，直接把需求交给 Agent。" : "Copy this Skill-specific prompt and give the requirement to your agent."}</p></div>
            <div class="prompt-card"><div class="prompt-card-top"><span>requirements-analysis.prompt</span><button type="button" data-copy={copy.prompt}>{copy.copy}</button></div><pre><code>{copy.prompt}</code></pre></div>
          </section>
        </div>
      </div>
    </section>

    <section class="variant variant-b" data-variant-view="b" aria-label={copy.variantB}>
      <div class="b-layout">
        <aside class="b-sidebar">
          <div class="b-sidebar-stamp">RQ<br /><span>01</span></div>
          <p class="b-sidebar-kicker">{copy.testingType}</p>
          <h1>{displayName}</h1>
          <p>{content.intro}</p>
          <div class="b-sidebar-actions"><a class="button button-primary" href="#b-quick-start">{copy.install}</a><button class="button button-quiet" type="button" data-copy={copy.prompt}>{copy.copyPrompt}</button></div>
          <dl class="b-facts"><div><dt>{copy.type}</dt><dd>{copy.testingType}</dd></div><div><dt>{copy.synced}</dt><dd>{mainSkill.updatedAt || "—"}</dd></div><div><dt>{copy.evals}</dt><dd>{copy.documented}</dd></div></dl>
          <a class="b-source-link" href={sourceHref} target="_blank" rel="noopener noreferrer">{copy.openSource} ↗</a>
        </aside>
        <main class="b-main">
          <div class="b-index-bar"><span>Requirements / Quality / Analysis</span><span>01—09</span></div>
          <section class="b-lead-section"><p class="b-overline">01 / {copy.why}</p><h2>{content.problemLead}</h2><div class="b-rule"></div><div class="b-two-col"><p>{isZh ? "详情页首先帮助人判断：这是不是当前真正需要的 Skill。" : "The detail page first helps a person decide whether this is the right Skill for the current moment."}</p><ul>{content.problem.map((item) => <li>{item}</li>)}</ul></div></section>
