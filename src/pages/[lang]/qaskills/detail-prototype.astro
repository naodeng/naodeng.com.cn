<script is:inline define:vars={{ copiedLabel: copy.copied, copyButtonLabel: copy.copy, promptText: copy.prompt, skillMarkdown: mainSkill.rawSkillMarkdown, variantLabels: { a: copy.variantA, b: copy.variantB, c: copy.variantC } }}>
  (() => {
    const root = document.querySelector("[data-prototype-root]");
    if (!root) return;
    const variants = ["a", "b", "c"];
    const labels = variantLabels;
    const views = Array.from(root.querySelectorAll("[data-variant-view]"));
    const label = root.querySelector("[data-variant-label]");
    const toast = root.querySelector("[data-prototype-toast]");
    const docTabs = Array.from(root.querySelectorAll("[data-doc-tab]"));
    const docPanels = Array.from(root.querySelectorAll("[data-doc-panel]"));
    const docTitle = root.querySelector("[data-doc-title]");
    const docCopyButton = root.querySelector(".c-doc-card [data-copy]");
    const quickStart = root.querySelector("#c-quick-start");
    const installCta = root.querySelector("[data-install-cta]");
    const getCurrent = () => new URL(window.location.href).searchParams.get("variant")?.toLowerCase();
    const applyVariant = (candidate, replace = false) => {
      const variant = variants.includes(candidate) ? candidate : "a";
      views.forEach((view) => view.classList.toggle("is-active", view.getAttribute("data-variant-view") === variant));
      if (label) label.textContent = labels[variant];
      if (replace) {
        const url = new URL(window.location.href);
        url.searchParams.set("variant", variant);
        window.history.replaceState({}, "", url);
      }
    };
    const cycle = (direction) => {
      const current = variants.indexOf(getCurrent() || "a");
      const next = variants[(current + direction + variants.length) % variants.length];
      applyVariant(next, true);
    };
    applyVariant(getCurrent() || "a");
    root.querySelector("[data-variant-prev]")?.addEventListener("click", () => cycle(-1));
    root.querySelector("[data-variant-next]")?.addEventListener("click", () => cycle(1));
    const applyDoc = (doc) => {
      docTabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.getAttribute("data-doc-tab") === doc)));
      docPanels.forEach((panel) => { panel.hidden = panel.getAttribute("data-doc-panel") !== doc; });
      if (docTitle) docTitle.textContent = doc === "skill" ? "SKILL.md" : "requirements-analysis.prompt";
      if (docCopyButton) docCopyButton.setAttribute("data-copy", doc === "skill" ? skillMarkdown : promptText);
    };
    docTabs.forEach((tab) => tab.addEventListener("click", () => applyDoc(tab.getAttribute("data-doc-tab") || "prompt")));
    applyDoc("prompt");
    installCta?.addEventListener("click", (event) => {
      event.preventDefault();
      applyDoc("prompt");
      const url = new URL(window.location.href);
      url.hash = "c-quick-start";
      window.history.replaceState({}, "", url);
      quickStart?.scrollIntoView({ behavior: "smooth", block: "start" });
      quickStart?.classList.remove("is-highlighted");
      window.requestAnimationFrame(() => {
        quickStart?.classList.add("is-highlighted");
        quickStart?.focus({ preventScroll: true });
      });
      window.setTimeout(() => quickStart?.classList.remove("is-highlighted"), 1800);
    });
    window.addEventListener("keydown", (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && (target.matches("input, textarea, [contenteditable='true']") || target.isContentEditable)) return;
      if (event.key === "ArrowLeft") cycle(-1);
      if (event.key === "ArrowRight") cycle(1);
    });
    root.querySelectorAll("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const content = button.getAttribute("data-copy") || "";
        try {
          await navigator.clipboard.writeText(content);
          button.textContent = copiedLabel;
          if (toast) toast.textContent = copiedLabel;
          window.setTimeout(() => {
            button.textContent = copyButtonLabel;
            if (toast) toast.textContent = "";
          }, 1200);
        } catch {
          if (toast) toast.textContent = content;
        }
      });
    });
  })();
</script>

