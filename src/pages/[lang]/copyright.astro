---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import PageHeadline from "@/components/PageHeadline.astro";
import { COPYRIGHT_PAGE_TITLE, SITE_TITLE } from "@/consts";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);
const title = t(COPYRIGHT_PAGE_TITLE);
const siteName = typeof SITE_TITLE === "string" ? SITE_TITLE : SITE_TITLE[locale];

const licenseUrl = "https://polyformproject.org/licenses/noncommercial/1.0.0/";
const legalCodeUrl = "https://github.com/naodeng/naodeng.com.cn/blob/main/LICENSE";

const introZh = `本站（${siteName}，inaodeng.com）原创内容采用 PolyForm Noncommercial License 1.0.0 进行许可：非商业使用（含个人学习、研究与非商业组织）免费，商业使用需单独授权。`;
const introEn = `Original content on this site (${siteName}, inaodeng.com) is licensed under the PolyForm Noncommercial License 1.0.0: noncommercial use (including personal study, research, and noncommercial organizations) is free; commercial use requires separate authorization.`;

const freeToZh = "您可以自由地：";
const freeToEn = "You are free to:";
const termsZh = "在遵守以下条款的前提下：";
const termsEn = "Under the following terms:";
const noticeZh = "本页仅为许可协议摘要，完整法律文本请参阅上述链接。本站不对许可条款提供法律建议。";
const noticeEn = "This page is a summary of the license. See the links above for the full legal code. This site does not provide legal advice.";

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({ params: { lang } }));
---

<Layout {title}>
  <PageHeadline {title} />

  <section class="copyright-section l-content">
    <p class="intro">{locale === "zh-cn" ? introZh : introEn}</p>

    <h2>{locale === "zh-cn" ? "许可协议概要" : "License Summary"}</h2>
    <ul class="license-list">
      <li><strong>{locale === "zh-cn" ? "非商业目的" : "Noncommercial purposes"}</strong>: {locale === "zh-cn" ? "任何非商业目的都是被允许的目的。" : "Any noncommercial purpose is a permitted purpose."}</li>
      <li><strong>{locale === "zh-cn" ? "个人使用" : "Personal uses"}</strong>: {locale === "zh-cn" ? "研究、实验、个人学习、爱好项目等没有商业应用预期的使用均为允许用途。" : "Personal use for research, experiment, study, hobby projects, and similar uses without anticipated commercial application is permitted."}</li>
      <li><strong>{locale === "zh-cn" ? "非商业组织" : "Noncommercial organizations"}</strong>: {locale === "zh-cn" ? "慈善组织、教育机构、公共研究机构、公共安全或健康机构、环保组织及政府机构的使用为允许用途。" : "Use by charitable, educational, public research, public safety or health, environmental, and government institutions is permitted."}</li>
    </ul>

    <h2>{locale === "zh-cn" ? freeToZh : freeToEn}</h2>
    <ul>
      <li><strong>{locale === "zh-cn" ? "复制与使用" : "Copy and use"}</strong>: {locale === "zh-cn" ? "为非商业目的复制、使用、修改本作品并基于其创作新作品" : "copy, use, modify, and build new works for noncommercial purposes"}</li>
      <li><strong>{locale === "zh-cn" ? "分发" : "Distribute"}</strong>: {locale === "zh-cn" ? "分发副本时必须附上许可条款或其 URL，以及 Required Notice 声明行" : "distribute copies only together with these terms (or their URL) and all Required Notice lines"}</li>
      <li>{locale === "zh-cn" ? "商业使用不在本许可范围内，需单独授权。" : "Commercial use is outside this license and requires separate authorization."}</li>
    </ul>

    <h2>{locale === "zh-cn" ? termsZh : termsEn}</h2>
    <p>{locale === "zh-cn" ? "详见 PolyForm 官方许可文本。软件按现状提供，无担保。" : "See the official PolyForm license text for full terms. The software comes as is, without warranty."}</p>

    <div class="license-links">
      <a href={licenseUrl} target="_blank" rel="noopener noreferrer" class="btn">
        {locale === "zh-cn" ? "PolyForm Noncommercial 1.0.0（官方文本）" : "PolyForm Noncommercial 1.0.0 (Official Text)"}
      </a>
      <a href={legalCodeUrl} target="_blank" rel="noopener noreferrer" class="btn secondary">
        {locale === "zh-cn" ? "仓库 LICENSE 文件" : "LICENSE in Repository"}
      </a>
    </div>

    <p class="notice">{locale === "zh-cn" ? noticeZh : noticeEn}</p>
  </section>
</Layout>

<style>
  .copyright-section {
    max-inline-size: 55rem; /* 880px，与博文详情页一致 */
    margin-inline: auto;
    padding-inline: var(--sp-m);
    padding-block-end: var(--sp-l);
  }
  .intro {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-block-end: var(--sp-m);
  }
  .copyright-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-block: var(--sp-m) var(--sp-s);
  }
  .copyright-section ul {
    padding-inline-start: 1.5rem;
    margin-block-end: var(--sp-m);
  }
  .copyright-section li {
    margin-block: 0.35rem 0;
    line-height: 1.55;
  }
  .license-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block: var(--sp-m);
  }
  .btn {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    background: var(--color-theme);
    color: var(--color-base);
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
  .btn.secondary {
    background: color-mix(in srgb, var(--color-theme) 15%, transparent);
    color: var(--color-main);
    border: 1px solid color-mix(in srgb, var(--color-theme) 35%, transparent);
  }
  .notice {
    font-size: 0.9rem;
    opacity: 0.85;
    margin-block-start: var(--sp-m);
  }
</style>
