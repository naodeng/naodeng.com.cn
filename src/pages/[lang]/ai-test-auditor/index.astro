---
import { LOCALES, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { AI_TEST_AUDITOR_SITE } from "@/data/aiTestAuditorSite";
export const getStaticPaths = () => Object.keys(LOCALES).map((lang) => ({ params: { lang } }));
const locale = Astro.currentLocale as Lang;
const site = AI_TEST_AUDITOR_SITE[locale];
const breadcrumbs = [{ name: locale === "zh-cn" ? "首页" : "Home", url: `/${locale}/` }, { name: "AI Test Auditor", url: `/${locale}/ai-test-auditor/` }];
---
<Layout title={site.meta.title} description={site.meta.description} breadcrumbs={breadcrumbs}>
  <main class="auditor-page">
    <section class="hero"><div><p class="eyebrow">{site.hero.eyebrow}</p><h1>{site.hero.title}</h1><p class="summary">{site.hero.summary}</p><div class="actions">{site.hero.actions.map((a) => <a class:list={['action', { primary: a.external }]} href={a.href} target={a.external ? '_blank' : undefined} rel={a.external ? 'noopener noreferrer' : undefined}>{a.label}<span>{a.external ? '↗' : '↓'}</span></a>)}</div></div><aside class="panel"><small>AI TEST / AUDIT</small><strong>FAKE · WEAK</strong><span>{locale === 'zh-cn' ? '证据先于信任，边界清晰才能做出更好的质量判断。' : 'Evidence before trust. Clear boundaries make better quality decisions.'}</span></aside></section>
    <section class="section"><p class="kicker">01 / {site.labels.features}</p><h2>{site.labels.features}</h2><div class="grid">{site.features.map((f) => <article><span class="material-icons-sharp icon">{f.icon}</span><h3>{f.title}</h3><p>{f.description}</p></article>)}</div></section>
    <section class="section"><p class="kicker">02 / {site.labels.rules}</p><h2>{site.labels.rules}</h2><div class="rules">{site.rules.map((r) => <article><strong class:list={['status', r.status.toLowerCase()]}>{r.status}</strong><div><h3>{r.title}</h3><p>{r.description}</p></div></article>)}</div></section>
    <section class="section"><p class="kicker">03 / {site.labels.install}</p><h2>{site.labels.install}</h2><div class="grid">{site.installModes.map((m) => <article id={m.id}><h3>{m.title}</h3><p>{m.description}</p><small class="command">{site.labels.commandLabel}</small>{m.commands.map((c) => <pre><code>{c}</code></pre>)}</article>)}</div></section>
    <section class="section"><p class="kicker">04 / {site.labels.ecosystem}</p><h2>{site.labels.ecosystem}</h2><div class="links">{site.ecosystemLinks.map((l) => <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>{l.label}<span>→</span></a>)}</div></section>
    <section class="section"><p class="kicker">05 / RELEASES</p><h2>{site.labels.releaseNotes}</h2><div class="releases">{site.releases.map((r) => <details><summary><span><strong>{r.version}</strong><time>{r.publishedAt}</time></span><span>{r.summary}</span></summary><div><ul>{r.changes.map((c) => <li>{c}</li>)}</ul><a href={r.url} target="_blank" rel="noopener noreferrer">{site.labels.releaseLink} ↗</a></div></details>)}</div></section>
  </main>
</Layout>
<style>
  .auditor-page{--ink:var(--color-main);--muted:color-mix(in srgb,var(--color-main) 72%,transparent);--line:color-mix(in srgb,var(--color-theme) 18%,transparent);max-width:72rem;margin:auto;padding:2rem var(--sp-m) 5rem;color:var(--ink)}.hero,.section{border:0;background:transparent}.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(15rem,.55fr);gap:2rem;padding:2.5rem 0 3rem;border-bottom:1px solid var(--line)}.eyebrow,.kicker,.command{color:var(--color-theme);font-size:.75rem;font-weight:800;letter-spacing:.14em}.hero h1,.section h2{margin:0;font-family:inherit}.hero h1{font-size:clamp(2.7rem,7vw,5.6rem);line-height:.95}.summary{max-width:42rem;margin:1.35rem 0 0;color:var(--muted);font-size:1.1rem;line-height:1.7}.actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.action,.links a,.releases a{display:inline-flex;justify-content:space-between;gap:.7rem;padding:.7rem 1rem;border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);text-decoration:none;font-weight:800}.action.primary,.action:hover,.links a:hover,.releases a:hover{background:var(--color-theme);color:var(--color-base)}.panel{align-self:center;display:grid;gap:.8rem;padding:1.25rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:color-mix(in srgb,var(--color-base) 96%,var(--color-theme))}.panel small,.panel strong{color:var(--color-theme)}.panel span,article p,time{color:var(--muted);line-height:1.55}.section{padding-top:3.5rem}.section h2{font-size:clamp(1.7rem,3vw,2.4rem)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.5rem}.grid article,.rules article,.releases details{padding:1.15rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:color-mix(in srgb,var(--color-base) 96%,var(--color-theme))}.icon{color:var(--color-theme)}h3{margin:.8rem 0 .45rem}.grid p,.rules p{margin:0}.rules{display:grid;gap:.6rem;margin-top:1.5rem}.rules article{display:grid;grid-template-columns:7rem 1fr;gap:1rem;align-items:start}.status{font-family:monospace;color:var(--color-theme)}.status.fake{color:#c24b4b}.status.weak{color:#b57921}.status.unassessed{color:var(--muted)}.command{display:block;margin-top:1.2rem}pre{overflow:auto;margin:.45rem 0 0;padding:.75rem;border-radius:var(--radius-sm);background:color-mix(in srgb,var(--color-base) 90%,var(--color-theme))}.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:.7rem;margin-top:1.5rem}.releases{display:grid;gap:.6rem;margin-top:1.5rem}.releases summary{display:flex;justify-content:space-between;gap:1rem;cursor:pointer}.releases summary span{display:grid;gap:.25rem}.releases time{font-size:.8rem}.releases details>div{padding-top:1rem}.releases ul{line-height:1.6}@media(max-width:720px){.hero,.grid{grid-template-columns:1fr}.panel{margin-top:1rem}.section{padding-top:2.75rem}.rules article{grid-template-columns:1fr}.releases summary{display:grid}}
</style>
