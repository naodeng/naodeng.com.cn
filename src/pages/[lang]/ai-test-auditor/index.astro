---
import { LOCALES, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { AI_TEST_AUDITOR_SITE } from "@/data/aiTestAuditorSite";
export const getStaticPaths = () => Object.keys(LOCALES).map((lang) => ({ params: { lang } }));
const locale = Astro.currentLocale as Lang;
const site = AI_TEST_AUDITOR_SITE[locale];
const breadcrumbs = [{ name: locale === "zh-cn" ? "首页" : "Home", url: `/${locale}/` }, { name: "AI Test Auditor", url: `/${locale}/ai-test-auditor/` }];
---
<Layout title={site.meta.title} description={site.meta.description} breadcrumbs={breadcrumbs}>
  <div class="auditor-page" data-ai-test-auditor-page>
    <section class="hero"><div><p class="eyebrow">{site.hero.eyebrow}</p><h1>{site.hero.title}</h1><p class="summary">{site.hero.summary}</p><div class="actions">{site.hero.actions.map((a) => <a class:list={['action', { primary: a.external }]} href={a.href} target={a.external ? '_blank' : undefined} rel={a.external ? 'noopener noreferrer' : undefined}>{a.label}<span>{a.external ? '↗' : '↓'}</span></a>)}</div></div><aside class="panel"><small>AI TEST / AUDIT</small><strong>FAKE · WEAK</strong><span>{locale === 'zh-cn' ? '证据先于信任，边界清晰才能做出更好的质量判断。' : 'Evidence before trust. Clear boundaries make better quality decisions.'}</span></aside></section>
    <section class="section"><h2>{site.labels.features}</h2><div class="grid">{site.features.map((f) => <article><span class="material-icons-sharp icon">{f.icon}</span><h3>{f.title}</h3><p>{f.description}</p></article>)}</div></section>
    <section class="section"><h2>{site.labels.rules}</h2><div class="rules">{site.rules.map((r) => <article><strong class:list={['status', r.status.toLowerCase()]}>{r.status}</strong><div><h3>{r.title}</h3><p>{r.description}</p></div></article>)}</div></section>
    <section class="section"><h2>{site.labels.install}</h2><div class="grid">{site.installModes.map((m) => <article id={m.id}><h3>{m.title}</h3><p>{m.description}</p><small class="command">{site.labels.commandLabel}</small>{m.commands.map((c) => <pre><code>{c}</code></pre>)}</article>)}</div></section>
    <section class="section"><h2>{site.labels.ecosystem}</h2><div class="links">{site.ecosystemLinks.map((l) => <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>{l.label}<span>→</span></a>)}</div></section>
    <section class="section"><h2>{site.labels.releaseNotes}</h2><div class="releases">{site.releases.map((r) => <details><summary><span><strong>{r.version}</strong><time>{r.publishedAt}</time></span><span>{r.summary}</span></summary><div><ul>{r.changes.map((c) => <li>{c}</li>)}</ul><a href={r.url} target="_blank" rel="noopener noreferrer">{site.labels.releaseLink} ↗</a></div></details>)}</div></section>
  </div>
</Layout>
<style>
  .auditor-page {
    max-inline-size: min(var(--layout-max), 1920px);
    margin-inline: auto;
    padding: 2rem var(--sp-m) 5rem;
    color: var(--color-main);
  }
  .hero,
  .section { border: 0; background: transparent; }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.55fr);
    gap: 2rem;
    padding: 2.5rem 0 3rem;
    border-block-end: 1px solid var(--color-border);
  }
  .eyebrow,
  .command { color: var(--color-theme); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.14em; }
  .hero h1,
  .section h2 { margin: 0; font-family: inherit; }
  .hero h1 { font-size: clamp(2.7rem, 7vw, 5.6rem); line-height: 0.95; }
  .summary { max-inline-size: 42rem; margin: 1.35rem 0 0; color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.7; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2rem; }
  .action,
  .links a,
  .releases a {
    display: inline-flex;
    justify-content: space-between;
    gap: 0.7rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-main);
    text-decoration: none;
    font-weight: 800;
  }
  .action.primary,
  .action:hover,
  .action:focus-visible,
  .links a:hover,
  .links a:focus-visible,
  .releases a:hover,
  .releases a:focus-visible { background: var(--color-theme); color: var(--color-theme-on-dark); }
  .panel {
    align-self: center;
    display: grid;
    gap: 0.8rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .panel small { color: var(--color-text-tertiary); }
  .panel strong { color: var(--color-main); }
  .panel span,
  .auditor-page article p,
  .auditor-page time { color: var(--color-text-secondary); line-height: 1.55; }
  .section { padding-top: 3.5rem; }
  .section h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .grid article,
  .rules article,
  .releases details {
    padding: 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .grid article { min-width: 0; }
  .icon { color: var(--color-text-secondary); }
  .auditor-page h3 { margin: 0.8rem 0 0.45rem; }
  .grid p,
  .rules p { margin: 0; }
  .rules { display: grid; gap: 0.6rem; margin-top: 1.5rem; }
  .rules article { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; align-items: start; }
  .status { font-family: ui-monospace, monospace; color: var(--color-theme); }
  .status.fake { color: var(--color-caution); }
  .status.weak { color: var(--color-warn); }
  .status.unassessed { color: var(--color-text-secondary); }
  .command { display: block; margin-top: 1.2rem; }
  .auditor-page pre { overflow: auto; margin: 0.45rem 0 0; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-code-surface); color: var(--color-text-primary); }
  .links { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.7rem; margin-top: 1.5rem; }
  .releases { display: grid; gap: 0.6rem; margin-top: 1.5rem; }
  .releases summary { display: flex; justify-content: space-between; gap: 1rem; cursor: pointer; }
  .releases summary:focus,
  .releases summary:focus-visible { outline: 2px solid var(--color-theme-focus); outline-offset: 2px; }
  .releases summary span { display: grid; gap: 0.25rem; min-width: 0; }
  .releases time { font-size: 0.8rem; }
  .releases details > div { padding-top: 1rem; }
  .releases ul { line-height: 1.6; }
  @media (max-width: 720px) {
    .hero,
    .grid { grid-template-columns: minmax(0, 1fr); }
    .panel { margin-top: 1rem; }
    .section { padding-top: 2.75rem; }
    .rules article,
    .releases summary { display: grid; grid-template-columns: 1fr; }
  }
</style>
