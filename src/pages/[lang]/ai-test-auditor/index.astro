---
import { LOCALES, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { AI_TEST_AUDITOR_SITE } from "@/data/aiTestAuditorSite";

export const getStaticPaths = () => Object.keys(LOCALES).map((lang) => ({ params: { lang } }));

const locale = Astro.currentLocale as Lang;
const site = AI_TEST_AUDITOR_SITE[locale];
const breadcrumbs = [
  { name: locale === "zh-cn" ? "首页" : "Home", url: `/${locale}/` },
  { name: "AI Test Auditor", url: `/${locale}/ai-test-auditor/` },
];
const latestRelease = site.releases[0];
const historicalReleases = site.releases.slice(1);
const copyLabels = locale === "zh-cn"
  ? { copy: "复制命令", copied: "已复制", unavailable: "无法复制，请手动选择命令" }
  : { copy: "Copy command", copied: "Copied", unavailable: "Copy unavailable; select the command manually" };
---

<Layout title={site.meta.title} description={site.meta.description} breadcrumbs={breadcrumbs}>
  <div class="auditor-page" data-ai-test-auditor-page>
    <section class="hero" aria-labelledby="auditor-title">
      <div class="hero-copy">
        <h1 id="auditor-title">{site.hero.title}</h1>
        <p class="hero-summary">{site.hero.summary}</p>
        <div class="hero-actions">
          {site.hero.actions.map((action) => <a class:list={["hero-action", { primary: action.external }]} href={action.href} target={action.external ? "_blank" : undefined} rel={action.external ? "noopener noreferrer" : undefined}>{action.label}<span aria-hidden="true">{action.external ? "↗" : "↓"}</span></a>)}
        </div>
        <a class="latest-release" href={latestRelease.url} target="_blank" rel="noopener noreferrer">
          <span>{locale === "zh-cn" ? "最新版本" : "Latest release"}</span>
          <strong>{latestRelease.version}</strong>
          <time datetime={latestRelease.publishedAt}>{latestRelease.publishedAt}</time>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <aside class="hero-summary-card panel" data-ui="audit-summary" aria-label={locale === "zh-cn" ? "审计结果概览" : "Audit summary"} data-reveal>
        <div class="hero-metrics">
          <div><strong>{site.demo.total}</strong><span>{site.labels.tests}</span></div>
          <div><strong class="fake-ink">{site.demo.fake}</strong><span>{site.labels.fake}</span></div>
          <div><strong class="weak-ink">{site.demo.weak}</strong><span>{site.labels.weak}</span></div>
          <div><strong>{site.demo.unassessed}</strong><span>{site.labels.unassessed}</span></div>
        </div>
        <p>{site.labels.sourceOnlyNotice}</p>
      </aside>
    </section>

    <section class="report-section" aria-labelledby="sample-report-title">
      <div class="section-heading">
        <h2 id="sample-report-title">{site.labels.sampleReport}</h2>
        <span class="fixture-tag">{site.labels.benchmarkFixture}</span>
      </div>
      <div class="report-shell" data-report-shell>
        <div class="report-toolbar" data-ui="report-controls">
          <div class="source-path"><code>{site.demo.source}</code></div>
          <div class="report-filters" role="group" aria-label={locale === "zh-cn" ? "按发现类型筛选" : "Filter findings by type"}>
            <button type="button" data-report-filter="all" aria-pressed="true">{site.labels.filterAll}</button>
            <button type="button" data-report-filter="fake" aria-pressed="false">{site.labels.filterFake}</button>
            <button type="button" data-report-filter="weak" aria-pressed="false">{site.labels.filterWeak}</button>
          </div>
        </div>
        <div class="report-ledger" data-ui="report-totals">
          <div class="report-total"><span>{locale === "zh-cn" ? "审计汇总" : "Audit summary"}</span><strong>{site.demo.assessed} / {site.demo.total}</strong><small>{site.labels.tests}</small></div>
          <div><span class="ledger-dot fake-dot" aria-hidden="true"></span><span>{site.labels.fake}</span><strong>{site.demo.fake}</strong></div>
          <div><span class="ledger-dot weak-dot" aria-hidden="true"></span><span>{site.labels.weak}</span><strong>{site.demo.weak}</strong></div>
          <div><span class="ledger-dot" aria-hidden="true"></span><span>{site.labels.unassessed}</span><strong>{site.demo.unassessed}</strong></div>
        </div>
        <div class="finding-list" data-finding-list>
          {site.demo.findings.map((finding) => (
            <article class="finding-card" data-finding-card data-finding-class={finding.classification.toLowerCase()} data-ui="audit-finding" data-reveal>
              <div class="finding-meta"><strong class:list={["classification", finding.classification.toLowerCase()]}>{finding.classification}</strong><span>{finding.ruleId}</span><span>{locale === "zh-cn" ? `第 ${finding.line} 行` : `Line ${finding.line}`}</span></div>
              <strong class="finding-title">{finding.title}</strong>
              <pre class="source-code"><span aria-hidden="true">{finding.line}</span><code>{finding.code}</code></pre>
              <p class="finding-description">{finding.description}</p>
              <div class="remediation"><span>{locale === "zh-cn" ? "修复建议" : "Suggested remediation"}</span><p>{finding.remediation}</p></div>
            </article>
          ))}
        </div>
        <p class="filter-status" data-report-status aria-live="polite" data-summary-template={locale === "zh-cn" ? "显示 {visible} / {total} 条发现" : "Showing {visible} of {total} findings"}>
          {locale === "zh-cn" ? `显示 ${site.demo.findings.length} / ${site.demo.findings.length} 条发现` : `Showing ${site.demo.findings.length} of ${site.demo.findings.length} findings`}
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="features-title">
      <h2 id="features-title">{site.labels.features}</h2>
      <div class="feature-grid grid">
        {site.features.map((feature, index) => <article class:list={["feature-card", { "feature-lead": index === 0 }]} data-reveal>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </article>)}
      </div>
    </section>

    <section class="section" aria-labelledby="rules-title">
      <h2 id="rules-title">{site.labels.rules}</h2>
      <div class="rule-ledger">
        {site.rules.map((rule) => <article class="rule-row" data-reveal>
          <strong class:list={["status", rule.status.toLowerCase()]}>{rule.status}</strong>
          <div><h3>{rule.title}</h3><p>{rule.description}</p></div>
        </article>)}
      </div>
    </section>

    <section class="section install-section" aria-labelledby="install-title">
      <h2 id="install-title">{site.labels.install}</h2>
      <div class="install-grid grid">
        {site.installModes.map((mode) => <article class="install-card" id={mode.id} data-reveal>
          <h3>{mode.title}</h3>
          <p>{mode.description}</p>
          <span class="command-label">{site.labels.commandLabel}</span>
          {mode.commands.map((command) => <div class="install-command" data-copy-state="idle" data-ui="install-command">
            <pre><code>{command}</code></pre>
            <button type="button" class="copy-command" data-copy-command data-command={command} data-copied-label={copyLabels.copied} data-copy-error-label={copyLabels.unavailable}>
              <span class="material-icons-sharp" aria-hidden="true">content_copy</span>
              <span data-copy-label>{copyLabels.copy}</span>
            </button>
            <span class="visually-hidden" aria-live="polite" data-copy-feedback></span>
          </div>)}
        </article>)}
      </div>
    </section>

    <section class="section" aria-labelledby="ecosystem-title">
      <h2 id="ecosystem-title">{site.labels.ecosystem}</h2>
      <div class="ecosystem-links">
        {site.ecosystemLinks.map((link) => <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}
      </div>
      <p class="license-note"><a href="https://github.com/naodeng/ai-test-auditor/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">{site.labels.licenseNotice}<span aria-hidden="true">↗</span></a></p>
    </section>

    <section class="section releases" aria-labelledby="releases-title">
      <h2 id="releases-title">{site.labels.releaseNotes}</h2>
      <article class="current-release" data-reveal>
        <div class="current-release-heading"><span>{locale === "zh-cn" ? "当前版本" : "Current release"}</span><strong>{latestRelease.version}</strong><time datetime={latestRelease.publishedAt}>{latestRelease.publishedAt}</time></div>
        <div class="release-copy">
          <p>{latestRelease.summary}</p>
          <ul>{latestRelease.changes.map((change) => <li>{change}</li>)}</ul>
          <a href={latestRelease.url} target="_blank" rel="noopener noreferrer">{site.labels.releaseLink}<span aria-hidden="true">↗</span></a>
        </div>
      </article>
      <h3 class="release-history-title">{locale === "zh-cn" ? "历史版本" : "Release history"}</h3>
      <div class="release-list">
        {historicalReleases.map((release) => <details class="release-entry" data-release-note>
          <summary>
            <span><strong>{release.version}</strong><time datetime={release.publishedAt}>{release.publishedAt}</time></span>
            <span>{release.summary}</span>
            <span class="release-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="release-body">
            <ul>{release.changes.map((change) => <li>{change}</li>)}</ul>
            <a href={release.url} target="_blank" rel="noopener noreferrer">{site.labels.releaseLink}<span aria-hidden="true">↗</span></a>
          </div>
        </details>)}
      </div>
    </section>
  </div>
</Layout>

<script>
  const reportShell = document.querySelector<HTMLElement>("[data-report-shell]");
  const filterButtons = reportShell?.querySelectorAll<HTMLButtonElement>("[data-report-filter]");
  const findingCards = reportShell?.querySelectorAll<HTMLElement>("[data-finding-card]");
  const reportStatus = reportShell?.querySelector<HTMLElement>("[data-report-status]");

  filterButtons?.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.reportFilter;
      let visible = 0;
      findingCards?.forEach((card) => {
        const matches = filter === "all" || card.dataset.findingClass === filter;
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      filterButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      if (reportStatus) {
        reportStatus.textContent = (reportStatus.dataset.summaryTemplate || "Showing {visible} of {total} findings")
          .replace("{visible}", String(visible))
          .replace("{total}", String(findingCards?.length ?? 0));
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-copy-command]").forEach((button) => {
    button.addEventListener("click", async () => {
      const group = button.closest<HTMLElement>("[data-copy-state]");
      const feedback = group?.querySelector<HTMLElement>("[data-copy-feedback]");
      const label = button.querySelector<HTMLElement>("[data-copy-label]");
      const idleLabel = label?.textContent || "";
      try {
        await navigator.clipboard.writeText(button.dataset.command || "");
        if (group) group.dataset.copyState = "copied";
        if (label) label.textContent = button.dataset.copiedLabel || "Copied";
        if (feedback) feedback.textContent = button.dataset.copiedLabel || "Copied";
      } catch {
        if (group) group.dataset.copyState = "failed";
        if (label) label.textContent = button.dataset.copyErrorLabel || "Copy unavailable";
        if (feedback) feedback.textContent = button.dataset.copyErrorLabel || "Copy unavailable";
      }
      window.setTimeout(() => {
        if (!group?.isConnected) return;
        group.dataset.copyState = "idle";
        if (label) label.textContent = idleLabel;
      }, 2400);
    });
  });

  const page = document.querySelector<HTMLElement>("[data-ai-test-auditor-page]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (page && !reduceMotion.matches && "IntersectionObserver" in window) {
    page.dataset.motionReady = "true";
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-revealed");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.1, rootMargin: "0px 0px -8% 0px" });
    page.querySelectorAll<HTMLElement>("[data-reveal]").forEach((item) => observer.observe(item));
  }
</script>

<style>
  :root:not([data-theme="dark"]) .auditor-page { --color-warn: #936100; }

  .auditor-page {
    --page-soft: color-mix(in srgb, var(--color-theme) 7%, var(--color-surface));
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: 2rem 0 5rem;
    color: var(--color-main);
  }
  .auditor-page h1,
  .auditor-page h2,
  .auditor-page h3 { color: var(--color-main); }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, .95fr);
    align-items: center;
    gap: clamp(2rem, 4.5vw, 4rem);
    padding: 1.5rem 0 3.2rem;
  }
  .hero-copy { min-width: 0; }
  .hero h1 { margin: 0; font-size: clamp(3.2rem, 6.6vw, 5.4rem); font-weight: 800; letter-spacing: -.06em; line-height: .98; animation: headline-rise 680ms cubic-bezier(.2,.8,.2,1) both; }
  .hero-summary { max-width: 42rem; margin: 1.2rem 0 0; color: var(--color-text-secondary); font-size: clamp(1.1rem, 1.55vw, 1.25rem); line-height: 1.6; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin-top: 1.5rem; }
  .hero-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    min-height: 3rem;
    padding: .55rem .95rem;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--color-main);
    background: transparent;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    transition: color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }
  .hero-action.primary { color: var(--color-theme-on-dark); background: var(--color-theme); }
  .hero-action:hover,
  .hero-action:focus-visible { color: var(--color-theme); background: var(--color-theme-soft); }
  .hero-action.primary:hover,
  .hero-action.primary:focus-visible { color: var(--color-theme-on-dark); background: var(--color-theme-focus); }
  .hero-action > span,
  .ecosystem-links a > span { transition: transform var(--transition-fast); }
  .hero-action:hover > span,
  .ecosystem-links a:hover > span { transform: translateX(3px); }
  .latest-release { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: .35rem .65rem; margin-top: 1rem; color: var(--color-text-secondary); font-size: .95rem; text-decoration: none; }
  .latest-release strong { color: var(--color-theme); }
  .latest-release:hover strong,
  .latest-release:focus-visible strong { text-decoration: underline; text-underline-offset: .2em; }
  .hero-summary-card {
    min-width: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-code-surface);
    color: var(--color-main);
    overflow: hidden;
  }
  .hero-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; padding: .65rem; }
  .hero-metrics > div { display: grid; gap: .35rem; min-height: 6rem; align-content: center; padding: 1rem 1.2rem; border-radius: var(--radius-sm); background: var(--color-surface); }
  .hero-metrics strong { font-size: 2rem; font-variant-numeric: tabular-nums; line-height: 1; }
  .hero-metrics span { color: var(--color-main); font-size: 1rem; line-height: 1.35; }
  .fake-ink,
  .classification.fake,
  .status.fake { color: var(--color-caution); }
  .weak-ink,
  .classification.weak,
  .status.weak { color: var(--color-warn); }
  .hero-summary-card > p { margin: 0; padding: .9rem 1.2rem 1rem; color: var(--color-main); font-size: 1rem; line-height: 1.5; }
  .report-section { padding-top: clamp(2.9rem, 5.8vw, 4.8rem); }
  .section { padding-top: clamp(3.1rem, 5.8vw, 4.8rem); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
  .auditor-page .section h2,
  .report-section h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.35rem); line-height: 1.15; letter-spacing: -.03em; }
  .fixture-tag { flex: 0 0 auto; max-width: 50%; color: var(--color-theme); font-size: .875rem; font-weight: 700; text-align: end; }
  .report-shell { min-width: 0; overflow: hidden; border-radius: var(--radius-md); background: var(--color-surface); }
  .report-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem .9rem; background: var(--color-code-surface); }
  .source-path { min-width: 0; color: var(--color-main); }
  .source-path code { overflow-wrap: anywhere; font-family: ui-monospace, monospace; font-size: 1rem; }
  .report-filters { display: flex; flex: 0 0 auto; gap: .35rem; }
  .report-filters button {
    min-height: 2.8rem;
    padding: .45rem .7rem;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--color-main);
    background: transparent;
    font: inherit;
    font-size: .875rem;
    font-weight: 700;
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }
  .report-filters button[aria-pressed="true"] { color: var(--color-theme); background: var(--color-theme-soft); }
  .report-filters button:hover,
  .report-filters button:focus-visible { color: var(--color-theme); }
  .report-ledger { display: grid; grid-template-columns: 1.25fr repeat(3, 1fr); gap: .5rem; padding: .6rem; background: var(--color-code-surface); }
  .report-ledger > div { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .45rem; min-width: 0; padding: .75rem .9rem; border-radius: var(--radius-sm); background: var(--color-surface); font-size: .875rem; }
  .report-ledger > div > strong { font-size: 1rem; font-variant-numeric: tabular-nums; }
  .report-ledger .report-total { display: grid; grid-template-columns: 1fr auto; gap: 0 .55rem; }
  .report-total > span { color: var(--color-main); }
  .report-total > strong { grid-row: span 2; font-size: 1.4rem; font-variant-numeric: tabular-nums; }
  .report-total > small { color: var(--color-main); font-size: .875rem; }
  .ledger-dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--color-text-secondary); }
  .fake-dot { background: var(--color-caution); }
  .weak-dot { background: var(--color-warn); }
  .finding-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem 1.2rem; padding: 1rem .85rem; }
  .finding-card {
    min-width: 0;
    padding: .9rem;
    border-radius: var(--radius-sm);
    background: var(--color-code-surface);
  }
  .finding-card[hidden] { display: none; }
  .finding-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .65rem; color: var(--color-text-secondary); font-size: .875rem; }
  .classification { font-weight: 800; }
  .finding-title { display: block; margin-top: .65rem; font-size: 1.15rem; line-height: 1.35; }
  .source-code { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: .7rem; margin: .7rem 0 0; padding: .65rem .75rem; border-radius: var(--radius-sm); background: var(--color-surface); }
  .source-code > span { color: var(--color-text-secondary); font-family: ui-monospace, monospace; font-size: .875rem; text-align: end; }
  .source-code code { min-width: 0; overflow-wrap: anywhere; white-space: normal; color: var(--color-main); font-family: ui-monospace, monospace; font-size: 1rem; }
  .finding-description { margin: .7rem 0; color: var(--color-main); font-size: 1rem; line-height: 1.5; }
  .remediation { padding: .75rem .8rem; border-left: 3px solid var(--color-theme); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; background: var(--color-surface); }
  .remediation > span { color: var(--color-text-secondary); font-size: .875rem; font-weight: 700; }
  .remediation p { margin: .3rem 0 0; font-size: 1rem; line-height: 1.5; }
  .filter-status { margin: 0; padding: .65rem .9rem .8rem; color: var(--color-text-secondary); font-size: .875rem; }
  .feature-grid,
  .install-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.8rem 2.8rem; align-items: start; }
  .feature-card,
  .install-card { position: relative; min-width: 0; }
  .feature-card.feature-lead { display: grid; grid-column: 1 / -1; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); gap: 2rem; align-items: baseline; }
  .auditor-page h3 { margin: 0 0 .45rem; font-size: 1.2rem; line-height: 1.35; }
  .feature-card p,
  .install-card p,
  .rule-row p { margin: 0; color: var(--color-text-secondary); font-size: 1rem; line-height: 1.55; }
  .rule-ledger { display: grid; gap: 1.25rem; }
  .rule-row { display: grid; grid-template-columns: minmax(10rem, .7fr) minmax(0, 1.3fr); gap: 2rem; align-items: start; }
  .status { font-size: 1rem; font-weight: 800; }
  .status.unassessed { color: var(--color-text-secondary); }
  .install-card h3 { margin-bottom: .45rem; }
  .command-label { display: block; margin: 1rem 0 .45rem; color: var(--color-text-secondary); font-size: .875rem; font-weight: 700; }
  .install-command { display: grid; gap: .35rem; }
  .install-command pre { min-width: 0; margin: 0; padding: .8rem .9rem; border: 0; border-radius: var(--radius-sm); background: var(--color-code-surface); color: var(--color-main); font-size: 1rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  .install-command code { font-family: ui-monospace, monospace; font-size: 1rem; overflow-wrap: anywhere; white-space: inherit; }
  .copy-command {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    width: fit-content;
    min-height: 2.7rem;
    padding: .45rem .6rem;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--color-main);
    background: transparent;
    font: inherit;
    font-size: .95rem;
    font-weight: 700;
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }
  .copy-command .material-icons-sharp { font-size: 1.1rem; }
  .copy-command:hover,
  .copy-command:focus-visible { color: var(--color-theme); background: var(--color-theme-soft); }
  [data-copy-state="copied"] .copy-command { color: var(--color-success-text); }
  [data-copy-state="failed"] .copy-command { color: var(--color-caution); }
  .ecosystem-links { display: flex; flex-wrap: wrap; gap: .35rem 1.7rem; }
  .ecosystem-links a,
  .current-release a,
  .release-body a {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 2.8rem;
    color: var(--color-main);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .ecosystem-links a:hover,
