---
import Layout from "@/layouts/Article.astro";
import ArticleShare from "@/components/ArticleShare.astro";
import AuthorStatsCard from "@/components/AuthorStatsCard.astro";
import Giscus from "@/components/Giscus.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import TrackingEvents from "@/components/TrackingEvents.astro";
import { getCollection, render } from "astro:content";
import { ARTICLE_LICENSE, NAV_HOME, READING_TIME_LABEL, SITE_SLOGAN } from "@/consts";
import type { Lang } from "@/i18n";
import { wikiIdToSlug, getTitleZhFromBody, getTitleZh, slugToTitleEn } from "@/data/wiki";
import { aiwikiIdToSlug, aiwikiIdToLang, getAiWikiDisplayTitle } from "@/data/aiwiki";
import { filterPublishedBlogPosts } from "@/utils/blogPublication";
import { blogReadingTime } from "@/utils/readingTime";
import { serializeJsonLd } from "@/utils/seoHtml.mjs";

export async function getStaticPaths() {
  const posts = filterPublishedBlogPosts(await getCollection("blog"));
  return posts.map((post) => {
    const [lang, ...idParts] = post.id.split("/");
    // 博文 URL 路径段统一小写，避免大小写不一致导致 404
    const id = idParts.join("/").toLowerCase();
    return {
      params: { lang, id },
      props: post,
    };
  });
}

const { lang, id } = Astro.params;
const post = Astro.props;
const locale = (lang ?? "zh-cn") as Lang;
const siteOrigin = "https://inaodeng.com";
const postPath = `/${lang}/blog/${id ?? ""}/`;
const canonicalUrl = `${siteOrigin}${postPath}`;

const ogImageUrl = `${siteOrigin}/ogp.png`;

const { Content, headings = [] } = await render(post);
const hasToc = headings.some(({ depth }) => depth === 2 || depth === 3);
const tocLabel = locale === "zh-cn" ? "目录" : "Table of Contents";
const title = post.data.title;
const description = post.data.description;
const articleCategory = post.data.categories?.[0];
const categoryTag = articleCategory
  ? post.data.tags?.find((tag) => tag.toLowerCase() === articleCategory.toLowerCase())
  : undefined;
const tagUrl = (tag: string) => {
  const tagSegment = tag.includes("/") || tag.includes(" ") ? encodeURIComponent(tag) : tag;
  return `/${lang}/tags/${tagSegment}/`;
};
const categoryTagUrl = categoryTag ? tagUrl(categoryTag) : undefined;
const articleTags = (post.data.tags ?? []).filter((tag) => tag !== categoryTag);
const visibleArticleTags = articleTags.slice(0, articleCategory ? 2 : 3);
const authorName = post.data.author || "Nao Deng";
const datePublished = post.data.date.toISOString();
const dateModified = post.data.updated ? new Date(post.data.updated).toISOString() : datePublished;

const rawBody = typeof post.body === "string" ? post.body : "";
const wordCount = rawBody.split(/\s+/).filter(Boolean).length;
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished,
  dateModified,
  url: canonicalUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  image: { "@type": "ImageObject", url: ogImageUrl, width: 1200, height: 630 },
  inLanguage: locale === "zh-cn" ? "zh-CN" : "en",
  wordCount,
  author: { "@type": "Person", name: authorName, url: siteOrigin },
  publisher: {
    "@type": "Organization",
    name: "Nao's Blog",
    url: siteOrigin,
    logo: { "@type": "ImageObject", url: `${siteOrigin}/ogp.png`, width: 1200, height: 630 },
  },
};

const homeName = typeof NAV_HOME === "string" ? NAV_HOME : (NAV_HOME[locale] ?? (locale === "zh-cn" ? "首页" : "Home"));
const readMinutes = blogReadingTime(rawBody);
const readingTimeLabel = typeof READING_TIME_LABEL === "string" ? READING_TIME_LABEL : (READING_TIME_LABEL[locale] ?? (locale === "zh-cn" ? "分钟阅读" : "min read"));
const breadcrumbs = [
  { name: homeName, url: `/${lang}/` },
  { name: locale === "zh-cn" ? "博客" : "Blog", url: `/${lang}/blog/` },
  { name: title, url: postPath },
];

// 站点统计（用于文末作者信息）
const allPosts = filterPublishedBlogPosts(await getCollection("blog"));
const totalArticles = allPosts.length;
const allCategories = new Set(allPosts.flatMap((p) => p.data.categories ?? []));
const allTags = new Set(allPosts.flatMap((p) => p.data.tags ?? []));
const totalChars = allPosts.reduce((sum, p) => sum + (typeof p.body === "string" ? p.body.length : 0), 0);
const authorSlogan = typeof SITE_SLOGAN === "string" ? SITE_SLOGAN : (SITE_SLOGAN[locale] ?? (locale === "zh-cn" ? "质量分析师，而非质量保证师。" : "Quality Analyst, Not Quality Assurance."));
const statsLabels = locale === "zh-cn"
  ? { articles: "文章", categories: "分类", tags: "标签", words: "字数" }
  : { articles: "Articles", categories: "Categories", tags: "Tags", words: "Words" };

type TermLink = { label: string; href: string; score: number };
const norm = (s: string) =>
  String(s || "")
    .toLowerCase()
    .replace(/[`*_~#()[\]{}|\\/:;,.!?'"“”‘’·\-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const signals = [
  title,
  ...(post.data.tags ?? []),
  ...(post.data.categories ?? []),
  ...(post.data.series ?? []),
]
  .map((x) => norm(String(x)))
  .filter(Boolean);

const allAiWiki = await getCollection("aiwiki");
const aiEntries = allAiWiki.filter((e) =>
  (e.data.lang ? e.data.lang === locale : aiwikiIdToLang(e.id) === locale)
);
const wikiEntries = locale === "zh-cn" ? await getCollection("wiki") : [];

const candidates: TermLink[] = [];
for (const e of aiEntries) {
  const slug = e.data.slug ?? aiwikiIdToSlug(e.id);
  const label = getAiWikiDisplayTitle(e, locale);
  const text = norm(`${slug} ${label}`);
  let score = 0;
  for (const s of signals) {
    if (!s || s.length < 2) continue;
    if (text === s) score = Math.max(score, 10);
    else if (text.includes(s) || s.includes(text)) score = Math.max(score, 6);
  }
  candidates.push({ label, href: `/${locale}/AIWiki/${slug}/`, score });
}

if (locale === "zh-cn") {
  for (const e of wikiEntries) {
    const slug = wikiIdToSlug(e.id);
    const label = getTitleZhFromBody(e.body) || getTitleZh(e.data.title ?? "") || slugToTitleEn(slug);
    const text = norm(`${slug} ${label}`);
    let score = 0;
    for (const s of signals) {
      if (!s || s.length < 2) continue;
      if (text === s) score = Math.max(score, 10);
      else if (text.includes(s) || s.includes(text)) score = Math.max(score, 6);
    }
    candidates.push({ label, href: `/${locale}/wiki/${slug}/`, score });
  }
}

const relatedTerms: TermLink[] = [];
const seenHref = new Set<string>();
for (const item of candidates.sort((a, b) => b.score - a.score || a.label.localeCompare(b.label, locale === "zh-cn" ? "zh-CN" : "en"))) {
  if (seenHref.has(item.href)) continue;
  seenHref.add(item.href);
  relatedTerms.push(item);
  if (relatedTerms.length >= 5) break;
}
---

<Layout
  title={title}
  description={description}
  image={ogImageUrl}
  imageAlt={title}
  articlePublishedTime={datePublished}
  articleModifiedTime={dateModified}
  articleAuthor={authorName}
  breadcrumbs={breadcrumbs}
  contentWide
>
  <script type="application/ld+json" set:html={serializeJsonLd(blogPostingSchema)} is:inline />
  <div class:list={["article-with-toc", { "article-with-toc--plain": !hasToc }]}>
    <header class="article-title-header" id="article-title-header">
      <h1>{title}</h1>
      <p class="article-summary">{description}</p>
      <div class="article-byline">
        <p class="article-meta">
          <span class="meta-item">
            <span class="meta-icon" aria-hidden="true">
              <span class="material-icons-sharp" aria-hidden="true">calendar_today</span>
            </span>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString(lang)}
            </time>
          </span>
          <span class="meta-item">
            <span class="meta-icon" aria-hidden="true">
              <span class="material-icons-sharp" aria-hidden="true">schedule</span>
            </span>
            <span>{readMinutes} {readingTimeLabel}</span>
          </span>
          {post.data.updated && (
            <>
              <span class="meta-item">
                <span class="meta-icon" aria-hidden="true">
                  <span class="material-icons-sharp" aria-hidden="true">refresh</span>
                </span>
                <time datetime={dateModified}>
                  {locale === "zh-cn" ? "更新于 " : "Updated "}
                  {new Date(post.data.updated).toLocaleDateString(locale === "zh-cn" ? "zh-CN" : "en-US", { year: "numeric", month: "short", day: "numeric" })}
                </time>
              </span>
            </>
          )}
        </p>
        {(articleCategory || visibleArticleTags.length > 0) && (
          <nav class="tags" aria-label={locale === "zh-cn" ? "文章分类与标签" : "Article category and tags"}>
            {articleCategory && (categoryTagUrl ? (
              <a href={categoryTagUrl} class="tag tag--category">{articleCategory}</a>
            ) : (
              <span class="tag tag--category">{articleCategory}</span>
            ))}
            {visibleArticleTags.map((tag) => (
              <a href={tagUrl(tag)} class="tag">{tag}</a>
            ))}
          </nav>
        )}
      </div>
    </header>

    {hasToc && <aside class="article-sidebar" aria-label={tocLabel}>
      <div class="article-sidebar-inner">
        <TableOfContents headings={headings} label={tocLabel} placement="article" />
      </div>
    </aside>}

    <div class="article-body">
      <div class="article-main">
        <div class="prose">
          <Content />
        </div>
        {relatedTerms.length > 0 && (
          <section class="blog-related-terms" aria-labelledby="blog-related-terms-heading">
            <h2 id="blog-related-terms-heading">
              {locale === "zh-cn" ? "相关术语" : "Related Terms"}
            </h2>
            <div class="blog-related-terms-pills">
              {relatedTerms.map((item) => (
                <a href={item.href} class="blog-related-terms-pill">{item.label}</a>
              ))}
            </div>
          </section>
        )}
        <ArticleShare title={title} url={canonicalUrl} locale={locale as "zh-cn" | "en"} />
        <footer class="article-endmatter">
          <AuthorStatsCard
            avatarUrl="/favicon.svg"
            authorName={authorName}
            slogan={authorSlogan}
            authorLink={`/${lang}/`}
            stats={{ articles: totalArticles, categories: allCategories.size, tags: allTags.size, words: totalChars }}
            labels={statsLabels}
            social={{
              github: "https://github.com/naodeng",
              medium: "https://naodeng.medium.com/",
              x: "https://x.com/inaodeng",
              weibo: "https://weibo.com/u/1651778270",
              rss: `/${lang}/rss.xml`,
            }}
          />
          <p class="article-license">
            <span>{locale === "zh-cn" ? "内容许可" : "Content license"}</span>
            <a href={`/${lang}/copyright/`}>
              {ARTICLE_LICENSE}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </p>
        </footer>
        <Giscus
          lang={locale === "zh-cn" ? "zh-CN" : "en"}
          theme="preferred_color_scheme"
          inputPosition="bottom"
          reactionsEnabled={true}
          loading="lazy"
        />
      </div>
    </div>
  </div>
</Layout>
<TrackingEvents mode="detail" locale={locale} channel="blog" slug={String(id ?? "")} detailLinkSelector=".blog-related-terms-pill" />

<style>
  :global(.l-main.l-content:has(.article-with-toc)) {
    margin-block-start: clamp(1rem, 1.5vw, 1.75rem);
  }
  :global(.l-main:has(.article-with-toc) .breadcrumb) {
    margin-block-end: 1rem;
    padding-block: 0.375rem;
  }
  :global(.l-main:has(.article-with-toc) > article) {
    padding-inline: 0;
  }
  .article-with-toc {
    --blog-reading-max: min(1440px, calc(var(--layout-max) - 19rem));
    display: grid;
    max-inline-size: var(--blog-reading-max);
    margin-inline: auto;
    grid-template-columns: 1fr;
    grid-template-areas: "heading" "toc" "body";
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 1100px) {
    .article-with-toc {
      max-inline-size: min(var(--layout-max), 1440px);
      grid-template-columns: minmax(0, 1fr) 16rem;
      grid-template-areas: "heading toc" "body toc";
      column-gap: 3rem;
    }
    .article-sidebar {
      align-self: stretch;
    }
    .article-sidebar-inner {
      position: sticky;
      top: var(--sticky-offset);
      max-height: calc(100dvh - var(--sticky-offset) - 1rem);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--color-border-strong) transparent;
      scrollbar-gutter: stable;
    }
  }
  .article-with-toc--plain {
    max-inline-size: var(--blog-reading-max);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "heading" "body";
  }
  @media (min-width: 1600px) {
    .article-with-toc:not(.article-with-toc--plain) {
      max-inline-size: min(var(--layout-max), 2160px);
      margin-inline: 0;
    }
    .article-with-toc--plain {
      max-inline-size: var(--layout-max);
    }
    .article-with-toc:not(.article-with-toc--plain) .article-title-header {
      inline-size: min(100%, 1600px);
      margin-inline: 0;
    }
    .article-with-toc--plain .article-title-header {
      inline-size: min(100%, 1440px);
      margin-inline: auto;
    }
    .article-with-toc--plain .article-main .prose {
      max-inline-size: min(100%, 1440px);
      margin-inline: auto;
    }
    .article-with-toc:not(.article-with-toc--plain) .article-main .prose > :global(:is(p, h2, h3, h4, h5, h6, ul, ol, blockquote):not(:has(img, video, iframe, picture, table, pre))) {
      max-inline-size: min(100%, 1200px);
      margin-inline: 0 auto;
    }
    .article-main .prose {
      font-size: clamp(1rem, calc(0.75rem + 0.25vw), 1.125rem);
    }
    .article-main .prose :global(h2) {
      font-size: clamp(1.6rem, 1.2vw, 1.9rem);
    }
  }
  .article-body {
    grid-area: body;
    width: 100%;
    min-width: 0;
    margin-inline: 0;
    box-sizing: border-box;
  }
  .article-sidebar {
    grid-area: toc;
    min-width: 0;
  }
  .article-sidebar-inner {
    min-width: 0;
  }
  @media (min-width: 1100px) {
    .article-sidebar :global(.toc-nav) {
      border-radius: var(--radius-lg);
      background: var(--color-surface-muted);
      box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-text-primary) 5%, transparent);
    }
    .article-sidebar :global(.toc-link) {
      transition: color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
    }
    .article-sidebar :global(.toc-link:hover) {
      transform: translateX(2px);
    }
  }
  .article-title-header {
    grid-area: heading;
    text-align: start;
    border-block-end: 1px solid var(--color-border);
    padding-block: clamp(1.25rem, 1.8vw, 2rem) clamp(1.5rem, 2vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0;
  }
  .article-title-header h1 {
    color: var(--color-main);
    font-size: clamp(2rem, 2.75vw, 3.25rem);
    line-height: 1.14;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin: 0;
  }
  .article-summary {
    max-inline-size: min(100%, 64em);
    margin-block-start: 1rem;
    color: var(--color-text-secondary);
    font-size: clamp(var(--text-base), calc(var(--text-base) + 0.35vw), var(--text-lg));
    font-weight: 500;
    line-height: 1.68;
    text-wrap: pretty;
    margin-block-end: 0;
  }
  .article-meta {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: start;
    gap: 0.45rem 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .article-byline {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    inline-size: 100%;
    margin-block-start: 1.35rem;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .meta-item + .meta-item::before {
    content: "";
    inline-size: 1px;
    block-size: 0.9em;
    background: var(--color-border-strong);
    margin-inline-end: 0.1rem;
  }
  .meta-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-text-secondary);
  }
  .meta-icon svg {
    vertical-align: middle;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    justify-content: start;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    background-color: var(--color-surface-muted);
    color: var(--color-text-secondary);
    border: 1px solid transparent;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-xl);
    font-size: var(--text-xs);
    line-height: 1.35;
    text-decoration: none;
    transition: color var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }
  .tag--category {
    color: var(--color-theme);
    background-color: var(--color-theme-soft);
    border-color: color-mix(in srgb, var(--color-theme) 18%, transparent);
    font-weight: 600;
  }
  .tags a.tag:hover {
    color: var(--color-theme);
    background: var(--color-theme-soft);
    border-color: var(--color-border-strong);
    transform: translateY(-1px);
  }
  .tags a.tag:active {
    transform: translateY(0) scale(0.98);
  }
  .tags a.tag:focus-visible {
    outline: 2px solid var(--color-theme);
    outline-offset: 2px;
  }
  @media (max-width: 600px) {
    .article-title-header {
      padding-block: 1rem 1.25rem;
    }
    .article-title-header h1 {
      font-size: 2rem;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
    .article-summary {
      margin-block-start: 0.8rem;
      font-size: var(--text-base);
      line-height: 1.65;
    }
    .article-byline {
      gap: 0.75rem;
      margin-block-start: 1.1rem;
    }
    .article-meta {
      gap: 0.45rem 0.7rem;
    }
    .meta-item + .meta-item::before {
      display: none;
    }
    .tags {
      gap: 0.4rem;
    }
  }
  .article-main {
    min-width: 0;
  }
  .article-endmatter {
    margin-block-start: 1.5rem;
  }
  .article-license {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    margin: 0;
    padding: 0.5rem 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }
  .article-license a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 44px;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 0.2em;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }
  .article-license a:hover {
    color: var(--color-theme);
    text-decoration-color: currentColor;
  }
  .article-license a:focus-visible {
    outline: 2px solid var(--color-theme);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .article-license svg {
    flex-shrink: 0;
  }
  .article-main :global(.giscus-section) {
    margin-block-start: 2rem;
    padding-block-start: 1.5rem;
    border-block-start-color: var(--color-border);
  }
  .blog-related-terms {
    margin: 1.25rem 0 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
  }
  .blog-related-terms h2 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--color-main);
  }
  .blog-related-terms-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .blog-related-terms-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.32rem 0.62rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 600;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .blog-related-terms-pill:hover {
    color: var(--color-theme-on-dark);
    background: var(--color-theme);
    border-color: var(--color-theme);
  }

  /* Markdown / 正文内容样式 */
  .prose {
    max-inline-size: 100%;
    overflow-wrap: anywhere;
    margin-inline: 0;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-main);
  }
  .prose :global(h2) {
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    font-weight: 700;
    margin-block: 2em 0.6em;
    padding-block-end: 0.3em;
    border-block-end: 1px solid var(--color-border);
    color: var(--color-main);
  }
  .prose :global(h2:first-child) {
    margin-block-start: 0;
  }
  .prose > :global(:first-child) {
    margin-block-start: 0;
  }
  .article-main .prose > :global(p:first-child) {
    margin-block-end: 1.75rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--color-theme);
    color: var(--color-text-primary);
    font-size: clamp(1.08rem, calc(1rem + 0.16vw), 1.25rem);
    line-height: 1.75;
  }
  .prose :global(h3) {
    font-size: 1.2rem;
    font-weight: 700;
    margin-block: 1.25em 0.4em;
    color: var(--color-main);
  }
  .prose :global(h4) {
