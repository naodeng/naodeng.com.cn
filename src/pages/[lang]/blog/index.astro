---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import PageHeadline from "@/components/PageHeadline.astro";
import PaginationNav from "@/components/PaginationNav.astro";
import CollectionPostGrid from "@/components/CollectionPostGrid.astro";
import "@/styles/blog-index.css";
import { BLOG_INDEX_TITLE, BLOG_INDEX_DESCRIPTION, BLOG_POSTS_PER_PAGE, BLOG_INTRO, NAV_HOME, NAV_SERIES, NAV_TAGS, NAV_ARCHIVE } from "@/consts";
import { filterPublishedBlogPosts } from "@/utils/blogPublication";
import { serializeJsonLd } from "@/utils/seoHtml.mjs";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";

const allPosts = filterPublishedBlogPosts(await getCollection("blog"))
  .filter((post) => post.id.split("/")[0] === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const totalPosts = allPosts.length;
const totalPages = Math.max(1, Math.ceil(totalPosts / BLOG_POSTS_PER_PAGE));
const currentPage = 1;
const posts = allPosts.slice(0, BLOG_POSTS_PER_PAGE);
const featuredPost = posts[0];
const listPosts = posts.slice(1);

const title = t({ en: "Blog", "zh-cn": "博客" });
const description = t(BLOG_INDEX_DESCRIPTION);
const nextUrl = totalPages > 1 ? `${siteOrigin}/${locale}/blog/page/2/` : undefined;
const homeName = (typeof NAV_HOME === "string" ? NAV_HOME : NAV_HOME[locale]) ?? (locale === "zh-cn" ? "首页" : "Home");
const breadcrumbs = [
  { name: homeName, url: `/${locale}/` },
  { name: title, url: `/${locale}/blog/` },
];
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: title,
  description,
  numberOfItems: totalPosts,
  itemListElement: posts.slice(0, 10).map((post, i) => {
    const [, ...idParts] = post.id.split("/");
    const slug = idParts.join("/").toLowerCase();
    return {
      "@type": "ListItem",
      position: i + 1,
      url: `${siteOrigin}/${locale}/blog/${slug}/`,
      name: post.data.title,
    };
  }),
};

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));
---

<Layout title={t(BLOG_INDEX_TITLE)} description={description} breadcrumbs={breadcrumbs} nextUrl={nextUrl}>
  <script type="application/ld+json" set:html={serializeJsonLd(itemListSchema)} is:inline />
  <section class="blog-headline-wrap">
    <PageHeadline {title} compact>
      <p class="headline-intro">{t(BLOG_INTRO)}</p>
      <div class="headline-actions">
        <a href={getRelativeLocaleUrl(locale, "/series")} class="headline-btn">{t(NAV_SERIES)}</a>
        <a href={getRelativeLocaleUrl(locale, "/tags")} class="headline-btn">{t(NAV_TAGS)}</a>
        <a href={getRelativeLocaleUrl(locale, "/archive")} class="headline-btn">{t(NAV_ARCHIVE)}</a>
      </div>
    </PageHeadline>
  </section>

  <div class="blog-container">
    {featuredPost && (() => {
      const [, ...id] = featuredPost.id.split("/");
      const postUrl = `/${locale}/blog/${id.join("/").toLowerCase()}/`;
      const dateStr = featuredPost.data.date.toLocaleDateString(
        locale === "zh-cn" ? "zh-CN" : "en-US",
        { year: "numeric", month: "short", day: "numeric" },
      );
      return (
        <article class="featured-post">
          <div class="featured-post__meta">
            <span>{locale === "zh-cn" ? "最新文章" : "Latest article"}</span>
            <time datetime={featuredPost.data.date.toISOString()}>{dateStr}</time>
          </div>
          <h2><a href={postUrl}>{featuredPost.data.title}</a></h2>
          {featuredPost.data.description && <p>{featuredPost.data.description}</p>}
          <a class="featured-post__link" href={postUrl}>
            {locale === "zh-cn" ? "阅读全文" : "Read article"}
            <span class="material-icons-sharp" aria-hidden="true">arrow_forward</span>
          </a>
        </article>
      );
    })()}
    <CollectionPostGrid posts={listPosts} {locale} variant="list" />
    {totalPages > 1 && (
      <PaginationNav {currentPage} {totalPages} {locale} />
    )}
  </div>
</Layout>

<style>
  .featured-post {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    gap: 0 3rem;
    margin-block-end: 1rem;
    padding: clamp(1.4rem, 3vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .featured-post__meta {
    display: flex;
    grid-column: 1 / -1;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .5rem 1rem;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .featured-post h2 {
    margin: .8rem 0 .6rem;
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 3vw, 2.3rem);
    line-height: 1.3;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .featured-post h2 a { color: inherit; text-decoration: none; }
  .featured-post h2 a:hover { color: var(--color-theme); }
  .featured-post p { margin: .8rem 0 0; color: var(--color-text-secondary); line-height: 1.7; }
  .featured-post__link {
    grid-column: 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    min-height: 44px;
    color: var(--color-theme);
    font-weight: 700;
    text-decoration: none;
  }
  .featured-post__link:hover { text-decoration: underline; }
  @media (max-width: 700px) {
    .featured-post { grid-template-columns: minmax(0, 1fr); }
    .featured-post p { margin-top: .3rem; }
    .featured-post__link { margin-top: .75rem; }
  }
</style>
