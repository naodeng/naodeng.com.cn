---
import { LOCALES, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { DSH_QA_SITE } from "@/data/dshQaSite";

export const getStaticPaths = () => Object.keys(LOCALES).map((lang) => ({ params: { lang } }));

const locale = Astro.currentLocale as Lang;
const site = DSH_QA_SITE[locale];
const homeName = locale === "zh-cn" ? "首页" : "Home";
const breadcrumbs = [
  { name: homeName, url: `/${locale}/` },
  { name: "dsh-qa", url: `/${locale}/dsh-qa/` },
];
const pluginCommand = site.installModes.find((mode) => mode.id === "install-plugin")?.commands[0] ?? "npx @deepseek-ai/dsh plugin --profile web add dsh-qa";
const standaloneCommand = site.installModes.find((mode) => mode.id === "install-standalone")?.commands[0] ?? "npm install -g dsh-qa";
const copyLabels = locale === "zh-cn"
  ? { copy: "复制命令", copied: "已复制", unavailable: "无法复制，请手动选择命令" }
  : { copy: "Copy command", copied: "Copied", unavailable: "Copy unavailable; select the command manually" };
const latestRelease = site.releases[0];
const historicalReleases = site.releases.slice(1);
---

<Layout title={site.meta.title} description={site.meta.description} breadcrumbs={breadcrumbs}>
  <div class="dsh-qa-page" data-dsh-qa-page>
    <section class="hero" aria-labelledby="dsh-qa-title">
      <div class="hero-copy">
        <h1 id="dsh-qa-title">{site.hero.title}</h1>
        <p class="hero-summary">{site.hero.summary}</p>
        <div class="hero-actions">
          {site.hero.actions.map((action) => <a class:list={["hero-action", { primary: action.external }]} href={action.href} target={action.external ? "_blank" : undefined} rel={action.external ? "noopener noreferrer" : undefined} data-dsh-qa-action>{action.label}<span aria-hidden="true">{action.external ? "↗" : "↓"}</span></a>)}
        </div>
        <a class="latest-release" href={site.hero.latestRelease.url} target="_blank" rel="noopener noreferrer" data-dsh-qa-latest-release>
          <span>{locale === "zh-cn" ? "最新版本" : "Latest release"}</span>
          <strong>{site.hero.latestRelease.version}</strong>
          <time datetime={site.hero.latestRelease.publishedAt}>{site.hero.latestRelease.publishedAt}</time>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="hero-side">
        <div class="hero-panel" data-ui="gate-status" aria-label={locale === "zh-cn" ? "质量门禁状态" : "Quality gate states"}>
          <div class="panel-heading"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{locale === "zh-cn" ? "本地 QA 工作区" : "Local QA workspace"}</span></div>
          <p>{locale === "zh-cn" ? "交付门禁" : "Delivery gate"}</p>
          <div class="gate-states"><span class="gate-pass">PASS</span><span class="gate-warn">WARN</span><span class="gate-block">BLOCK</span></div>
          <span>{locale === "zh-cn" ? "证据先于结论，最终决策由人保留。" : "Evidence precedes conclusions; people retain the final decision."}</span>
        </div>
        <div class="command-card" data-ui="install-command" data-dsh-command-card data-copy-state="idle" data-command={standaloneCommand}>
          <div class="command-tabs" role="group" aria-label={locale === "zh-cn" ? "安装方式" : "Installation method"}>
            <button type="button" aria-pressed="true" data-dsh-command-tab data-command={standaloneCommand}>{locale === "zh-cn" ? "独立安装" : "Standalone"}</button>
            <button type="button" aria-pressed="false" data-dsh-command-tab data-command={pluginCommand}>{locale === "zh-cn" ? "Harness 插件" : "Harness plugin"}</button>
          </div>
          <div class="command-line">
            <code data-dsh-command-value><span aria-hidden="true">$</span> {standaloneCommand}</code>
            <button type="button" data-dsh-command-copy data-copied-label={copyLabels.copied} data-copy-error-label={copyLabels.unavailable}><span class="material-icons-sharp" aria-hidden="true">content_copy</span>{copyLabels.copy}</button>
          </div>
          <span class="visually-hidden" aria-live="polite" data-dsh-command-feedback></span>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="features-title">
      <div class="section-heading"><h2 id="features-title">{site.labels.features}</h2></div>
      <div class="feature-grid">
        {site.features.map((feature) => <article class="feature-card" data-dsh-qa-feature><span class="material-icons-sharp" aria-hidden="true">{feature.icon}</span><h3>{feature.title}</h3><p>{feature.description}</p></article>)}
      </div>
    </section>

    <section class="section showcase" aria-labelledby="showcase-title">
      <div class="section-heading"><h2 id="showcase-title">{site.labels.showcase}</h2></div>
      <div class="showcase-grid">
        {site.showcase.map((item, index) => <article class="showcase-card" data-dsh-qa-showcase>
          <img src={item.image} width={item.width} height={item.height} alt={item.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" fetchpriority={index === 0 ? "high" : "auto"} />
          <div><h3>{item.title}</h3><p>{item.description}</p></div>
        </article>)}
      </div>
    </section>

    <section class="section flow-section" aria-labelledby="flow-title">
      <div class="section-heading"><h2 id="flow-title">{site.labels.flow}</h2></div>
      <ol class="flow-list">
        {site.deliveryFlow.map((stage, index) => <li data-dsh-qa-flow-stage><span class="flow-index">{index + 1}</span><div><h3>{stage.title}</h3><p>{stage.description}</p></div><span class:list={["flow-status", stage.status.toLowerCase()]}>{stage.status}</span></li>)}
      </ol>
    </section>

    <section class="section" aria-labelledby="install-title">
      <div class="section-heading"><h2 id="install-title">{site.labels.install}</h2></div>
      <div class="install-grid">
        {site.installModes.map((mode) => <article class="install-card" id={mode.id} data-install-mode><h3>{mode.title}</h3><p>{mode.description}</p><span class="command-label">{site.labels.commandLabel}</span>{mode.commands.map((command) => <pre><code>{command}</code></pre>)}</article>)}
      </div>
    </section>

    <section class="section ecosystem" aria-labelledby="ecosystem-title">
      <div class="section-heading"><h2 id="ecosystem-title">{site.labels.ecosystem}</h2></div>
      <div class="ecosystem-links">{site.ecosystemLinks.map((link) => <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>{link.label}<span aria-hidden="true">→</span></a>)}</div>
    </section>

    <section class="section releases" data-release-notes aria-labelledby="releases-title">
      <div class="section-heading"><h2 id="releases-title">{site.labels.releaseNotes}</h2></div>
      <article class="current-release" data-dsh-current-release>
        <div class="current-release-heading"><span>{locale === "zh-cn" ? "当前版本" : "Current release"}</span><strong>{latestRelease.version}</strong><time datetime={latestRelease.publishedAt}>{latestRelease.publishedAt}</time></div>
        <p>{latestRelease.summary}</p>
        <div class="release-body"><ul>{latestRelease.changes.map((change) => <li>{change}</li>)}</ul><a href={latestRelease.url} target="_blank" rel="noopener noreferrer">{site.labels.releaseLink} <span aria-hidden="true">↗</span></a></div>
      </article>
      <details class="release-history" data-dsh-release-history>
        <summary>{locale === "zh-cn" ? "查看历史版本" : "View release history"}<span aria-hidden="true">↓</span></summary>
        <div class="release-list">
          {historicalReleases.map((release) => <details data-release-note><summary><span><strong>{release.version}</strong><time datetime={release.publishedAt}>{release.publishedAt}</time></span><span>{release.summary}</span></summary><div class="release-body"><ul>{release.changes.map((change) => <li>{change}</li>)}</ul><a href={release.url} target="_blank" rel="noopener noreferrer">{site.labels.releaseLink} <span aria-hidden="true">↗</span></a></div></details>)}
        </div>
      </details>
    </section>
  </div>
</Layout>

<script>
  const copyCommand = async (button: HTMLButtonElement) => {
    const card = button.closest<HTMLElement>("[data-dsh-command-card]");
    const feedback = card?.querySelector<HTMLElement>("[data-dsh-command-feedback]");
    if (!card || !feedback) return;

    try {
      await navigator.clipboard.writeText(card.dataset.command || "");
    } catch {
      card.dataset.copyState = "failed";
      feedback.textContent = button.dataset.copyErrorLabel || "Copy unavailable; select the command manually";
      return;
    }

    card.dataset.copyState = "copied";
    feedback.textContent = button.dataset.copiedLabel || "Copied";
  };

  document.querySelectorAll<HTMLButtonElement>("[data-dsh-command-copy]").forEach((button) => {
    button.addEventListener("click", () => void copyCommand(button));
  });

  document.querySelectorAll<HTMLButtonElement>("[data-dsh-command-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const card = tab.closest<HTMLElement>("[data-dsh-command-card]");
      const value = card?.querySelector<HTMLElement>("[data-dsh-command-value]");
      if (!card || !value) return;
      card.dataset.command = tab.dataset.command || "";
      card.dataset.copyState = "idle";
      value.lastChild!.textContent = ` ${card.dataset.command}`;
      card.querySelectorAll<HTMLButtonElement>("[data-dsh-command-tab]").forEach((button) => {
        button.setAttribute("aria-pressed", String(button === tab));
      });
    });
  });
</script>
\n<style>
  .dsh-qa-page {
    --page-line: var(--color-border);
    --page-soft: color-mix(in srgb, var(--color-theme) 4%, var(--color-surface));
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: 2rem 0 5rem;
    color: var(--color-main);
  }
  .dsh-qa-page h1,
  .dsh-qa-page h2,
  .dsh-qa-page h3 { color: var(--color-main); }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, .8fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding: 1.5rem 0 3rem;
  }
  .hero-copy { min-width: 0; }
  .hero h1 {
    margin: 0;
    font-size: clamp(3.4rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: -.065em;
    line-height: .98;
  }
  .hero-summary {
    max-width: 42rem;
    margin: 1.25rem 0 0;
    color: var(--color-text-secondary);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.65;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.6rem; }
  .hero-action,
  .ecosystem-links a,
  .release-body a {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: .65rem;
    min-height: 2.8rem;
    padding: .65rem .9rem;
    border: 1px solid var(--page-line);
    border-radius: var(--radius-sm);
    color: var(--color-main);
    background: var(--color-surface);
    text-decoration: none;
    font-weight: 700;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }
  .hero-action.primary { border-color: var(--color-theme); background: var(--color-theme); color: var(--color-theme-on-dark); }
  .hero-action:hover,
  .hero-action:focus-visible,
  .ecosystem-links a:hover,
  .ecosystem-links a:focus-visible,
  .release-body a:hover,
  .release-body a:focus-visible { border-color: var(--color-theme); background: var(--color-theme-soft); color: var(--color-main); }
  .hero-action.primary:hover,
  .hero-action.primary:focus-visible { background: var(--color-theme-focus); color: var(--color-theme-on-dark); }
  .latest-release {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .35rem .65rem;
    margin-top: 1.2rem;
    color: var(--color-text-secondary);
    font-size: .9rem;
    text-decoration: none;
  }
  .latest-release strong { color: var(--color-theme); }
  .latest-release:hover strong,
  .latest-release:focus-visible strong { text-decoration: underline; text-underline-offset: .2em; }
  .hero-side { display: grid; gap: .8rem; min-width: 0; }
  .hero-panel,
  .command-card,
  .feature-card,
  .install-card,
  .showcase-card,
  .current-release,
  .release-history {
    border: 1px solid var(--page-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .hero-panel { display: grid; gap: .85rem; padding: 1rem 1.1rem 1.1rem; }
  .panel-heading { display: flex; align-items: center; gap: .65rem; color: var(--color-text-secondary); font-size: .82rem; }
  .window-dots { display: inline-flex; gap: .28rem; }
  .window-dots i { width: .5rem; height: .5rem; border-radius: 50%; background: var(--color-border-strong); }
  .window-dots i:first-child { background: var(--color-theme); }
  .hero-panel > p { margin: .35rem 0 0; font-size: .9rem; font-weight: 700; }
  .gate-states { display: flex; flex-wrap: wrap; gap: .45rem; }
  .gate-states span { padding: .24rem .55rem; border-radius: 999px; font-size: .78rem; font-weight: 800; }
  .gate-pass { background: color-mix(in srgb, var(--color-success-text) 12%, var(--color-surface)); color: var(--color-success-text); }
  .gate-warn { background: color-mix(in srgb, var(--color-warn) 12%, var(--color-surface)); color: var(--color-warn); }
  .gate-block { background: color-mix(in srgb, var(--color-caution) 11%, var(--color-surface)); color: var(--color-caution); }
  .hero-panel > span { color: var(--color-text-secondary); font-size: .92rem; line-height: 1.5; }
  .command-card { overflow: hidden; background: var(--color-code-surface); }
  .command-tabs { display: flex; flex-wrap: wrap; gap: .35rem; padding: .55rem .65rem; border-bottom: 1px solid var(--page-line); background: var(--color-surface); }
  .command-tabs button {
    min-height: 2.2rem;
    padding: .45rem .7rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--color-text-secondary);
    background: transparent;
    font: inherit;
    font-size: .8rem;
    font-weight: 700;
    cursor: pointer;
  }
  .command-tabs button[aria-pressed="true"] { border-color: var(--page-line); color: var(--color-theme); background: var(--color-theme-soft); }
  .command-line { display: flex; align-items: center; gap: .5rem; min-width: 0; padding: .35rem .55rem .35rem .9rem; }
  .command-card button[data-dsh-command-copy] { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .35rem; min-height: 2.2rem; padding: .35rem .45rem; border: 0; border-radius: var(--radius-sm); color: var(--color-text-secondary); background: transparent; font: inherit; font-size: .78rem; font-weight: 700; cursor: pointer; }
  .command-card button:hover,
  .command-card button:focus-visible { color: var(--color-theme); background: var(--color-theme-soft); }
  .command-card button .material-icons-sharp { font-size: 1rem; }
  .command-card code { display: block; flex: 1 1 auto; min-width: 0; padding: .65rem 0; color: var(--color-main); font-family: ui-monospace, monospace; font-size: clamp(.75rem, 1.3vw, .9rem); line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
  .command-card code span { color: var(--color-theme); }
  .command-card[data-copy-state="copied"] [data-dsh-command-copy] { color: var(--color-success-text); }
  .command-card[data-copy-state="failed"] [data-dsh-command-copy] { color: var(--color-caution); }
  .section { padding-top: clamp(3rem, 6vw, 5rem); }
  .section-heading { display: flex; align-items: baseline; gap: .8rem; }
  .section h2 { margin: 0; font-size: clamp(1.55rem, 3vw, 2.3rem); line-height: 1.2; }
  .feature-grid,
  .install-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; margin-top: 1.15rem; }
  .feature-card,
  .install-card { min-width: 0; padding: 1.15rem; transition: border-color var(--transition-fast), transform var(--transition-fast), background-color var(--transition-fast); }
  .feature-card:hover,
  .install-card:hover { transform: translateY(-2px); border-color: var(--color-border-strong); background: var(--page-soft); }
  .feature-card .material-icons-sharp { color: var(--color-theme); }
  .feature-card h3,
  .install-card h3,
  .flow-list h3,
  .showcase-card h3 { margin: .65rem 0 .4rem; font-size: 1.1rem; line-height: 1.35; }
  .feature-card p,
  .install-card p,
  .flow-list p,
  .showcase-card p { margin: 0; color: var(--color-text-secondary); line-height: 1.55; }
  .showcase-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; margin-top: 1.15rem; }
  .showcase-card { min-width: 0; overflow: hidden; transition: transform var(--transition-fast), border-color var(--transition-fast); }
  .showcase-card:hover { transform: translateY(-2px); border-color: var(--color-border-strong); }
  .showcase-card img { display: block; width: 100%; height: auto; background: var(--color-code-surface); }
  .showcase-card > div { min-height: 7.5rem; padding: .9rem 1rem 1rem; background: var(--color-code-surface); }
  .showcase-card h3 { margin-top: 0; }
  .showcase-card p { font-size: .93rem; }
  .flow-list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .55rem; margin: 1.15rem 0 0; padding: 0; list-style: none; }
  .flow-list li { min-width: 0; padding: .85rem; border: 1px solid var(--page-line); border-radius: var(--radius-md); background: var(--color-surface); }
  .flow-index { color: var(--color-theme); font-size: .8rem; font-variant-numeric: tabular-nums; font-weight: 700; }
  .flow-list h3 { margin-top: .65rem; }
  .flow-list p { font-size: .9rem; }
  .flow-status { display: inline-flex; margin-top: .7rem; padding: .2rem .5rem; border-radius: 999px; background: var(--color-theme-soft); color: var(--color-theme); font-size: .7rem; font-weight: 800; }
  .flow-status.pass { background: color-mix(in srgb, var(--color-success-text) 12%, var(--color-surface)); color: var(--color-success-text); }
  .command-label { display: block; margin-top: 1rem; color: var(--color-text-tertiary); font-size: .82rem; font-weight: 700; }
  .install-card pre { overflow: visible; margin: .45rem 0 0; padding: .75rem; border: 1px solid var(--page-line); border-radius: var(--radius-sm); background: var(--color-code-surface); color: var(--color-main); font-size: .82rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  .install-card code { font-family: ui-monospace, monospace; overflow-wrap: anywhere; white-space: inherit; }
  .ecosystem-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: .55rem; margin-top: 1.15rem; }
  .ecosystem-links a { gap: 1rem; }
  .current-release { margin-top: 1.15rem; padding: 1.1rem; background: var(--page-soft); }
  .current-release-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem .65rem; }
  .current-release-heading > span { color: var(--color-text-secondary); font-size: .84rem; }
  .current-release-heading strong { font-size: 1.2rem; }
  .current-release-heading time,
  .release-list time { color: var(--color-text-secondary); font-size: .83rem; }
  .current-release > p { margin: .7rem 0; font-weight: 700; line-height: 1.5; }
  .release-body { color: var(--color-text-secondary); }
  .release-body ul { margin: .7rem 0 1rem; padding-inline-start: 1.25rem; line-height: 1.6; }
  .release-body a { display: flex; width: fit-content; min-height: 2.6rem; }
  .release-history { margin-top: .65rem; overflow: hidden; }
  .release-history > summary,
  .release-list summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 1rem; cursor: pointer; font-weight: 700; }
  .release-history > summary { min-height: 3rem; }
  .release-history[open] > summary { background: var(--page-soft); }
  .release-history > .release-list { display: grid; gap: .5rem; margin: 0; padding: .6rem; }
  .release-list details { border: 1px solid var(--page-line); border-radius: var(--radius-sm); background: var(--color-surface); }
  .release-list summary > span:first-child { display: flex; flex: 0 0 auto; align-items: baseline; gap: .65rem; }
  .release-list summary > span:last-child { color: var(--color-text-secondary); font-weight: 400; text-align: end; }
  .release-list details[open] { background: var(--page-soft); }
  .release-list .release-body { padding: 0 1rem 1rem; }
  .dsh-qa-page a:focus-visible,
  .dsh-qa-page button:focus-visible,
  .dsh-qa-page summary:focus-visible { outline: 2px solid var(--color-theme-focus); outline-offset: 3px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 1000px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(17rem, .85fr); gap: 2rem; }
    .showcase-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flow-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .dsh-qa-page { padding: 1.25rem 0 4rem; }
    .hero { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding: 1rem 0 2rem; }
    .hero h1 { font-size: clamp(3.4rem, 16vw, 5rem); }
    .hero-summary { margin-top: .9rem; font-size: 1.08rem; }
    .hero-side { gap: .65rem; }
    .section { padding-top: 2.8rem; }
    .feature-grid,
    .install-grid,
    .showcase-grid { grid-template-columns: minmax(0, 1fr); }
    .flow-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .showcase-card > div { min-height: 0; }
    .release-list summary { align-items: flex-start; }
    .release-list summary > span:last-child { text-align: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-action,
    .feature-card,
    .install-card,
    .showcase-card { transition: none; }
  }
</style>
