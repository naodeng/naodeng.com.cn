---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import { useTranslations, type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  PROMPTS_PAGE_TITLE,
  PROMPTS_PAGE_DESCRIPTION,
  PROMPTS_WORKFLOWS_SECTION_TITLE,
  PROMPTS_QUICKSTART_TITLE,
  PROMPTS_FLOW_TITLE,
} from "@/consts";
import GoogleAd from "@/components/GoogleAd.astro";
import PromptVersionGuide from "@/components/prompts/PromptVersionGuide.astro";
import PromptExamples from "@/components/prompts/PromptExamples.astro";
import AIOutputNotice from "@/components/prompts/AIOutputNotice.astro";
import {
  PROMPT_EXAMPLES,
  PROMPT_QUICK_STEPS,
  PROMPT_TYPE_COPY,
  PROMPT_VERSION_GUIDE,
  type PromptTestingType,
} from "@/data/promptLibrary";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "zh-cn" } },
  ];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Fetch prompts for this locale, group by testingType, take first per type
const allPrompts = await getCollection("prompts");
const localePrompts = allPrompts.filter((p) => p.data.lang === lang);

const TESTING_TYPE_ORDER = [
  "requirements-analysis",
  "test-case-writing",
  "functional-testing",
  "performance-testing",
  "automation-testing",
  "mobile-testing",
  "bug-reporting",
  "test-reporting",
  "test-strategy",
  "ai-assisted-testing",
  "manual-testing",
  "security-testing",
  "api-testing",
  "accessibility-testing",
  "test-case-reviewer",
];

// Group by testingType, keep lowest-order entry per type for card display
const typeMap = new Map<string, typeof localePrompts[0]>();
for (const p of localePrompts.sort((a, b) => a.data.order - b.data.order)) {
  if (!typeMap.has(p.data.testingType)) {
    typeMap.set(p.data.testingType, p);
  }
}
const typeCards = Array.from(typeMap.values()).sort(
  (a, b) => TESTING_TYPE_ORDER.indexOf(a.data.testingType) - TESTING_TYPE_ORDER.indexOf(b.data.testingType)
);

// Fetch workflows for this locale, sorted by order
const allWorkflows = await getCollection("workflows");
const localeWorkflows = allWorkflows
  .filter((w) => w.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
const promptCount = localePrompts.length;
const testingTypeCount = typeCards.length;
const workflowCount = localeWorkflows.length;

const breadcrumbs = [
  { name: lang === "zh-cn" ? "首页" : "Home", url: getRelativeLocaleUrl(lang, "/") },
  { name: t(PROMPTS_PAGE_TITLE), url: getRelativeLocaleUrl(lang, "/prompts") },
];

const siteOrigin = "https://inaodeng.com";
const promptsKeywords = lang === "zh-cn"
  ? "QA提示词, AI测试提示词, 软件测试AI, ChatGPT测试, 测试自动化提示词, 需求分析提示词, 测试用例提示词"
  : "QA prompt, AI testing prompt, software testing AI, ChatGPT testing, test automation prompt, requirements analysis prompt";

// ItemList JSON-LD for the prompts index
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t(PROMPTS_PAGE_TITLE),
  description: t(PROMPTS_PAGE_DESCRIPTION),
  url: `${siteOrigin}${getRelativeLocaleUrl(lang, "/prompts/")}`,
  inLanguage: lang === "zh-cn" ? "zh-CN" : "en",
  numberOfItems: typeCards.length,
  itemListElement: typeCards.map((entry, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: entry.data.title.replace(/^[^-]+ - /, ""),
    url: `${siteOrigin}${getRelativeLocaleUrl(lang, `/prompts/${entry.data.testingType}/`)}`,
  })),
};
---

<Base
  title={t(PROMPTS_PAGE_TITLE)}
  description={t(PROMPTS_PAGE_DESCRIPTION)}
  keywords={promptsKeywords}
  extraStructuredData={[itemListSchema]}
  breadcrumbs={breadcrumbs}
>
  <div class="prompts-page">
    <header class="prompts-header">
      <div class="prompts-hero">
        <div class="prompts-hero-text">
          <h1>{lang === "zh-cn" ? "软件测试提示词库" : "QA Prompt Library"}</h1>
          <p class="prompts-hero-sub">
            {lang === "zh-cn" ? "专业的质量保证 AI 提示词库" : "Professional QA AI Prompt Library"}
          </p>
          <p class="prompts-intro">
            {lang === "zh-cn"
              ? `覆盖 ${testingTypeCount} 个测试类型、${workflowCount} 个工作流程与 ${promptCount} 个专业提示词的 AI 测试资源库`
              : `An AI testing resource library covering ${testingTypeCount} testing types, ${workflowCount} workflows, and ${promptCount} professional prompts`
            }
          </p>
          <div class="prompts-hero-actions">
            <a href="#quickstart-heading" class="hero-btn hero-btn--primary">
              {lang === "zh-cn" ? "快速开始" : "Quick Start"}
            </a>
            <a href="#workflows-heading" class="hero-btn hero-btn--outline">
              {lang === "zh-cn" ? "查看工作流程" : "View Workflows"}
            </a>
            <a href="https://github.com/naodeng/awesome-qa-prompt" target="_blank" rel="noopener noreferrer" class="hero-btn hero-btn--github">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
              GitHub
            </a>
          </div>
        </div>
        <div class="prompts-hero-img">
          <div class="prompt-console" aria-hidden="true">
            <div class="prompt-console-bar">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="prompt-console-body">
              <span class="prompt-label">{lang === "zh-cn" ? "测试提示词" : "QA Prompt"}</span>
              <strong>{lang === "zh-cn" ? "生成高覆盖率测试用例" : "Generate high-coverage test cases"}</strong>
              <p>{lang === "zh-cn" ? "输入需求、接口或用户故事，输出结构化测试策略。" : "Turn requirements, APIs, or user stories into a structured testing strategy."}</p>
              <div class="prompt-lines">
                <span></span>
                <span></span>
                <span></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Testing Type Cards -->
    <section class="prompts-section" aria-labelledby="testing-types-heading">
      <h2 id="testing-types-heading">
        {lang === "zh-cn" ? "测试类型" : "Testing Types"}
      </h2>
      <ul class="prompts-grid" role="list">
        {typeCards.map((entry) => (
          <li>
            <a
              href={getRelativeLocaleUrl(lang, `/prompts/${entry.data.testingType}/`)}
              class="prompt-card"
              data-prompt-type={entry.data.testingType}
            >
              <h3 class="prompt-card-title">{entry.data.title.replace(/^[^-]+ - /, "")}</h3>
              <p class="prompt-card-desc">{PROMPT_TYPE_COPY[lang][entry.data.testingType as PromptTestingType].description}</p>
              <span class="prompt-card-cta" aria-hidden="true">
                {lang === "zh-cn" ? "查看提示词 →" : "View prompts →"}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <PromptVersionGuide lang={lang} items={PROMPT_VERSION_GUIDE[lang]} />

    <section class="prompts-section" aria-labelledby="quickstart-heading">
      <h2 id="quickstart-heading">{t(PROMPTS_QUICKSTART_TITLE)}</h2>
      <ol class="qs-grid">
        {PROMPT_QUICK_STEPS[lang].map((step, index) => (
          <li class="qs-card" data-prompt-quick-step>
            <span class="qs-num">{index + 1}</span>
            <h3 class="qs-title">{step.title}</h3>
            <p class="qs-desc">{step.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <PromptExamples lang={lang} examples={PROMPT_EXAMPLES[lang]} />
    <AIOutputNotice lang={lang} />

    <GoogleAd />

    <!-- Full Testing Flow -->
    <section class="prompts-section" aria-labelledby="flow-heading">
      <h2 id="flow-heading">{t(PROMPTS_FLOW_TITLE)}</h2>
      <div class="flow-wrap">
        {([
          {
            icon: "📝",
            slug: "requirements-analysis",
            label: lang === "zh-cn" ? "需求分析" : "Requirements Analysis",
            desc: lang === "zh-cn" ? "深度分析需求文档，设计全维度测试场景" : "Analyze requirements and design comprehensive test scenarios",
          },
          {
            icon: "🎯",
            slug: "test-strategy",
            label: lang === "zh-cn" ? "测试策略" : "Test Strategy",
            desc: lang === "zh-cn" ? "制定整体测试策略和测试计划" : "Define overall test strategy and test plan",
          },
          {
            icon: "✍️",
            slug: "test-case-writing",
            label: lang === "zh-cn" ? "测试用例编写" : "Test Case Writing",
            desc: lang === "zh-cn" ? "基于测试场景生成详细测试用例" : "Generate detailed test cases from test scenarios",
          },
          {
            icon: "🔍",
            slug: "functional-testing",
            label: lang === "zh-cn" ? "功能测试" : "Functional Testing",
            desc: lang === "zh-cn" ? "执行功能测试，确保功能完整性" : "Execute functional tests to ensure completeness",
          },
          {
            icon: "🤖",
            slug: "automation-testing",
            label: lang === "zh-cn" ? "自动化测试" : "Automation Testing",
            desc: lang === "zh-cn" ? "设计自动化测试脚本和框架" : "Design automation test scripts and frameworks",
          },
          {
            icon: "⚡",
            slug: "performance-testing",
            label: lang === "zh-cn" ? "性能测试" : "Performance Testing",
            desc: lang === "zh-cn" ? "设计性能测试场景和指标分析" : "Design performance test scenarios and metrics",
          },
          {
            icon: "🔒",
            slug: "security-testing",
            label: lang === "zh-cn" ? "安全测试" : "Security Testing",
            desc: lang === "zh-cn" ? "检测安全漏洞和安全测试策略" : "Detect vulnerabilities and define security strategy",
          },
          {
            icon: "🐛",
            slug: "bug-reporting",
            label: lang === "zh-cn" ? "缺陷上报" : "Bug Reporting",
            desc: lang === "zh-cn" ? "标准化缺陷报告和根因分析" : "Standardized bug reports and root cause analysis",
          },
          {
            icon: "📊",
            slug: "test-reporting",
            label: lang === "zh-cn" ? "测试报告" : "Test Reporting",
            desc: lang === "zh-cn" ? "生成测试执行报告和质量分析" : "Generate test execution reports and quality analysis",
          },
        ] as const).map((step, i, arr) => (
          <>
            <a
              href={getRelativeLocaleUrl(lang, `/prompts/${step.slug}/`)}
              class="flow-node"
            >
              <span class="flow-icon" aria-hidden="true">{step.icon}</span>
              <span class="flow-label">{step.label}</span>
              <span class="flow-desc">{step.desc}</span>
            </a>
            {i < arr.length - 1 && (
              <span class="flow-arrow" aria-hidden="true">→</span>
            )}
          </>
        ))}
      </div>
    </section>

    <!-- Workflow Cards -->
    <section class="prompts-section" aria-labelledby="workflows-heading">
      <h2 id="workflows-heading">{t(PROMPTS_WORKFLOWS_SECTION_TITLE)}</h2>
      <ul class="workflows-grid" role="list">
        {localeWorkflows.map((wf) => (
          <li>
            <a
              href={getRelativeLocaleUrl(lang, `/prompts/workflows/${wf.data.workflowType}/`)}
              class="workflow-card"
            >
              <h3 class="workflow-card-title">{wf.data.title}</h3>
              <p class="workflow-card-desc">{wf.data.description}</p>
              <span class="workflow-card-cta" aria-hidden="true">
                {lang === "zh-cn" ? "查看工作流程 →" : "View workflow →"}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <GoogleAd />
  </div>
</Base>

<style>
  .prompts-page {
    padding-block: var(--sp-m);
    max-inline-size: 1400px;
    margin-inline: auto;
  }

  /* ── Hero header ── */
  .prompts-header {
    margin-block-end: 2rem;
  }

  .prompts-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    align-items: center;
    gap: 2rem;
    padding: 2rem;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 28px;
    background:
      radial-gradient(circle at 18% 12%, rgba(79, 70, 229, 0.16), transparent 34%),
      radial-gradient(circle at 92% 18%, rgba(20, 184, 166, 0.16), transparent 30%),
      rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .prompts-hero-text {
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .prompts-hero-text h1 {
    font-size: 46px;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.08;
  }

  .prompts-hero-sub {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-theme);
    margin: 0;
  }

  .prompts-intro {
    max-width: 58ch;
    font-size: 1.02rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .prompts-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.65em 1.25em;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .hero-btn--primary {
    background: var(--gradient-theme);
    color: #fff;
    border: 1px solid transparent;
    box-shadow: 0 14px 28px rgba(79, 70, 229, 0.2);
  }

  .hero-btn--primary:hover {
    transform: translateY(-1px);
  }

  .hero-btn--outline {
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-text-primary);
    border: 1px solid rgba(148, 163, 184, 0.28);
  }

  .hero-btn--outline:hover {
    border-color: rgba(79, 70, 229, 0.42);
    color: var(--color-theme);
    transform: translateY(-1px);
  }

  .hero-btn--github {
    background: rgba(15, 23, 42, 0.04);
    color: var(--color-text-primary);
    border: 1px solid rgba(15, 23, 42, 0.1);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-btn--github:hover {
    border-color: rgba(15, 23, 42, 0.22);
    color: var(--color-main);
    transform: translateY(-1px);
  }

  .prompts-hero-img {
    min-width: 0;
  }

  .prompt-console {
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .prompt-console-bar {
    display: flex;
    gap: 0.45rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(248, 250, 252, 0.9);
  }

  .prompt-console-bar span {
    width: 0.64rem;
    height: 0.64rem;
    border-radius: 999px;
    background: rgba(79, 70, 229, 0.42);
  }

  .prompt-console-bar span:nth-child(2) {
    background: rgba(20, 184, 166, 0.42);
  }

  .prompt-console-bar span:nth-child(3) {
    background: rgba(245, 158, 11, 0.5);
  }

  .prompt-console-body {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .prompt-label {
    width: fit-content;
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
    background: rgba(20, 184, 166, 0.12);
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .prompt-console-body strong {
    font-family: var(--font-heading);
    font-size: 1.08rem;
    color: var(--color-text-primary);
  }

  .prompt-console-body p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .prompt-lines {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .prompt-lines span {
    height: 0.62rem;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(79, 70, 229, 0.18), rgba(20, 184, 166, 0.12));
  }

  .prompt-lines span:nth-child(2) {
    width: 76%;
  }

  .prompt-lines span:nth-child(3) {
    width: 58%;
  }

  /* ── Sections ── */
  .prompts-section {
    margin-block-end: 2.5rem;
  }

  .prompts-section h2 {
    font-size: 1.35rem;
    font-weight: 800;
    margin-block-end: 1rem;
    padding-block-end: 0.4em;
    border-block-end: 1px solid rgba(148, 163, 184, 0.22);
    color: var(--color-text-primary);
  }

  .prompts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--sp-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .workflows-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--sp-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .prompt-card,
  .workflow-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--sp-m);
    border-radius: 18px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .prompt-card:hover,
  .workflow-card:hover {
    border-color: rgba(79, 70, 229, 0.36);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .prompt-card:focus-visible,
  .workflow-card:focus-visible {
    outline: 2px solid var(--color-theme);
    outline-offset: 2px;
  }

  .prompt-card-title,
  .workflow-card-title {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-theme);
    margin: 0;
    line-height: 1.3;
  }

  .prompt-card-desc,
  .workflow-card-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  .prompt-card-cta,
  .workflow-card-cta {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-theme);
    margin-block-start: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .prompt-card,
    .workflow-card {
      transition: none;
      transform: none !important;
    }
  }

  /* ── Quick Start ── */
  .qs-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-m);
  }

  .qs-card {
    padding: var(--sp-m);
    border-radius: 18px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .qs-num {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--gradient-theme);
    color: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-block-end: 0.25rem;
  }

  .qs-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .qs-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .qs-list {
    margin: 0.25rem 0 0;
    padding-inline-start: 1.25em;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* ── Full Testing Flow ── */
  .flow-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-s);
    padding: var(--sp-m);
    border-radius: 20px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: rgba(255, 255, 255, 0.76);
  }

  /* each cell = node + optional arrow, laid out as a row pair */
  .flow-cell {
    display: contents;
  }

  .flow-node {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: var(--sp-s) var(--sp-m);
    border-radius: 16px;
