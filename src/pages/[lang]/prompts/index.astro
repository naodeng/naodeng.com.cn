---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import { useTranslations, type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  PROMPTS_PAGE_TITLE,
  PROMPTS_PAGE_DESCRIPTION,
  PROMPTS_WORKFLOWS_SECTION_TITLE,
  PROMPTS_QUICKSTART_TITLE,
  PROMPTS_FLOW_TITLE,
} from "@/consts";
import PromptExamples from "@/components/prompts/PromptExamples.astro";
import AIOutputNotice from "@/components/prompts/AIOutputNotice.astro";
import {
  PROMPT_ASSISTED_FLOW,
  PROMPT_EXAMPLES,
  PROMPT_QUICK_STEPS,
} from "@/data/promptLibrary";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "zh-cn" } },
  ];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Each upstream category has one canonical prompt.
const allPrompts = await getCollection("prompts");
const localePrompts = allPrompts.filter((p) => p.data.lang === lang);
const promptCategories = Array.from(
  localePrompts.reduce((categories, prompt) => {
    const existing = categories.get(prompt.data.category) ?? {
      title: prompt.data.category,
      order: prompt.data.categoryOrder,
      prompts: [],
    };
    existing.prompts.push(prompt);
    categories.set(prompt.data.category, existing);
    return categories;
  }, new Map<string, { title: string; order: number; prompts: typeof localePrompts }>()).values(),
).sort((a, b) => a.order - b.order || a.title.localeCompare(b.title, lang));

for (const category of promptCategories) {
  category.prompts.sort((a, b) => a.data.title.localeCompare(b.data.title, lang));
}

// Fetch workflows for this locale, sorted by order
const allWorkflows = await getCollection("workflows");
const localeWorkflows = allWorkflows
  .filter((w) => w.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
const promptCount = localePrompts.length;
const categoryCount = promptCategories.length;
const workflowCount = localeWorkflows.length;

const breadcrumbs = [
  { name: lang === "zh-cn" ? "首页" : "Home", url: getRelativeLocaleUrl(lang, "/") },
  { name: t(PROMPTS_PAGE_TITLE), url: getRelativeLocaleUrl(lang, "/prompts") },
];

const siteOrigin = "https://inaodeng.com";
const promptsKeywords = lang === "zh-cn"
  ? "QA提示词, AI测试提示词, 软件测试AI, ChatGPT测试, 测试自动化提示词, 需求分析提示词, 测试用例提示词"
  : "QA prompt, AI testing prompt, software testing AI, ChatGPT testing, test automation prompt, requirements analysis prompt";

// ItemList JSON-LD for the prompts index
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t(PROMPTS_PAGE_TITLE),
  description: t(PROMPTS_PAGE_DESCRIPTION),
  url: `${siteOrigin}${getRelativeLocaleUrl(lang, "/prompts/")}`,
  inLanguage: lang === "zh-cn" ? "zh-CN" : "en",
  numberOfItems: localePrompts.length,
  itemListElement: localePrompts.map((entry, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: entry.data.title.replace(/^[^-]+ - /, ""),
    url: `${siteOrigin}${getRelativeLocaleUrl(lang, `/prompts/${entry.data.testingType}/`)}`,
  })),
};
---

<Base
  title={t(PROMPTS_PAGE_TITLE)}
  description={t(PROMPTS_PAGE_DESCRIPTION)}
  keywords={promptsKeywords}
  extraStructuredData={[itemListSchema]}
  breadcrumbs={breadcrumbs}
>
  <div class="prompts-page">
    <header class="directory-hero">
      <div class="directory-hero-topline">
        <span class="eyebrow">{lang === "zh-cn" ? "提示词目录" : "PROMPT DIRECTORY"}</span>
        <span class="hero-sync">{promptCount} {lang === "zh-cn" ? "个提示词" : "prompts"} · {categoryCount} {lang === "zh-cn" ? "个分类" : "categories"}</span>
      </div>
      <div class="directory-hero-main">
        <div>
          <h1>{lang === "zh-cn" ? "软件测试提示词库" : "Software Testing Prompt Library"}</h1>
          <p class="hero-intro">
            {lang === "zh-cn"
              ? `收录 ${promptCount} 个可复用提示词，覆盖 ${categoryCount} 个测试主题，并提供 ${workflowCount} 个工作流程。`
              : `${promptCount} reusable prompts across ${categoryCount} testing themes, with ${workflowCount} guided workflows.`}
          </p>
        </div>
        <a href="https://github.com/naodeng/awesome-qa-prompt" target="_blank" rel="noopener noreferrer" class="source-link">
          <span>{lang === "zh-cn" ? "查看 GitHub" : "View GitHub"}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="hero-metrics" aria-label={lang === "zh-cn" ? "提示词目录信息" : "Prompt directory information"}>
        <span><strong>{promptCount}</strong> {lang === "zh-cn" ? "个专业提示词" : "prompts"}</span>
        <span><strong>{categoryCount}</strong> {lang === "zh-cn" ? "个分类" : "categories"}</span>
        <span><strong>{workflowCount}</strong> {lang === "zh-cn" ? "个工作流程" : "workflows"}</span>
      </div>
    </header>

    <!-- Upstream prompt categories -->
    <section class="prompts-section prompt-directory" aria-labelledby="testing-types-heading">
      <div class="prompt-directory-toolbar">
        <div class="prompt-toolbar-main">
          <div class="prompt-search">
            <label class="visually-hidden" for="prompt-search-input">{lang === "zh-cn" ? "搜索提示词" : "Search prompts"}</label>
            <span class="material-icons-sharp" aria-hidden="true">search</span>
            <input id="prompt-search-input" type="search" placeholder={lang === "zh-cn" ? "按名称、分类或描述搜索…" : "Search by name, category, or description…"} autocomplete="off" />
          </div>
          <p id="prompt-results-count" class="prompt-results-count" aria-live="polite" data-suffix={lang === "zh-cn" ? "个匹配结果" : "matching prompts"}>{promptCount} {lang === "zh-cn" ? "个匹配结果" : "matching prompts"}</p>
        </div>
      </div>
      <div class="prompt-directory-layout">
        <aside class="prompt-filter-sidebar" aria-labelledby="prompt-filter-title">
          <div class="prompt-filter-heading">
            <h2 id="prompt-filter-title">{lang === "zh-cn" ? "筛选目录" : "Filter directory"}</h2>
            <strong>{categoryCount}</strong>
          </div>
          <p class="prompt-filter-label">{lang === "zh-cn" ? "提示词分类" : "PROMPT CATEGORIES"}</p>
          <div class="prompt-filter-options" role="group" aria-label={lang === "zh-cn" ? "提示词分类筛选" : "Prompt category filters"}>
            <button type="button" class="prompt-category-filter is-active" data-prompt-filter="all" aria-pressed="true">
              <span>{lang === "zh-cn" ? "全部" : "All"}</span><span>{promptCount}</span>
            </button>
            {promptCategories.map((category) => (
              <button type="button" class="prompt-category-filter" data-prompt-filter={category.order} aria-pressed="false">
                <span>{category.title}</span><span>{category.prompts.length}</span>
              </button>
            ))}
          </div>
          <p class="prompt-filter-scroll-hint">{lang === "zh-cn" ? "左右滑动查看更多分类" : "Swipe to see more categories"}</p>
        </aside>

        <div class="prompt-results-column">
          <div class="prompt-results-heading">
            <div>
              <span class="prompt-results-eyebrow">{lang === "zh-cn" ? "目录浏览" : "BROWSE DIRECTORY"}</span>
              <h2 id="testing-types-heading">{lang === "zh-cn" ? "全部提示词" : "All Prompts"}</h2>
            </div>
            <p>{lang === "zh-cn" ? "按分类浏览，点击卡片直接打开提示词。" : "Browse by category and open a prompt by clicking its card."}</p>
          </div>
          <p class="prompt-search-empty" hidden>{lang === "zh-cn" ? "未找到匹配的提示词。" : "No matching prompts found."}</p>
          <div class="prompt-category-list">
            {promptCategories.map((category) => (
              <section class="prompt-category" data-prompt-category-block data-prompt-category-key={category.order} aria-labelledby={`prompt-category-${category.order}`}>
                <div class="prompt-category-heading">
                  <h3 id={`prompt-category-${category.order}`}>
                    <button type="button" class="prompt-category-toggle" aria-expanded="false" aria-controls={`prompt-category-list-${category.order}`}>
                      <span class="material-icons-sharp" aria-hidden="true">expand_more</span>
                      <span>{category.title}</span>
                    </button>
                  </h3>
                  <span>{category.prompts.length} {lang === "zh-cn" ? "个提示词" : "prompts"}</span>
                </div>
                <ul id={`prompt-category-list-${category.order}`} class="prompts-grid" role="list" hidden>
                  {category.prompts.map((entry) => (
                    <li>
                      <a
                        href={getRelativeLocaleUrl(lang, `/prompts/${entry.data.testingType}/`)}
                        class="prompt-card"
                        data-prompt-type={entry.data.testingType}
                        data-prompt-category={category.title}
                      >
                        <h4 class="prompt-card-title">{entry.data.title}</h4>
                        <p class="prompt-card-desc">{entry.data.description}</p>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="prompts-section" aria-labelledby="quickstart-heading">
      <h2 id="quickstart-heading">{t(PROMPTS_QUICKSTART_TITLE)}</h2>
      <ol class="qs-grid">
        {PROMPT_QUICK_STEPS[lang].map((step, index) => (
          <li class="qs-card" data-prompt-quick-step>
            <span class="qs-num">{index + 1}</span>
            <h3 class="qs-title">{step.title}</h3>
            <p class="qs-desc">{step.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <PromptExamples lang={lang} examples={PROMPT_EXAMPLES[lang]} />
    <AIOutputNotice lang={lang} />

    <!-- Full Testing Flow -->
    <section class="prompts-section" aria-labelledby="flow-heading">
      <h2 id="flow-heading">{t(PROMPTS_FLOW_TITLE)}</h2>
      <div class="flow-wrap">
        {PROMPT_ASSISTED_FLOW[lang].map((step, i, arr) => (
          <>
            <a
              href={getRelativeLocaleUrl(lang, `/prompts/${step.slug}/`)}
              class="flow-node"
            >
              <span class="flow-icon material-icons-sharp" aria-hidden="true">{step.icon}</span>
              <span class="flow-label">{step.label}</span>
              <span class="flow-desc">{step.desc}</span>
            </a>
            {i < arr.length - 1 && (
              <span class="flow-arrow" aria-hidden="true">→</span>
            )}
          </>
        ))}
      </div>
    </section>

    <!-- Workflow Cards -->
    <section class="prompts-section" aria-labelledby="workflows-heading">
      <h2 id="workflows-heading">{t(PROMPTS_WORKFLOWS_SECTION_TITLE)}</h2>
      <ul class="workflows-grid" role="list">
        {localeWorkflows.map((wf) => (
          <li>
            <a
              href={getRelativeLocaleUrl(lang, `/prompts/workflows/${wf.data.workflowType}/`)}
              class="workflow-card"
            >
              <h3 class="workflow-card-title">{wf.data.title}</h3>
              <p class="workflow-card-desc">{wf.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

  </div>
</Base>

<script>
  const searchInput = document.getElementById("prompt-search-input") as HTMLInputElement | null;
  const emptyState = document.querySelector<HTMLElement>(".prompt-search-empty");
  const resultsCount = document.getElementById("prompt-results-count");
  const categoryBlocks = Array.from(document.querySelectorAll<HTMLElement>("[data-prompt-category-block]"));
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".prompt-category-filter"));
  let activeFilter = "all";

  const updateDirectory = () => {
    const query = searchInput?.value.trim().toLowerCase() ?? "";
    let visible = 0;

    categoryBlocks.forEach((block) => {
      const cards = Array.from(block.querySelectorAll<HTMLElement>(".prompt-card"));
      const categoryText = block.querySelector("h3")?.textContent?.toLowerCase() ?? "";
      const categoryMatches = activeFilter === "all" || block.dataset.promptCategoryKey === activeFilter;

      cards.forEach((card) => {
        const matches = categoryMatches && (!query || `${categoryText} ${card.textContent ?? ""}`.toLowerCase().includes(query));
        card.closest("li")!.hidden = !matches;
        if (matches) visible += 1;
      });
      const hasMatches = cards.some((card) => !card.closest("li")!.hidden);
      block.hidden = !categoryMatches || (query.length > 0 && !hasMatches);

      const list = block.querySelector<HTMLElement>(".prompts-grid");
      const toggle = block.querySelector<HTMLButtonElement>(".prompt-category-toggle");
      const shouldOpen = categoryMatches && (query.length > 0 || activeFilter !== "all") && hasMatches;
      if (query.length > 0 && hasMatches) {
        list?.removeAttribute("hidden");
        toggle?.setAttribute("aria-expanded", "true");
      } else if (shouldOpen) {
        list?.removeAttribute("hidden");
        toggle?.setAttribute("aria-expanded", "true");
      } else if (query.length === 0 && activeFilter === "all") {
        list?.setAttribute("hidden", "");
        toggle?.setAttribute("aria-expanded", "false");
      }
    });

    if (resultsCount) {
      const suffix = resultsCount.dataset.suffix ?? "matching prompts";
      resultsCount.textContent = `${visible} ${suffix}`;
    }
    if (emptyState) emptyState.hidden = visible > 0;
  };

  searchInput?.addEventListener("input", updateDirectory);

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeFilter = button.dataset.promptFilter ?? "all";
      filterButtons.forEach((filterButton) => {
        const isActive = filterButton === button;
        filterButton.classList.toggle("is-active", isActive);
        filterButton.setAttribute("aria-pressed", String(isActive));
      });
      updateDirectory();
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".prompt-category-toggle").forEach((button) => {
    button.addEventListener("click", () => {
      const list = document.getElementById(button.getAttribute("aria-controls") ?? "");
      if (!list) return;
      const expanded = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!expanded));
      list.hidden = expanded;
    });
  });
</script>

<style>
  /* ── Sections ── */
  :global(.prompts-section) {
    margin-block-end: 2.5rem;
  }

  :global(.prompts-section h2) {
    font-size: 1.35rem;
    font-weight: 800;
    margin-block-end: 1rem;
    padding-block-end: 0.4em;
    border-block-end: 1px solid rgba(148, 163, 184, 0.22);
    color: var(--color-text-primary);
  }

  .prompts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .prompts-grid[hidden] {
    display: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .workflows-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--sp-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .prompt-card,
  .workflow-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-elevated);
    color: inherit;
    text-decoration: none;
    height: 100%;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .prompt-card-title,
  .workflow-card-title {
    margin: 0;
    color: var(--color-theme);
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .prompt-card-desc,
  .workflow-card-desc {
    flex: 1;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  /* ── Quick Start ── */
  .qs-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--sp-m);
  }

  .qs-card {
    grid-column: span 2;
    padding: var(--sp-m);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: var(--color-surface-elevated);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .qs-card:nth-last-child(-n + 2) {
    grid-column: span 3;
  }

  .qs-num {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-theme);
    color: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-block-end: 0.25rem;
  }

  .qs-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .qs-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .qs-list {
    margin: 0.25rem 0 0;
    padding-inline-start: 1.25em;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* ── Full Testing Flow ── */
  .flow-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-s);
    padding: var(--sp-m);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: var(--color-surface-muted);
  }

  /* each cell = node + optional arrow, laid out as a row pair */
  .flow-cell {
    display: contents;
  }

  .flow-node {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: var(--sp-s) var(--sp-m);
    border-radius: var(--radius-md);
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: var(--color-surface-elevated);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    /* ~4 per row accounting for arrows */
    width: clamp(140px, calc(25% - 2.5rem), 200px);
    flex-shrink: 0;
  }

  .flow-node:hover {
    border-color: color-mix(in srgb, var(--color-theme) 50%, transparent);
    box-shadow: 0 2px 10px color-mix(in srgb, var(--color-theme) 10%, transparent);
    transform: translateY(-2px);
  }

  .flow-node:focus-visible {
    outline: 2px solid var(--color-theme);
    outline-offset: 2px;
  }

  .flow-icon {
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-theme);
  }

  .flow-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .flow-desc {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .flow-arrow {
    font-size: 1.1rem;
    color: color-mix(in srgb, var(--color-theme) 55%, transparent);
    flex-shrink: 0;
  }

  @media (width < 900px) {
    .qs-grid {
      grid-template-columns: 1fr;
    }
    .qs-card,
    .qs-card:nth-last-child(-n + 2) {
      grid-column: auto;
    }
    .flow-node {
      width: min(100%, 220px);
    }
  }

  @media (width < 540px) {
    .flow-node {
      width: 100%;
    }
    .flow-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prompt-card,
    .workflow-card,
    .flow-node {
      transition: none;
      transform: none !important;
    }
  }

  /* ── Directory refinement ── */
  :global(.l-main:has(.prompts-page)) { margin-block-start: 0; }

  .prompts-page {
    max-inline-size: 1400px;
    margin-inline: auto;
    padding-block: clamp(1rem, 2vw, 1.75rem) 3.5rem;
  }

  .directory-hero {
    padding-block: 0.65rem 1.4rem;
  }

  .directory-hero-topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .eyebrow,
  .prompt-results-eyebrow {
    color: var(--color-theme);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-sync {
    color: var(--color-text-tertiary);
    font-size: 0.8rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .directory-hero-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem;
    margin-top: 1.1rem;
  }

  .directory-hero h1 {
    max-width: 15ch;
    margin: 0;
    color: var(--color-main);
    font-size: clamp(2.3rem, 6vw, 4.8rem);
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .directory-hero .hero-intro {
    max-width: 62ch;
    margin: 0.7rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .directory-hero .source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.45rem;
    border-block-end: 1px solid color-mix(in srgb, var(--color-theme) 45%, transparent);
    color: var(--color-theme);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .directory-hero .source-link:hover {
    border-color: var(--color-theme);
    color: var(--color-theme-focus);
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 1.4rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .hero-metrics span {
    min-width: 0;
    padding-inline: 0.85rem;
    border-inline-start: 1px solid var(--color-border);
    font-size: 0.86rem;
  }

  .hero-metrics span:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }

  .hero-metrics strong {
    margin-inline-end: 0.25rem;
    color: var(--color-main);
