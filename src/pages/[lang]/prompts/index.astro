---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import AIOutputNotice from "@/components/prompts/AIOutputNotice.astro";
import { useTranslations, type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  PROMPTS_PAGE_DESCRIPTION,
  PROMPTS_PAGE_TITLE,
  PROMPTS_QUICKSTART_TITLE,
  PROMPTS_WORKFLOWS_SECTION_TITLE,
} from "@/consts";
import { PROMPT_QUICK_STEPS } from "@/data/promptLibrary";
import {
  buildPromptRegistry,
  getPromptAreaCounts,
  getPromptTaskCounts,
} from "@/data/promptRegistry";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh-cn" } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const allPrompts = await getCollection("prompts");
const registry = buildPromptRegistry(allPrompts, lang);
const areas = getPromptAreaCounts(registry, lang).filter((area) => area.count > 0);
const tasks = getPromptTaskCounts(registry, lang).filter((task) => task.count > 0);
const allWorkflows = await getCollection("workflows");
const localeWorkflows = allWorkflows
  .filter((workflow) => workflow.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);

const promptCount = registry.length;
const allUrl = getRelativeLocaleUrl(lang, "/prompts/all/");
const promptUrl = (slug: string) => getRelativeLocaleUrl(lang, `/prompts/${slug}/`);
const featuredIds = [
  "requirements-analysis",
  "test-strategy",
  "test-case-writing",
  "api-testing",
  "ui-test-playwright",
  "release-readiness-review",
];
const featuredPrompts = featuredIds
  .map((id) => registry.find((entry) => entry.id === id))
  .filter((entry): entry is (typeof registry)[number] => Boolean(entry));

const breadcrumbs = [
  { name: lang === "zh-cn" ? "首页" : "Home", url: getRelativeLocaleUrl(lang, "/") },
  { name: t(PROMPTS_PAGE_TITLE), url: getRelativeLocaleUrl(lang, "/prompts/") },
];

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t(PROMPTS_PAGE_TITLE),
  description: t(PROMPTS_PAGE_DESCRIPTION),
  url: `${siteOrigin}${getRelativeLocaleUrl(lang, "/prompts/")}`,
  inLanguage: lang === "zh-cn" ? "zh-CN" : "en",
  numberOfItems: promptCount,
  itemListElement: registry.map((entry, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: entry.title,
    url: `${siteOrigin}${promptUrl(entry.slug)}`,
  })),
};

const copy = lang === "zh-cn"
  ? {
      eyebrow: "QA 提示词库",
      title: "先说你要完成什么，再找到合适的提示词",
      intro: "面向软件测试与质量工作的可复用提示词。按任务、测试领域和输入输出浏览，不必先记住提示词名称。",
      searchLabel: "搜索提示词",
      searchPlaceholder: "搜索需求分析、API、性能、智能体...",
      searchButton: "搜索",
      tryLabel: "试试",
      browseAll: "浏览全部提示词",
      source: "查看 GitHub 源码",
      prompts: "个提示词",
      areas: "个测试领域",
      workflows: "个工作流程",
      taskTitle: "你现在想完成什么？",
      taskIntro: "选一个更接近当前工作的入口，探索器会保留这个筛选条件。",
      areaTitle: "把问题放进正确的 QA 上下文",
      areaIntro: "按稳定的测试领域浏览，从需求一路找到发布后的质量信号。",
      openArea: "查看这个领域",
      quickIntro: "从输入材料开始，逐步得到可评审的测试分析或设计结果。",
      workflowIntro: "把单个提示词放进日常、迭代或发布测试流程中。",
      featuredEyebrow: "精选入口",
      featuredTitle: "从这些提示词开始",
      featuredIntro: "先从适合当前任务的提示词开始，需要时再切换其他版本。",
      input: "需要输入",
      output: "可期待的输出",
      vsEyebrow: "提示词还是技能",
      vsTitle: "选择适合当前工作的工具",
      vsIntro: "提示词适合一次任务的分析与设计；技能适合带有固定流程、工具调用或仓库约束的重复工作。",
      promptColumn: "提示词",
      skillColumn: "技能",
      promptRow: "复制到 AI 对话中，围绕一项任务产出结构化结果。",
      skillRow: "安装到支持的智能体环境中，按约定流程处理更完整的工作。",
      promptFit: "需求分析、测试设计、评审和风险梳理",
      skillFit: "需要脚本、工具、文件操作或多步执行的工作",
      workflowEyebrow: "测试工作流",
    }
  : {
      eyebrow: "QA PROMPT LIBRARY",
      title: "Start with the task, then find the right prompt",
      intro: "Reusable prompts for software testing and quality work. Browse by task, QA area, and inputs or outputs instead of memorizing prompt names.",
      searchLabel: "Search prompts",
      searchPlaceholder: "Try requirements, API, performance, agent...",
      searchButton: "Search",
      tryLabel: "Try",
      browseAll: "Browse all prompts",
      source: "View source on GitHub",
      prompts: "prompts",
      areas: "QA areas",
      workflows: "workflows",
      taskTitle: "What do you want to do?",
      taskIntro: "Choose the entry point closest to your work. The explorer will keep the filter for you.",
      areaTitle: "Put the problem in the right QA context",
      areaIntro: "Browse stable QA areas that cover the path from requirements to post-release quality signals.",
      openArea: "View this area",
      quickIntro: "Start from source material and move toward a reviewable testing analysis or design result.",
      workflowIntro: "Place an individual prompt inside a daily, sprint, or release testing workflow.",
      featuredEyebrow: "Featured entry points",
      featuredTitle: "Start with these prompts",
      featuredIntro: "Start with the prompt that fits your task, then switch versions when needed.",
      input: "Inputs",
      output: "Expected output",
      vsEyebrow: "Prompt or Skill",
      vsTitle: "Choose the right tool for the work",
      vsIntro: "A Prompt fits one analysis or design task. A Skill fits repeatable work with a fixed process, tool calls, or repository constraints.",
      promptColumn: "Prompt",
      skillColumn: "Skill",
      promptRow: "Copy it into an AI conversation and produce a structured result for one task.",
      skillRow: "Install it into a supported Agent environment and follow a fuller working process.",
      promptFit: "Requirements analysis, test design, review, and risk mapping",
      skillFit: "Work that needs scripts, tools, file operations, or multiple steps",
      workflowEyebrow: "Testing workflows",
    };

const workflowTypeLabels = lang === "zh-cn"
  ? { daily: "日常测试", sprint: "迭代测试", release: "发布测试" }
  : { daily: "Daily testing", sprint: "Sprint testing", release: "Release testing" };
const variantLabel = (variant: string) => (lang === "zh-cn"
  ? ({ lite: "轻量版", standard: "默认版", plus: "增强版" }[variant] || variant)
  : ({ lite: "Lite", standard: "Standard", plus: "Plus" }[variant] || variant));
const searchExamples = lang === "zh-cn"
  ? [
      { label: "需求分析", query: "requirements" },
      { label: "接口", query: "API" },
      { label: "性能", query: "performance" },
      { label: "智能体", query: "agent" },
    ]
  : [
      { label: "requirements", query: "requirements" },
      { label: "API", query: "API" },
      { label: "performance", query: "performance" },
      { label: "agent", query: "agent" },
    ];
---

<Base
  title={t(PROMPTS_PAGE_TITLE)}
  description={t(PROMPTS_PAGE_DESCRIPTION)}
  keywords={lang === "zh-cn"
    ? "QA提示词, AI测试提示词, 软件测试提示词, 需求分析, 测试用例, 接口测试, 性能测试"
    : "QA prompt, AI testing prompt, software testing prompt, requirements analysis, test cases, API testing, performance testing"}
  extraStructuredData={[itemListSchema]}
  breadcrumbs={breadcrumbs}
>
  <div class="prompt-home">
    <section class="prompt-hero" aria-labelledby="prompt-home-title">
      <div class="prompt-hero-copy">
        <p class="prompt-eyebrow">{copy.eyebrow}</p>
        <h1 id="prompt-home-title">{copy.title}</h1>
        <p class="prompt-hero-intro">{copy.intro}</p>
        <form class="prompt-home-search" action={allUrl} role="search">
          <label for="prompt-home-search-input" class="visually-hidden">{copy.searchLabel}</label>
          <div class="prompt-search-control">
            <span class="prompt-search-icon material-icons-sharp" aria-hidden="true">search</span>
            <input id="prompt-home-search-input" name="q" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" />
            <button type="submit">{copy.searchButton}</button>
          </div>
          <div class="prompt-search-examples" aria-label={copy.tryLabel}>
            <span>{copy.tryLabel}</span>
            {searchExamples.map((example) => <a href={`${allUrl}?q=${example.query}`}>{example.label}</a>)}
          </div>
        </form>
      </div>
      <div class="prompt-hero-aside">
        <div class="prompt-stat-grid" aria-label={lang === "zh-cn" ? "提示词库统计" : "Prompt library statistics"}>
          <div><strong>{promptCount}</strong><span>{copy.prompts}</span></div>
          <div><strong>{areas.length}</strong><span>{copy.areas}</span></div>
          <div><strong>{localeWorkflows.length}</strong><span>{copy.workflows}</span></div>
        </div>
        <a class="prompt-source-link" href="https://github.com/naodeng/awesome-qa-prompt" target="_blank" rel="noopener noreferrer">
          {copy.source}<span class="material-icons-sharp prompt-inline-icon" aria-hidden="true">open_in_new</span>
        </a>
      </div>
    </section>

    <section class="prompt-section task-section" aria-labelledby="prompt-task-heading">
      <div class="prompt-section-heading">
        <div>
          <h2 id="prompt-task-heading">{copy.taskTitle}</h2>
        </div>
        <p>{copy.taskIntro}</p>
      </div>
      <div class="prompt-task-grid">
        {tasks.map((task) => (
          <a class="prompt-task-card" href={`${allUrl}?task=${task.key}`} data-prompt-task={task.key}>
            <span class="prompt-task-card-content">
              <strong>{task.label}</strong>
              <span>{task.description}</span>
              <small>{task.count} {copy.prompts}</small>
            </span>
            <span class="prompt-arrow material-icons-sharp" aria-hidden="true">arrow_forward</span>
          </a>
        ))}
      </div>
    </section>

    <section class="prompt-section area-section" aria-labelledby="prompt-area-heading">
      <div class="prompt-section-heading">
        <div>
          <h2 id="prompt-area-heading">{copy.areaTitle}</h2>
        </div>
        <p>{copy.areaIntro}</p>
      </div>
      <div class="prompt-area-grid">
        {areas.map((area) => (
          <a class="prompt-area-card" href={`${allUrl}?area=${area.key}`} data-prompt-area={area.key}>
            <span class="prompt-area-count"><strong>{area.count}</strong><span>{copy.prompts}</span></span>
            <strong>{area.label}</strong>
            <span>{area.description}</span>
            <span class="prompt-area-link">{copy.openArea}<span class="material-icons-sharp prompt-inline-icon" aria-hidden="true">arrow_forward</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="prompt-section quick-section" aria-labelledby="quickstart-heading">
      <div class="prompt-section-heading compact-heading">
        <div>
          <h2 id="quickstart-heading">{t(PROMPTS_QUICKSTART_TITLE)}</h2>
        </div>
        <p>{copy.quickIntro}</p>
      </div>
      <ol class="prompt-steps">
        {PROMPT_QUICK_STEPS[lang].map((step, index) => (
          <li data-prompt-quick-step>
            <span class="prompt-step-number">{index + 1}</span>
            <div><h3>{step.title}</h3><p>{step.description}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="prompt-section comparison-section" aria-labelledby="prompt-vs-heading">
      <div class="prompt-section-heading compact-heading">
        <div>
          <h2 id="prompt-vs-heading">{copy.vsTitle}</h2>
        </div>
        <p>{copy.vsIntro}</p>
      </div>
      <div class="prompt-comparison" role="table" aria-label={copy.vsTitle}>
        <div class="prompt-comparison-row prompt-comparison-head" role="row">
          <span role="columnheader">{copy.promptColumn}</span><span role="columnheader">{copy.skillColumn}</span>
        </div>
        <div class="prompt-comparison-row" role="row">
          <span role="cell">{copy.promptRow}</span><span role="cell">{copy.skillRow}</span>
        </div>
        <div class="prompt-comparison-row" role="row">
          <span role="cell">{copy.promptFit}</span><span role="cell">{copy.skillFit}</span>
        </div>
      </div>
    </section>

    <section class="prompt-section workflow-section" aria-labelledby="workflows-heading">
      <div class="prompt-section-heading">
        <div>
          <p class="prompt-eyebrow">{copy.workflowEyebrow}</p>
          <h2 id="workflows-heading">{t(PROMPTS_WORKFLOWS_SECTION_TITLE)}</h2>
        </div>
        <p>{copy.workflowIntro}</p>
      </div>
      <div class="prompt-workflow-grid">
        {localeWorkflows.map((workflow) => (
          <a class="prompt-workflow-card" href={getRelativeLocaleUrl(lang, `/prompts/workflows/${workflow.data.workflowType}/`)}>
            <span class="prompt-workflow-type">{workflowTypeLabels[workflow.data.workflowType]}</span>
            <strong>{workflow.data.title}</strong>
            <span>{workflow.data.description}</span>
            <span class="prompt-arrow material-icons-sharp" aria-hidden="true">arrow_forward</span>
          </a>
        ))}
      </div>
    </section>

    <section class="prompt-section featured-section" aria-labelledby="prompt-featured-heading">
      <div class="prompt-section-heading">
        <div>
          <p class="prompt-eyebrow">{copy.featuredEyebrow}</p>
          <h2 id="prompt-featured-heading">{copy.featuredTitle}</h2>
        </div>
        <p>{copy.featuredIntro}</p>
      </div>
      <div class="prompt-featured-grid">
        {featuredPrompts.map((entry) => (
          <a class="prompt-featured-card" data-featured-prompt={entry.id} href={promptUrl(entry.slug)}>
            <div class="prompt-card-meta">
              <span>{entry.areaLabel}</span>
              {entry.variant !== "standard" && <span>{variantLabel(entry.variant)}</span>}
            </div>
            <h3>{entry.title}</h3>
            <p>{entry.cardDescription}</p>
            <div class="prompt-card-signals">
              <div><span>{copy.input}</span><strong>{entry.inputs[0]}</strong></div>
              <div><span>{copy.output}</span><strong>{entry.outputs[0]}</strong></div>
            </div>
          </a>
        ))}
      </div>
      <a class="prompt-outline-link" href={allUrl}>{copy.browseAll}<span class="material-icons-sharp prompt-inline-icon" aria-hidden="true">arrow_forward</span></a>
    </section>

    <AIOutputNotice lang={lang} />
  </div>
</Base>

<style>
  .prompt-home {
    --prompt-ink-soft: color-mix(in srgb, var(--color-main) 65%, transparent);
    --prompt-button-ink: #ffffff;
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: 0 0 4rem;
  }

  :global(:root[data-theme="dark"]) .prompt-home { --prompt-button-ink: var(--color-base); }

  .prompt-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(230px, 0.45fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding: 0 0 clamp(2.5rem, 5vw, 4rem);
  }

  .prompt-eyebrow {
    margin: 0 0 0.85rem;
    color: var(--color-theme);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .prompt-hero h1 {
    max-width: 24ch;
    margin: 0;
    font-size: clamp(2.4rem, 5.4vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
  }

  .prompt-hero-intro {
    max-width: 63ch;
    margin: 1.35rem 0 0;
    color: var(--prompt-ink-soft);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .prompt-home-search { margin-top: 2rem; max-width: 700px; }
  .prompt-search-control {
    display: flex;
    align-items: center;
    min-height: 58px;
    padding: 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--color-main) 7%, transparent);
  }
  .prompt-search-control:focus-within { border-color: var(--color-theme); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-theme) 16%, transparent); }
  .prompt-search-icon { padding-inline: 0.75rem; color: var(--color-theme); font-size: 1.25rem; line-height: 1; }
  .prompt-search-control input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--color-main); font: inherit; }
  .prompt-search-control input::placeholder { color: var(--color-text-tertiary); opacity: 1; }
  .prompt-search-control button { min-height: 44px; padding: 0 1rem; border: 0; border-radius: var(--radius-sm); background: var(--color-theme); color: var(--prompt-button-ink); font: inherit; font-weight: 800; cursor: pointer; transition: none; }
  .prompt-search-control button:hover { background: var(--color-theme-focus); }
  .prompt-search-control button:active { transform: translateY(1px); }
  .prompt-search-examples { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center; margin-top: 0.7rem; color: var(--prompt-ink-soft); font-size: 0.82rem; }
  .prompt-search-examples a { color: var(--color-theme); text-decoration: none; }
  .prompt-search-examples a:hover { text-decoration: underline; }
  .prompt-inline-icon { font-size: 1rem; line-height: 1; vertical-align: middle; }

  .prompt-hero-aside { display: grid; align-content: start; gap: 1.35rem; padding-top: 0.65rem; }
  .prompt-stat-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .prompt-stat-grid div { display: grid; gap: 0.25rem; }
  .prompt-stat-grid strong { font-size: 1.8rem; letter-spacing: -0.05em; }
  .prompt-stat-grid span { color: var(--prompt-ink-soft); font-size: 0.78rem; }
  .prompt-source-link, .prompt-outline-link { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-theme); font-weight: 800; text-decoration: none; }
  .prompt-source-link:hover, .prompt-outline-link:hover { text-decoration: underline; }

  .prompt-section { padding: clamp(3rem, 6vw, 5.5rem) 0; }
  .task-section { padding-top: clamp(2rem, 4vw, 3.5rem); }
  .prompt-section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(250px, 0.6fr); gap: 2rem; align-items: start; margin-bottom: 2rem; }
  .prompt-section-heading h2 { margin: 0; max-width: 18ch; font-size: clamp(1.9rem, 4vw, 3.2rem); line-height: 1.05; letter-spacing: -0.04em; }
  .prompt-section-heading > p { max-width: 42ch; margin: 0; color: var(--prompt-ink-soft); line-height: 1.7; }
  .compact-heading { align-items: start; }
  .compact-heading h2 { max-width: none; }

  .prompt-task-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem 1rem; }
  .prompt-task-card { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 0.8rem; min-height: 0; padding: 1.1rem 1.15rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-main); text-decoration: none; transition: border-color 0.15s, background-color 0.15s; }
  .prompt-task-card:hover { border-color: color-mix(in srgb, var(--color-theme) 60%, var(--color-border)); background: var(--color-theme-soft); }
  .prompt-task-card-content { display: grid; align-content: start; gap: 0.45rem; }
  .prompt-task-card-content strong { font-size: 1rem; }
  .prompt-task-card-content span { color: var(--prompt-ink-soft); font-size: 0.86rem; line-height: 1.5; }
  .prompt-task-card-content small { color: var(--color-theme); font-size: 0.75rem; font-weight: 700; }
  .prompt-arrow { align-self: start; color: var(--color-theme); font-size: 1rem; }

  .prompt-area-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem 1rem; }
  .prompt-area-card { display: grid; align-content: start; gap: 0.55rem; min-height: 0; padding: 1.1rem 1.15rem 1.2rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-main); text-decoration: none; }
  .prompt-area-card:hover { border-color: color-mix(in srgb, var(--color-theme) 60%, var(--color-border)); background: var(--color-theme-soft); }
  .prompt-area-count { display: flex; align-items: baseline; gap: 0.35rem; color: var(--color-theme); }
  .prompt-area-count strong { font-size: 1.35rem; letter-spacing: -0.04em; }
  .prompt-area-count span { font-size: 0.72rem; font-weight: 800; }
  .prompt-area-card strong { font-size: 1rem; }
  .prompt-area-card > span:not(.prompt-area-count):not(.prompt-area-link) { color: var(--prompt-ink-soft); font-size: 0.85rem; line-height: 1.55; }
  .prompt-area-link { display: inline-flex; gap: 0.4rem; align-items: center; margin-top: auto; color: var(--color-theme); font-size: 0.8rem; font-weight: 800; }

  .prompt-featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .prompt-featured-card { display: flex; flex-direction: column; padding: 1.2rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-main); text-decoration: none; }
  .prompt-featured-card:hover { border-color: color-mix(in srgb, var(--color-theme) 60%, var(--color-border)); }
  .prompt-card-meta { display: flex; justify-content: space-between; gap: 0.5rem; color: var(--color-theme); font-size: 0.72rem; font-weight: 800; text-transform: uppercase; }
  .prompt-featured-card h3 { margin: 1rem 0 0.55rem; font-size: 1.08rem; line-height: 1.25; }
  .prompt-featured-card:hover h3 { color: var(--color-theme); }
  .prompt-featured-card > p { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; margin: 0; color: var(--prompt-ink-soft); font-size: 0.87rem; line-height: 1.6; }
  .prompt-card-signals { display: grid; gap: 0.7rem; margin-top: 1rem; padding-top: 0.85rem; border-top: 1px solid var(--color-border); }
  .prompt-card-signals div { display: grid; gap: 0.2rem; }
