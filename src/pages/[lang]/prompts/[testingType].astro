---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import SidebarAd from "@/components/SidebarAd.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ArticleShare from "@/components/ArticleShare.astro";
import GoogleAd from "@/components/GoogleAd.astro";
import Giscus from "@/components/Giscus.astro";
import { useTranslations, type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  PROMPTS_PAGE_TITLE,
  PROMPTS_COPY_BUTTON,
  PROMPTS_COPY_SUCCESS,
  PROMPTS_DETAIL_KEYWORDS,
} from "@/consts";

export async function getStaticPaths() {
  const allPrompts = await getCollection("prompts");

  const seen = new Set<string>();
  const routes: { params: { lang: string; testingType: string }; props: { entries: typeof allPrompts } }[] = [];

  for (const entry of allPrompts) {
    const key = `${entry.data.lang}__${entry.data.testingType}`;
    if (!seen.has(key)) {
      seen.add(key);
      const entries = allPrompts
        .filter((p) => p.data.lang === entry.data.lang && p.data.testingType === entry.data.testingType)
        .sort((a, b) => a.data.order - b.data.order);
      routes.push({
        params: { lang: entry.data.lang, testingType: entry.data.testingType },
        props: { entries },
      });
    }
  }

  return routes;
}

const { entries } = Astro.props;
const lang = Astro.params.lang as Lang;
const testingType = Astro.params.testingType as string;
const t = useTranslations(lang);

// Extract usage tip blockquote from body (first > ... line after the h1)
function extractUsageTip(body: string): string {
  const match = body.match(/^>\s*(.+?)(?:\n(?!>)|$)/m);
  if (!match) return "";

  return match[1]
    .trim()
    .replace(/^💡\s*/u, "")
    .replace(/^\*\*(使用说明|Usage Tip)\*\*[:：]\s*/i, "")
    .replace(/^(使用说明|Usage Tip)[:：]\s*/i, "");
}

// Render all entries without editorial history sections.
const rendered = await Promise.all(
  entries.map(async (entry) => {
    const rawBody = entry.body ?? "";
    const cleanBody = rawBody;
    const usageTip = extractUsageTip(rawBody);
    const patchedEntry = { ...entry, body: cleanBody };
    const { Content, headings } = await render(patchedEntry);
    return { entry: patchedEntry, Content, headings, usageTip };
  })
);

// Page title from first entry
const pageTitle = entries[0]?.data.title ?? testingType;
const pageDescription = entries[0]?.data.description ?? "";

// TOC headings from the first (default active) tab
const activeHeadings = rendered[0]?.headings ?? [];
const tocHeadings = activeHeadings.filter((h) => h.depth === 2 || h.depth === 3);

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com";
const canonicalUrl = `${siteOrigin}${getRelativeLocaleUrl(lang, `/prompts/${testingType}/`)}`;

const breadcrumbs = [
  { name: lang === "zh-cn" ? "首页" : "Home", url: getRelativeLocaleUrl(lang, "/") },
  { name: t(PROMPTS_PAGE_TITLE), url: getRelativeLocaleUrl(lang, "/prompts/") },
  { name: pageTitle, url: getRelativeLocaleUrl(lang, `/prompts/${testingType}/`) },
];

const copyLabel = t(PROMPTS_COPY_BUTTON);
const copiedLabel = t(PROMPTS_COPY_SUCCESS);
const sourceRepositoryUrl = "https://github.com/naodeng/awesome-qa-prompt/blob/main/";
const sourceUrl = `${sourceRepositoryUrl}${entries[0]?.data.sourcePath ?? ""}`;

// Page-specific keywords
const pageKeywords = `${PROMPTS_DETAIL_KEYWORDS[lang]}, ${testingType.replace(/-/g, " ")}, ${pageTitle}`;

// HowTo JSON-LD for the testing type detail page
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  inLanguage: lang === "zh-cn" ? "zh-CN" : "en",
  step: entries.map((entry, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: entry.data.title,
    text: entry.data.description,
  })),
};

// Build left sidebar nav from upstream categories.
const allPrompts = await getCollection("prompts");
const localePrompts = allPrompts.filter((p) => p.data.lang === lang);
const typeMap = new Map<string, { testingType: string; label: string }>();
for (const p of localePrompts.sort((a, b) => a.data.order - b.data.order)) {
  if (!typeMap.has(p.data.testingType)) {
    typeMap.set(p.data.testingType, {
      testingType: p.data.testingType,
      label: p.data.title,
    });
  }
}
const sidebarItems = Array.from(typeMap.values()).sort((a, b) => a.label.localeCompare(b.label, lang));

const currentPrompt = entries[0];
const currentTerms = new Set(
  `${currentPrompt?.data.testingType ?? ""} ${currentPrompt?.data.title ?? ""}`
    .toLowerCase()
    .split(/[^a-z0-9]+/)
    .filter((term) => term.length > 2),
);
const relatedPrompts = localePrompts
  .filter((prompt) => prompt.data.testingType !== testingType)
  .map((prompt) => {
    const candidateTerms = `${prompt.data.testingType} ${prompt.data.title}`
      .toLowerCase()
      .split(/[^a-z0-9]+/)
      .filter((term) => term.length > 2);
    const sharedTerms = candidateTerms.filter((term) => currentTerms.has(term)).length;
    const categoryScore = prompt.data.category === currentPrompt?.data.category ? 100 : 0;
    return { prompt, score: categoryScore + sharedTerms };
  })
  .sort((a, b) => b.score - a.score || a.prompt.data.title.localeCompare(b.prompt.data.title, lang))
  .slice(0, 5)
  .map(({ prompt }) => prompt);

const tocLabel = lang === "zh-cn" ? "本页目录" : "On this page";
const sidebarLabel = lang === "zh-cn" ? "测试类型" : "Testing Types";
---

<Base
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  type="article"
  breadcrumbs={breadcrumbs}
  extraStructuredData={[howToSchema]}
  contentWide={true}
>
  <div class="prompts-layout" data-has-toc={tocHeadings.length > 0}>
    <!-- Left sidebar: testing type nav -->
    <aside class="prompts-sidebar-left" aria-label={sidebarLabel}>
      <div class="prompts-sidebar-inner">
        <button
          type="button"
          class="prompts-sidebar-toggle"
          aria-expanded="false"
          aria-controls="prompts-sidebar-nav"
          id="prompts-sidebar-toggle"
        >
          <span>{sidebarLabel}</span>
          <span class="material-icons-sharp" aria-hidden="true">expand_more</span>
        </button>
        <nav id="prompts-sidebar-nav" class="prompts-sidebar-nav">
          <div class="prompts-sidebar-search">
            <label for="prompts-sidebar-search-input" class="visually-hidden">
              {lang === "zh-cn" ? "搜索测试类型" : "Search testing types"}
            </label>
            <input
              type="search"
              id="prompts-sidebar-search-input"
              class="prompts-sidebar-search-input"
              placeholder={lang === "zh-cn" ? "搜索…" : "Search…"}
              autocomplete="off"
            />
          </div>
          <p class="prompts-sidebar-section-title">{sidebarLabel}</p>
          <ul class="prompts-sidebar-list">
            {sidebarItems.map((item) => (
              <li>
                <a
                  href={getRelativeLocaleUrl(lang, `/prompts/${item.testingType}/`)}
                  class:list={[
                    "prompts-sidebar-link",
                    item.testingType === testingType && "prompts-sidebar-link--active",
                  ]}
                  aria-current={item.testingType === testingType ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>

    <!-- Main content -->
    <div class="prompts-main">
      <Breadcrumb items={breadcrumbs} />
      <header
        class="prompt-detail-header"
        id="prompt-usage-tip"
        data-tips={JSON.stringify(rendered.map((r) => r.usageTip))}
      >
        <div class="prompt-detail-header-main">
          <div class="prompt-detail-meta">
            <span class="prompt-detail-badge">
              {lang === "zh-cn" ? "提示词" : "Prompt"}
            </span>
          </div>
          <h1>{pageTitle}</h1>
          <p class="prompt-detail-desc">{pageDescription}</p>
        </div>
        {rendered[0]?.usageTip && (
          <div class="prompt-detail-tip">
            <span class="prompt-detail-tip-label"><span class="material-icons-sharp" aria-hidden="true">lightbulb</span> {lang === "zh-cn" ? "使用说明" : "Usage Tip"}</span>
            <span class="prompt-usage-tip-text" set:html={rendered[0].usageTip.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")} />
          </div>
        )}
        <div class="prompt-detail-actions">
          <button
            type="button"
            class="prompt-copy-btn"
            data-copy-label={copyLabel}
            data-copied-label={copiedLabel}
            data-raw-content={rendered[0]?.entry.body ?? ""}
            aria-label={copyLabel}
          >
            <span class="material-icons-sharp" aria-hidden="true">content_copy</span>
            <span class="prompt-copy-btn-text">{copyLabel}</span>
          </button>
          <a class="prompt-source-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">
            <span class="material-icons-sharp" aria-hidden="true">open_in_new</span>
            {lang === "zh-cn" ? "GitHub 源提示词" : "GitHub source"}
          </a>
        </div>
      </header>

      {rendered.map(({ entry, Content, headings }) => (
        <div
          class="prompt-panel"
          data-headings={JSON.stringify(
            headings
              .filter((h) => h.depth === 2 || h.depth === 3)
              .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }))
          )}
        >
          <div class="prompt-content prose">
            <Content />
          </div>
        </div>
      ))}

      <GoogleAd />

      <ArticleShare
        title={pageTitle}
        url={canonicalUrl}
        locale={lang as "en" | "zh-cn"}
      />

      {relatedPrompts.length > 0 && (
        <section class="prompt-related-prompts" aria-labelledby="related-prompts-heading">
          <div class="prompt-related-prompts-heading">
            <h2 id="related-prompts-heading">{lang === "zh-cn" ? "关联提示词" : "Related Prompts"}</h2>
          </div>
          <div class="prompt-related-prompts-grid">
            {relatedPrompts.map((prompt) => (
              <a
                href={getRelativeLocaleUrl(lang, `/prompts/${prompt.data.testingType}/`)}
                class="prompt-related-prompt"
                data-related-prompt
              >
                <span class="prompt-related-prompt-title">{prompt.data.title}</span>
                <span class="prompt-related-prompt-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <Giscus
        lang={lang === "zh-cn" ? "zh-CN" : "en"}
        inputPosition="bottom"
        loading="lazy"
      />
    </div>

    <!-- Right TOC sidebar -->
    {tocHeadings.length > 0 && (
      <aside class="prompts-toc-wrap" id="prompts-toc-wrap">
        <TableOfContents headings={tocHeadings} label={tocLabel} placement="right" />
        <SidebarAd />
      </aside>
    )}
  </div>
</Base>

<script>
  // Copy button
  document.querySelectorAll<HTMLButtonElement>(".prompt-copy-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const rawContent = btn.dataset.rawContent ?? "";

      const copyLabel = btn.dataset.copyLabel ?? "Copy";
      const copiedLabel = btn.dataset.copiedLabel ?? "Copied!";
      const textEl = btn.querySelector(".prompt-copy-btn-text");

      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(rawContent).then(() => {
          if (textEl) textEl.textContent = copiedLabel;
          btn.setAttribute("aria-label", copiedLabel);
          btn.classList.add("copied");
          setTimeout(() => {
            if (textEl) textEl.textContent = copyLabel;
            btn.setAttribute("aria-label", copyLabel);
            btn.classList.remove("copied");
          }, 1500);
        }).catch(() => {});
      }
    });
  });

  // Sidebar toggle (mobile)
  const sidebarToggle = document.getElementById("prompts-sidebar-toggle");
  if (sidebarToggle) {
    const inner = sidebarToggle.closest(".prompts-sidebar-inner");
    sidebarToggle.addEventListener("click", () => {
      const isOpen = inner?.classList.toggle("is-open");
      sidebarToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });
  }

  // Sidebar search filter
  const searchInput = document.getElementById("prompts-sidebar-search-input") as HTMLInputElement | null;
  if (searchInput) {
    searchInput.addEventListener("input", () => {
      const q = searchInput.value.trim().toLowerCase();
      document.querySelectorAll<HTMLLIElement>(".prompts-sidebar-list li").forEach((li) => {
        const text = li.querySelector("a")?.textContent?.toLowerCase() ?? "";
        li.style.display = !q || text.includes(q) ? "" : "none";
      });
    });
  }
</script>

<style>
  /* ── 3-column layout ── */
  .prompts-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--sp-l);
    align-items: start;
    max-inline-size: 1400px;
    margin-inline: auto;
    padding-inline: var(--sp-m);
    padding-block-start: calc(var(--sp-l) * 0.15);
    padding-block-end: var(--sp-l);
  }
  .prompts-layout[data-has-toc="true"] {
    grid-template-columns: 220px minmax(0, 1fr) 200px;
    max-inline-size: 1400px;
  }

  /* ── Left sidebar ── */
  .prompts-sidebar-left {
    position: sticky;
    top: var(--sp-m);
    align-self: start;
  }
  .prompts-sidebar-inner {
    border: 1px solid color-mix(in srgb, var(--color-theme) 22%, transparent);
    border-radius: var(--radius-md);
    background: var(--color-surface-elevated);
  }
  .sidebar-ad-wrap {
    max-height: 200px;
    overflow: hidden;
    margin: var(--sp-s) var(--sp-m) var(--sp-m);
  }
  .prompts-sidebar-toggle {
    display: none;
    width: 100%;
    padding: var(--sp-s) var(--sp-m);
    font-weight: 600;
    font-size: inherit;
    font-family: inherit;
    color: var(--color-theme);
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: start;
    align-items: center;
    gap: 0.5rem;
    justify-content: space-between;
  }
  .prompts-sidebar-toggle svg {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .prompts-sidebar-inner.is-open .prompts-sidebar-toggle svg {
    transform: rotate(180deg);
  }
  .prompts-sidebar-nav {
    padding: var(--sp-s) var(--sp-m);
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .prompts-sidebar-search {
    margin-block-end: var(--sp-s);
  }
  .prompts-sidebar-search-input {
    width: 100%;
    padding: 0.4em 0.65em;
    font-size: 0.85rem;
    font-family: inherit;
    color: var(--color-text-primary);
    background: var(--color-surface-muted);
    border: 1px solid color-mix(in srgb, var(--color-theme) 22%, transparent);
    border-radius: var(--radius-sm);
    outline: none;
    box-sizing: border-box;
  }
  .prompts-sidebar-search-input::placeholder {
    color: var(--color-text-tertiary);
  }
  .prompts-sidebar-search-input:focus {
    border-color: var(--color-theme);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-theme) 20%, transparent);
  }
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
  .prompts-sidebar-section-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin: 0 0 var(--sp-s);
    padding-block-end: 0.35rem;
    border-block-end: 1px solid color-mix(in srgb, var(--color-theme) 12%, transparent);
  }
  .prompts-sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .prompts-sidebar-list li {
    margin: 0;
  }
  .prompts-sidebar-link {
    display: block;
    padding: 0.35em 0.6em;
    margin-block: 0.1em 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background 0.15s ease, color 0.15s ease;
    line-height: 1.4;
  }
  .prompts-sidebar-link:hover {
    color: var(--color-theme);
    background: color-mix(in srgb, var(--color-theme) 8%, transparent);
  }
  .prompts-sidebar-link--active {
    color: var(--color-theme);
    font-weight: 600;
    background: color-mix(in srgb, var(--color-theme) 12%, transparent);
  }
  .prompts-sidebar-link:focus-visible {
    outline: 2px solid var(--color-theme);
    outline-offset: 2px;
  }

  /* ── Main content ── */
  .prompts-main {
    min-inline-size: 0;
  }

  /* ── Main content header (merged with usage tip) ── */
  .prompt-detail-header {
    margin-block-end: var(--sp-m);
    padding: var(--sp-m);
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--color-theme) 20%, transparent);
    background: color-mix(in srgb, var(--color-theme) 5%, var(--color-base));
    display: flex;
    flex-direction: column;
    gap: var(--sp-s);
  }
  .prompt-detail-header-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .prompt-detail-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 0.15rem;
  }
  .prompt-detail-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.15em 0.65em;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 999px;
    background: var(--color-theme);
    color: #fff;
  }
  .prompt-detail-count {
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    font-weight: 500;
  }
  .prompt-detail-header h1 {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 800;
    margin: 0;
    color: var(--color-theme);
    line-height: 1.2;
  }
  .prompt-detail-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .prompt-detail-tip {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.5em 0.75em;
    background: color-mix(in srgb, var(--color-theme) 8%, var(--color-base));
    border: 1px solid color-mix(in srgb, var(--color-theme) 18%, transparent);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-main) 85%, transparent);
  }
  .prompt-detail-tip-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-theme);
    letter-spacing: 0.02em;
    margin-block-end: 0.1rem;
  }

  .prompt-detail-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: auto;
  }

  /* Hide the first blockquote inside prompt content (it's the usage tip shown above) */
  .prompt-content :global(blockquote:first-of-type) {
    display: none !important;
  }

  /* The detail card is the canonical page title; hide the source H1 to avoid
     repeating source-only version labels such as "Default版". */
  .prompt-content :global(h1:first-child) {
    display: none;
  }

  /* ── Tabs ── */
  .prompt-tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25rem;
    margin-block-end: var(--sp-m);
    border-block-end: 2px solid color-mix(in srgb, var(--color-theme) 18%, transparent);
    padding-block-end: 0;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }
  .prompt-tabs::-webkit-scrollbar {
    display: none;
  }
  .prompt-tab {
    flex: 0 0 auto;
    padding: 0.45em clamp(0.55rem, 1.1vw, 1rem);
    font-size: clamp(0.78rem, 1.1vw, 0.9rem);
    font-weight: 600;
    font-family: inherit;
    border: 1px solid color-mix(in srgb, var(--color-theme) 22%, transparent);
    border-block-end: none;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: var(--color-surface-elevated);
    color: color-mix(in srgb, var(--color-main) 70%, transparent);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
    position: relative;
    bottom: -2px;
  }
  .prompt-tab:hover {
    background: color-mix(in srgb, var(--color-theme) 12%, var(--color-base));
    color: var(--color-theme);
  }
  .prompt-tab[aria-selected="true"] {
    background: var(--color-surface-elevated);
    color: var(--color-theme);
    border-color: color-mix(in srgb, var(--color-theme) 35%, transparent);
    border-block-end: 2px solid var(--color-base);
    z-index: 1;
  }
  .prompt-tab:focus-visible {
    outline: 2px solid var(--color-theme);
    outline-offset: 2px;
  }

  .prompt-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35em 0.65em;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: inherit;
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-main) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-main) 18%, transparent);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .prompt-copy-btn:hover {
    background: color-mix(in srgb, var(--color-theme) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-theme) 30%, transparent);
    color: var(--color-theme);
  }
  .prompt-copy-btn.copied {
    color: var(--color-theme);
    border-color: var(--color-theme);
  }
  .prompt-copy-btn:focus-visible {
    outline: 2px solid var(--color-theme);
    outline-offset: 2px;
  }
  .prompt-source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35em 0.65em;
    border: 1px solid color-mix(in srgb, var(--color-theme) 22%, transparent);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }
  .prompt-source-link:hover {
    color: var(--color-theme);
    border-color: var(--color-theme);
  }
  .prompt-source-link:focus-visible {
    outline: 2px solid var(--color-theme);
    outline-offset: 2px;
  }

  /* ── Prose content ── */
  .prompt-content {
