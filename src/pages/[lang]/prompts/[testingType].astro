---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ArticleShare from "@/components/ArticleShare.astro";
import Giscus from "@/components/Giscus.astro";
import { useTranslations, type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  PROMPTS_COPY_BUTTON,
  PROMPTS_COPY_SUCCESS,
  PROMPTS_DETAIL_KEYWORDS,
  PROMPTS_PAGE_TITLE,
} from "@/consts";
import { PROMPT_ASSISTED_FLOW as PROMPT_FLOW } from "@/data/promptLibrary";
import {
  buildPromptRegistry,
  getPromptAreaCounts,
  getRelatedPromptEntries,
  getVariantGroup,
} from "@/data/promptRegistry";

export async function getStaticPaths() {
  const allPrompts = await getCollection("prompts");
  const seen = new Set<string>();
  const routes: { params: { lang: string; testingType: string }; props: { entries: typeof allPrompts } }[] = [];

  for (const entry of allPrompts) {
    const key = `${entry.data.lang}__${entry.data.testingType}`;
    if (seen.has(key)) continue;
    seen.add(key);
    routes.push({
      params: { lang: entry.data.lang, testingType: entry.data.testingType },
      props: {
        entries: allPrompts
          .filter((prompt) => prompt.data.lang === entry.data.lang && prompt.data.testingType === entry.data.testingType)
          .sort((a, b) => a.data.order - b.data.order),
      },
    });
  }

  return routes;
}

const { entries } = Astro.props;
const lang = Astro.params.lang as Lang;
const testingType = Astro.params.testingType as string;
const t = useTranslations(lang);
const activeEntry = entries[0];
if (!activeEntry) throw new Error(`Prompt entry not found: ${testingType}`);

const rawBody = activeEntry.body ?? "";
const { Content, headings } = await render(activeEntry);
const registry = buildPromptRegistry(await getCollection("prompts"), lang);
const currentPrompt = registry.find((entry) => entry.id === testingType) || registry[0];
if (!currentPrompt) throw new Error(`Prompt registry entry not found: ${testingType}`);

const areas = getPromptAreaCounts(registry, lang);
const variants = getVariantGroup(currentPrompt, registry);
const relatedPrompts = getRelatedPromptEntries(currentPrompt, registry, 6);
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const promptHomeUrl = getRelativeLocaleUrl(lang, "/prompts/");
const allPromptsUrl = getRelativeLocaleUrl(lang, "/prompts/all/");
const promptUrl = (slug: string) => getRelativeLocaleUrl(lang, `/prompts/${slug}/`);

const pageTitle = activeEntry.data.title;
const pageDescription = currentPrompt.cardDescription;
const canonicalUrl = `${Astro.site?.toString().replace(/\/$/, "") || "https://inaodeng.com"}${promptUrl(testingType)}`;
const sourceRepositoryUrl = "https://github.com/naodeng/awesome-qa-prompt/blob/main/";
const sourceUrl = `${sourceRepositoryUrl}${activeEntry.data.sourcePath}`;
const copyLabel = t(PROMPTS_COPY_BUTTON);
const copiedLabel = t(PROMPTS_COPY_SUCCESS);
const tocLabel = lang === "zh-cn" ? "本页目录" : "On this page";
const sidebarLabel = lang === "zh-cn" ? "按测试领域浏览" : "Browse by QA area";
const detailCopy = lang === "zh-cn"
  ? {
      prompt: "提示词",
      contract: "提示词契约",
      inputs: "准备这些输入",
      outputs: "可期待的输出",
      variant: "选择版本",
      platform: "平台",
      body: "提示词正文",
      workflow: "继续你的测试流程",
      workflowIntro: "选择下一个分析或设计环节，保持上下文连续。",
      related: "相关提示词",
      back: "返回提示词首页",
      browseAll: "在全部提示词中筛选",
      source: "查看 GitHub 源提示词",
      comments: "评论",
      standard: "默认版",
      lite: "轻量版",
      plus: "增强版",
    }
  : {
      prompt: "Prompt",
      contract: "Prompt contract",
      inputs: "Prepare these inputs",
      outputs: "Expected output",
      variant: "Choose a variant",
      platform: "Platform",
      body: "Prompt body",
      workflow: "Continue your QA workflow",
      workflowIntro: "Choose the next analysis or design step while keeping context connected.",
      related: "Related prompts",
      back: "Back to prompt library",
      browseAll: "Filter all prompts",
      source: "View source on GitHub",
      comments: "Comments",
      standard: "Standard",
      lite: "Lite",
      plus: "Plus",
      basic: "Basic",
      intermediate: "Intermediate",
      advanced: "Advanced",
    };

const breadcrumbs = [
  { name: lang === "zh-cn" ? "首页" : "Home", url: getRelativeLocaleUrl(lang, "/") },
  { name: t(PROMPTS_PAGE_TITLE), url: promptHomeUrl },
  { name: currentPrompt.areaLabel, url: `${allPromptsUrl}?area=${currentPrompt.areaKey}` },
  { name: pageTitle, url: promptUrl(testingType) },
];

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  inLanguage: lang === "zh-cn" ? "zh-CN" : "en",
  step: [
    { "@type": "HowToStep", position: 1, name: detailCopy.inputs, text: currentPrompt.inputs.join("; ") },
    { "@type": "HowToStep", position: 2, name: detailCopy.prompt, text: pageDescription },
    { "@type": "HowToStep", position: 3, name: detailCopy.outputs, text: currentPrompt.outputs.join("; ") },
  ],
};

const workflowSteps = PROMPT_FLOW[lang].slice(0, 9);
const platformLabel = (platform: string) => lang === "zh-cn"
  ? ({ mobile: "移动端", web: "网页端" }[platform] || platform)
  : platform;
const variantLabel = (entry: (typeof registry)[number]) => {
  return entry.variant === "plus" ? detailCopy.plus : entry.variant === "lite" ? detailCopy.lite : detailCopy.standard;
};
const variantDisplayLabel = (entry: (typeof registry)[number]) => (
  entry.platform ? `${variantLabel(entry)} · ${platformLabel(entry.platform)}` : variantLabel(entry)
);
---

<Base
  title={pageTitle}
  description={pageDescription}
  keywords={`${PROMPTS_DETAIL_KEYWORDS[lang]}, ${testingType.replace(/-/g, " ")}, ${pageTitle}`}
  type="article"
  breadcrumbs={breadcrumbs}
  extraStructuredData={[howToSchema]}
  contentWide={true}
>
  <Breadcrumb items={breadcrumbs} />
  <div class="prompt-detail-layout" data-has-toc={tocHeadings.length > 0}>
    <aside class="prompt-detail-sidebar" aria-label={sidebarLabel}>
      <div class="prompt-detail-sidebar-inner">
        <button type="button" class="prompt-sidebar-toggle" aria-expanded="false" aria-controls="prompt-sidebar-nav" id="prompts-sidebar-toggle">
          <span>{sidebarLabel}</span><span class="material-icons-sharp" aria-hidden="true">expand_more</span>
        </button>
        <nav id="prompt-sidebar-nav" class="prompt-sidebar-nav">
          <a class="prompt-sidebar-home" href={promptHomeUrl}><span class="material-icons-sharp" aria-hidden="true">arrow_back</span>{detailCopy.back}</a>
          <a class="prompt-sidebar-all" href={`${allPromptsUrl}?area=${currentPrompt.areaKey}`}>{detailCopy.browseAll}</a>
          <p class="prompt-sidebar-label">{sidebarLabel}</p>
          <ul>
            {areas.map((area) => (
              <li>
                <a
                  href={`${allPromptsUrl}?area=${area.key}`}
                  class:list={{ "is-current": area.key === currentPrompt.areaKey }}
                  aria-current={area.key === currentPrompt.areaKey ? "location" : undefined}
                >
                  <span>{area.label}</span><small>{area.count}</small>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>

    <main class="prompt-detail-main">
      <header class="prompt-detail-header" id="prompt-usage-tip">
        <div class="prompt-detail-kicker">
          <span>{currentPrompt.areaLabel}</span><span aria-hidden="true">/</span><span>{currentPrompt.taskLabel}</span>
        </div>
        <h1>{pageTitle}</h1>
        <p class="prompt-detail-desc">{pageDescription}</p>
        <div class="prompt-detail-badges">
          {currentPrompt.variant !== "standard" && <span>{variantLabel(currentPrompt)}</span>}
          {currentPrompt.platform && <span>{platformLabel(currentPrompt.platform)}</span>}
        </div>
        <div class="prompt-detail-actions">
          <button
            type="button"
            class="prompt-copy-btn"
            data-copy-label={copyLabel}
            data-copied-label={copiedLabel}
            data-raw-content={rawBody}
            aria-label={copyLabel}
          >
            <span class="material-icons-sharp" aria-hidden="true">content_copy</span><span class="prompt-copy-btn-text">{copyLabel}</span>
          </button>
          <a class="prompt-source-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">{detailCopy.source}<span class="material-icons-sharp" aria-hidden="true">open_in_new</span></a>
        </div>
      </header>

      <section class="prompt-at-a-glance" aria-labelledby="prompt-at-a-glance-heading">
        <h2 id="prompt-at-a-glance-heading" class="visually-hidden">{detailCopy.contract}</h2>
        <div class="prompt-contract-block">
          <span class="prompt-glance-label">{detailCopy.inputs}</span>
          <ul>{currentPrompt.inputs.map((input) => <li>{input}</li>)}</ul>
        </div>
        <div class="prompt-contract-block">
          <span class="prompt-glance-label">{detailCopy.outputs}</span>
          <ul>{currentPrompt.outputs.map((output) => <li>{output}</li>)}</ul>
        </div>
      </section>

      {variants.length > 1 && (
        <nav class="prompt-variants" aria-label={detailCopy.variant}>
          <span class="prompt-variants-label">{detailCopy.variant}</span>
          <div>
            {variants.map((variant) => (
              <a
                href={promptUrl(variant.slug)}
                class:list={{ "is-current": variant.id === currentPrompt.id }}
                aria-current={variant.id === currentPrompt.id ? "page" : undefined}
              >
                {variantDisplayLabel(variant)}
              </a>
            ))}
          </div>
        </nav>
      )}

      <section class="prompt-body-panel" aria-labelledby="prompt-body-heading">
        <div class="prompt-body-heading">
          <h2 id="prompt-body-heading">{detailCopy.body}</h2>
        </div>
        <div
          class="prompt-content prose"
          data-headings={JSON.stringify(tocHeadings.map((heading) => ({ depth: heading.depth, slug: heading.slug, text: heading.text })))}
        >
          <Content />
        </div>
      </section>

      <ArticleShare title={pageTitle} url={canonicalUrl} locale={lang as "en" | "zh-cn"} />

      <section class="prompt-workflow-next" aria-labelledby="prompt-workflow-heading">
        <div class="prompt-related-heading">
          <h2 id="prompt-workflow-heading">{detailCopy.workflow}</h2>
          <p>{detailCopy.workflowIntro}</p>
        </div>
        <ol>
          {workflowSteps.map((step, index) => {
            const isCurrent = step.slug === currentPrompt.familyId;
            return (
              <li class:list={{ "is-current": isCurrent }}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <a href={promptUrl(step.slug)} aria-current={isCurrent ? "step" : undefined}>
                  <strong>{step.label}</strong><small>{step.desc}</small>
                </a>
              </li>
            );
          })}
        </ol>
      </section>

      {relatedPrompts.length > 0 && (
        <section class="prompt-related-prompts" aria-labelledby="related-prompts-heading">
          <div class="prompt-related-heading">
            <h2 id="related-prompts-heading">{detailCopy.related}</h2>
          </div>
          <div class="prompt-related-prompts-grid">
            {relatedPrompts.map((entry) => (
              <a href={promptUrl(entry.slug)} class="prompt-related-prompt" data-related-prompt>
                <span><strong>{entry.title}</strong><small>{entry.taskLabel}</small></span><span class="prompt-related-prompt-arrow material-icons-sharp" aria-hidden="true">arrow_forward</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <Giscus lang={lang === "zh-cn" ? "zh-CN" : "en"} inputPosition="bottom" loading="lazy" />
    </main>

    {tocHeadings.length > 0 && (
      <aside class="prompt-detail-toc" id="prompts-toc-wrap">
        <TableOfContents headings={tocHeadings} label={tocLabel} placement="right" />
      </aside>
    )}
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>(".prompt-copy-btn").forEach((button) => {
    button.addEventListener("click", async () => {
      const content = button.dataset.rawContent || "";
      const copyLabel = button.dataset.copyLabel || "Copy";
      const copiedLabel = button.dataset.copiedLabel || "Copied!";
      const text = button.querySelector(".prompt-copy-btn-text");
      if (!content || !navigator.clipboard?.writeText) return;
      try {
        await navigator.clipboard.writeText(content);
        if (text) text.textContent = copiedLabel;
        button.classList.add("is-copied");
        window.setTimeout(() => {
          if (text) text.textContent = copyLabel;
          button.classList.remove("is-copied");
        }, 1600);
      } catch {
        // Keep the original label when clipboard permission is unavailable.
      }
    });
  });

  const sidebarToggle = document.getElementById("prompts-sidebar-toggle");
  sidebarToggle?.addEventListener("click", () => {
    const sidebar = sidebarToggle.closest(".prompt-detail-sidebar-inner");
    const expanded = sidebar?.classList.toggle("is-open") || false;
    sidebarToggle.setAttribute("aria-expanded", String(expanded));
  });
</script>

<style>
  .prompt-detail-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: var(--sp-l); max-width: var(--layout-max); margin: 0 auto; padding: 0 var(--sp-m) 5rem; align-items: start; }
  .prompt-detail-layout[data-has-toc="true"] { grid-template-columns: 220px minmax(0, 1fr) 200px; }
  .prompt-detail-sidebar, .prompt-detail-toc { position: sticky; top: var(--sp-m); align-self: start; }
  .prompt-detail-sidebar-inner { border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .prompt-sidebar-toggle { display: none; width: 100%; justify-content: space-between; padding: 0.85rem 1rem; border: 0; background: transparent; color: var(--color-main); font: inherit; font-weight: 800; text-align: start; cursor: pointer; }
  .prompt-sidebar-toggle .material-icons-sharp { font-size: 1.1rem; }
  .prompt-sidebar-nav { max-height: calc(100vh - 2rem); overflow-y: auto; padding: 1rem; }
  .prompt-sidebar-home, .prompt-sidebar-all { display: inline-flex; gap: 0.35rem; align-items: center; color: var(--color-theme); font-size: 0.78rem; font-weight: 800; text-decoration: none; line-height: 1.45; }
  .prompt-sidebar-home .material-icons-sharp { font-size: 0.95rem; }
  .prompt-sidebar-home:hover, .prompt-sidebar-all:hover { text-decoration: underline; }
  .prompt-sidebar-all { margin-top: 0.8rem; padding-top: 0.8rem; border-top: 1px solid var(--color-border); }
  .prompt-sidebar-label { margin: 1rem 0 0.5rem; color: color-mix(in srgb, var(--color-main) 55%, transparent); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .prompt-sidebar-nav ul { display: grid; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .prompt-sidebar-nav li a { display: flex; justify-content: space-between; gap: 0.5rem; padding: 0.48rem 0.55rem; border-radius: var(--radius-sm); color: color-mix(in srgb, var(--color-main) 70%, transparent); font-size: 0.8rem; line-height: 1.35; text-decoration: none; }
  .prompt-sidebar-nav li a:hover, .prompt-sidebar-nav li a.is-current { background: var(--color-theme-soft); color: var(--color-theme); }
  .prompt-sidebar-nav li small { flex: 0 0 auto; opacity: 0.7; }
  .prompt-detail-main { min-width: 0; }
  .prompt-detail-header { padding: 0 0 2rem; }
  .prompt-detail-kicker { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; color: var(--color-theme); font-size: 0.76rem; font-weight: 800; }
  .prompt-detail-header h1 { max-width: 22ch; margin: 0.75rem 0 0; font-size: clamp(2.1rem, 5vw, 4.2rem); line-height: 1; letter-spacing: -0.055em; }
  .prompt-detail-desc { max-width: 70ch; margin: 1rem 0 0; color: color-mix(in srgb, var(--color-main) 68%, transparent); font-size: 1rem; line-height: 1.7; }
  .prompt-detail-badges { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.1rem; }
  .prompt-detail-badges span, .prompt-variants a { padding: 0.3rem 0.6rem; border: 1px solid var(--color-border); border-radius: 999px; color: color-mix(in srgb, var(--color-main) 72%, transparent); font-size: 0.72rem; font-weight: 800; text-decoration: none; }
  .prompt-detail-badges span:first-child { border-color: color-mix(in srgb, var(--color-theme) 30%, var(--color-border)); background: var(--color-theme-soft); color: var(--color-theme); }
  .prompt-detail-actions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.5rem; }
  .prompt-copy-btn, .prompt-source-link { display: inline-flex; min-height: 42px; align-items: center; gap: 0.45rem; padding: 0 0.8rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-main); font: inherit; font-size: 0.82rem; font-weight: 800; text-decoration: none; cursor: pointer; }
  .prompt-copy-btn:hover, .prompt-source-link:hover, .prompt-copy-btn.is-copied { border-color: var(--color-theme); color: var(--color-theme); }
  .prompt-at-a-glance { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin: 1.5rem 0 0; }
  .prompt-contract-block { min-width: 0; padding: 1.15rem 1rem 1.25rem; border-radius: var(--radius-sm); background: var(--color-surface-muted); }
  .prompt-contract-block + .prompt-contract-block { padding-inline: 1rem; border-inline-start: 0; }
  .prompt-glance-label { color: var(--color-theme); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; }
  .prompt-contract-block ul { display: grid; gap: 0.45rem; margin: 0.7rem 0 0; padding-inline-start: 1.1rem; color: color-mix(in srgb, var(--color-main) 75%, transparent); font-size: 0.83rem; line-height: 1.45; }

  .prompt-variants { display: flex; flex-wrap: wrap; gap: 0.7rem; align-items: center; margin: 1.5rem 0; padding-block: 0.2rem; }
  .prompt-variants-label { color: color-mix(in srgb, var(--color-main) 58%, transparent); font-size: 0.75rem; font-weight: 800; }
  .prompt-variants > div { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .prompt-variants a:hover, .prompt-variants a.is-current { border-color: var(--color-theme); background: var(--color-theme-soft); color: var(--color-theme); }

  .prompt-body-panel { margin-top: 3rem; }
  .prompt-body-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: end; padding-bottom: 0.5rem; }
  .prompt-body-heading h2 { margin: 0; font-size: 1.35rem; }
  .prompt-content { padding-top: 0.35rem; color: var(--color-main); line-height: 1.8; }
  .prompt-content :global(h1:first-child) { display: none; }
  .prompt-content :global(blockquote:first-of-type) { display: none; }
  .prompt-content :global(h1) { margin-block: 1.2em 0.5em; font-size: 1.55rem; }
  .prompt-content :global(h2) { margin-block: 2em 0.55em; padding-inline-start: 0.75rem; border-inline-start: 3px solid var(--color-theme); font-size: 1.25rem; }
  .prompt-content :global(h3) { margin-block: 1.5em 0.45em; font-size: 1.08rem; }
  .prompt-content :global(p) { margin-block: 0.8em 0; }
  .prompt-content :global(ul), .prompt-content :global(ol) { margin-block: 0.55em 0; padding-inline-start: 1.5em; }
  .prompt-content :global(li) { margin-block: 0.25em 0; }
  .prompt-content :global(:not(pre) > code) { padding: 0.15em 0.4em; border-radius: var(--radius-sm); background: var(--color-theme-soft); color: var(--color-theme); font-family: ui-monospace, "Cascadia Code", Menlo, Consolas, monospace; font-size: 0.9em; }
  .prompt-content :global(pre) { overflow-x: auto; margin-block: 1em 0; padding: 1em 1.25em; border-left: 3px solid var(--color-theme); border-radius: var(--radius-sm); background: var(--color-surface-muted); direction: ltr; }
  .prompt-content :global(blockquote) { margin-block: 1em 0; padding: 0.75em 1em; border-left: 3px solid color-mix(in srgb, var(--color-theme) 40%, transparent); background: var(--color-surface-muted); color: color-mix(in srgb, var(--color-main) 70%, transparent); }
  .prompt-content :global(table) { display: block; width: 100%; overflow-x: auto; margin-block: 1em 0; border-collapse: collapse; font-size: 0.9rem; }
  .prompt-content :global(th), .prompt-content :global(td) { padding: 0.5em 0.75em; border: 1px solid var(--color-border); text-align: start; }
  .prompt-content :global(th) { background: var(--color-theme-soft); }
  .prompt-content :global(a) { color: var(--color-theme); text-decoration: underline; }

  .prompt-workflow-next, .prompt-related-prompts { margin-top: 3rem; padding-top: 0; }
  .prompt-related-heading { display: block; margin-bottom: 1rem; }
  .prompt-related-heading h2 { margin: 0; font-size: 1.45rem; }
  .prompt-related-heading p { max-width: 52ch; margin: 0.45rem 0 0; color: color-mix(in srgb, var(--color-main) 62%, transparent); font-size: 0.85rem; line-height: 1.55; }
  .prompt-workflow-next ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; list-style: none; margin: 0; padding: 0; }
  .prompt-workflow-next li { min-width: 0; padding: 0.85rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .prompt-workflow-next li.is-current { border-color: var(--color-theme); background: var(--color-theme-soft); }
  .prompt-workflow-next li > span { color: var(--color-theme); font-size: 0.7rem; font-weight: 800; }
  .prompt-workflow-next li a { display: grid; gap: 0.3rem; margin-top: 0.55rem; color: var(--color-main); text-decoration: none; }
  .prompt-workflow-next li a:hover strong { color: var(--color-theme); }
  .prompt-workflow-next li small { color: color-mix(in srgb, var(--color-main) 58%, transparent); line-height: 1.45; }
  .prompt-related-prompts-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; }
  .prompt-related-prompt { display: flex; min-height: 80px; justify-content: space-between; gap: 0.7rem; align-items: center; padding: 0.8rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-main); text-decoration: none; }
  .prompt-related-prompt:hover { border-color: var(--color-theme); background: var(--color-theme-soft); }
  .prompt-related-prompt span:first-child { display: grid; gap: 0.3rem; }
  .prompt-related-prompt strong { font-size: 0.82rem; line-height: 1.35; }
  .prompt-related-prompt small { color: color-mix(in srgb, var(--color-main) 58%, transparent); font-size: 0.7rem; }
  .prompt-related-prompt-arrow { color: var(--color-theme); }
  .prompt-detail-toc :global(.toc-sidebar--right) { position: static; max-height: calc(100vh - 2rem); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

