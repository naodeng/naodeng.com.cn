---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CollectionPostGrid from "@/components/CollectionPostGrid.astro";
import PageHeadline from "@/components/PageHeadline.astro";
import PaginationNav from "@/components/PaginationNav.astro";
import { BLOG_POSTS_PER_PAGE, NAV_HOME, NAV_TAGS } from "@/consts";
import { getCollection, type CollectionEntry } from "astro:content";
import { filterPublishedBlogPosts } from "@/utils/blogPublication";
import { paginateItems } from "@/utils/blogPagination";

function tagToSlug(tag: string) {
  return tag.includes("/") || tag.includes(" ") ? encodeURIComponent(tag) : tag;
}

function slugToTag(slug: string) {
  return decodeURIComponent(slug);
}

export async function getStaticPaths() {
  const allPosts = filterPublishedBlogPosts(await getCollection("blog"));
  const paths: {
    params: { lang: string; tag: string; page: string };
    props: { posts: CollectionEntry<"blog">[] };
  }[] = [];

  for (const lang of Object.keys(LOCALES)) {
    const langPosts = allPosts.filter((post) => post.id.startsWith(`${lang}/`));
    const tags = [...new Set(langPosts.flatMap((post) => post.data.tags || []))];

    for (const tag of tags) {
      const postsWithTag = langPosts.filter((post) => post.data.tags?.includes(tag));
      const totalPages = Math.max(1, Math.ceil(postsWithTag.length / BLOG_POSTS_PER_PAGE));
      const tagSegment = tag.includes("/") ? encodeURIComponent(tag) : tag;

      for (let page = 2; page <= totalPages; page += 1) {
        paths.push({
          params: { lang, tag: tagSegment, page: String(page) },
          props: { posts: postsWithTag },
        });
      }
    }
  }

  return paths;
}

const { lang, tag: tagSlug, page } = Astro.params;
const tag = tagSlug ? slugToTag(tagSlug) : "";
const { posts } = Astro.props;
const locale = lang as Lang;
const t = useTranslations(locale);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const paginated = paginateItems(sortedPosts, Number(page) || 1, BLOG_POSTS_PER_PAGE);
const title = `#${tag}`;
const tagBasePath = `/tags/${tagToSlug(tag)}/`;
const pageLabel = locale === "zh-cn" ? `第 ${paginated.currentPage} 页` : `Page ${paginated.currentPage}`;
const homeName = typeof NAV_HOME === "string" ? NAV_HOME : (NAV_HOME[locale] ?? (locale === "zh-cn" ? "首页" : "Home"));
const tagsLabel = typeof NAV_TAGS === "string" ? NAV_TAGS : (NAV_TAGS[locale] ?? (locale === "zh-cn" ? "标签" : "Tags"));
const breadcrumbs = [
  { name: homeName, url: `/${lang}/` },
  { name: tagsLabel, url: `/${lang}/tags/` },
  { name: `#${tag}`, url: `/${lang}/tags/${tagToSlug(tag)}/` },
  { name: pageLabel, url: `/${lang}${tagBasePath}page/${paginated.currentPage}/` },
];
---

<Layout {title}>
  <Breadcrumb items={breadcrumbs} />
  <PageHeadline {title}>
    <p class="tag-meta">{paginated.totalItems} {t({ en: "posts found", "zh-cn": "篇文章" })}</p>
  </PageHeadline>

  <div class="blog-container">
    <CollectionPostGrid posts={paginated.items} locale={locale} showAllTags activeTag={tag} />
    {paginated.totalPages > 1 && (
      <PaginationNav currentPage={paginated.currentPage} totalPages={paginated.totalPages} locale={locale} basePath={tagBasePath} />
    )}
  </div>
</Layout>

<style>
  .tag-meta {
    font-size: 1rem;
    opacity: 0.8;
    margin-block-start: 0.5rem;
    font-weight: 600;
  }

  .blog-container {
    margin-block-start: var(--sp-l);
  }
</style>
