---
// Redirect /prompts/ to the locale-prefixed prompts page based on browser language
import { LOCALES, DEFAULT_LOCALE } from "@/i18n";

const langs = Object.keys(LOCALES);
const baseUrl = "/";
const fallbackLocale = LOCALES["zh-cn"] ? "zh-cn" : DEFAULT_LOCALE;
---

<html lang={fallbackLocale}>
  <head>
    <meta charset="UTF-8" />
    <title>redirect...</title>
    <meta name="robots" content="noindex, follow" />
    <meta name="baidu-site-verification" content="codeva-vnBqpvbpQk" />
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${baseUrl + fallbackLocale}/prompts/`} />
    </noscript>
    <script is:inline define:vars={{ langs, baseUrl, fallbackLocale }}>
      (function () {
        var selectedLang = "";
        try {
          selectedLang = localStorage.getItem("selectedLang") || "";
        } catch {
          // Browser storage can be unavailable when cookies or site data are blocked.
        }
        if (selectedLang && langs.includes(selectedLang)) {
          location.replace(baseUrl + selectedLang + "/prompts/");
          return;
        }
        var list = [];
        try {
          var preferred = navigator.language || navigator.userLanguage || "";
          if (preferred) list.push(preferred);
        } catch {
          // Browser language is optional; use the Chinese fallback below.
        }
        try {
          if (navigator.languages && navigator.languages.length) {
            list = list.concat(Array.from(navigator.languages));
          }
        } catch {
          // Keep navigator.language when the full preference list is unavailable.
        }
        for (var i = 0; i < list.length; i++) {
          var raw = (list[i] || "").toLowerCase();
          if (langs.includes(raw)) {
            location.replace(baseUrl + raw + "/prompts/");
            return;
          }
          var primary = raw.split("-")[0];
          if (primary === "zh") {
            location.replace(baseUrl + "zh-cn/prompts/");
            return;
          }
          if (langs.includes(primary)) {
            location.replace(baseUrl + primary + "/prompts/");
            return;
          }
        }
        location.replace(baseUrl + fallbackLocale + "/prompts/");
      })();
    </script>
  </head>
  <body>
    <p>redirect...</p>
  </body>
</html>
