---
// Redirect to Top page for user's system locale
import {
  useTranslations,
  getLocalePaths,
  LOCALES,
  DEFAULT_LOCALE,
  type Lang,
} from "@/i18n";
import { SITE_TITLE, SITE_DESCRIPTION, X_ACCOUNT } from "@/consts";

const fallbackLocale: Lang = LOCALES["zh-cn"] ? "zh-cn" : DEFAULT_LOCALE;
const t = useTranslations(fallbackLocale);
const langs = Object.keys(LOCALES);
const baseUrl = "/";
const localePaths = await getLocalePaths(Astro.url);
---

<html lang={fallbackLocale}>
  <head>
    <meta charset="UTF-8" />
    <title>redirect...</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {
      localePaths.map((props) => (
        <link
          rel="alternate"
          hreflang={LOCALES[props.lang].lang || props.lang}
          href={Astro.site?.origin + props.path}
        />
      ))
    }

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light" />
    <meta name="baidu-site-verification" content="codeva-vnBqpvbpQk" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t(SITE_TITLE)} />
    <meta property="og:site_name" content={t(SITE_TITLE)} />
    <meta property="og:description" content={t(SITE_DESCRIPTION)} />
    <meta property="og:image" content={Astro.site + "ogp.png"} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content={fallbackLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content={t(X_ACCOUNT)} />

    <noscript>
      <meta
        http-equiv="refresh"
        content={`0;url=${baseUrl + fallbackLocale}/`}
      />
    </noscript>

    <script is:inline define:vars={{ langs, baseUrl, fallbackLocale }}>
      (function () {
        // 1. 用户曾在站内选择过语言时，优先使用
        var selectedLang = "";
        try {
          selectedLang = localStorage.getItem("selectedLang") || "";
        } catch {
          // Browser storage can be unavailable when cookies or site data are blocked.
        }
        if (selectedLang && langs.includes(selectedLang)) {
          location.replace(baseUrl + selectedLang + "/");
          return;
        }
        // 2. 根据浏览器语言偏好选择站点语言（navigator.language + navigator.languages）
        var list = [];
        try {
          var preferred = navigator.language || navigator.userLanguage || "";
          if (preferred) list.push(preferred);
        } catch {
          // Browser language is optional; use the Chinese fallback below.
        }
        try {
          if (navigator.languages && navigator.languages.length) {
            list = list.concat(Array.from(navigator.languages));
          }
        } catch {
          // Keep navigator.language when the full preference list is unavailable.
        }
        for (var i = 0; i < list.length; i++) {
          var raw = (list[i] || "").toLowerCase();
          if (langs.includes(raw)) {
            location.replace(baseUrl + raw + "/");
            return;
          }
          var primary = raw.split("-")[0];
          if (primary === "zh") {
            location.replace(baseUrl + "zh-cn/");
            return;
          }
          if (langs.includes(primary)) {
            location.replace(baseUrl + primary + "/");
            return;
          }
        }
        location.replace(baseUrl + fallbackLocale + "/");
      })();
    </script>
  </head>
  <body>
    <h1>redirect...</h1>
  </body>
</html>
