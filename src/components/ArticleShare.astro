---
/**
 * 博文下方分享组件：复制链接、X、微博、LinkedIn、Facebook
 */
interface Props {
  title: string;
  url: string;
  /** 是否中文环境，用于文案与是否显示微博 */
  locale?: "zh-cn" | "en";
  /** 是否显示分享区域标题 */
  showLabel?: boolean;
}

const { title, url, locale = "en", showLabel = true } = Astro.props;
const isZh = locale === "zh-cn";
const labelShare = isZh ? "分享" : "Share";
const labelCopy = isZh ? "复制链接" : "Copy link";
const labelCopied = isZh ? "已复制" : "Copied";
const labelCopyFail = isZh ? "复制失败" : "Copy failed";
const labelCopyUnsupported = isZh ? "请手动复制链接" : "Please copy the link manually";
const labelTwitter = "X (Twitter)";
const labelWeibo = "微博";
const labelLinkedIn = "LinkedIn";
const labelFacebook = "Facebook";

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const twitterUrl = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
const weiboUrl = `https://service.weibo.com/share/share.php?url=${encodedUrl}&title=${encodedTitle}`;
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
---

<section class="article-share" aria-label={labelShare}>
  {showLabel && <span class="article-share-label">{labelShare}</span>}
  <div class="article-share-buttons">
    <button
      type="button"
      class="article-share-btn article-share-copy"
      data-url={url}
      data-label-copy={labelCopy}
      data-label-copied={labelCopied}
      data-label-fail={labelCopyFail}
      title={labelCopy}
      aria-label={labelCopy}
      aria-describedby="article-share-copy-feedback"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
      <span class="article-share-btn-text">{labelCopy}</span>
    </button>
    <a href={twitterUrl} target="_blank" rel="noopener noreferrer" class="article-share-btn" title={labelTwitter} aria-label={labelTwitter}>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
    </a>
    {isZh && (
      <a href={weiboUrl} target="_blank" rel="noopener noreferrer" class="article-share-btn" title={labelWeibo} aria-label={labelWeibo}>
        {/* Remix Icon weibo-fill; Copyright (c) 2017-2026 Remix Design. https://github.com/Remix-Design/RemixIcon/blob/master/License */}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4.27799 8.59201C7.05085 5.8217 10.282 4.55876 11.4966 5.77587C12.0338 6.31312 12.0848 7.23996 11.741 8.34757C11.5628 8.9052 12.2655 8.5971 12.2655 8.5971C14.5062 7.66008 16.4618 7.60407 17.1747 8.62511C17.5541 9.16746 17.5184 9.93133 17.1671 10.8149C17.0041 11.2223 17.2154 11.2859 17.5261 11.3776C18.789 11.7697 20.1945 12.7144 20.1945 14.3822C20.1945 17.1448 16.2148 20.6205 10.2311 20.6205C5.66569 20.6205 1.00098 18.4078 1.00098 14.7692C1.00098 12.8671 2.20535 10.6672 4.27799 8.59201ZM16.4108 14.3338C16.174 11.9429 13.0294 10.2954 9.38829 10.657C5.74717 11.016 2.9845 13.2465 3.2213 15.6375C3.4581 18.0309 6.60271 19.6758 10.2438 19.3168C13.885 18.9552 16.6451 16.7247 16.4108 14.3338ZM6.16221 14.4382C6.91589 12.9104 8.87395 12.0473 10.6079 12.4979C12.4005 12.9614 13.3146 14.6521 12.5838 16.2969C11.8403 17.98 9.70148 18.8763 7.88856 18.2906C6.13674 17.7254 5.39579 15.9965 6.16221 14.4382ZM8.8765 15.0162C8.31378 14.7794 7.58556 15.0238 7.23672 15.5687C6.88279 16.1162 7.0483 16.7705 7.60847 17.0252C8.17628 17.2823 8.93252 17.0379 9.2839 16.4752C9.63019 15.9074 9.44686 15.2581 8.8765 15.0162ZM10.2642 14.4382C10.0478 14.3542 9.77787 14.456 9.65056 14.6699C9.52834 14.8838 9.59709 15.1282 9.81352 15.2173C10.0325 15.309 10.3151 15.2046 10.4424 14.9856C10.5647 14.7666 10.4857 14.5197 10.2642 14.4382ZM15.9576 2.92408C17.9258 2.50649 20.0545 3.12017 21.5008 4.71918C22.947 6.31822 23.3341 8.50034 22.7204 10.4228C22.5796 10.8639 22.1036 11.1075 21.6612 10.9626C21.2181 10.8174 20.9762 10.3438 21.1188 9.90078C21.5568 8.54108 21.2806 6.98652 20.2531 5.84971C19.2244 4.71154 17.712 4.27613 16.3115 4.57404C15.8558 4.67099 15.41 4.37994 15.3109 3.92475C15.2115 3.46897 15.5018 3.02078 15.9576 2.92408ZM16.584 5.84971C17.5414 5.64601 18.5802 5.94392 19.283 6.72307C19.9858 7.50222 20.1742 8.56655 19.8737 9.49847C19.7511 9.87865 19.3409 10.089 18.9596 9.96443C18.5777 9.83967 18.3714 9.43227 18.4962 9.04779C18.6464 8.59201 18.5522 8.07258 18.2085 7.69064C17.8622 7.31125 17.3555 7.16611 16.887 7.26542C16.4949 7.35199 16.1104 7.09991 16.0263 6.71034C15.9423 6.31822 16.1917 5.93316 16.584 5.84971Z"/>
            </svg>
      </a>
    )}
    <a href={linkedInUrl} target="_blank" rel="noopener noreferrer" class="article-share-btn" title={labelLinkedIn} aria-label={labelLinkedIn}>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
    </a>
    <a href={facebookUrl} target="_blank" rel="noopener noreferrer" class="article-share-btn" title={labelFacebook} aria-label={labelFacebook}>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>
    </a>
  </div>
  <span class="article-share-copy-feedback" id="article-share-copy-feedback" role="status" aria-live="polite" data-copied={labelCopied} data-copy-fail={labelCopyFail} data-copy-unsupported={labelCopyUnsupported} hidden>{labelCopied}</span>
</section>

<script is:inline>
  (function () {
    const btn = document.querySelector(".article-share-copy");
    const feedback = document.getElementById("article-share-copy-feedback");
    if (!btn || !feedback) return;
    btn.addEventListener("click", function () {
      const url = btn.getAttribute("data-url") || "";
      if (!url) return;
      const text = btn.querySelector(".article-share-btn-text");
      const defaultLabel = btn.getAttribute("data-label-copy") || "Copy link";
      const setCopyState = function (state, message, resetDelay) {
        btn.setAttribute("data-state", state);
        btn.setAttribute("aria-label", message);
        btn.setAttribute("title", message);
        if (text) text.textContent = message;
        feedback.hidden = false;
        feedback.textContent = message;
        window.setTimeout(function () {
          btn.removeAttribute("data-state");
          btn.setAttribute("aria-label", defaultLabel);
          btn.setAttribute("title", defaultLabel);
          if (text) text.textContent = defaultLabel;
          feedback.hidden = true;
        }, resetDelay);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () {
          setCopyState("copied", feedback.getAttribute("data-copied") || "Copied", 1500);
        }).catch(function () {
          setCopyState("failed", feedback.getAttribute("data-copy-fail") || "Copy failed", 2000);
        });
      } else {
        setCopyState("failed", feedback.getAttribute("data-copy-unsupported") || "Copy not supported", 2000);
      }
    });
  })();
</script>

<style>
  .article-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block-start: 2rem;
    margin-block-end: 0;
    padding-block: 1.25rem;
    border-block-start: 1px solid var(--color-border);
  }
  .article-share-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }
  .article-share-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .article-share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 44px;
    min-inline-size: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-main);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
    cursor: pointer;
  }
  .article-share-btn:hover,
  .article-share-btn:focus-visible {
    background: var(--color-theme-soft);
    border-color: var(--color-border-strong);
    color: var(--color-theme);
  }
  .article-share-btn:focus-visible {
    outline: 2px solid var(--color-theme-focus);
    outline-offset: 3px;
  }
  .article-share-copy[data-state="copied"] {
    background: var(--color-base);
    border-color: color-mix(in srgb, var(--color-success-text) 45%, var(--color-border));
    color: var(--color-success-text);
  }
  .article-share-copy[data-state="failed"] {
    background: var(--color-base);
    border-color: color-mix(in srgb, var(--color-caution) 45%, var(--color-border));
    color: var(--color-caution);
  }
  .article-share-btn svg {
    flex-shrink: 0;
  }
  .article-share-btn-text {
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .article-share-btn-text {
      display: none;
    }
    .article-share-btn {
      padding: 0.5rem;
    }
  }
  .article-share-copy-feedback {
    font-size: 0.85rem;
    color: var(--color-theme);
    margin-inline-start: 0.25rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .article-share-btn {
      transition: none;
    }
  }
</style>
