---
/**
 * Guild 首页展示 — 与站点主题 token 保持一致
 */
import { getGuildConfig } from '../../config/guild.config';
import type { Lang } from '@/i18n';

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const guildConfig = getGuildConfig(locale);

const visibleTypes = guildConfig.testTypes.filter(
  (t) => t.id === 'api-testing' || t.id === 'performance-testing'
);

const totalFrameworks = visibleTypes.reduce((n, t) => n + t.frameworks.length, 0);
const isZh = locale === 'zh-cn';
---

<section class="guild-showcase" aria-labelledby="guild-showcase-title">
  <div class="gs-header">
    <h2 id="guild-showcase-title" class="gs-title">
      {isZh ? '测试自动化指南' : 'Test Automation Guild'}
    </h2>
    <p class="gs-subtitle">
      {isZh
        ? '系统化的测试自动化学习路径，从入门到进阶'
        : 'Systematic test automation learning paths, from beginner to advanced'}
    </p>
    <p class="gs-stats">
      <span>{visibleTypes.length}{isZh ? ' 测试类型' : ' test types'}</span>
      <span aria-hidden="true">·</span>
      <span>{totalFrameworks}{isZh ? ' 框架' : ' frameworks'}</span>
    </p>
  </div>

  <div class="gs-sections">
    {visibleTypes.map((testType) => (
      <div class="gs-type-block" data-type={testType.id}>
        <div class="gs-type-header">
          <div class="gs-type-meta">
            <h3 class="gs-type-title">{testType.title}</h3>
            <p class="gs-type-desc">{testType.description}</p>
          </div>
          <a
            href={`/${locale}/guild/${testType.id}/`}
            class="gs-type-link"
            aria-label={isZh ? `查看${testType.title}全部内容` : `View all ${testType.title}`}
          >
            {isZh ? '查看全部' : 'View all'}
          </a>
        </div>

        <div class="gs-frameworks">
          {testType.frameworks.map((fw) => (
            <a
              href={`/${locale}/guild/${testType.id}/${fw.id}/`}
              class="gs-fw-card"
              title={fw.description}
            >
              <div class="gs-fw-card-top">
                {fw.icon ? (
                  <img
                    src={fw.icon}
                    alt=""
                    class="gs-fw-icon"
                    width="28"
                    height="28"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                ) : null}
                <span class="gs-fw-lang">{fw.language}</span>
              </div>
              <span class="gs-fw-name">{fw.name}</span>
              <span class="gs-fw-desc">{fw.description}</span>
              <span class="gs-fw-more">{isZh ? '了解更多 →' : 'Learn more →'}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="gs-footer">
    <a href={`/${locale}/guild/`} class="gs-cta">
      {isZh ? '查看完整指南' : 'View Full Guide'}
    </a>
  </div>
</section>

<style>
  .guild-showcase {
    margin: 0 auto;
    max-width: 1040px;
    padding: 0;
    background: transparent;
    border: none;
  }

  .gs-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .gs-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 34px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .gs-subtitle {
    margin: 8px auto 0;
    max-width: 36em;
    font-size: 17px;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .gs-stats {
    margin: 12px 0 0;
    font-size: 14px;
    color: var(--color-text-tertiary);
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .gs-sections {
    display: flex;
    flex-direction: column;
    gap: 24px;
    text-align: start;
  }

  .gs-type-block {
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-sm);
  }

  .gs-type-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  }

  .gs-type-title {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0;
    color: var(--color-text-primary);
  }

  .gs-type-desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .gs-type-link {
    flex-shrink: 0;
    color: var(--color-theme);
    font-size: 14px;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .gs-frameworks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .gs-fw-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border-radius: var(--radius-lg);
    background: rgba(248, 250, 252, 0.82);
    border: 1px solid rgba(148, 163, 184, 0.18);
    text-decoration: none;
    color: inherit;
    box-shadow: none;
    transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
  }

  .gs-fw-card:hover {
    border-color: rgba(79, 70, 229, 0.34);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .gs-fw-card:active {
    transform: scale(0.98);
  }

  .gs-fw-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .gs-fw-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .gs-fw-lang {
    font-size: 12px;
    color: var(--color-text-tertiary);
  }

  .gs-fw-name {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0;
    color: var(--color-text-primary);
  }

  .gs-fw-desc {
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .gs-fw-more {
    margin-top: 4px;
    font-size: 14px;
    color: var(--color-theme);
  }

  .gs-footer {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  .gs-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 11px 22px;
    border-radius: 9999px;
    font-size: 17px;
    font-weight: 800;
    text-decoration: none;
    color: #fff;
    background: var(--gradient-theme);
    border: 1px solid transparent;
    box-shadow: var(--shadow-product);
  }

  .gs-cta:active {
    transform: scale(0.95);
  }

  @media (width < 900px) {
    .gs-title {
      font-size: 28px;
    }

    .gs-frameworks {
      grid-template-columns: 1fr;
    }

    .gs-type-header {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
