---
import type { Lang } from "@/i18n";
import type { PromptVersionGuideItem } from "@/data/promptLibrary";

interface Props {
  lang: Lang;
  items: PromptVersionGuideItem[];
}

const { lang, items } = Astro.props;
---

<section class="prompts-section version-guide" aria-labelledby="prompt-version-heading">
  <h2 id="prompt-version-heading">{lang === "zh-cn" ? "如何选择 Prompt 版本" : "Choose a Prompt version"}</h2>
  <p class="section-intro">
    {lang === "zh-cn"
      ? "第一次使用建议选择 Standard；只有任务明确需要特定组织方式时，再切换其他版本。"
      : "Start with Standard. Switch only when the task clearly benefits from a specific structure."}
  </p>
  <ul class="version-grid" role="list">
    {items.map((item) => (
      <li data-prompt-version={item.version} data-recommended={String(item.recommended)}>
        <div class="version-heading">
          <h3>{item.version}</h3>
          {item.recommended && <span>{lang === "zh-cn" ? "默认" : "Default"}</span>}
        </div>
        <p>{item.description}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .section-intro { color: var(--color-text-secondary); line-height: 1.7; }
  .version-grid { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .version-grid li { padding: 1.2rem; border: 1px solid rgba(148, 163, 184, .24); border-radius: 18px; background: rgba(255,255,255,.78); }
  .version-grid li[data-recommended="true"] { border-color: color-mix(in srgb, var(--color-theme) 45%, transparent); background: color-mix(in srgb, var(--color-theme) 6%, white); }
  .version-heading { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  h3, p { margin: 0; }
  .version-heading span { padding: .2rem .55rem; border-radius: 999px; color: var(--color-theme); background: color-mix(in srgb, var(--color-theme) 12%, white); font-size: .78rem; font-weight: 800; }
  .version-grid p { margin-top: .6rem; color: var(--color-text-secondary); line-height: 1.6; }
  @media (max-width: 800px) { .version-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .version-grid { grid-template-columns: 1fr; } }
</style>
