---
import type { CollectionEntry } from "astro:content";
import type { Lang } from "@/i18n";

interface Props {
  posts: CollectionEntry<"blog">[];
  locale: Lang;
  showAllTags?: boolean;
  activeTag?: string;
}

const { posts, locale, showAllTags = false, activeTag } = Astro.props;

function tagToSlug(tag: string) {
  return tag.includes("/") || tag.includes(" ") ? encodeURIComponent(tag) : tag;
}
---

<div class="post-grid">
  {
    posts.map((post) => {
      const [, ...id] = post.id.split("/");
      const postUrl = `/${locale}/blog/${id.join("/").toLowerCase()}/`;
      const dateStr = post.data.date.toLocaleDateString(
        locale === "zh-cn" ? "zh-CN" : "en-US",
        { year: "numeric", month: "short", day: "numeric" }
      );
      const visibleTags = showAllTags ? post.data.tags : post.data.tags?.slice(0, 3);

      return (
        <article class="post-card">
          <a href={postUrl} class="post-link">
            <div class="post-content">
              <time class="post-date">{dateStr}</time>
              <h2 class="post-title">{post.data.title}</h2>
              {post.data.description && <p class="post-desc">{post.data.description}</p>}
            </div>
          </a>

          {visibleTags && (
            <div class="post-tags">
              {visibleTags.map((tag) => (
                <a href={`/${locale}/tags/${tagToSlug(tag)}/`} class={`tag-link ${activeTag === tag ? "active" : ""}`}>
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </article>
      );
    })
  }
</div>

<style>
  .post-grid {
    display: grid;
    gap: var(--sp-m);
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
  }

  .post-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-base) 95%, var(--color-main));
    border: 1px solid color-mix(in srgb, var(--color-theme) 15%, transparent);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-theme);
    box-shadow: 0 12px 40px -12px rgba(0, 0, 0, 0.1);
  }

  .post-link {
    text-decoration: none;
    color: inherit;
    flex-grow: 1;
  }

  .post-content {
    padding: var(--sp-m);
  }

  .post-date {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-theme);
    opacity: 0.8;
    margin-block-end: 0.5rem;
    display: block;
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--color-main);
    margin-block-end: 0.75rem;
  }

  .post-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    opacity: 0.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-tags {
    padding: 0 var(--sp-m) var(--sp-m);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-theme);
    text-decoration: none;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-theme) 8%, transparent);
    transition: all 0.2s ease;
  }

  .tag-link:hover,
  .tag-link.active {
    background: var(--color-theme);
    color: white;
  }
</style>
