---
interface Props {
  title: string;
  compact?: boolean;
}
const { title, compact = false } = Astro.props;
---

<header class:list={[compact && "compact"]}>
  <h1>{title}</h1>
  <slot />
</header>

<style>
  header {
    position: relative;
    overflow: hidden;
    padding-block: var(--sp-l) calc(var(--sp-l) + var(--sp-s));
    padding-inline: var(--sp-m);
    text-align: center;
    border-radius: var(--radius-md);
    color: var(--color-main);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: none;
  }
  @media (width < 768px) {
    header {
      padding-inline: var(--sp-s);
    }
  }
  h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.15rem, 1.15rem + 2.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0;
    line-height: 1.12;
    text-wrap: balance;
    color: var(--color-main);
  }
  header :global(.headline-intro) {
    padding-inline: var(--sp-s);
  }

  header.compact {
    padding-block: clamp(1.75rem, 3vw, 2.75rem) clamp(1.15rem, 2vw, 1.6rem);
  }

  header.compact h1 {
    font-size: clamp(2rem, 1rem + 1.8vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  @media (min-width: 1600px) {
    header.compact h1 {
      font-size: clamp(2.75rem, 1.5rem + 1vw, 3.5rem);
    }
  }
</style>
