---
interface Props {
  title: string;
  compact?: boolean;
}
const { title, compact = false } = Astro.props;
---

<header class:list={[compact && "compact"]}>
  <h1>{title}</h1>
  <slot />
</header>

<style>
  header {
    position: relative;
    overflow: hidden;
    padding-block: var(--sp-l) calc(var(--sp-l) + var(--sp-s));
    padding-inline: var(--sp-m);
    text-align: center;
    border-radius: var(--radius-md);
    color: var(--color-main);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: none;
  }
  @media (width < 768px) {
    header {
      /* Cancel .l-content padding without 100vw (avoids scrollbar-induced overflow) */
      margin-inline: calc(-1 * var(--sp-m));
      width: auto;
      max-width: none;
      border-radius: 0;
      border-inline: none;
      padding-inline: var(--sp-m);
      box-sizing: border-box;
    }
  }
  h1 {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0;
    margin: 0;
    line-height: 1.25;
    color: var(--color-main);
  }
  header :global(.headline-intro) {
    padding-inline: var(--sp-s);
  }

  header.compact {
    padding-block: var(--sp-m) var(--sp-s);
  }

  header.compact h1 {
    font-size: 1.5rem;
  }
</style>
