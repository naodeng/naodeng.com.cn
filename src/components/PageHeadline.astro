---
interface Props {
  title: string;
  compact?: boolean;
}
const { title, compact = false } = Astro.props;
---

<header class:list={[compact && "compact"]}>
  <h1>{title}</h1>
  <slot />
</header>

<style>
  header {
    position: relative;
    overflow: hidden;
    padding-block: var(--sp-l) calc(var(--sp-l) + var(--sp-s));
    padding-inline: var(--sp-m);
    text-align: center;
    border-radius: 24px;
    color: var(--color-main);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-theme) 10%, white), transparent 42%),
      linear-gradient(315deg, color-mix(in srgb, var(--color-accent) 12%, white), transparent 38%),
      rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(148, 163, 184, 0.24);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(18px);
  }
  @media (width < 768px) {
    header {
      /* Cancel .l-content padding without 100vw (avoids scrollbar-induced overflow) */
      margin-inline: calc(-1 * var(--sp-m));
      width: auto;
      max-width: none;
      border-radius: 0;
      border-inline: none;
      padding-inline: var(--sp-m);
      box-sizing: border-box;
    }
  }
  h1 {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0;
    margin: 0;
    line-height: 1.25;
    background: linear-gradient(90deg, var(--color-main), var(--color-theme) 58%, var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  header :global(.headline-intro) {
    padding-inline: var(--sp-s);
  }

  header.compact {
    padding-block: var(--sp-m) var(--sp-s);
  }

  header.compact h1 {
    font-size: 1.5rem;
  }
</style>
