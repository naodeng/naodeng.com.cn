---
import type { Lang } from "@/i18n";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
interface Props {
  locale: Lang;
  title: string;
  subtitle: string;
  moreLabel: string;
  cards: Array<{ key: string; href: string; title: string; desc: string; icon: string; meta?: string }>;
  productLinks?: Array<{ href: string; title: string; desc: string; logo?: string }>;
}
const { locale, title, subtitle, moreLabel, cards, productLinks = [] } = Astro.props;
const isZh = locale === "zh-cn";

---
<section class="home-band home-band--white home-explore-hub" aria-labelledby="home-explore-title">
  <div class="home-inner">
    <HomeSectionHeading
      id="home-explore-title"
      title={title}
      subtitle={subtitle}
    />
    <ul class="home-grid home-explore-grid" role="list">
      {cards.map((card) => (
        <li>
          <a class="home-card" href={card.href}>
            <span class="home-card__signal" aria-hidden="true">{card.icon}</span>
            <span class="home-card__icon material-icons-sharp" aria-hidden="true">{card.icon}</span>
            <span class="home-card__topline">
              <h3 class="home-card__title">{card.title}</h3>
              {card.meta && <span class="home-card__meta">{card.meta}</span>}
            </span>
            <p class="home-card__desc">{card.desc}</p>
            <span class="home-card__more">{moreLabel}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

{productLinks.length > 0 && (
  <section class="home-band home-band--muted home-product-sites" aria-labelledby="home-product-links-title">
    <div class="home-inner">
      <HomeSectionHeading
        id="home-product-links-title"
        title={isZh ? "产品官网" : "Product sites"}
      />
      <div class="home-product-links__list">
        {productLinks.map((link) => (
          <a class="home-product-link" href={link.href}>
            {link.logo && <img class="home-product-link__logo" src={link.logo} alt="" width="48" height="48" loading="lazy" decoding="async" />}
            <span class="home-product-link__copy">
              <strong>{link.title}</strong>
              <small>{link.desc}</small>
            </span>
            <span class="home-product-link__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .home-grid {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    text-align: start;
  }

  .home-explore-grid {
    width: min(100%, 90rem);
    margin-inline: auto;
  }

  .home-grid > li {
    position: relative;
    width: auto;
    align-self: stretch;
  }

  .home-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0;
    min-height: clamp(14rem, 18vw, 18rem);
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }


  .home-band--white .home-card { background: var(--color-surface); }

  .home-card:hover,
  .home-card:focus-visible {
    border-color: var(--color-theme);
    background: var(--color-theme-soft);
    transform: translateY(-1px);
  }

  .home-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: 14px;
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-size: 22px;
  }

  .home-card__topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .home-card__title {
    margin: 0 0 10px;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--color-main);
  }

  .home-card__meta {
    flex: none;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-xl);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .home-card__desc {
    margin: 0;
    flex: 1;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-card__signal {
    position: absolute;
    inset: 50% 1.1rem auto auto;
    transform: translateY(-50%);
    color: var(--color-text-tertiary);
    font-family: "Material Icons Sharp";
    font-style: normal;
    font-weight: normal;
    line-height: 1;
    font-size: clamp(3.4rem, 5vw, 5.4rem);
    opacity: 0.11;
    pointer-events: none;
  }

  .home-card__more {
    margin-top: 18px;
    font-size: 15px;
    color: var(--color-theme);
    font-weight: 800;
  }

  @media (width < 900px) {
    .home-grid { margin-top: 20px; gap: 0.75rem; }
    .home-grid > li { width: 100%; }
    .home-card { min-height: 14rem; padding: 1.1rem; }
    .home-card__signal { font-size: 3.4rem; opacity: 0.09; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-card:hover,
    .home-card:focus-visible {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .home-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-card {
      padding: 1rem;
    }
  }

  .home-product-links__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    width: min(100%, 90rem);
    margin-inline: auto;
    margin-block-start: 1.75rem;
  }

  .home-product-link {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 24px;
    align-items: start;
    gap: 1rem;
    min-height: 190px;
    padding: 1.3rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    text-align: start;
    transition: border-color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }

  .home-product-link:hover,
  .home-product-link:focus-visible {
    border-color: var(--color-theme);
    background: var(--color-theme-soft);
    transform: translateY(-1px);
  }

  .home-product-link:focus-visible {
    outline: 2px solid var(--color-theme);
    outline-offset: 3px;
  }

  .home-product-link strong,
  .home-product-link small {
    display: block;
  }

  .home-product-link__logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .home-product-link__copy {
    display: grid;
    gap: .55rem;
    min-width: 0;
  }

  .home-product-link strong {
    color: var(--color-main);
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .home-product-link small {
    color: var(--color-text-secondary);
    font-size: .92rem;
    line-height: 1.65;
  }

  .home-product-link__arrow {
    align-self: center;
    color: var(--color-theme);
    font-size: 1.2rem;
    transition: transform var(--transition-fast);
  }

  .home-product-link:hover .home-product-link__arrow,
  .home-product-link:focus-visible .home-product-link__arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .home-product-links__list {
      grid-template-columns: 1fr;
    }
    .home-product-link {
      grid-template-columns: 40px minmax(0, 1fr) 18px;
      gap: .75rem;
      min-height: 0;
      padding: 1rem;
    }
    .home-product-link__logo {
      width: 40px;
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-card,
    .home-product-link,
    .home-product-link__arrow { transition: none; }
    .home-card:hover,
    .home-card:focus-visible,
    .home-product-link:hover,
    .home-product-link:focus-visible,
    .home-product-link:hover .home-product-link__arrow,
    .home-product-link:focus-visible .home-product-link__arrow { transform: none; }
  }
</style>
