---
import type { Lang } from "@/i18n";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
interface Props {
  locale: Lang;
  title: string;
  subtitle: string;
  moreLabel: string;
  cards: Array<{ key: string; href: string; title: string; desc: string; icon: string; meta?: string }>;
  productLinks?: Array<{ href: string; title: string; desc: string }>;
}
const { locale, title, subtitle, moreLabel, cards, productLinks = [] } = Astro.props;
const isZh = locale === "zh-cn";

---
<section class="home-band home-band--white home-explore-hub" aria-labelledby="home-explore-title">
  <div class="home-inner">
    <HomeSectionHeading
      id="home-explore-title"
      watermark={title.includes("资源") ? "资源探索" : "EXPLORE"}
      title={title}
      subtitle={subtitle}
      showWatermark={false}
    />
    <ul class="home-grid home-explore-grid" role="list">
      {cards.map((card) => (
        <li>
          <a class="home-card" href={card.href}>
            <span class="home-card__signal" aria-hidden="true">{card.icon}</span>
            <span class="home-card__icon material-icons-sharp" aria-hidden="true">{card.icon}</span>
            <span class="home-card__topline">
              <h3 class="home-card__title">{card.title}</h3>
              {card.meta && <span class="home-card__meta">{card.meta}</span>}
            </span>
            <p class="home-card__desc">{card.desc}</p>
            <span class="home-card__more">{moreLabel}</span>
          </a>
        </li>
      ))}
    </ul>
    {productLinks.length > 0 && (
      <section class="home-product-links" aria-labelledby="home-product-links-title">
        <div class="home-product-links__heading">
          <h3 id="home-product-links-title">{isZh ? "产品官网" : "Product sites"}</h3>
          <span>{isZh ? "继续了解我们的 QA 工具" : "Explore the products behind the work"}</span>
        </div>
        <div class="home-product-links__list">
          {productLinks.map((link) => (
            <a class="home-product-link" href={link.href}>
              <span>
                <strong>{link.title}</strong>
                <small>{link.desc}</small>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</section>
<style>
  .home-grid {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    text-align: start;
  }

  .home-grid > li {
    position: relative;
    width: auto;
    align-self: stretch;
  }

  .home-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0;
    min-height: 0;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }


  .home-band--white .home-card { background: var(--color-surface); }

  .home-card:hover,
  .home-card:focus-visible {
    border-color: var(--color-theme);
    background: var(--color-theme-soft);
    transform: translateY(-1px);
  }

  .home-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: 14px;
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-size: 22px;
  }

  .home-card__topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .home-card__title {
    margin: 0 0 10px;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--color-main);
  }

  .home-card__meta {
    flex: none;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-xl);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .home-card__desc {
    margin: 0;
    flex: 1;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-card__signal {
    position: absolute;
    inset: 50% 1.1rem auto auto;
    transform: translateY(-50%);
    color: var(--color-text-tertiary);
    font-family: "Material Icons Sharp";
    font-style: normal;
    font-weight: normal;
    line-height: 1;
    font-size: clamp(3.4rem, 5vw, 5.4rem);
    opacity: 0.11;
    pointer-events: none;
  }

  .home-card__more {
    margin-top: 18px;
    font-size: 15px;
    color: var(--color-theme);
    font-weight: 800;
  }

  @media (width < 900px) {
    .home-grid { margin-top: 20px; gap: 0.75rem; }
    .home-grid > li { width: 100%; }
    .home-card { padding: 1.1rem; }
    .home-card__signal { font-size: 3.4rem; opacity: 0.09; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-card:hover,
    .home-card:focus-visible {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .home-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-card {
      padding: 1rem;
    }
  }

  .home-product-links {
    margin-block-start: var(--sp-l);
    padding-block-start: var(--sp-m);
    border-block-start: 1px solid var(--color-border);
  }

  .home-product-links__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-s);
    margin-block-end: var(--sp-s);
  }

  .home-product-links__heading h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .home-product-links__heading span {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .home-product-links__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .home-product-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
  }

  .home-product-link:hover,
  .home-product-link:focus-visible {
    border-color: var(--color-border-strong);
    background: var(--color-theme-soft);
    transform: translateY(-1px);
  }

  .home-product-link strong,
  .home-product-link small {
    display: block;
  }

  .home-product-link strong {
    color: var(--color-main);
  }

  .home-product-link small {
    margin-block-start: 0.25rem;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .home-product-link > span:last-child {
    color: var(--color-theme);
    font-size: 1.1rem;
    font-weight: 800;
  }

  @media (max-width: 640px) {
    .home-product-links__list {
      grid-template-columns: 1fr;
    }
    .home-product-links__heading {
      display: block;
    }
    .home-product-links__heading span {
      display: block;
      margin-block-start: 0.25rem;
    }
  }
</style>
