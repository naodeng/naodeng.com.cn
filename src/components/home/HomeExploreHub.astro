---
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
interface Props {
  title: string;
  subtitle: string;
  moreLabel: string;
  cards: Array<{ key: string; href: string; title: string; desc: string; icon: string; meta?: string }>;
}
const { title, subtitle, moreLabel, cards } = Astro.props;

---
<section class="home-band home-band--white home-explore-hub" aria-labelledby="home-explore-title">
  <div class="home-inner">
    <HomeSectionHeading
      id="home-explore-title"
      watermark={title.includes("资源") ? "资源探索" : "EXPLORE"}
      title={title}
      subtitle={subtitle}
      showWatermark={false}
    />
    <ul class="home-grid home-explore-grid" role="list">
      {cards.map((card) => (
        <li>
          <a class="home-card" href={card.href}>
            <span class="home-card__signal material-icons-sharp" aria-hidden="true">{card.icon}</span>
            <span class="home-card__icon material-icons-sharp" aria-hidden="true">{card.icon}</span>
            <span class="home-card__topline">
              <h3 class="home-card__title">{card.title}</h3>
              {card.meta && <span class="home-card__meta">{card.meta}</span>}
            </span>
            <p class="home-card__desc">{card.desc}</p>
            <span class="home-card__more">{moreLabel}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .home-grid {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: start;
  }

  .home-grid > li {
    position: relative;
    width: min(68%, 720px);
  }

  .home-grid > li:nth-child(even) {
    align-self: flex-end;
  }

  .home-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0;
    min-height: 0;
    height: 100%;
    padding: 22px 4px;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    background: transparent;
    color: inherit;
    text-decoration: none;
    transition:
      transform 220ms ease,
      color 220ms ease;
  }


  .home-band--white .home-card { background: transparent; }

  .home-card:hover,
  .home-card:focus-visible {
    transform: translateX(4px);
  }

  .home-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: 14px;
    border-radius: var(--radius-md);
    background: var(--color-theme-soft);
    color: var(--color-theme);
    font-size: 22px;
  }

  .home-card__topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .home-card__title {
    margin: 0 0 10px;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--color-main);
  }

  .home-card__meta {
    flex: none;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-xl);
    background: var(--color-theme-soft);
    color: var(--color-theme);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .home-card__desc {
    margin: 0;
    flex: 1;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-card__signal {
    position: absolute;
    inset: 50% 1.1rem auto auto;
    transform: translateY(-50%);
    color: var(--color-theme);
    font-size: clamp(3.4rem, 5vw, 5.4rem);
    opacity: 0.11;
    pointer-events: none;
  }

  .home-card__more {
    margin-top: 18px;
    font-size: 15px;
    color: var(--color-theme);
    font-weight: 800;
  }

  @media (width < 900px) {
    .home-grid { margin-top: 20px; gap: 0; }
    .home-grid > li { width: 100%; }
    .home-grid > li:nth-child(even) { align-self: stretch; }
    .home-card { padding: 17px 2px; }
    .home-card__signal { font-size: 3.4rem; opacity: 0.09; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-card:hover,
    .home-card:focus-visible {
      transform: none;
    }
  }
</style>
