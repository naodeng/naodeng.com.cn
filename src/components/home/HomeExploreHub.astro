---
import type { Lang } from "@/i18n";
interface Props {
  locale: Lang;
  title: string;
  subtitle: string;
  moreLabel: string;
  cards: Array<{ key: string; href: string; title: string; desc: string; icon: string; meta?: string }>;
}
const { title, subtitle, moreLabel, cards } = Astro.props;

---
<section class="home-band home-band--white home-explore-hub" aria-labelledby="home-explore-title">
  <div class="home-inner">
    <h2 id="home-explore-title" class="home-band__title">{title}</h2>
    <p class="home-band__subtitle">{subtitle}</p>
    <ul class="home-grid home-explore-grid" role="list">
      {cards.map((card) => (
        <li>
          <a class="home-card" href={card.href}>
            <span class="home-card__icon material-icons-sharp" aria-hidden="true">{card.icon}</span>
            <span class="home-card__topline">
              <h3 class="home-card__title">{card.title}</h3>
              {card.meta && <span class="home-card__meta">{card.meta}</span>}
            </span>
            <p class="home-card__desc">{card.desc}</p>
            <span class="home-card__more">{moreLabel}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .home-grid {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    text-align: start;
  }

  .home-card {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-height: 240px;
    height: 100%;
    padding: 28px;
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-lg);
    background: var(--color-glass-medium);
    box-shadow: var(--shadow-glass-sm);
    backdrop-filter: blur(14px) saturate(118%);
    color: inherit;
    text-decoration: none;
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .home-band--white .home-card { background: var(--color-glass-medium); }

  .home-card:hover,
  .home-card:focus-visible {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-theme) 32%, transparent);
    box-shadow: var(--shadow-md);
  }

  .home-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: 16px;
    border-radius: 50%;
    background: var(--color-theme-soft);
    color: var(--color-theme);
    font-size: 26px;
    box-shadow: var(--shadow-sm);
  }

  .home-card__topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .home-card__title {
    margin: 0 0 10px;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--color-main);
  }

  .home-card__meta {
    flex: none;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-xl);
    background: var(--color-theme-soft);
    color: var(--color-theme);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .home-card__desc {
    margin: 0;
    flex: 1;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-card__more {
    margin-top: 18px;
    font-size: 15px;
    color: var(--color-theme);
    font-weight: 800;
  }

  @media (width < 900px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-card:hover,
    .home-card:focus-visible {
      transform: none;
    }
  }
</style>
