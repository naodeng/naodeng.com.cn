---
import type { Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
interface Props { locale: Lang }
const { locale } = Astro.props;
const items = locale === "zh-cn" ? [
  { key:"skills", title:"QA Skills", desc:"面向完整测试任务的可复用能力包，包含步骤、输入要求与输出结构。", path:"/qaskills/" },
  { key:"prompts", title:"Prompts", desc:"面向单次生成和分析任务的提示词，可快速复制、调整并人工复核。", path:"/prompts/" },
  { key:"knowledge", title:"知识与实践", desc:"通过博客、测试百科和 AI 百科理解方法、概念与真实实践。", path:"/blog/" },
] : [
  { key:"skills", title:"QA Skills", desc:"Reusable capability packages for complete QA tasks, with steps, inputs, and output structures.", path:"/qaskills/" },
  { key:"prompts", title:"Prompts", desc:"Prompts for focused generation and analysis tasks, ready to copy, adapt, and review.", path:"/prompts/" },
  { key:"knowledge", title:"Knowledge and practice", desc:"Learn methods, concepts, and field experience through the blog and wikis.", path:"/blog/" },
];
---
<section class="home-band home-band--white" aria-labelledby="home-capabilities-title"><div class="home-inner">
  <h2 id="home-capabilities-title" class="home-band__title">{locale === "zh-cn" ? "三类核心能力" : "Three core capabilities"}</h2>
  <ul class="capability-grid" role="list">{items.map(item => <li><a data-home-capability={item.key} href={getRelativeLocaleUrl(locale,item.path)}><span>{item.key}</span><h3>{item.title}</h3><p>{item.desc}</p></a></li>)}</ul>
</div></section>
<style>
  .capability-grid{list-style:none;margin:2rem 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem} a{display:block;height:100%;padding:1.4rem;border-radius:24px;border:1px solid rgba(148,163,184,.2);color:inherit;text-decoration:none} a>span{color:var(--color-theme);font-weight:900;text-transform:uppercase;font-size:.78rem} h3{font-size:1.3rem;margin:.55rem 0} p{color:var(--color-text-secondary);line-height:1.65}@media(max-width:700px){.capability-grid{grid-template-columns:1fr}}
</style>
