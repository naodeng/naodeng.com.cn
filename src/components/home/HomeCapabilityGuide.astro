---
import type { Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
interface Props { locale: Lang }
const { locale } = Astro.props;

const CAPABILITY_ICONS: Record<string, string> = {
  skills: "bolt",
  prompts: "chat",
  knowledge: "menu_book",
};

const items = locale === "zh-cn" ? [
  { key:"skills", title:"QA Skills", desc:"面向完整测试任务的可复用能力包，包含步骤、输入要求与输出结构。", path:"/qaskills/", recommendations:[
    ["需求分析", "/qaskills/requirements-analysis/"], ["测试用例评审", "/qaskills/test-case-reviewer/"], ["测试用例编写", "/qaskills/test-case-writing/"], ["代码评审", "/qaskills/code-review/"]
  ] },
  { key:"prompts", title:"Prompts", desc:"面向单次生成和分析任务的提示词，可快速复制、调整并人工复核。", path:"/prompts/", recommendations:[
    ["需求分析", "/prompts/requirements-analysis/"], ["测试用例评审", "/prompts/test-case-reviewer/"], ["测试用例编写", "/prompts/test-case-writing/"], ["代码评审", "/prompts/security-testing/"]
  ] },
  { key:"knowledge", title:"知识与实践", desc:"通过博客、测试百科和 AI 百科理解方法、概念与真实实践。", path:"/blog/", recommendations:[
    ["AI 测试质量工作台", "/blog/ai-testing/dsh-qa-ai-testing-workbench/"], ["自动化测试实践", "/blog/ui-automation-testing/ui-testing-best-practice-generic-best-practices-2-ui-tests-debugging-best-practices-and-reaching-ui-state/"]
  ] },
] : [
  { key:"skills", title:"QA Skills", desc:"Reusable capability packages for complete QA tasks, with steps, inputs, and output structures.", path:"/qaskills/", recommendations:[
    ["Requirements analysis", "/qaskills/requirements-analysis/"], ["Test case review", "/qaskills/test-case-reviewer/"], ["Test case writing", "/qaskills/test-case-writing/"], ["Code review", "/qaskills/code-review/"]
  ] },
  { key:"prompts", title:"Prompts", desc:"Prompts for focused generation and analysis tasks, ready to copy, adapt, and review.", path:"/prompts/", recommendations:[
    ["Requirements analysis", "/prompts/requirements-analysis/"], ["Test case review", "/prompts/test-case-reviewer/"], ["Test case writing", "/prompts/test-case-writing/"], ["Code review", "/prompts/security-testing/"]
  ] },
  { key:"knowledge", title:"Knowledge and practice", desc:"Learn methods, concepts, and field experience through the blog and wikis.", path:"/blog/", recommendations:[
    ["AI testing quality workbench", "/blog/ai-testing/dsh-qa-ai-testing-workbench/"], ["Automation testing practice", "/blog/ui-automation-testing/ui-testing-best-practice-generic-best-practices-2-ui-tests-debugging-best-practices-and-reaching-ui-state/"]
  ] },
];

---
<section class="home-band home-band--white home-capability-guide" aria-labelledby="home-capability-title">
  <div class="home-inner home-capability-inner">
    <HomeSectionHeading
      id="home-capability-title"
      watermark={locale === "zh-cn" ? "核心能力" : "CORE CAPABILITIES"}
      title={locale === "zh-cn" ? "三类核心能力" : "Three core capabilities"}
      subtitle={locale === "zh-cn" ? "如果已经知道需要哪类资源，可以按 QA Skills、Prompts 或知识实践直接浏览。" : "If you already know the resource type, browse directly by QA Skills, Prompts, or practical knowledge."}
    />
    <ul class="capability-list" role="list">
      {items.map((item) => (
        <li>
          <div class="capability-item" data-home-capability={item.key}>
            <a class="capability-item__main" href={getRelativeLocaleUrl(locale, item.path)}>
            <span class="capability-item__top">
              <span class="capability-item__icon material-icons-sharp" aria-hidden="true">{CAPABILITY_ICONS[item.key] ?? "bolt"}</span>
            </span>
            <h3 class="capability-item__title">{item.title}</h3>
            <p class="capability-card__desc">{item.desc}</p>
            </a>
            <div class="capability-recommendations" aria-label={locale === "zh-cn" ? "推荐内容" : "Recommended content"}>
              <span class="capability-recommendations__label">{locale === "zh-cn" ? "推荐阅读" : "Explore next"}</span>
              <ul role="list">
                {item.recommendations.map(([label, path]) => <li><a href={getRelativeLocaleUrl(locale, path)}>{label}</a></li>)}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .home-capability-inner { display: grid; row-gap: 20px; }

  .capability-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    text-align: start;
  }

  .capability-list > li { display: block; }

  .capability-item {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface-elevated);
    color: inherit;
    text-decoration: none;
    transition: transform 220ms cubic-bezier(.22,1,.36,1), border-color 220ms ease;
  }

  .capability-item:hover,
  .capability-item:focus-within {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-theme) 32%, transparent);
  }

  .capability-item__main {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.5rem 1.55rem 1.2rem;
    color: inherit;
    text-decoration: none;
  }

  .capability-item__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: .75rem;
  }

  .capability-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.15rem;
    height: 3.15rem;
    border-radius: var(--radius-md);
    background: var(--color-theme-soft);
    color: var(--color-theme);
    font-size: 1.65rem;
  }

  .capability-item__title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    margin: 1.15rem 0 0;
  }

  .capability-card__desc {
    margin: .65rem 0 0;
    font-size: .95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .capability-recommendations {
    padding: .85rem 1.55rem 1.2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-glass-border) 70%, transparent);
  }

  .capability-recommendations__label {
    display: block;
    margin-bottom: .45rem;
    color: var(--color-text-tertiary);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .01em;
  }

  .capability-recommendations ul {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem .75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capability-recommendations a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: .15rem .2rem;
    color: var(--color-text-secondary);
    font-size: .78rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .capability-recommendations a::before { content: "↗"; margin-right: .2rem; color: var(--color-theme); }
  .capability-recommendations a:hover,
  .capability-recommendations a:focus-visible { color: var(--color-theme); text-decoration: underline; }

  @media (max-width: 700px) {
    .home-capability-inner { row-gap: 14px; }
    .capability-list { grid-template-columns: 1fr; gap: .65rem; }
    .capability-item__main { padding: 1.1rem 1.15rem .85rem; }
    .capability-item__title { margin-top: .8rem; }
    .capability-recommendations { padding: .7rem 1.15rem .85rem; }
  }

  @media (min-width: 701px) and (max-width: 960px) {
    .capability-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .capability-list > li:last-child { grid-column: 1 / -1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .capability-item { transition: none; }
    .capability-item:hover,
    .capability-item:focus-within { transform: none; }
    .capability-recommendations a { transition: none; }
  }
</style>
