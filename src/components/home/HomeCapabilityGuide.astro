---
import type { Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { HOME_EXAMPLES } from "@/data/homeTaskEntries";
interface Props { locale: Lang }
const { locale } = Astro.props;

// 三类能力的语义图标（Material Icons Sharp 连字名）
const CAPABILITY_ICONS: Record<string, string> = {
  skills: "bolt",
  prompts: "chat",
  knowledge: "menu_book",
};

const items = locale === "zh-cn" ? [
  { key:"skills", title:"QA Skills", desc:"面向完整测试任务的可复用能力包，包含步骤、输入要求与输出结构。", path:"/qaskills/" },
  { key:"prompts", title:"Prompts", desc:"面向单次生成和分析任务的提示词，可快速复制、调整并人工复核。", path:"/prompts/" },
  { key:"knowledge", title:"知识与实践", desc:"通过博客、测试百科和 AI 百科理解方法、概念与真实实践。", path:"/blog/" },
] : [
  { key:"skills", title:"QA Skills", desc:"Reusable capability packages for complete QA tasks, with steps, inputs, and output structures.", path:"/qaskills/" },
  { key:"prompts", title:"Prompts", desc:"Prompts for focused generation and analysis tasks, ready to copy, adapt, and review.", path:"/prompts/" },
  { key:"knowledge", title:"Knowledge and practice", desc:"Learn methods, concepts, and field experience through the blog and wikis.", path:"/blog/" },
];

const example = HOME_EXAMPLES[locale][0];
const stepLabels = locale === "zh-cn"
  ? ["输入", "能力", "输出"]
  : ["Input", "Capability", "Output"];
const exampleValues = [example.input, example.capability, example.output];
---
<section class="home-band home-band--white home-capability-guide" aria-labelledby="home-capability-title">
  <div class="home-inner home-capability-inner">
    <h2 id="home-capability-title" class="home-band__title">{locale === "zh-cn" ? "三类核心能力" : "Three core capabilities"}</h2>
    <p class="home-band__subtitle">{locale === "zh-cn" ? "从任务出发选择可复用的 QA 能力；所有产出都需要结合项目上下文和人工评审。" : "Pick a reusable QA capability from the task at hand; every output still needs project context and human review."}</p>
    <ul class="capability-list" role="list">
      {items.map((item, i) => (
        <li>
          <a class="capability-item" data-home-capability={item.key} href={getRelativeLocaleUrl(locale, item.path)}>
            <span class="capability-item__top">
              <span class="capability-item__icon material-icons-sharp" aria-hidden="true">{CAPABILITY_ICONS[item.key] ?? "bolt"}</span>
              <span class="capability-item__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            </span>
            <h3 class="capability-item__title">{item.title}</h3>
            <p class="capability-card__desc">{item.desc}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="home-band__subtitle home-band__subtitle--spaced">{locale === "zh-cn" ? "一个从输入到可评审交付物的示例" : "One example from input to a reviewable deliverable"}</p>
    <ol class="example-flow" role="list" data-home-example={example.key}>
      {exampleValues.map((value, i) => (
        <li class="example-node">
          <span class="example-node__badge" aria-hidden="true">{i + 1}</span>
          <div class="example-node__body">
            <strong>{stepLabels[i]}</strong>
            <p>{value}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .home-capability-inner { display: grid; row-gap: 20px; }
  .home-capability-inner > .home-band__title { margin: 0; }
  .home-capability-inner > .home-band__subtitle { width: min(100%, 42rem); margin: 0 auto; text-align: center; }

  .capability-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .75rem;
    text-align: start;
  }

  .capability-list > li { display: block; }

  .capability-item {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.15rem 1.2rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(255,255,255,.82);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .capability-item:hover,
  .capability-item:focus-visible {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-theme) 32%, transparent);
    box-shadow: var(--shadow-md);
  }

  .capability-item__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: .75rem;
  }

  .capability-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--color-theme-soft);
    color: var(--color-theme);
    font-size: 1.45rem;
  }

  .capability-item__num {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: color-mix(in srgb, var(--color-text-tertiary) 38%, transparent);
    letter-spacing: -0.02em;
  }

  .capability-item__title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 800;
    margin: .9rem 0 0;
  }

  .capability-card__desc {
    margin: .45rem 0 0;
    font-size: .875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* 编号步骤流：输入 → 能力 → 输出 */
  .example-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .75rem;
  }

  .example-node {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: .8rem;
    padding: 1.1rem 1.2rem;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .example-node__badge {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--gradient-theme);
    color: #fff;
    font-family: var(--font-heading);
    font-size: .85rem;
    font-weight: 800;
  }

  .example-node__body strong {
    display: block;
    margin-bottom: .25rem;
    color: var(--color-theme);
    font-size: .75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .example-node__body p {
    margin: 0;
    line-height: 1.5;
    color: var(--color-text-secondary);
    font-size: .9rem;
  }

  @media (max-width: 700px) {
    .capability-list { grid-template-columns: 1fr; }
    .example-flow { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .capability-item { transition: none; }
    .capability-item:hover,
    .capability-item:focus-visible { transform: none; }
  }
</style>
