---
interface Props {
  id: string;
  watermark: string;
  title: string;
  subtitle?: string;
  showWatermark?: boolean;
}

const { id, watermark, title, subtitle, showWatermark = true } = Astro.props;
---

<header class="home-section-heading">
  {showWatermark && <span class="home-section-heading__watermark" aria-hidden="true">{watermark}</span>}
  <h2 id={id} class="home-band__title">{title}</h2>
  {subtitle && <p class="home-band__subtitle">{subtitle}</p>}
</header>

<style>
  .home-section-heading {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    text-align: center;
  }

  .home-section-heading__watermark {
    margin-bottom: .5rem;
    color: var(--color-theme);
    font-family: var(--font-heading);
    font-size: .8125rem;
    font-weight: 700;
    letter-spacing: .04em;
    line-height: 1.3;
  }

  .home-band__title {
    position: relative;
    z-index: 1;
    margin: 0;
    text-wrap: balance;
  }

  .home-band__subtitle {
    position: relative;
    z-index: 1;
    margin: 10px auto 0;
    max-width: 62ch;
    text-wrap: pretty;
  }

</style>
