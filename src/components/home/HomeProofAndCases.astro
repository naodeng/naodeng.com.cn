---
import type { Lang } from "@/i18n";
import { HOME_EXAMPLES } from "@/data/homeTaskEntries";
interface Props { locale: Lang }
const { locale } = Astro.props;
---
<section class="home-band home-band--muted" aria-labelledby="home-proof-title"><div class="home-inner home-proof-inner">
  <h2 id="home-proof-title" class="home-band__title">{locale === "zh-cn" ? "从输入到可评审交付物" : "From input to reviewable deliverable"}</h2>
  <p class="home-band__subtitle">{locale === "zh-cn" ? "这些能力用于加速分析与整理，最终结论仍应结合项目上下文和人工评审。" : "These capabilities accelerate analysis and structuring; final decisions still require project context and human review."}</p>
  <ol class="example-grid">{HOME_EXAMPLES[locale].map(example => <li data-home-example={example.key}><p><strong>{locale === "zh-cn" ? "输入" : "Input"}</strong>{example.input}</p><span>→</span><p><strong>{locale === "zh-cn" ? "能力" : "Capability"}</strong>{example.capability}</p><span>→</span><p><strong>{locale === "zh-cn" ? "输出" : "Output"}</strong>{example.output}</p></li>)}</ol>
</div></section>
<style>
  .home-proof-inner { display: grid; row-gap: 20px; }
  .home-proof-inner > .home-band__title { margin: 0; }
  .home-proof-inner > .home-band__subtitle { width: min(100%, 42rem); margin: 0 auto; text-align: center; }
  .example-grid{list-style:none;margin:2rem 0 0;padding:0;display:grid;gap:1rem} li{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:1rem;padding:1.1rem 1.3rem;background:#fff;border:1px solid rgba(148,163,184,.18);border-radius:20px} p{margin:0;line-height:1.5} strong{display:block;margin-bottom:.25rem;color:var(--color-theme);font-size:.78rem;text-transform:uppercase}@media(max-width:650px){li{grid-template-columns:1fr}li>span{transform:rotate(90deg);justify-self:start}}
</style>
