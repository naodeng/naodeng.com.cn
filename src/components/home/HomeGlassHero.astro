---
import { useTranslations, type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { HOME_CTA_SKILLS, HOME_CTA_TASK, HOME_HERO_SUBTITLE, HOME_HERO_TITLE } from "@/consts";

interface Props { locale: Lang }

const { locale } = Astro.props;
const t = useTranslations(locale);
const topicLinks = locale === "zh-cn" ? [
  { label: "QA 技能", meta: "完整测试任务的可复用能力包", href: getRelativeLocaleUrl(locale, "/qaskills") },
  { label: "提示词", meta: "可复制、可调整的测试输入模板", href: getRelativeLocaleUrl(locale, "/prompts") },
  { label: "AI 百科", meta: "AI 测试与智能体知识库", href: getRelativeLocaleUrl(locale, "/AIWiki") },
] : [
  { label: "QA Skills", meta: "Reusable packages for complete QA tasks", href: getRelativeLocaleUrl(locale, "/qaskills") },
  { label: "Prompts", meta: "Copy-ready inputs for testing work", href: getRelativeLocaleUrl(locale, "/prompts") },
  { label: "AI Wiki", meta: "AI testing and agent knowledge", href: getRelativeLocaleUrl(locale, "/AIWiki") },
];
---

<section
  class:list={["glass-hero", "home-hero", "home-hero--a", locale === "en" && "home-hero--en"]}
  data-locale={locale}
  aria-labelledby="glass-hero-title"
>
  <div class="hero-a__shell">
    <div class="hero-a__copy">
      <p class="hero-eyebrow">{locale === "zh-cn" ? "软件测试 · QA · AI" : "SOFTWARE TESTING · QA · AI"}</p>
      <h1 id="glass-hero-title">{t(HOME_HERO_TITLE)}</h1>
      <p class="glass-hero__summary home-hero__subtitle">{t(HOME_HERO_SUBTITLE)}</p>
      <div class="glass-hero__actions home-hero__ctas">
        <a class="pill-cta pill-cta--primary" href="#home-task-navigator">
          {t(HOME_CTA_TASK)} <span aria-hidden="true">→</span>
        </a>
        <a class="pill-cta pill-cta--ghost" href={getRelativeLocaleUrl(locale, "/qaskills")}>
          {t(HOME_CTA_SKILLS)} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <nav class="hero-topic-map" aria-label={locale === "zh-cn" ? "首页内容入口" : "Homepage content paths"}>
      <p class="hero-topic-map__label">{locale === "zh-cn" ? "从这里进入" : "START HERE"}</p>
      <ol>
        {topicLinks.map((topic, index) => (
          <li>
            <a href={topic.href}>
              <span class="hero-topic-map__number">0{index + 1}</span>
              <span class="hero-topic-map__copy">
                <strong>{topic.label}</strong>
                <small>{topic.meta}</small>
              </span>
              <span class="hero-topic-map__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  .glass-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .home-hero--a {
    background: var(--color-base);
  }

  .home-hero--a::before {
    display: none;
  }

  .hero-a__shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(17rem, .78fr);
    align-items: center;
    gap: clamp(2.25rem, 5vw, 5.5rem);
    width: min(var(--layout-max), calc(100% - (2 * var(--layout-gutter))));
    min-height: clamp(340px, 33vw, 450px);
    margin-inline: auto;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .hero-a__copy {
    max-width: 44rem;
  }

  .hero-eyebrow {
    margin: 0 0 1rem;
    color: var(--color-theme);
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .14em;
  }

  .glass-hero h1 {
    margin: 0;
    color: var(--color-main);
    font-family: var(--font-heading);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -.03em;
    text-wrap: balance;
  }

  .home-hero--a h1 {
    max-width: 12ch;
    font-size: clamp(2.75rem, 5vw, 4.75rem);
  }

  /* The English copy is longer, so keep its visual weight compact. */
  .home-hero--en h1 {
    max-width: 20ch;
    font-size: clamp(2.45rem, 4.15vw, 4.15rem);
    line-height: 1.07;
  }

  .glass-hero__summary {
    max-width: 38rem;
    margin: 1.35rem 0 0;
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.65;
    text-wrap: balance;
  }

  .glass-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    margin-top: 1.75rem;
  }

  .glass-hero .pill-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .6rem;
    min-height: 2.8rem;
    padding: .72rem 1.1rem;
    border-radius: var(--radius-sm);
    font: 800 .82rem/1.2 var(--font-sans);
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .glass-hero .pill-cta--primary {
    border: 1px solid var(--color-theme);
    background: var(--color-theme);
    color: var(--color-theme-on-dark);
  }

  .glass-hero .pill-cta--ghost {
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-theme);
  }

  .glass-hero .pill-cta:hover,
  .glass-hero .pill-cta:focus-visible {
    transform: translateY(-1px);
  }

  .hero-topic-map {
    position: relative;
    align-self: center;
    justify-self: end;
    width: min(100%, 26rem);
    padding: .5rem 0 .5rem 1.75rem;
  }

  .hero-topic-map::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 1px;
    background: var(--color-border-strong);
    transform-origin: top;
    animation: proofline-rail 700ms var(--ease-out);
  }

  @keyframes proofline-rail {
    from { transform: scaleY(.2); }
    to { transform: scaleY(1); }
  }

  .hero-topic-map__label {
    margin: 0 0 .85rem;
    color: var(--color-text-tertiary);
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .hero-topic-map ol {
    display: grid;
    gap: .2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-topic-map a {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr) auto;
    align-items: center;
    gap: .65rem;
    padding: .85rem .4rem .85rem 0;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .hero-topic-map a:hover strong,
  .hero-topic-map a:focus-visible strong {
    color: var(--color-theme);
  }

  .hero-topic-map a:hover,
  .hero-topic-map a:focus-visible {
    background: var(--color-theme-soft);
  }

  .hero-topic-map__number {
    color: var(--color-theme);
    font: 800 .7rem/1 var(--font-sans);
  }

  .hero-topic-map__copy {
    display: grid;
    gap: .18rem;
    min-width: 0;
  }

  .hero-topic-map__copy strong {
    color: var(--color-main);
    font-size: .9rem;
    transition: color var(--transition-fast);
  }

  .hero-topic-map__copy small {
    color: var(--color-text-secondary);
    font-size: .8rem;
    line-height: 1.55;
  }

  .hero-topic-map__arrow {
    color: var(--color-theme);
    font-size: 1rem;
    transition: transform var(--transition-fast);
  }

  .hero-topic-map a:hover .hero-topic-map__arrow,
  .hero-topic-map a:focus-visible .hero-topic-map__arrow {
    transform: translate(2px, -2px);
  }

  .glass-hero .pill-cta:active {
    transform: translateY(1px);
  }

  @media (max-width: 900px) {
    .hero-a__shell {
      grid-template-columns: minmax(0, 1.1fr) minmax(14rem, .9fr);
      gap: 2rem;
    }

    .home-hero--a h1 {
      font-size: clamp(2.7rem, 7vw, 4.4rem);
    }

    .home-hero--en h1 {
      max-width: 18ch;
      font-size: clamp(2.4rem, 5.4vw, 3.8rem);
    }
  }

  @media (max-width: 680px) {
    .hero-a__shell {
      display: block;
      width: min(100% - (2 * var(--layout-gutter)), var(--layout-max));
      min-height: 0;
      padding-block: 2.75rem 2.5rem;
    }

    .home-hero--a h1,
    .home-hero--en h1 {
      max-width: 14ch;
      font-size: clamp(2.5rem, 11vw, 3.6rem);
      line-height: 1.12;
    }

    .home-hero--en h1 {
      max-width: 16ch;
      font-size: clamp(2.2rem, 9.5vw, 3.2rem);
    }

    .hero-topic-map {
      width: 100%;
      max-width: none;
      margin-top: 2rem;
      padding: 1.2rem 0 0;
      border-inline-start: 0;
      border-top: 1px solid color-mix(in srgb, var(--color-theme) 38%, var(--color-border));
    }

    .hero-topic-map::before { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-topic-map::before { animation: none; }
    .hero-topic-map a:hover .hero-topic-map__arrow,
    .hero-topic-map a:focus-visible .hero-topic-map__arrow { transform: none; }
    .glass-hero .pill-cta {
      transition: none;
    }

    .glass-hero .pill-cta:hover,
    .glass-hero .pill-cta:focus-visible {
      transform: none;
    }
  }

  /* Proofline hero: rely on a rule and signal rail, not a decorative gradient. */
  .glass-hero {
    background: var(--color-base);
  }
  .glass-hero .pill-cta--primary {
    color: var(--color-theme-on-dark);
    box-shadow: var(--shadow-sm);
  }
</style>
