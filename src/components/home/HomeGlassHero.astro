---
import { useTranslations, type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { HOME_CTA_SKILLS, HOME_CTA_TASK, HOME_HERO_SUBTITLE, HOME_HERO_TITLE } from "@/consts";

interface Props { locale: Lang }

const { locale } = Astro.props;
const t = useTranslations(locale);
const topicLinks = locale === "zh-cn" ? [
  { label: "QA 技能", meta: "完整测试任务的可复用能力包", icon: "checklist", href: getRelativeLocaleUrl(locale, "/qaskills") },
  { label: "提示词", meta: "可复制、可调整的测试输入模板", icon: "prompt", href: getRelativeLocaleUrl(locale, "/prompts") },
  { label: "AI 百科", meta: "AI 测试与智能体知识库", icon: "knowledge", href: getRelativeLocaleUrl(locale, "/AIWiki") },
] : [
  { label: "QA Skills", meta: "Reusable packages for complete QA tasks", icon: "checklist", href: getRelativeLocaleUrl(locale, "/qaskills") },
  { label: "Prompts", meta: "Copy-ready inputs for testing work", icon: "prompt", href: getRelativeLocaleUrl(locale, "/prompts") },
  { label: "AI Wiki", meta: "AI testing and agent knowledge", icon: "knowledge", href: getRelativeLocaleUrl(locale, "/AIWiki") },
];
---

<section
  class:list={["glass-hero", "home-hero", "home-hero--a", locale === "en" && "home-hero--en"]}
  data-locale={locale}
  aria-labelledby="glass-hero-title"
>
  <div class="hero-a__shell">
    <div class="hero-a__copy">
      <h1 id="glass-hero-title">{t(HOME_HERO_TITLE)}</h1>
      <p class="glass-hero__summary home-hero__subtitle">{t(HOME_HERO_SUBTITLE)}</p>
      <div class="glass-hero__actions home-hero__ctas">
        <a class="pill-cta pill-cta--primary" href="#home-task-navigator">
          {t(HOME_CTA_TASK)} <span aria-hidden="true">→</span>
        </a>
        <a class="pill-cta pill-cta--ghost" href={getRelativeLocaleUrl(locale, "/qaskills")}>
          {t(HOME_CTA_SKILLS)} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <nav class="hero-topic-map" aria-label={locale === "zh-cn" ? "首页内容入口" : "Homepage content paths"}>
      <ol>
        {topicLinks.map((topic) => (
          <li>
            <a href={topic.href}>
              <span class="hero-topic-map__mark" aria-hidden="true">
                {topic.icon === "checklist" ? (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <rect x="5" y="4" width="14" height="17" rx="2.2" />
                    <path d="M9 4V3.5A1.5 1.5 0 0 1 10.5 2h3A1.5 1.5 0 0 1 15 3.5V5H9z" />
                    <path d="m8 10 1.2 1.2 2.2-2.4m2.2 1.3h2.5m-8.1 4.1 1.2 1.2 2.2-2.4m2.2 1.3h2.5" />
                  </svg>
                ) : topic.icon === "prompt" ? (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M5 5.5A2.5 2.5 0 0 1 7.5 3h9A2.5 2.5 0 0 1 19 5.5v7a2.5 2.5 0 0 1-2.5 2.5H11l-4 4v-4A2.5 2.5 0 0 1 5 12.5z" />
                    <path d="m8 7.5 2 1.7-2 1.7m4 0h3.5" />
                    <path d="m17.5 2 .7 1.5 1.5.7-1.5.7-.7 1.5-.7-1.5-1.5-.7 1.5-.7z" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M12 6.2C9.7 4.6 6.6 4.2 3.5 5v14c3.1-.8 6.2-.4 8.5 1.3 2.3-1.7 5.4-2.1 8.5-1.3V5c-3.1-.8-6.2-.4-8.5 1.2zM12 6.2v14" />
                    <path d="M6 9c1.4-.2 2.8 0 4 .7m5-3h2.5v2.5h2m-4.5 0v3" />
                    <circle cx="16.5" cy="9.7" r=".7" />
                    <circle cx="19.5" cy="12.2" r=".7" />
                    <circle cx="17.5" cy="16.2" r=".7" />
                  </svg>
                )}
              </span>
              <span class="hero-topic-map__copy">
                <strong>{topic.label}</strong>
                <small>{topic.meta}</small>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  .glass-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .home-hero--a {
    background: var(--color-base);
  }

  .home-hero--a::before {
    display: none;
  }

  .hero-a__shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(17rem, .78fr);
    align-items: center;
    gap: clamp(2.25rem, 5vw, 5.5rem);
    width: min(var(--layout-max), calc(100% - (2 * var(--layout-gutter))));
    min-height: clamp(340px, 33vw, 450px);
    margin-inline: auto;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .hero-a__copy {
    max-width: 44rem;
  }

  .glass-hero h1 {
    margin: 0;
    color: var(--color-main);
    font-family: var(--font-heading);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -.03em;
    text-wrap: balance;
  }

  .home-hero--a h1 {
    max-width: 12ch;
    font-size: clamp(2.75rem, 5vw, 4.75rem);
  }

  /* The English copy is longer, so keep its visual weight compact. */
  .home-hero--en h1 {
    max-width: 13.5em;
    font-size: clamp(2.35rem, 3.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .glass-hero__summary {
    max-width: 38rem;
    margin: 1.35rem 0 0;
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.65;
    text-wrap: balance;
  }

  .glass-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    margin-top: 1.75rem;
  }

  .glass-hero .pill-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .6rem;
    min-height: 2.8rem;
    padding: .72rem 1.1rem;
    border-radius: var(--radius-sm);
    font: 800 .82rem/1.2 var(--font-sans);
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .glass-hero .pill-cta--primary {
    border: 1px solid var(--color-theme);
    background: var(--color-theme);
    color: var(--color-theme-on-dark);
  }

  .glass-hero .pill-cta--ghost {
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-theme);
  }

  .glass-hero .pill-cta:hover,
  .glass-hero .pill-cta:focus-visible {
    transform: translateY(-1px);
  }

  .hero-topic-map {
    align-self: center;
    justify-self: end;
    display: grid;
    gap: .7rem;
    width: min(100%, 27rem);
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-muted);
  }

  @media (min-width: 1920px) {
    .hero-a__shell { grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); }
    .hero-topic-map { justify-self: start; width: min(100%, 32rem); }
  }

  .hero-topic-map ol {
    display: grid;
    gap: .7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-topic-map a {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: center;
    gap: .2rem 1rem;
    min-height: 78px;
    padding: .8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    animation: home-hero-enter 460ms cubic-bezier(.2, .7, .2, 1) both;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .hero-a__copy {
    animation: home-hero-enter 500ms cubic-bezier(.2, .7, .2, 1) both;
  }

  .hero-topic-map li:nth-child(1) a { animation-delay: 80ms; }
  .hero-topic-map li:nth-child(2) a { animation-delay: 150ms; }
  .hero-topic-map li:nth-child(3) a { animation-delay: 220ms; }

  @keyframes home-hero-enter {
    from { opacity: .72; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-topic-map a:hover,
  .hero-topic-map a:focus-visible {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
    transform: translateY(-2px);
  }

  .hero-topic-map__mark {
    display: grid;
    grid-row: 1 / span 2;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--color-theme-soft);
    color: var(--color-theme);
    transition: transform var(--transition-fast);
  }

  .hero-topic-map__mark svg {
    width: 27px;
    height: 27px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-topic-map a:hover .hero-topic-map__mark,
  .hero-topic-map a:focus-visible .hero-topic-map__mark {
    transform: rotate(-4deg) scale(1.04);
  }

  .hero-topic-map__copy {
    display: grid;
    gap: .1rem;
    min-width: 0;
  }

  .hero-topic-map__copy strong {
    color: var(--color-main);
    font-size: 1rem;
  }

  .hero-topic-map__copy small {
    color: var(--color-text-secondary);
    font-size: .875rem;
    line-height: 1.55;
  }

  .glass-hero .pill-cta:active {
    transform: translateY(1px);
  }

  @media (max-width: 900px) {
    .hero-a__shell {
      grid-template-columns: minmax(0, 1.1fr) minmax(14rem, .9fr);
      gap: 2rem;
    }

    .home-hero--a h1 {
      font-size: clamp(2.7rem, 7vw, 4.4rem);
    }

    .home-hero--en h1 {
      max-width: 13em;
      font-size: clamp(2.15rem, 4.6vw, 3.2rem);
    }
  }

  @media (max-width: 680px) {
    .hero-a__shell {
      display: block;
      width: min(100% - (2 * var(--layout-gutter)), var(--layout-max));
      min-height: 0;
      padding-block: 2rem 1.75rem;
    }

    .home-hero--a h1,
    .home-hero--en h1 {
      max-width: 14ch;
      font-size: clamp(2.5rem, 11vw, 3.6rem);
      line-height: 1.12;
    }

    .home-hero--en h1 {
      max-width: none;
      font-size: clamp(1.9rem, 8.2vw, 2.45rem);
      line-height: 1.08;
      text-wrap: wrap;
    }

    .glass-hero__summary { margin-top: 1rem; }
    .glass-hero__actions { gap: .5rem; margin-top: 1.25rem; }
    .glass-hero .pill-cta { padding-inline: .75rem; }

    .hero-topic-map {
      width: 100%;
      max-width: none;
      margin-top: 1.5rem;
      padding: .85rem;
    }

    .hero-topic-map ol { gap: .5rem; }
    .hero-topic-map a { min-height: 68px; padding: .6rem; }
    .hero-topic-map__copy {
      grid-template-columns: max-content minmax(0, 1fr);
      align-items: baseline;
      column-gap: .65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-a__copy,
    .hero-topic-map a { animation: none; }
    .hero-topic-map a,
    .hero-topic-map__mark { transition: none; }
    .hero-topic-map a:hover,
    .hero-topic-map a:focus-visible,
    .hero-topic-map a:hover .hero-topic-map__mark,
    .hero-topic-map a:focus-visible .hero-topic-map__mark { transform: none; }
    .glass-hero .pill-cta {
      transition: none;
    }

    .glass-hero .pill-cta:hover,
    .glass-hero .pill-cta:focus-visible {
      transform: none;
    }
  }

  /* Proofline hero: rely on a rule and signal rail, not a decorative gradient. */
  .glass-hero {
    background: var(--color-base);
  }
  .glass-hero .pill-cta--primary {
    color: var(--color-theme-on-dark);
    box-shadow: var(--shadow-sm);
  }
</style>
