---
import { useTranslations, type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { HOME_CTA_SKILLS, HOME_CTA_TASK, HOME_HERO_SUBTITLE, HOME_HERO_TITLE } from "@/consts";

interface Props { locale: Lang }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="glass-hero home-hero" aria-labelledby="glass-hero-title">
  <div class="glass-hero__panel">
    <span class="glass-hero__accent" aria-hidden="true"></span>
    <h1 id="glass-hero-title">{t(HOME_HERO_TITLE)}</h1>
    <p class="glass-hero__summary home-hero__subtitle">{t(HOME_HERO_SUBTITLE)}</p>
    <div class="glass-hero__actions home-hero__ctas">
      <a class="pill-cta pill-cta--primary" href="#home-task-navigator">{t(HOME_CTA_TASK)} <span aria-hidden="true">→</span></a>
      <a class="pill-cta pill-cta--ghost" href={getRelativeLocaleUrl(locale, "/qaskills")}>{t(HOME_CTA_SKILLS)} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .glass-hero { position:relative; min-height:clamp(420px,50vw,560px); display:grid; place-items:center; padding:clamp(4rem,8vw,7rem) 1.5rem; isolation:isolate; background:var(--color-surface); border-bottom:1px solid var(--color-border); }
  .glass-hero::before { content:none; }
  .glass-hero__panel { position:relative; width:min(var(--layout-max),calc(100% - (2 * var(--layout-gutter)))); padding:clamp(2.2rem,5vw,4.4rem) 0; overflow:hidden; border:0; border-radius:0; background:transparent; box-shadow:none; }
  .glass-hero__panel::after { content:none; }
  .glass-hero__accent { display:block; width:3.25rem; height:.2rem; margin-bottom:1.6rem; border-radius:0; background:var(--color-theme); }
  .glass-hero h1 { max-width:820px; margin:0; color:var(--color-main); font-family:var(--font-heading); font-size:clamp(3rem,6.2vw,5.8rem); font-weight:800; line-height:1.04; letter-spacing:-.035em; text-wrap:balance; }
  .glass-hero__summary { max-width:43rem; margin:1.5rem 0 0; color:var(--color-text-secondary); font-size:clamp(1rem,1.7vw,1.2rem); }
  .glass-hero__actions { display:flex; flex-wrap:wrap; gap:.75rem; margin-top:2rem; }
  .glass-hero .pill-cta { display:inline-flex; align-items:center; justify-content:center; gap:.65rem; min-height:46px; padding:.8rem 1.3rem; border-radius:var(--radius-md); font:700 .875rem/1.2 var(--font-sans); text-decoration:none; }
  .glass-hero .pill-cta--primary { color:#fff; border:1px solid var(--color-theme); background:var(--color-theme); box-shadow:none; }
  .glass-hero .pill-cta--ghost { color:var(--color-theme); border:1px solid var(--color-border); background:transparent; }
  .glass-hero .pill-cta:hover,.glass-hero .pill-cta:focus-visible { transform:translateY(-2px); }
  @media(max-width:720px){.glass-hero{min-height:540px;padding:3.5rem var(--layout-gutter)}.glass-hero__panel{width:100%;padding:1.6rem 0}.glass-hero h1{font-size:clamp(2.65rem,12vw,4rem)}.glass-hero__actions{display:grid}}
  @media(prefers-reduced-motion:reduce){.glass-hero .pill-cta{transition:none}}
</style>
