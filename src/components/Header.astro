---
import LocaleSelect from "@/components/i18n/LocaleSelect.astro";
import { useTranslations, type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  SITE_TITLE,
  SITE_SLOGAN,
  NAV_HOME,
  NAV_ABOUT,
  NAV_PROJECTS,
  NAV_QA_WIKI,
  NAV_AI_WIKI,
  NAV_ENCYCLOPEDIA,
  NAV_GUILD,
  NAV_GUIDES,
  NAV_AI_TESTING,
  NAV_MORE,
  NAV_SPONSOR,
  NAV_SEARCH,
} from "@/consts";

const t = useTranslations(Astro.currentLocale as Lang);
const locale = Astro.currentLocale as Lang;

const pathWithoutLang = Astro.url.pathname.replace(/^\/[a-zA-Z-]+/, "") || "/";

const isExactPath = (path: string) => {
  const localizedPath = getRelativeLocaleUrl(locale, path);
  return Astro.url.pathname === localizedPath || Astro.url.pathname === `${localizedPath}/`;
};

const isSectionPath = (path: string) => pathWithoutLang === path || pathWithoutLang.startsWith(`${path}/`);
const isWikiSection = () => isSectionPath("/wiki");
const isAiWikiSection = () => isSectionPath("/AIWiki");
const isGuildSection = () => isSectionPath("/guild");
const isPromptsSection = () => isSectionPath("/prompts");
const isQASkillsSection = () => isSectionPath("/qaskills");
const isProjectsSection = () => isSectionPath("/projects");
const isSponsorSection = () => isSectionPath("/sponsor");
const siteTitle = t(SITE_TITLE);

const navGroups = [
  {
    key: "encyclopedia",
    label: t(NAV_ENCYCLOPEDIA),
    active: isWikiSection() || isAiWikiSection(),
    items: [
      {
        key: "qa-wiki",
        href: locale === "zh-cn" ? getRelativeLocaleUrl(locale, "/wiki") : "https://ray.run/wiki",
        label: t(NAV_QA_WIKI),
        icon: "menu_book",
        active: isWikiSection(),
        external: locale !== "zh-cn",
      },
      {
        key: "ai-wiki",
        href: getRelativeLocaleUrl(locale, "/AIWiki"),
        label: t(NAV_AI_WIKI),
        icon: "psychology",
        active: isAiWikiSection(),
      },
    ],
  },
  {
    key: "guides",
    label: t(NAV_GUIDES),
    active: isGuildSection(),
    items: [
      {
        key: "guild",
        href: getRelativeLocaleUrl(locale, "/guild"),
        label: t(NAV_GUILD),
        icon: "route",
        active: isGuildSection(),
      },
    ],
  },
  {
    key: "ai-testing",
    label: t(NAV_AI_TESTING),
    active: isPromptsSection() || isQASkillsSection(),
    items: [
      {
        key: "qa-prompts",
        href: getRelativeLocaleUrl(locale, "/prompts"),
        label: locale === "zh-cn" ? "软件测试提示词库" : "QA Prompt Library",
        icon: "tips_and_updates",
        active: isPromptsSection(),
      },
      {
        key: "qa-skills",
        href: getRelativeLocaleUrl(locale, "/qaskills"),
        label: locale === "zh-cn" ? "软件测试技能库" : "QA Skill Library",
        icon: "build",
        active: isQASkillsSection(),
      },
    ],
  },
  {
    key: "more",
    label: t(NAV_MORE),
    active: isProjectsSection() || isSponsorSection(),
    items: [
      {
        key: "projects",
        href: getRelativeLocaleUrl(locale, "/projects"),
        label: t(NAV_PROJECTS),
        icon: "folder",
        active: isProjectsSection(),
      },
      {
        key: "sponsor",
        href: getRelativeLocaleUrl(locale, "/sponsor"),
        label: t(NAV_SPONSOR),
        icon: "favorite",
        active: isSponsorSection(),
      },
    ],
  },
];
---

<header class="l-header" data-header>
  <div class:list={["header-shell l-content", { "header-shell--en": locale === "en" }]}>
    <div class:list={["site-brand", { "site-brand--en": locale === "en" }]}>
      <div class="site-brand-row">
        <h1>
          <a href={getRelativeLocaleUrl(locale, "/")} class="site-brand-link">
            <span class="brand-mark" aria-hidden="true"></span>
            <img src="/favicon.svg" alt="" class="site-logo" width="18" height="18" />
            {locale === "zh-cn" ? (
              <span class="site-title-cobrand" aria-label={siteTitle}>
                <span>软件测试同学</span>
                <span class="site-title-cobrand-x" aria-hidden="true">X</span>
                <span>naodeng</span>
              </span>
            ) : (
              <span>{siteTitle}</span>
            )}
          </a>
        </h1>
        <p class="site-slogan">{t(SITE_SLOGAN)}</p>
      </div>
    </div>

    <nav class="site-nav" id="site-primary-nav" data-site-nav>
      <ul>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "/")}
            class={isExactPath("/") ? "active" : null}
            data-nav-item="home"
          >
            {t(NAV_HOME)}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "/blog")}
            class={isSectionPath("/blog") ? "active" : null}
            data-nav-item="blog"
          >
            {t({ en: "Blog", "zh-cn": "博客" })}
          </a>
        </li>
        {
          navGroups.map((group) =>
            group.items.length === 1 ? (
              <li class="nav-group nav-group--link" data-nav-group={group.key}>
                <a
                  href={group.items[0].href}
                  class={group.active ? "active" : null}
                  data-nav-item={group.items[0].key}
                  target={group.items[0].external ? "_blank" : undefined}
                  rel={group.items[0].external ? "noopener noreferrer" : undefined}
                >
                  {group.label}
                </a>
              </li>
            ) : (
              <li class="nav-group" data-nav-group={group.key}>
                <details data-nav-details>
                  <summary class:list={["nav-group-trigger", { active: group.active }]}>
                    <span>{group.label}</span>
                    <span class="material-icons-sharp nav-group-chevron" aria-hidden="true">expand_more</span>
                  </summary>
                  <ul class="nav-submenu">
                    {group.items.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          class={item.active ? "active" : null}
                          data-nav-item={item.key}
                          target={item.external ? "_blank" : undefined}
                          rel={item.external ? "noopener noreferrer" : undefined}
                        >
                          <span class="nav-submenu-icon material-icons-sharp" aria-hidden="true">{item.icon}</span>
                          <span class="nav-submenu-text">{item.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ),
          )
        }
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "/about")}
            class={isExactPath("/about") ? "active" : null}
            data-nav-item="about"
          >
            {t(NAV_ABOUT)}
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-utils">
      <div class="nav-tool nav-tool--bar">
        <LocaleSelect compact />
      </div>
      <button type="button" class="btn-icon" aria-label={t(NAV_SEARCH)} data-search-open>
        <span class="material-icons-sharp" aria-hidden="true">search</span>
      </button>
      <button
        type="button"
        class="btn-icon nav-toggle"
        data-nav-toggle
        aria-controls="site-primary-nav"
        aria-expanded="false"
        aria-label={locale === "zh-cn" ? "打开导航菜单" : "Open navigation menu"}
      >
        <span class="material-icons-sharp nav-toggle__open" aria-hidden="true">menu</span>
        <span class="material-icons-sharp nav-toggle__close" aria-hidden="true">close</span>
      </button>
    </div>
  </div>
  <button
    type="button"
    class="nav-backdrop"
    data-nav-backdrop
    tabindex="-1"
    aria-hidden="true"
    aria-label={locale === "zh-cn" ? "关闭导航菜单" : "Close navigation menu"}
  ></button>
</header>

<script>
  const HOVER_CLOSE_MS = 120;
  const DESKTOP_MQ = "(min-width: 834px)";
  const HOVER_MQ = "(hover: hover) and (pointer: fine)";

  const isDesktopNav = () => window.matchMedia(DESKTOP_MQ).matches;
  const canHoverNav = () => window.matchMedia(HOVER_MQ).matches;

  const closeAllDetails = (except?: HTMLDetailsElement | null) => {
    document.querySelectorAll("[data-nav-details]").forEach((node) => {
      if (!(node instanceof HTMLDetailsElement)) return;
      if (except && node === except) return;
      node.open = false;
    });
  };

  const syncToggleA11y = (toggle: HTMLButtonElement, open: boolean) => {
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    const openLabel = toggle.getAttribute("data-label-open") || "Open navigation menu";
    const closeLabel = toggle.getAttribute("data-label-close") || "Close navigation menu";
    toggle.setAttribute("aria-label", open ? closeLabel : openLabel);
  };

  const setNavOpen = (open: boolean) => {
    const header = document.querySelector("[data-header]");
    const toggle = document.querySelector("[data-nav-toggle]");
    if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;

    header.toggleAttribute("data-nav-open", open);
    syncToggleA11y(toggle, open);
    document.documentElement.classList.toggle("nav-drawer-open", open);

    if (!open) {
      closeAllDetails();
      return;
    }

    if (!isDesktopNav()) {
      const firstLink = header.querySelector<HTMLElement>("[data-site-nav] a");
      firstLink?.focus({ preventScroll: true });
    }
  };

  const bindHoverMenus = (detail: HTMLDetailsElement) => {
    if (detail.dataset.hoverBound) return;
    detail.dataset.hoverBound = "1";

    let openTimer = 0;
    let closeTimer = 0;
    const clearTimers = () => {
      if (openTimer) {
        window.clearTimeout(openTimer);
        openTimer = 0;
      }
      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = 0;
      }
    };

    detail.addEventListener("pointerenter", () => {
      if (!isDesktopNav() || !canHoverNav()) return;
      clearTimers();
      // 短延迟，避免与点击打开打架（pointerenter 后立刻 click 会先 toggle）
      openTimer = window.setTimeout(() => {
        closeAllDetails(detail);
        detail.open = true;
      }, 80);
    });

    detail.addEventListener("pointerleave", () => {
      if (!isDesktopNav() || !canHoverNav()) return;
      clearTimers();
      closeTimer = window.setTimeout(() => {
        detail.open = false;
      }, HOVER_CLOSE_MS);
    });
  };

  const initHeaderNav = () => {
    const header = document.querySelector("[data-header]");
    const toggle = document.querySelector("[data-nav-toggle]");
    const backdrop = document.querySelector("[data-nav-backdrop]");
    const nav = document.querySelector("[data-site-nav]");
    const detailNodes = Array.from(document.querySelectorAll("[data-nav-details]"));

    if (toggle instanceof HTMLButtonElement && !toggle.dataset.bound) {
      toggle.dataset.bound = "1";
      const isZh = document.documentElement.lang?.toLowerCase().startsWith("zh");
      toggle.setAttribute("data-label-open", isZh ? "打开导航菜单" : "Open navigation menu");
      toggle.setAttribute("data-label-close", isZh ? "关闭导航菜单" : "Close navigation menu");
      toggle.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = !(header instanceof HTMLElement && header.hasAttribute("data-nav-open"));
        setNavOpen(open);
      });
    }

    if (backdrop instanceof HTMLElement && !backdrop.dataset.bound) {
      backdrop.dataset.bound = "1";
      backdrop.addEventListener("click", () => setNavOpen(false));
    }

    detailNodes.forEach((detail) => {
      if (!(detail instanceof HTMLDetailsElement)) return;
      bindHoverMenus(detail);

      if (detail.dataset.toggleBound) return;
      detail.dataset.toggleBound = "1";
      detail.addEventListener("toggle", () => {
        if (!detail.open) return;
        closeAllDetails(detail);
      });
    });

    nav?.querySelectorAll("a").forEach((link) => {
      if (link.dataset.navCloseBound) return;
      link.dataset.navCloseBound = "1";
      link.addEventListener("click", () => {
        if (!isDesktopNav()) setNavOpen(false);
      });
    });

    if (!document.documentElement.dataset.appleHeaderDocBound) {
      document.documentElement.dataset.appleHeaderDocBound = "1";

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;

        const currentHeader = document.querySelector("[data-header]");
        const inHeader = currentHeader instanceof HTMLElement && currentHeader.contains(target);

        // 桌面：点空白关闭下拉
        if (isDesktopNav()) {
          const details = Array.from(document.querySelectorAll("[data-nav-details]"));
          if (!details.some((detail) => detail.contains(target))) {
            closeAllDetails();
          }
          return;
        }

        // 移动：点顶栏外关闭抽屉
        if (
          currentHeader instanceof HTMLElement &&
          currentHeader.hasAttribute("data-nav-open") &&
          !inHeader
        ) {
          setNavOpen(false);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        closeAllDetails();
        setNavOpen(false);
        const currentToggle = document.querySelector("[data-nav-toggle]");
        if (currentToggle instanceof HTMLButtonElement && !isDesktopNav()) {
          currentToggle.focus();
        }
      });

      window.matchMedia(DESKTOP_MQ).addEventListener("change", (event) => {
        if (event.matches) setNavOpen(false);
        else closeAllDetails();
      });
    }
  };

  initHeaderNav();
  document.addEventListener("astro:after-swap", initHeaderNav);
</script>

<style>
  .l-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 44px;
    background: #000;
    color: #fff;
    border: none;
    box-shadow: none;
  }
  .l-header::after {
    display: none;
  }
  .header-shell {
    max-inline-size: 1400px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: 20px;
    margin-inline: auto;
  }
  .header-shell--en {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
  }
  .site-brand {
    display: flex;
    justify-content: flex-start;
    min-width: 0;
    flex-shrink: 0;
  }
  .site-brand-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    max-width: none;
  }
  .site-slogan {
    display: none;
  }
  h1 {
    margin: 0;
    font-size: 14px;
    font-family: var(--english-font);
    font-weight: 600;
    letter-spacing: -0.12px;
    line-height: 1;
  }
  .site-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.18s ease;
  }
  .site-brand-link:hover {
    opacity: 0.8;
    color: #fff;
  }
  .brand-mark {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-mark);
    margin-inline-end: 8px;
    vertical-align: middle;
    flex-shrink: 0;
  }
  .site-title-cobrand {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    white-space: nowrap;
    line-height: 1;
  }
  .site-title-cobrand-x {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1em;
    height: 1em;
    padding-inline: 0.12em;
    margin-inline: 0.04em 0.08em;
    font-size: 0.55em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, white 70%, transparent);
    background: color-mix(in srgb, white 10%, transparent);
    border: 1px solid color-mix(in srgb, white 14%, transparent);
    border-radius: 999px;
  }
  .site-brand-link .site-logo {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-inline-end: 0.4em;
    object-fit: contain;
  }
  .site-nav {
    display: flex;
    justify-content: flex-end;
    min-width: 0;
    flex: 1 1 auto;
  }
  .site-nav > ul {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    width: max-content;
    max-width: none;
  }
  .site-nav > ul > li {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .site-nav > ul > li > a,
  .nav-group-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    min-height: 44px;
    padding: 0 0.7rem;
    border-radius: 0;
    white-space: nowrap;
    text-decoration: none;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: -0.12px;
    color: #fff;
    opacity: 0.8;
    background: transparent;
    box-shadow: none;
    transition: opacity 0.18s ease, background-color 0.18s ease;
    position: relative;
  }
  .site-nav > ul > li > a:hover,
  .site-nav > ul > li > a:active,
  .site-nav > ul > li > a:focus-visible,
  .nav-group-trigger:hover,
  .nav-group-trigger:focus-visible {
    color: #fff;
    opacity: 1;
    background: transparent;
  }
  .site-nav > ul > li > a:focus-visible,
  .nav-group-trigger:focus-visible {
    outline: 2px solid color-mix(in srgb, white 70%, transparent);
    outline-offset: -2px;
  }
  .site-nav > ul > li > a.active,
  .nav-group-trigger.active {
    color: #fff;
    opacity: 1;
    background: transparent;
    box-shadow: none;
  }
  .site-nav > ul > li > a.active::after,
  .nav-group-trigger.active::after {
    content: "";
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 7px;
    height: 1px;
    background: color-mix(in srgb, white 72%, transparent);
  }
  .nav-group {
    position: relative;
  }
  .nav-group details {
    position: relative;
  }
  .nav-group summary {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    list-style: none;
    cursor: pointer;
  }
  .nav-group summary::-webkit-details-marker {
    display: none;
  }
  .nav-group-chevron {
    font-size: 14px;
    opacity: 0.7;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .nav-group details[open] .nav-group-chevron,
  .nav-group summary:hover .nav-group-chevron {
    opacity: 1;
  }
  .nav-group details[open] .nav-group-chevron {
    transform: rotate(180deg);
  }
  .nav-submenu {
    position: absolute;
    top: calc(100% - 2px);
    left: 0;
    z-index: 120;
    display: grid;
    gap: 0.1rem;
    width: max-content;
    min-width: 11.5rem;
    max-width: calc(100vw - 2rem);
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    border: 1px solid color-mix(in srgb, white 12%, transparent);
    border-radius: 0.75rem;
    background: #1d1d1f;
    box-shadow: 0 12px 28px color-mix(in srgb, black 45%, transparent);
    transform-origin: top center;
    animation: nav-submenu-in 0.16s ease-out;
  }
  @keyframes nav-submenu-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-submenu {
      animation: none;
    }
  }
  .nav-group[data-nav-group="more"] .nav-submenu {
    left: auto;
    right: 0;
  }
  .nav-submenu::before {
    content: "";
    position: absolute;
    top: -10px;
    left: 0;
    width: 100%;
    height: 12px;
    background: transparent;
  }
  .nav-submenu li {
    display: block;
  }
  .nav-submenu a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.25rem;
    width: auto;
    min-width: max-content;
    padding: 0.45rem 0.7rem;
    border-radius: 0.5rem;
    color: #fff;
    background: transparent;
    border: 1px solid transparent;
    box-sizing: border-box;
    text-decoration: none;
    opacity: 0.88;
    transition: background 0.15s ease, opacity 0.15s ease;
  }
  .nav-submenu a:hover,
  .nav-submenu a:focus-visible,
  .nav-submenu a.active {
    opacity: 1;
    background: color-mix(in srgb, white 10%, transparent);
    border-color: transparent;
  }
  .nav-submenu a.active::after {
    display: none;
  }
  .nav-submenu-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    flex: 0 0 1.1rem;
    font-size: 1rem;
    color: color-mix(in srgb, white 72%, transparent);
  }
  .nav-submenu-text {
    line-height: 1.25;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: -0.12px;
    flex: 1 1 auto;
    color: #fff;
  }
  .nav-backdrop {
    display: none;
  }
  .nav-tool {
    display: flex;
    align-items: center;
    margin-inline-start: 0.1rem;
    padding-inline-start: 0.35rem;
    border-inline-start: 1px solid color-mix(in srgb, white 16%, transparent);
    color: #fff;
  }
  .header-utils {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    flex-shrink: 0;
    margin-inline-start: 0.25rem;
  }
  .header-utils .nav-tool--bar {
    margin-inline-start: 0;
    padding-inline-start: 0;
    border-inline-start: none;
  }
  .nav-toggle {
    display: none;
  }
  .nav-toggle__close {
    display: none;
  }
  .l-header[data-nav-open] .nav-toggle__open {
    display: none;
  }
  .l-header[data-nav-open] .nav-toggle__close {
    display: inline-flex;
  }
  .nav-tool :global(.locale-trigger) {
    height: 32px;
    min-height: 32px;
    min-width: 44px;
    padding-inline: 6px;
    font-size: 12px;
    font-weight: 400;
    color: #fff;
    border: none;
    border-radius: 4px;
  }
  .nav-tool :global(.locale-trigger:hover),
  .nav-tool :global(.locale-trigger:focus-visible) {
    color: #fff;
    background: color-mix(in srgb, white 10%, transparent);
    border-color: transparent;
  }
  .nav-tool :global(.icon-lang),
  .nav-tool :global(.icon-expand) {
    color: #fff;
    opacity: 0.85;
    font-size: 16px;
  }
  .nav-tool :global(.locale-panel) {
