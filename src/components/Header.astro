---
import LocaleSelect from "@/components/i18n/LocaleSelect.astro";
import { useTranslations, type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  SITE_TITLE,
  SITE_SLOGAN,
  NAV_HOME,
  NAV_ABOUT,
  NAV_PROJECTS,
  NAV_QA_WIKI,
  NAV_AI_WIKI,
  NAV_ENCYCLOPEDIA,
  NAV_GUILD,
  NAV_GUIDES,
  NAV_AI_TESTING,
  NAV_MORE,
  NAV_SPONSOR,
  NAV_SEARCH,
} from "@/consts";

const t = useTranslations(Astro.currentLocale as Lang);
const locale = Astro.currentLocale as Lang;

const pathWithoutLang = Astro.url.pathname.replace(/^\/[a-zA-Z-]+/, "") || "/";

const isExactPath = (path: string) => {
  const localizedPath = getRelativeLocaleUrl(locale, path);
  return Astro.url.pathname === localizedPath || Astro.url.pathname === `${localizedPath}/`;
};

const isSectionPath = (path: string) => pathWithoutLang === path || pathWithoutLang.startsWith(`${path}/`);
const isWikiSection = () => isSectionPath("/wiki");
const isAiWikiSection = () => isSectionPath("/AIWiki");
const isGuildSection = () => isSectionPath("/guild");
const isPromptsSection = () => isSectionPath("/prompts");
const isQASkillsSection = () => isSectionPath("/qaskills");
const isProjectsSection = () => isSectionPath("/projects");
const isSponsorSection = () => isSectionPath("/sponsor");
const siteTitle = t(SITE_TITLE);

const navGroups = [
  {
    key: "encyclopedia",
    label: t(NAV_ENCYCLOPEDIA),
    active: isWikiSection() || isAiWikiSection(),
    items: [
      {
        key: "qa-wiki",
        href: locale === "zh-cn" ? getRelativeLocaleUrl(locale, "/wiki") : "https://ray.run/wiki",
        label: t(NAV_QA_WIKI),
        icon: "menu_book",
        active: isWikiSection(),
        external: locale !== "zh-cn",
      },
      {
        key: "ai-wiki",
        href: getRelativeLocaleUrl(locale, "/AIWiki"),
        label: t(NAV_AI_WIKI),
        icon: "psychology",
        active: isAiWikiSection(),
      },
    ],
  },
  {
    key: "guides",
    label: t(NAV_GUIDES),
    active: isGuildSection(),
    items: [
      {
        key: "guild",
        href: getRelativeLocaleUrl(locale, "/guild"),
        label: t(NAV_GUILD),
        icon: "route",
        active: isGuildSection(),
      },
    ],
  },
  {
    key: "ai-testing",
    label: t(NAV_AI_TESTING),
    active: isPromptsSection() || isQASkillsSection(),
    items: [
      {
        key: "qa-prompts",
        href: getRelativeLocaleUrl(locale, "/prompts"),
        label: locale === "zh-cn" ? "软件测试提示词库" : "QA Prompt Library",
        icon: "tips_and_updates",
        active: isPromptsSection(),
      },
      {
        key: "qa-skills",
        href: getRelativeLocaleUrl(locale, "/qaskills"),
        label: locale === "zh-cn" ? "软件测试技能库" : "QA Skill Library",
        icon: "build",
        active: isQASkillsSection(),
      },
    ],
  },
  {
    key: "more",
    label: t(NAV_MORE),
    active: isProjectsSection() || isSponsorSection(),
    items: [
      {
        key: "projects",
        href: getRelativeLocaleUrl(locale, "/projects"),
        label: t(NAV_PROJECTS),
        icon: "folder",
        active: isProjectsSection(),
      },
      {
        key: "sponsor",
        href: getRelativeLocaleUrl(locale, "/sponsor"),
        label: t(NAV_SPONSOR),
        icon: "favorite",
        active: isSponsorSection(),
      },
    ],
  },
];
---

<header class="l-header">
  <div class:list={["header-shell l-content", { "header-shell--en": locale === "en" }]}>
    <div class:list={["site-brand", { "site-brand--en": locale === "en" }]}>
      <div class="site-brand-row">
        <h1>
          <a href={getRelativeLocaleUrl(locale, "/")} class="site-brand-link">
            <span class="brand-mark" aria-hidden="true"></span>
            <img src="/favicon.svg" alt="" class="site-logo" width="18" height="18" />
            {locale === "zh-cn" ? (
              <span class="site-title-cobrand" aria-label={siteTitle}>
                <span>软件测试同学</span>
                <span class="site-title-cobrand-x" aria-hidden="true">X</span>
                <span>naodeng</span>
              </span>
            ) : (
              <span>{siteTitle}</span>
            )}
          </a>
        </h1>
        <p class="site-slogan">{t(SITE_SLOGAN)}</p>
      </div>
    </div>

    <nav class="site-nav">
      <ul>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "/")}
            class={isExactPath("/") ? "active" : null}
            data-nav-item="home"
          >
            {t(NAV_HOME)}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "/blog")}
            class={isSectionPath("/blog") ? "active" : null}
            data-nav-item="blog"
          >
            {t({ en: "Blog", "zh-cn": "博客" })}
          </a>
        </li>
        {
          navGroups.map((group) => (
            <li class="nav-group" data-nav-group={group.key}>
              <details open={group.active || undefined} data-nav-details>
                <summary class:list={["nav-group-trigger", { active: group.active }]}>
                  <span>{group.label}</span>
                  <span class="material-icons-sharp nav-group-chevron" aria-hidden="true">expand_more</span>
                </summary>
                <ul class="nav-submenu">
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class={item.active ? "active" : null}
                        data-nav-item={item.key}
                        target={item.external ? "_blank" : undefined}
                        rel={item.external ? "noopener noreferrer" : undefined}
                      >
                        <span class="nav-submenu-icon material-icons-sharp" aria-hidden="true">{item.icon}</span>
                        <span class="nav-submenu-text">{item.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))
        }
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "/about")}
            class={isExactPath("/about") ? "active" : null}
            data-nav-item="about"
          >
            {t(NAV_ABOUT)}
          </a>
        </li>
        <li class="nav-tool">
          <LocaleSelect compact />
        </li>
        <li class="nav-tool">
          <button type="button" class="btn-icon" aria-label={t(NAV_SEARCH)} data-search-open>
            <span class="material-icons-sharp" aria-hidden="true">search</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const initHeaderNav = () => {
    const detailNodes = Array.from(document.querySelectorAll("[data-nav-details]"));
    detailNodes.forEach((detail) => {
      detail.addEventListener("toggle", () => {
        if (!(detail instanceof HTMLDetailsElement) || !detail.open) return;
        detailNodes.forEach((other) => {
          if (other !== detail && other instanceof HTMLDetailsElement) {
            other.open = false;
          }
        });
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (detailNodes.some((detail) => detail.contains(target))) return;
      detailNodes.forEach((detail) => {
        if (detail instanceof HTMLDetailsElement) {
          detail.open = false;
        }
      });
    });
  };

  initHeaderNav();
  document.addEventListener("astro:after-swap", initHeaderNav);
</script>

<style>
  .l-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 44px;
    background: #000;
    color: #fff;
    border: none;
    box-shadow: none;
  }
  .l-header::after {
    display: none;
  }
  .header-shell {
    max-inline-size: 1400px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: 20px;
    margin-inline: auto;
  }
  .header-shell--en {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
  }
  .site-brand {
    display: flex;
    justify-content: flex-start;
    min-width: 0;
    flex-shrink: 0;
  }
  .site-brand-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    max-width: none;
  }
  .site-slogan {
    display: none;
  }
  h1 {
    margin: 0;
    font-size: 14px;
    font-family: var(--english-font);
    font-weight: 600;
    letter-spacing: -0.12px;
    line-height: 1;
  }
  .site-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.18s ease;
  }
  .site-brand-link:hover {
    opacity: 0.8;
    color: #fff;
  }
  .brand-mark {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-mark);
    margin-inline-end: 8px;
    vertical-align: middle;
    flex-shrink: 0;
  }
  .site-title-cobrand {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    white-space: nowrap;
    line-height: 1;
  }
  .site-title-cobrand-x {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1em;
    height: 1em;
    padding-inline: 0.12em;
    margin-inline: 0.04em 0.08em;
    font-size: 0.55em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, white 70%, transparent);
    background: color-mix(in srgb, white 10%, transparent);
    border: 1px solid color-mix(in srgb, white 14%, transparent);
    border-radius: 999px;
  }
  .site-brand-link .site-logo {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-inline-end: 0.4em;
    object-fit: contain;
  }
  .site-nav {
    display: flex;
    justify-content: flex-end;
    min-width: 0;
    flex: 1 1 auto;
  }
  .site-nav > ul {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    width: max-content;
    max-width: none;
  }
  .site-nav > ul > li {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .site-nav > ul > li > a,
  .nav-group-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    min-height: 44px;
    padding: 0 0.7rem;
    border-radius: 0;
    white-space: nowrap;
    text-decoration: none;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: -0.12px;
    color: #fff;
    opacity: 0.8;
    background: transparent;
    box-shadow: none;
    transition: opacity 0.18s ease, background-color 0.18s ease;
    position: relative;
  }
  .site-nav > ul > li > a:hover,
  .site-nav > ul > li > a:active,
  .site-nav > ul > li > a:focus-visible,
  .nav-group-trigger:hover,
  .nav-group-trigger:focus-visible {
    color: #fff;
    opacity: 1;
    background: transparent;
  }
  .site-nav > ul > li > a:focus-visible,
  .nav-group-trigger:focus-visible {
    outline: 2px solid color-mix(in srgb, white 70%, transparent);
    outline-offset: -2px;
  }
  .site-nav > ul > li > a.active,
  .nav-group-trigger.active {
    color: #fff;
    opacity: 1;
    background: transparent;
    box-shadow: none;
  }
  .site-nav > ul > li > a.active::after,
  .nav-group-trigger.active::after {
    display: none;
  }
  .nav-group {
    position: relative;
  }
  .nav-group details {
    position: relative;
  }
  .nav-group summary {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    list-style: none;
    cursor: pointer;
  }
  .nav-group summary::-webkit-details-marker {
    display: none;
  }
  .nav-group-chevron {
    font-size: 14px;
    opacity: 0.7;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .nav-group details[open] .nav-group-chevron,
  .nav-group summary:hover .nav-group-chevron {
    opacity: 1;
  }
  .nav-group details[open] .nav-group-chevron {
    transform: rotate(180deg);
  }
  .nav-submenu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 120;
    display: grid;
    gap: 0.1rem;
    width: max-content;
    min-width: 0;
    max-width: calc(100vw - 2rem);
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    border: 1px solid color-mix(in srgb, white 12%, transparent);
    border-radius: 0.75rem;
    background: #1d1d1f;
    box-shadow: 0 12px 28px color-mix(in srgb, black 45%, transparent);
    transform: none;
  }
  .nav-group[data-nav-group="more"] .nav-submenu {
    left: auto;
    right: 0;
  }
  .nav-submenu::before {
    content: "";
    position: absolute;
    top: -10px;
    left: 0;
    width: 100%;
    height: 12px;
    background: transparent;
  }
  .nav-submenu li {
    display: block;
  }
  .nav-submenu a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.25rem;
    width: auto;
    min-width: max-content;
    padding: 0.45rem 0.7rem;
    border-radius: 0.5rem;
    color: #fff;
    background: transparent;
    border: 1px solid transparent;
    box-sizing: border-box;
    text-decoration: none;
    opacity: 0.88;
  }
  .nav-submenu a:hover,
  .nav-submenu a:focus-visible,
  .nav-submenu a.active {
    opacity: 1;
    background: color-mix(in srgb, white 10%, transparent);
    border-color: transparent;
  }
  .nav-submenu a.active::after {
    display: none;
  }
  .nav-submenu-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    flex: 0 0 1.1rem;
    font-size: 1rem;
    color: color-mix(in srgb, white 72%, transparent);
  }
  .nav-submenu-text {
    line-height: 1.25;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: -0.12px;
    flex: 1 1 auto;
    color: #fff;
  }
  .nav-tool {
    display: flex;
    align-items: center;
    margin-inline-start: 0.1rem;
    padding-inline-start: 0.35rem;
    border-inline-start: 1px solid color-mix(in srgb, white 16%, transparent);
    color: #fff;
  }
  .nav-tool :global(.locale-trigger) {
    height: 32px;
    min-height: 32px;
    min-width: 44px;
    padding-inline: 6px;
    font-size: 12px;
    font-weight: 400;
    color: #fff;
    border: none;
    border-radius: 4px;
  }
  .nav-tool :global(.locale-trigger:hover),
  .nav-tool :global(.locale-trigger:focus-visible) {
    color: #fff;
    background: color-mix(in srgb, white 10%, transparent);
    border-color: transparent;
  }
  .nav-tool :global(.icon-lang),
  .nav-tool :global(.icon-expand) {
    color: #fff;
    opacity: 0.85;
    font-size: 16px;
  }
  .nav-tool :global(.locale-panel) {
    background: #1d1d1f;
    border: 1px solid color-mix(in srgb, white 12%, transparent);
    box-shadow: 0 12px 28px color-mix(in srgb, black 45%, transparent);
  }
  .nav-tool :global(.locale-panel a) {
    color: #fff;
    font-size: 12px;
    font-weight: 400;
  }
  .nav-tool :global(.locale-panel a:hover) {
    background: color-mix(in srgb, white 10%, transparent);
    color: #fff;
  }
  .btn-icon {
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    height: 32px;
    min-width: 32px;
    padding-inline: 0.4rem;
    white-space: nowrap;
    font: inherit;
    font-size: 12px;
    font-weight: 400;
    color: #fff;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.18s ease, opacity 0.18s ease;
  }
  .btn-icon:hover,
  .btn-icon:focus-visible {
    color: #fff;
    background: color-mix(in srgb, white 10%, transparent);
    border-color: transparent;
  }
  .btn-icon:focus-visible {
    outline: 2px solid color-mix(in srgb, white 70%, transparent);
    outline-offset: 1px;
  }
  .btn-icon .material-icons-sharp {
    font-size: 18px;
    color: currentColor;
    opacity: 0.95;
    flex-shrink: 0;
  }

  @media (width < 834px) {
    .l-header {
      height: auto;
      min-height: 44px;
    }
    .header-shell {
      height: auto;
      min-height: 44px;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: 0;
    }
    .site-brand,
    .site-brand-row,
    .site-nav {
      justify-content: center;
    }
    .site-brand {
      min-height: 44px;
      align-items: center;
    }
    .site-nav {
      padding-block-end: 0.35rem;
    }
    .site-nav > ul {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0;
      width: 100%;
      max-width: 100%;
    }
    .site-nav > ul > li > a,
    .nav-group-trigger {
      min-height: 40px;
      padding-inline: 0.55rem;
    }
    .nav-group details {
      width: auto;
    }
    .nav-submenu {
      position: absolute;
      top: calc(100% + 0.2rem);
      left: 0;
      z-index: 130;
      margin-top: 0;
      transform: none;
      min-width: min(240px, calc(100vw - 2rem));
      width: max-content;
      max-width: calc(100vw - 2rem);
    }
    .nav-group[data-nav-group="more"] .nav-submenu {
      left: auto;
      right: 0;
    }
    .nav-group[data-nav-group="ai-testing"] .nav-submenu {
      left: auto;
      right: 0;
    }
    .nav-submenu::before {
      display: block;
    }
  }
</style>
