---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Lang } from "@/i18n";
import type { Multilingual } from "@/i18n";
import { 
  NAV_ABOUT, 
  NAV_PROJECTS, 
  NAV_ARCHIVE, 
  NAV_SPONSOR,
  NAV_SERIES,
  NAV_TAGS,
  FOOTER_NAV_QA_WIKI,
  FOOTER_NAV_AI_WIKI,
  FOOTER_NAV_GUILD,
  FOOTER_NAV_PROMPTS,
  FOOTER_NAV_QASKILLS,
  NAV_STATUS,
  NAV_COPYRIGHT,
  NAV_PRIVACY,
  NAV_LINKS,
  NAV_ANALYTICS,
  SITE_SLOGAN,
  LEARNING_SITES
} from "@/consts";

const locale = Astro.currentLocale as Lang;
const brandName = locale === "zh-cn" ? "软件测试同学 X naodeng" : "Nao's Blog";
const siteSlogan = typeof SITE_SLOGAN === "string" ? SITE_SLOGAN : SITE_SLOGAN[locale];
const localizedHomePath = getRelativeLocaleUrl(locale, "/");
const rssLabel = locale === "zh-cn" ? "订阅 RSS" : "RSS Feed";

const socialLinks = [
  { name: "GitHub", label: "GitHub", url: "https://github.com/naodeng", icon: "github" },
  { name: "X", label: "X", url: "https://x.com/inaodeng", icon: "x" },
  { name: "Medium", label: "Medium", url: "https://naodeng.medium.com/", icon: "medium" },
  { name: "Weibo", label: locale === "zh-cn" ? "微博" : "Weibo", url: "https://weibo.com/u/1651778270", icon: "weibo" },
  { name: "Ko-fi", label: "Ko-fi", url: "https://ko-fi.com/naodeng", icon: "kofi" },
  { name: "Email", label: locale === "zh-cn" ? "邮箱" : "Email", url: "mailto:dengnao@gmail.com", icon: "email" },
  { name: "RSS", label: rssLabel, url: getRelativeLocaleUrl(locale, "/rss.xml"), icon: "rss" },
];

const t = {
  rss: rssLabel,
  sitemap: locale === 'zh-cn' ? '站点地图' : 'Sitemap',
  license: locale === 'zh-cn' ? '遵循 PolyForm Noncommercial 1.0.0 许可协议' : 'Licensed under PolyForm Noncommercial 1.0.0',
  builtWith: locale === 'zh-cn' ? '由 Astro & Cloudflare & GitHub & AI 驱动' : 'Built with Astro & Cloudflare & GitHub & AI',
};

type FooterLink = { href: string; label: string; external?: boolean };
type FooterGroup = { key: string; title: string; rows: FooterLink[][] };
const localizedLabel = (label: string | Multilingual) => typeof label === "string" ? label : label[locale === "zh-cn" ? "zh-cn" : "en"] ?? "";
const pageLink = (path: string, label: string | Multilingual): FooterLink => ({
  href: getRelativeLocaleUrl(locale, path),
  label: localizedLabel(label),
});
const externalLink = (href: string, label: string): FooterLink => ({ href, label, external: true });
const learningLinks = LEARNING_SITES.map((site) => externalLink(site.url, site.label[locale === "zh-cn" ? "zh-cn" : "en"]));

const footerGroups: FooterGroup[] = [
  {
    key: "explore",
    title: locale === "zh-cn" ? "探索" : "Explore",
    rows: locale === "zh-cn"
      ? [[pageLink("/about", NAV_ABOUT), pageLink("/archive", NAV_ARCHIVE), pageLink("/projects", NAV_PROJECTS)], [pageLink("/series", NAV_SERIES), pageLink("/tags", NAV_TAGS)]]
      : [[pageLink("/about", NAV_ABOUT), pageLink("/archive", NAV_ARCHIVE)], [pageLink("/projects", NAV_PROJECTS), pageLink("/series", NAV_SERIES), pageLink("/tags", NAV_TAGS)]],
  },
  {
    key: "knowledge",
    title: locale === "zh-cn" ? "知识库" : "Knowledge",
    rows: [[pageLink("/wiki", FOOTER_NAV_QA_WIKI), pageLink("/AIWiki", FOOTER_NAV_AI_WIKI)], [pageLink("/guild", FOOTER_NAV_GUILD)]],
  },
  {
    key: "tools",
    title: locale === "zh-cn" ? "工具与学习" : "Tools",
    rows: locale === "zh-cn"
      ? [[pageLink("/prompts", FOOTER_NAV_PROMPTS)], [pageLink("/qaskills", FOOTER_NAV_QASKILLS)], [learningLinks[0], learningLinks[1]], [learningLinks[2]], [learningLinks[3]]]
      : [[pageLink("/prompts", FOOTER_NAV_PROMPTS)], [pageLink("/qaskills", FOOTER_NAV_QASKILLS)]],
  },
  {
    key: "site",
    title: locale === "zh-cn" ? "站点" : "Site",
    rows: [
      [pageLink("/copyright", NAV_COPYRIGHT), pageLink("/privacy", NAV_PRIVACY)],
      [pageLink("/links", NAV_LINKS), pageLink("/sponsor", NAV_SPONSOR)],
      [externalLink("https://status.inaodeng.com", localizedLabel(NAV_STATUS)), externalLink("https://analytics.inaodeng.com/dashboard?site=inaodeng.com", localizedLabel(NAV_ANALYTICS))],
      [pageLink("/sitemap", t.sitemap)],
    ],
  },
  {
    key: "products",
    title: locale === "zh-cn" ? "产品官网" : "Product sites",
    rows: [[pageLink("/dsh-qa", "DSH-QA")], [pageLink("/ai-test-auditor", "AI test audit")]],
  },
];
---

<footer class="l-footer">
  <div class="footer-container l-content">
    <div class="footer-main">
      <section class="footer-brand" aria-label={locale === "zh-cn" ? "软件测试同学品牌信息" : "Nao's Blog"}>
        <a class="footer-brand__link" href={localizedHomePath} aria-label={brandName}>
          <img
            src={locale === "zh-cn" ? "/brand/software-testing-students-logo-final.png" : "/favicon.svg"}
            alt=""
            width="40"
            height="40"
            loading="lazy"
          />
          <span>{brandName}</span>
        </a>
        <p class="footer-brand__slogan">{siteSlogan}</p>
        <ul class="footer-brand__socials" aria-label={locale === "zh-cn" ? "社交链接" : "Social links"}>
          {socialLinks.map((link) => (
            <li>
              <a
                class={link.icon === "rss" ? "footer-brand__social-link footer-brand__social-link--rss" : "footer-brand__social-link"}
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.label}
                title={link.name}
              >
                {link.icon === "github" && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>}
                {link.icon === "x" && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18.901 1.153h3.68l-8.04 4.617L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>}
                {link.icon === "medium" && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42S14.2 15.54 14.2 12s1.51-6.42 3.38-6.42 3.38 2.88 3.38 6.42zM24 12c0 3.17-.53 5.75-1.19 5.75s-1.19-2.58-1.19-5.75.53-5.75 1.19-5.75S24 8.83 24 12z"/></svg>}
                {link.icon === "weibo" && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10.08 18.12c-3.12 0-5.64-1.32-5.64-3 0-1.68 2.52-3 5.64-3s5.64 1.32 5.64 3c0 1.68-2.52 3-5.64 3zm13.92-10.8c-.24-.48-.72-.72-1.2-.72h-.24c-1.2.24-2.16 1.44-2.16 2.88 0 1.44.96 2.64 2.16 2.88h.24c.48 0 .96-.24 1.2-.72.24-.48.24-1.2 0-1.68-.24-.48-.24-1.2 0-1.68.24-.48.24-1.2 0-1.68zm-3.36 1.2c-.48-.24-.96-.48-1.44-.48h-.24c-1.44.24-2.64 1.68-2.64 3.36 0 1.68 1.2 3.12 2.64 3.36h.24c.48 0 .96-.24 1.44-.48.48-.24.72-.72.72-1.2 0-.48-.24-.96-.72-1.2-.48-.24-.48-1.2 0-1.44.48-.24.72-.72.72-1.2 0-.48-.24-.96-.72-1.2zM12 2.4c-6.6 0-12 4.08-12 9.12 0 5.04 5.4 9.12 12 9.12s12-4.08 12-9.12c0-5.04-5.4-9.12-12-9.12zm0 15.6c-4.68 0-8.4-2.88-8.4-6.48 0-3.6 3.72-6.48 8.4-6.48s8.4 2.88 8.4 6.48c0 3.6-3.72 6.48-8.4 6.48z"/></svg>}
                {link.icon === "kofi" && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.724c-.604 0-.724.467-.724.467s-.024 11.297 0 14.554c.024 3.258 1.821 4.622 1.821 4.622h12.012c.604 0 .724-.467.724-.467s.024-1.109 0-3.178l.232-.039c4.085-.691 9.113-2.34 9.092-11.361zm-4.805 7.403c-1.053.196-2.306.26-3.509.216l.103-8.847c.301-.004.621.005.952.026 3.29.21 4.269 2.739 4.256 5.075-.012 2.337-.791 3.33-1.802 3.53z"/></svg>}
                {link.icon === "email" && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>}
                {link.icon === "rss" && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6.18 17.82a2.18 2.18 0 1 0 0 4.36 2.18 2.18 0 0 0 0-4.36zM4 4.44v3.11c6.87 0 12.44 5.58 12.44 12.45h3.12C19.56 11.42 12.58 4.44 4 4.44zm0 6.22v3.12c3.43 0 6.22 2.79 6.22 6.22h3.12c0-5.15-4.19-9.34-9.34-9.34z"/></svg>}
                {link.icon === "rss" && <span>{link.label}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <nav class="footer-nav" aria-label={locale === "zh-cn" ? "页脚导航" : "Footer navigation"}>
        {footerGroups.map((group) => (
          <section class="footer-nav-group" data-footer-group={group.key}>
            <h2>{group.title}</h2>
            <ul>
              {group.rows.map((row) => (
                <li data-footer-row>
                  {row.map((link, index) => (
                    <>
                      {index > 0 && <span class="footer-nav-separator" aria-hidden="true">·</span>}
                      <a
                        href={link.href}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                      >
                        {link.label}
                      </a>
                    </>
                  ))}
                </li>
              ))}
            </ul>
          </section>
        ))}
        {locale === "zh-cn" && (
          <section class="footer-nav-group footer-wechat" data-footer-group="wechat">
            <img
              src="/brand/software-testing-students-wechat-qr.jpg"
              alt="软件测试同学微信公众号二维码"
              width="112"
              height="112"
              loading="lazy"
              data-footer-qr
            />
            <h2>微信公众号</h2>
            <p data-footer-row>关注软件测试同学<br />扫码获取软件测试与 AI 测试的最新内容。</p>
          </section>
        )}
      </nav>
    </div>

    <div class="footer-divider" aria-hidden="true"></div>
    <div class="footer-info">
      <div class="copyright">
        <a class="copy-link" href={localizedHomePath}>
          © {new Date().getFullYear()} {brandName}
        </a>
        <span class="separator" aria-hidden="true">·</span>
        <a href={getRelativeLocaleUrl(locale, "/copyright")} class="license-link">{t.license}</a>
      </div>
      <span class="built-with">{t.builtWith}</span>
    </div>
  </div>

  {locale === "zh-cn" && (
    <dialog class="wechat-follow-dialog" aria-label="关注软件测试同学公众号" data-wechat-dialog>
      <div class="wechat-follow-card">
        <button type="button" class="wechat-follow-close" aria-label="关闭二维码" data-wechat-close>×</button>
        <p class="wechat-follow-eyebrow">微信公众号</p>
        <h2>关注软件测试同学</h2>
        <p class="wechat-follow-description">使用微信扫描二维码，获取软件测试与 AI 测试的最新内容。</p>
        <img
          src="/brand/software-testing-students-wechat-qr.jpg"
          alt="软件测试同学微信公众号二维码"
          width="258"
          height="258"
          loading="lazy"
        />
        <p class="wechat-follow-hint">微信扫码关注公众号</p>
      </div>
    </dialog>
  )}
</footer>

<script>
  const followTriggers = document.querySelectorAll<HTMLButtonElement>("[data-wechat-follow]");
  const followDialog = document.querySelector<HTMLDialogElement>("[data-wechat-dialog]");
  const followClose = document.querySelector<HTMLButtonElement>("[data-wechat-close]");
  const followCoachmark = document.querySelector<HTMLElement>("[data-wechat-coachmark]");
  const followCoachmarkOpen = document.querySelector<HTMLButtonElement>("[data-wechat-coachmark-open]");
  const followCoachmarkClose = document.querySelector<HTMLButtonElement>("[data-wechat-coachmark-close]");
  const followPromptCookie = "wechat_follow_prompt_seen";
  let followCoachmarkTimer: ReturnType<typeof setTimeout> | undefined;

  const hideFollowCoachmark = () => {
    if (followCoachmarkTimer) clearTimeout(followCoachmarkTimer);
    followCoachmarkTimer = undefined;
    if (followCoachmark) followCoachmark.hidden = true;
  };

  const openFollowDialog = () => {
    hideFollowCoachmark();
    followDialog?.showModal();
  };

  const hasSeenFollowPrompt = document.cookie
    .split(";")
    .some((cookie) => cookie.trim().startsWith(`${followPromptCookie}=`));

  if (followCoachmark && !hasSeenFollowPrompt) {
    followCoachmark.hidden = false;
    document.cookie = `${followPromptCookie}=1; Max-Age=31536000; Path=/; SameSite=Lax`;
    followCoachmarkTimer = setTimeout(hideFollowCoachmark, 7_000);
  }

  followTriggers.forEach((trigger) => trigger.addEventListener("click", openFollowDialog));
  followCoachmarkOpen?.addEventListener("click", openFollowDialog);
  followCoachmarkClose?.addEventListener("click", hideFollowCoachmark);
  followClose?.addEventListener("click", () => followDialog?.close());
  followDialog?.addEventListener("click", (event) => {
    if (event.target === followDialog) followDialog.close();
  });
</script>

<style>
  /* Zenix footer: glass panel on cool gradient */
  .l-footer {
    position: relative;
    margin-block-start: 0;
    padding-block: 78px 56px;
    color: var(--color-text-secondary);
    background: transparent;
  }

  .footer-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-inline-size: 1120px;
    padding: 34px;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: var(--radius-lg);
    background: var(--color-glass-strong);
    box-shadow: var(--shadow-glass-md);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* 社交链接悬浮在卡片顶边 */
  .social-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    z-index: 10;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    color: var(--color-text-secondary);
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 50%;
    background: var(--color-glass-solid);
    box-shadow: var(--shadow-sm);
    transition: color 0.2s ease, border-color 0.2s ease;
    text-decoration: none;
    position: relative;
    padding: 0;
    cursor: pointer;
  }

  .social-icon svg {
    width: 23px;
    height: 23px;
  }

  .social-icon:hover,
  .social-icon:focus-visible {
    color: var(--color-theme);
    border-color: color-mix(in srgb, var(--color-theme) 26%, transparent);
    background: var(--color-theme-soft);
    transform: translateY(-2px);
  }

  .lang-toggle {
    background: var(--color-glass-solid);
  }

  .lang-label {
    position: absolute;
    bottom: 10px;
    font-size: var(--text-xs);
    font-weight: 900;
    padding: 2px 4px;
    border-radius: var(--radius-sm);
    line-height: 1;
    background: var(--color-theme);
    color: var(--color-theme-on-dark);
  }

  .wechat-follow-trigger {
    color: #07c160;
  }

  .wechat-follow-dialog {
    width: min(420px, calc(100vw - 32px));
    max-width: none;
    margin: auto;
    padding: 0;
    color: var(--color-main);
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 24px;
    background: var(--color-glass-solid);
    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.28);
    overflow: hidden;
  }

  .wechat-follow-dialog::backdrop {
    background: rgba(15, 23, 42, 0.48);
  }

  .wechat-follow-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 34px;
    text-align: center;
    background: var(--color-surface);
  }

  .wechat-follow-close {
    position: absolute;
    inset-block-start: 14px;
    inset-inline-end: 14px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    color: var(--color-text-secondary);
    font-size: 1.55rem;
    line-height: 1;
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-glass-solid) 90%, transparent);
    cursor: pointer;
  }

  .wechat-follow-close:hover,
  .wechat-follow-close:focus-visible {
    color: var(--color-theme);
    border-color: color-mix(in srgb, var(--color-theme) 28%, transparent);
  }

  .wechat-follow-eyebrow {
    margin: 0 0 0.55rem;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .wechat-follow-card h2 {
    margin: 0;
    font-size: 1.55rem;
    color: var(--color-main);
  }

  .wechat-follow-description {
    max-width: 30ch;
    margin: 0.75rem 0 1.25rem;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .wechat-follow-card img {
    display: block;
    width: min(258px, 100%);
    height: auto;
    padding: 10px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 18px;
    background: white;
    box-shadow: var(--shadow-sm);
  }

  .wechat-follow-hint {
    margin: 0.9rem 0 0;
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
  }

  /* 底部次级导航 */
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    justify-content: stretch;
    gap: 0.65rem 1rem;
    width: min(960px, 100%);
    max-width: 920px;
    margin-block-start: 1.2rem;
  }

  .footer-nav-group {
    min-width: 0;
  }

  .footer-nav-group h2 {
    margin: 0 0 0.65rem;
    font-size: var(--text-sm);
    line-height: 1.4;
    font-weight: 700;
    color: var(--color-main);
  }

  .footer-nav-group ul {
    list-style: none;
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
  }

  .footer-nav a,
  .social-links a {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 2.2;
  }

  .footer-nav a {
    text-decoration: none;
    font-weight: 700;
    line-height: 1.8;
    padding: 0.18rem 0.35rem;
    border-radius: 999px;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible {
    color: var(--color-theme);
    background: var(--color-theme-soft);
  }

  /* 版权与信息区域 */
  .footer-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-block-start: var(--sp-m);
    border-block-start: 1px solid rgba(148, 163, 184, 0.28);
    width: 100%;
    max-inline-size: 760px;
    text-align: center;
  }

  .footer-slogan {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-text-tertiary);
  }

  .copyright {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .copy-link {
    color: var(--color-main);
    text-decoration: none;
