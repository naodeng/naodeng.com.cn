{
  "name": "inaodeng-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e:build",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run test:e2e:build",
    "test:e2e:run": "e2e run",
    "test:e2e:build": "npm --prefix .. run build && npm run test:e2e:run",
    "test:e2e:all": "npm run test:e2e",
    "visual:sampling": "node scripts/visual-sampling.mjs"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.3",
    "e2e": "0.21.3",
    "fast-check": "^4.5.3",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "e2e": {
      "zod": "4.6.6"
    }
  }
}
